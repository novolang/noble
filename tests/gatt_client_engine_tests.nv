@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_an_included_service_with_a_128_bit_uuid_costs_a_read_for_its_uuid()
    var t = table()
    var s = server()
    let target = gatt_server.add_service(var s.db, false, gatt_server.uuid128(0x07))
    let _ = gatt_server.add_characteristic(var s.db, 0x02, gatt_server.PERM_READ, gatt_server.le16(0xDD01))
    test.assert(gatt_server.set_value(var s.db, 0, [0x01]))
    let outer = gatt_server.add_service(var s.db, false, gatt_server.le16(0xDD00))
    let include = gatt_server.add_included(var s.db, target)
    var trace = new_log()
    let _ = gatt_client.begin_find_included(var t, link_a(), 0, outer, include)
    pump(var t, link_a(), var s, var trace)
    test.assert_eq(trace.statuses, [0])
    test.assert_eq(gatt_client.cache_count(var t, link_a()), 1)
    test.assert_eq(gatt_client.cache_handle_at(var t, link_a(), 0), include)
    test.assert_eq(gatt_client.cache_a_at(var t, link_a(), 0), target)
    test.assert(gatt_client.uuid_same(gatt_client.cache_uuid_at(var t, link_a(), 0), uuid_of(gatt_server.uuid128(0x07))))
    // Read By Type found it, and a Read Request fetched the UUID.
    test.assert_eq(list.len(trace.sent), 2)
    test.assert_eq(trace.sent[1], [0x0A, target & 0xFF, target >>> 8])

// ── Reads ───────────────────────────────────────────────────────────

// A characteristic that anyone reads and writes, with no value set: it takes
// a value of any length up to the Attribute Protocol's 512 octets.  Answers
// the value handle.
fn open_value(var s: gatt_server.GattServer, uuid16: Int) -> Int
    let decl = gatt_server.add_characteristic(var s.db, 0x0A, gatt_server.PERM_READ | gatt_server.PERM_WRITE, gatt_server.le16(uuid16))
    decl + 1

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_value_is_read_with_one_request()
    var t = table()
    var s = server()
    var trace = new_log()
    let _ = gatt_client.begin_read(var t, link_a(), 0, 0x001A)
    pump(var t, link_a(), var s, var trace)
    test.assert_eq(trace.sent[0], [0x0A, 0x1A, 0x00])
    test.assert_eq(trace.statuses, [0])
    test.assert_eq(trace.values[0], [1, 2, 3, 4])
    test.assert_eq(gatt_client.value_len(var t, link_a(), 0), 4)

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
