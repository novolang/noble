@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_the_results_of_a_bearer_are_read_before_the_next_response_replaces_them()
    var t = table()
    var s = server()
    let first = gatt_client.begin_read(var t, link_a(), 0, 0x001A)
    let second = gatt_client.begin_read(var t, link_a(), 0, 0x0003)
    var trace = new_log()
    let answers = exchange(var t, link_a(), 0, var s, 0, var trace)
    deliver(var t, link_a(), 0, answers[0], var trace)
    // The second request has been started; the first one's result is still there.
    test.assert_eq(gatt_client.result_ticket(var t, link_a(), 0), first)
    test.assert_eq(value_of(var t, link_a(), 0), [1, 2, 3, 4])
    let more = exchange(var t, link_a(), 0, var s, 0, var trace)
    deliver(var t, link_a(), 0, more[0], var trace)
    test.assert_eq(gatt_client.result_ticket(var t, link_a(), 0), second)
    test.assert_eq(value_of(var t, link_a(), 0), [0x54, 0x65, 0x73, 0x74])

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_write_clears_the_value_a_read_left()
    var t = table()
