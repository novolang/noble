// tests/gatt_db_tests.nv — the unit tests of src/gatt_db.nv.
//
//   novo test tests/gatt_db_tests.nv

use std.test
use att
use att_server
use gatt_db.{ CENTRAL_ADDRESS_RESOLUTION_VALUE, CHAR_PROP_INDICATE, CHAR_PROP_NOTIFY, CHAR_PROP_READ, CHAR_PROP_WRITE, DATABASE_HASH_OCTETS, DEVICE_NAME_MAX, GAP_SERVER_APPEARANCE_HANDLE, GAP_SERVER_CAR_HANDLE, GAP_SERVER_CLIENT_SUPPORTED_FEATURES_DECL, GAP_SERVER_CLIENT_SUPPORTED_FEATURES_HANDLE, GAP_SERVER_DATABASE_HASH_DECL, GAP_SERVER_DATABASE_HASH_HANDLE, GAP_SERVER_DEVICE_NAME_HANDLE, GAP_SERVER_FIXED_BYTES, GAP_SERVER_GAP_END, GAP_SERVER_GATT_END, GAP_SERVER_GATT_SERVICE_HANDLE, GAP_SERVER_PPCP_HANDLE, GAP_SERVER_RPA_ONLY_DECL, GAP_SERVER_RPA_ONLY_HANDLE, GAP_SERVER_SECURITY_LEVELS_DECL, GAP_SERVER_SECURITY_LEVELS_HANDLE, GAP_SERVER_SERVER_SUPPORTED_FEATURES_DECL, GAP_SERVER_SERVER_SUPPORTED_FEATURES_HANDLE, GAP_SERVER_SERVICE_CHANGED_CCCD_HANDLE, GATT_DB_BLOB_BYTES, HANDLE_APPEARANCE_VALUE, HANDLE_BATTERY_LEVEL_CCCD, HANDLE_BATTERY_LEVEL_DECL, HANDLE_BATTERY_LEVEL_VALUE, HANDLE_BATTERY_SVC, HANDLE_BSL_VALUE, HANDLE_DEVICE_INFO_END_GROUP, HANDLE_DEVICE_INFO_SVC, HANDLE_DEVICE_NAME_VALUE, HANDLE_GAP_SVC, HANDLE_GAP_SVC_END_GROUP, HANDLE_GATT_SVC, HANDLE_GATT_SVC_END_GROUP, HANDLE_HRM_CCCD, HANDLE_HRM_VALUE, HANDLE_HRS_END_GROUP, HANDLE_HRS_SVC, HANDLE_MFR_NAME_DECL, HANDLE_MFR_NAME_VALUE, HANDLE_MODEL_NUMBER_VALUE, HANDLE_SERVICE_CHANGED_DECL, HANDLE_SERVICE_CHANGED_VALUE, RESOLVABLE_PRIVATE_ADDRESS_ONLY_VALUE, SECURITY_LEVEL_NO_SECURITY, SECURITY_MODE_LE, SERVER_SUPPORTED_FEATURES_EATT, UUID_BODY_SENSOR_LOCATION, UUID_CCCD, UUID_CLIENT_SUPPORTED_FEATURES, UUID_DATABASE_HASH, UUID_HEART_RATE_MEASUREMENT, UUID_LE_GATT_SECURITY_LEVELS, UUID_PRIMARY_SERVICE, UUID_RESOLVABLE_PRIVATE_ADDRESS_ONLY, UUID_SERVER_SUPPORTED_FEATURES, appearance_bytes, build, build_gap_server, device_name_bytes, ppcp_value }
use gatt_db

// ── Tests ───────────────────────────────────────────────────────────

@test
fn test_gap_server_layout()
    let name: [u8] = ['T', 'e', 's', 't']
    let db = build_gap_server(name, appearance_bytes(), ppcp_value(0x0018, 0x0028, 0, 0x01F4), true)
    test.assert_eq(att_server.db_count(db), 23)
    // The GAP service groups handles 1 to 13, the GATT service 14 to 23.
    test.assert_eq(att_server.db_end_group_at(db, 0), GAP_SERVER_GAP_END)
    test.assert_eq(att_server.db_handle_at(db, 13), GAP_SERVER_GATT_SERVICE_HANDLE)
    test.assert_eq(att_server.db_end_group_at(db, 13), GAP_SERVER_GATT_END)
    let car = att_server.db_value_at(db, att_server.db_index_for_handle(db, GAP_SERVER_CAR_HANDLE))
    test.assert_eq(list.len(car), 1)
    test.assert_eq(car[0] as Int, CENTRAL_ADDRESS_RESOLUTION_VALUE)
    let n = att_server.db_value_at(db, att_server.db_index_for_handle(db, GAP_SERVER_DEVICE_NAME_HANDLE))
    test.assert_eq(list.len(n), 4)
    test.assert_eq(n[0] as Int, 'T' as Int)
    let p = att_server.db_value_at(db, att_server.db_index_for_handle(db, GAP_SERVER_PPCP_HANDLE))
    test.assert_eq(list.len(p), 8)
    test.assert_eq(p[0] as Int, 0x18)
    test.assert_eq(p[6] as Int, 0xF4)
    // The Device Name and the Appearance take a write; the Peripheral
    // Preferred Connection Parameters, the two new GAP characteristics
    // and the Database Hash do not.
    test.assert_eq(att_server.db_writable_at(db, GAP_SERVER_DEVICE_NAME_HANDLE), true)
    test.assert_eq(att_server.db_writable_at(db, GAP_SERVER_APPEARANCE_HANDLE), true)
    // Without the option neither takes a write, and nothing else changes.
    let fixed = build_gap_server(name, appearance_bytes(), ppcp_value(0x0018, 0x0028, 0, 0x01F4), false)
    test.assert_eq(att_server.db_count(fixed), 23)
    test.assert_eq(att_server.db_writable_at(fixed, GAP_SERVER_DEVICE_NAME_HANDLE), false)
    test.assert_eq(att_server.db_writable_at(fixed, GAP_SERVER_APPEARANCE_HANDLE), false)
    test.assert_eq(att_server.db_writable_at(fixed, GAP_SERVER_CLIENT_SUPPORTED_FEATURES_HANDLE), true)
    test.assert_eq(att_server.db_writable_at(db, GAP_SERVER_PPCP_HANDLE), false)
    test.assert_eq(att_server.db_writable_at(db, GAP_SERVER_SECURITY_LEVELS_HANDLE), false)
    test.assert_eq(att_server.db_writable_at(db, GAP_SERVER_RPA_ONLY_HANDLE), false)
    test.assert_eq(att_server.db_writable_at(db, GAP_SERVER_DATABASE_HASH_HANDLE), false)
    test.assert_eq(att_server.db_writable_at(db, GAP_SERVER_SERVICE_CHANGED_CCCD_HANDLE), true)
    test.assert_eq(att_server.db_writable_at(db, GAP_SERVER_CLIENT_SUPPORTED_FEATURES_HANDLE), true)
    // The two new characteristics: their declarations name their values
    // and their UUIDs.
    let csf_decl = att_server.db_value_at(db, att_server.db_index_for_handle(db, GAP_SERVER_CLIENT_SUPPORTED_FEATURES_DECL))
    test.assert_eq(csf_decl[0] as Int, CHAR_PROP_READ + CHAR_PROP_WRITE)
    test.assert_eq(csf_decl[1] as Int, GAP_SERVER_CLIENT_SUPPORTED_FEATURES_HANDLE & 0xFF)
    test.assert_eq(csf_decl[3] as Int, UUID_CLIENT_SUPPORTED_FEATURES & 0xFF)
    test.assert_eq(csf_decl[4] as Int, UUID_CLIENT_SUPPORTED_FEATURES >>> 8)
    let csf = att_server.db_value_at(db, att_server.db_index_for_handle(db, GAP_SERVER_CLIENT_SUPPORTED_FEATURES_HANDLE))
    test.assert_eq(list.len(csf), 1)
    test.assert_eq(csf[0] as Int, 0x00)
    let hash_decl = att_server.db_value_at(db, att_server.db_index_for_handle(db, GAP_SERVER_DATABASE_HASH_DECL))
    test.assert_eq(hash_decl[0] as Int, CHAR_PROP_READ)
    test.assert_eq(hash_decl[1] as Int, GAP_SERVER_DATABASE_HASH_HANDLE & 0xFF)
    test.assert_eq(hash_decl[3] as Int, UUID_DATABASE_HASH & 0xFF)
    test.assert_eq(hash_decl[4] as Int, UUID_DATABASE_HASH >>> 8)
    let hash_value = att_server.db_value_at(db, att_server.db_index_for_handle(db, GAP_SERVER_DATABASE_HASH_HANDLE))
    test.assert_eq(list.len(hash_value), DATABASE_HASH_OCTETS)
    // The two GAP characteristics of Part C's Sections 12.7 and 12.5.
    let levels_decl = att_server.db_value_at(db, att_server.db_index_for_handle(db, GAP_SERVER_SECURITY_LEVELS_DECL))
    test.assert_eq(levels_decl[0] as Int, CHAR_PROP_READ)
    test.assert_eq(levels_decl[1] as Int, GAP_SERVER_SECURITY_LEVELS_HANDLE & 0xFF)
    test.assert_eq(levels_decl[3] as Int, UUID_LE_GATT_SECURITY_LEVELS & 0xFF)
    let levels = att_server.db_value_at(db, att_server.db_index_for_handle(db, GAP_SERVER_SECURITY_LEVELS_HANDLE))
    test.assert_eq(list.len(levels), 2)
    test.assert_eq(levels[0] as Int, SECURITY_MODE_LE)
    test.assert_eq(levels[1] as Int, SECURITY_LEVEL_NO_SECURITY)
    let rpa_decl = att_server.db_value_at(db, att_server.db_index_for_handle(db, GAP_SERVER_RPA_ONLY_DECL))
    test.assert_eq(rpa_decl[0] as Int, CHAR_PROP_READ)
    test.assert_eq(rpa_decl[3] as Int, UUID_RESOLVABLE_PRIVATE_ADDRESS_ONLY & 0xFF)
    let rpa = att_server.db_value_at(db, att_server.db_index_for_handle(db, GAP_SERVER_RPA_ONLY_HANDLE))
    test.assert_eq(list.len(rpa), 1)
    test.assert_eq(rpa[0] as Int, RESOLVABLE_PRIVATE_ADDRESS_ONLY_VALUE)
    // The Device Name and Appearance declarations carry the Write bit.
    let name_decl = att_server.db_value_at(db, att_server.db_index_for_handle(db, 0x0002))
    test.assert_eq(name_decl[0] as Int, CHAR_PROP_READ + CHAR_PROP_WRITE)
    // The Server Supported Features characteristic: read-only, its value
    // one octet with the EATT Supported bit, and no part of the Database
    // Hash ([Vol 3] Part G, Sections 7.4 and 7.3.1).
    let ssf_decl = att_server.db_value_at(db, att_server.db_index_for_handle(db, GAP_SERVER_SERVER_SUPPORTED_FEATURES_DECL))
    test.assert_eq(ssf_decl[0] as Int, CHAR_PROP_READ)
    test.assert_eq(ssf_decl[1] as Int, GAP_SERVER_SERVER_SUPPORTED_FEATURES_HANDLE & 0xFF)
    test.assert_eq(ssf_decl[3] as Int, UUID_SERVER_SUPPORTED_FEATURES & 0xFF)
    test.assert_eq(ssf_decl[4] as Int, UUID_SERVER_SUPPORTED_FEATURES >>> 8)
    let ssf = att_server.db_value_at(db, att_server.db_index_for_handle(db, GAP_SERVER_SERVER_SUPPORTED_FEATURES_HANDLE))
    test.assert_eq(list.len(ssf), 1)
    test.assert_eq(ssf[0] as Int, SERVER_SUPPORTED_FEATURES_EATT)
    test.assert_eq(att_server.db_writable_at(db, GAP_SERVER_SERVER_SUPPORTED_FEATURES_HANDLE), false)
    // The characteristic is the last attribute of the GATT service, and
    // the group the service declaration named moved with it.
    test.assert_eq(att_server.db_count(db), 23)

@test
fn test_gap_server_device_name_is_cut_at_248_octets()
    var long_name: [u8] = []
    for _ in 0..300
        list.push(long_name, 'x')
    let db = build_gap_server(long_name, appearance_bytes(), ppcp_value(0xFFFF, 0xFFFF, 0xFFFF, 0xFFFF), false)
    test.assert_eq(att_server.db_value_len_at(db, att_server.db_index_for_handle(db, GAP_SERVER_DEVICE_NAME_HANDLE)),
        DEVICE_NAME_MAX)

@test
fn test_build_returns_twenty_four_attributes()
    let db = build()
    // GAP (5) + GATT (3) + DI (5) + HRS (6) + Battery (4) = 23.
    // Double-check the arithmetic: HRS = svc + hrm_decl + hrm_val
    // + hrm_cccd + bsl_decl + bsl_val = 6.  Battery = svc +
    // bat_decl + bat_val + bat_cccd = 4.  Total = 5+3+5+6+4 = 23.
    test.assert_eq(att_server.db_count(db), 23)

@test
@satisfies("REQ-BLE-GATT-DB-004")
fn test_gap_service_at_handle_one()
    let db = build()
    test.assert_eq(att_server.db_handle_at(db, 0), HANDLE_GAP_SVC)
    test.assert_eq(att_server.db_type16_at(db, 0), UUID_PRIMARY_SERVICE)
    test.assert_eq(att_server.db_end_group_at(db, 0), HANDLE_GAP_SVC_END_GROUP)
    let v = att_server.db_value_at(db, 0)
    test.assert_eq(list.len(v), 2)
    test.assert_eq(v[0] as Int, 0x00)   // 0x1800 lo
    test.assert_eq(v[1] as Int, 0x18)   // 0x1800 hi

