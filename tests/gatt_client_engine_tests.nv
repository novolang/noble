    var t = table()
    var trace = new_log()
    deliver(var t, link_a(), 0, [0x1B, 0x03], var trace)
    deliver(var t, link_a(), 0, [0x1D], var trace)
    deliver(var t, link_a(), 0, [], var trace)
    test.assert_eq(trace.events, [])

// ── Errors in what the peer sends ───────────────────────────────────

// Take the request out and answer it with the PDU `answer`; answers the
// status the request ended with.
fn broken(var t: gatt_client.ClientTable, answer: [Int]) -> Int
    var out: gatt_client.ClientPdu = Vec.new()
    test.assert_eq(gatt_client.take_tx(var t, link_a(), 0, 0, var out), gatt_client.TX_REQUEST)
    var trace = new_log()
    deliver(var t, link_a(), 0, gatt_server.octets(answer), var trace)
    test.assert_eq(trace.events, [gatt_client.EV_DONE])
    trace.statuses[0]

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_response_the_client_cannot_read_ends_the_request_with_protocol_or_order_error()
    var t = table()
    let protocol = gatt_client.STATUS_PROTOCOL
    // A response whose handles go back is a status of its own, `STATUS_ORDER`.
    let order = gatt_client.STATUS_ORDER
    // Services: an item length that is neither 6 nor 20, a ragged list, a
    // range that runs backwards, a handle before the start.
    let _ = gatt_client.begin_discover_services(var t, link_a(), 0, 1, 0xFFFF, false)
    test.assert_eq(broken(var t, [0x11, 5, 1, 0, 2, 0, 0x0A]), protocol)
    let _ = gatt_client.begin_discover_services(var t, link_a(), 0, 1, 0xFFFF, false)
    test.assert_eq(broken(var t, [0x11, 6, 1, 0, 2, 0, 0x0A, 0x18, 9]), protocol)
    let _ = gatt_client.begin_discover_services(var t, link_a(), 0, 5, 0xFFFF, false)
    test.assert_eq(broken(var t, [0x11, 6, 1, 0, 2, 0, 0x0A, 0x18]), order)
    let _ = gatt_client.begin_discover_services(var t, link_a(), 0, 1, 0xFFFF, false)
    test.assert_eq(broken(var t, [0x11, 6, 4, 0, 2, 0, 0x0A, 0x18]), order)
    // Services by UUID: not a multiple of four.
    let _ = gatt_client.begin_discover_services_by_uuid(var t, link_a(), 0, 1, 0xFFFF, gatt_client.uuid16(0x180A))
    test.assert_eq(broken(var t, [0x07, 1, 0, 2]), protocol)
    // Included: an item length that is neither 6 nor 8; a handle before the start.
    let _ = gatt_client.begin_find_included(var t, link_a(), 0, 4, 0xFFFF)
    test.assert_eq(broken(var t, [0x09, 7, 1, 0, 2, 0, 3, 0, 0x0A]), protocol)
    let _ = gatt_client.begin_find_included(var t, link_a(), 0, 4, 0xFFFF)
    test.assert_eq(broken(var t, [0x09, 8, 1, 0, 2, 0, 3, 0, 0x0A, 0x18]), order)
    // Characteristics: item length; value handle not after the declaration.
    let _ = gatt_client.begin_discover_characteristics(var t, link_a(), 0, 1, 0xFFFF)
    test.assert_eq(broken(var t, [0x09, 6, 1, 0, 2, 3, 0, 0x0A]), protocol)
    let _ = gatt_client.begin_discover_characteristics(var t, link_a(), 0, 1, 0xFFFF)
    test.assert_eq(broken(var t, [0x09, 7, 2, 0, 2, 2, 0, 0x0A, 0x2A]), order)
    // Descriptors: a format that is neither 1 nor 2; a ragged list; a handle before the start.
    let _ = gatt_client.begin_discover_descriptors(var t, link_a(), 0, 3, 0xFFFF)
    test.assert_eq(broken(var t, [0x05, 3, 3, 0, 0x02, 0x29]), protocol)
    let _ = gatt_client.begin_discover_descriptors(var t, link_a(), 0, 3, 0xFFFF)
    test.assert_eq(broken(var t, [0x05, 1, 3, 0, 0x02, 0x29, 9]), protocol)
    let _ = gatt_client.begin_discover_descriptors(var t, link_a(), 0, 3, 0xFFFF)
    test.assert_eq(broken(var t, [0x05, 1, 2, 0, 0x02, 0x29]), order)
    // MTU, read by type and the hash.
    let _ = gatt_client.begin_exchange_mtu(var t, link_a(), 0)
    test.assert_eq(broken(var t, [0x03, 0x40]), protocol)
    let _ = gatt_client.begin_read_by_type(var t, link_a(), 0, 1, 0xFFFF, gatt_client.uuid16(0x2A00))
    test.assert_eq(broken(var t, [0x09, 4]), protocol)
    let _ = gatt_client.begin_database_hash(var t, link_a(), 0)
    test.assert_eq(broken(var t, [0x09, 6, 0x15, 0, 1, 2]), protocol)

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_response_that_does_not_answer_the_request_ends_it_with_protocol_error()
    var t = table()
    let _ = gatt_client.begin_read(var t, link_a(), 0, 3)
    test.assert_eq(broken(var t, [0x13]), gatt_client.STATUS_PROTOCOL)
    let _ = gatt_client.begin_read(var t, link_a(), 0, 3)
    // An Error Response for another request, and one too short to read.
    test.assert_eq(broken(var t, [0x01, 0x08, 3, 0, 0x0A]), gatt_client.STATUS_PROTOCOL)
    let _ = gatt_client.begin_read(var t, link_a(), 0, 3)
    test.assert_eq(broken(var t, [0x01, 0x0A, 3]), gatt_client.STATUS_PROTOCOL)

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.CLIENT_CACHE_RECORDS < 128 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_cache_that_is_full_ends_discovery_with_its_own_status()
    var t = table()
    var s = server()
    for i in 0..gatt_client.cache() + 6
        let _ = gatt_server.add_service(var s.db, false, gatt_server.le16(0xC000 + i))
    var trace = new_log()
    let _ = gatt_client.begin_discover_services(var t, link_a(), 0, 1, 0xFFFF, false)
    pump(var t, link_a(), var s, var trace)
    test.assert_eq(trace.statuses, [gatt_client.STATUS_CACHE_FULL])
    test.assert_eq(gatt_client.cache_count(var t, link_a()), gatt_client.cache())
    test.assert(gatt_client.is_local(trace.statuses[0]))
    // A record found again replaces itself and does not need room.
    gatt_client.cache_clear(var t, link_a())
    test.assert_eq(gatt_client.cache_count(var t, link_a()), 0)

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_rediscovery_replaces_what_was_found_before()
    var t = table()
    var s = server()
    discover_everything(var t, link_a(), var s)
    test.assert_eq(gatt_client.cache_count(var t, link_a()), 4)
    test.assert_eq(run(var t,
        link_a(),
        var s,
        gatt_client.begin_discover_services(var t, link_a(), 0, 1, 0xFFFF, false)),
        0)
    test.assert_eq(gatt_client.cache_count(var t, link_a()), 4)

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_the_cache_is_searched_by_kind_and_uuid()
    var t = table()
    var s = server()
    discover_everything(var t, link_a(), var s)
    test.assert_eq(run(var t,
        link_a(),
        var s,
        gatt_client.begin_discover_characteristics(var t, link_a(), 0, 0x0018, 0x0022)),
        0)
    test.assert_eq(gatt_client.cache_find(var t, link_a(), gatt_client.KIND_SERVICE, gatt_client.uuid16(0xBB00), 0),
        3)
    test.assert_eq(gatt_client.cache_find(var t, link_a(), gatt_client.KIND_CHAR, gatt_client.uuid16(0xAA02), 0),
        5)
    test.assert_eq(gatt_client.cache_find(var t, link_a(), gatt_client.KIND_CHAR, gatt_client.uuid16(0xAA02), 6),
        -1)
    test.assert_eq(gatt_client.cache_find(var t, link_a(), gatt_client.KIND_SERVICE, gatt_client.uuid16(0xAA02), 0),
        -1)
    test.assert_eq(gatt_client.cache_kind_at(var t, link_a(), 99), 0)
    test.assert_eq(gatt_client.cache_handle_at(var t, link_a(), -1), 0)

// ── Queue, time and the transaction rule ────────────────────────────

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_one_transaction_is_outstanding_and_the_rest_wait_in_order()
    var t = table()
    var s = server()
    let a = gatt_client.begin_read(var t, link_a(), 0, 0x001A)
    let b = gatt_client.begin_read(var t, link_a(), 0, 0x0020)
    let c = gatt_client.begin_read(var t, link_a(), 0, 0x0003)
    test.assert_eq(list.len([a, b, c]), 3)
    test.assert(a < b and b < c)
    var out: gatt_client.ClientPdu = Vec.new()
    test.assert_eq(gatt_client.take_tx(var t, link_a(), 0, 0, var out), gatt_client.TX_REQUEST)
    // The first is out; nothing else goes until it is answered.
    test.assert_eq(gatt_client.take_tx(var t, link_a(), 0, 0, var out), gatt_client.TX_NONE)
    var trace = new_log()
    let first = gatt_server.receive_on(var s.db, var s.link, 0, [0x0A, 0x1A, 0x00], 0)
    deliver(var t, link_a(), 0, first[0], var trace)
    test.assert_eq(trace.tickets, [a])
    pump(var t, link_a(), var s, var trace)
    test.assert_eq(trace.tickets, [a, b, c])
    test.assert_eq(trace.values[0], [1, 2, 3, 4])
    test.assert_eq(trace.values[1], ramp(22))
    test.assert_eq(trace.values[2], [0x54, 0x65, 0x73, 0x74])

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_full_queue_refuses_the_next_request_and_takes_it_again_when_room_is_made()
    var t = table()
    var s = server()
    // One request runs and the queue holds the rest.
    for _ in 0..gatt_client.queue() + 1
        test.assert(gatt_client.begin_read(var t, link_a(), 0, 0x001A) > 0)
    test.assert_eq(gatt_client.begin_read(var t, link_a(), 0, 0x001A), gatt_client.ERR_QUEUE_FULL)
    var trace = new_log()
    pump(var t, link_a(), var s, var trace)
    test.assert_eq(list.len(trace.tickets), gatt_client.queue() + 1)
    test.assert(gatt_client.begin_read(var t, link_a(), 0, 0x001A) > 0)

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_tickets_rise_by_one_for_each_request_of_a_bearer()
    var t = table()
    let a = gatt_client.begin_read(var t, link_a(), 0, 0x001A)
    let b = gatt_client.begin_write_command(var t, link_a(), 0, 0x0022, payload([1]), 1)
    let c = gatt_client.begin_exchange_mtu(var t, link_a(), 0)
    test.assert_eq(b, a + 1)
    test.assert_eq(c, a + 2)

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES == 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_queued_payloads_share_the_buffer_and_it_is_free_again_when_they_are_sent()
    var t = table()
    var s = server()
    let handle = open_value(var s, 0xAA10)
    test.assert(gatt_client.begin_write_long(var t, link_a(), 0, handle, payload(ramp(200)), 200) > 0)
    test.assert_eq(gatt_client.begin_write_long(var t, link_a(), 0, handle, payload(ramp(100)), 100),
        gatt_client.ERR_NO_ROOM)
    test.assert(gatt_client.begin_write_long(var t, link_a(), 0, handle, payload(ramp(56)), 56) > 0)
    var trace = new_log()
    pump(var t, link_a(), var s, var trace)
    test.assert_eq(trace.statuses, [0, 0])
    test.assert_eq(served(var s, handle), ramp(56))
    test.assert(gatt_client.begin_write_long(var t, link_a(), 0, handle, payload(ramp(100)), 100) > 0)

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_transaction_that_gets_no_response_in_30_s_ends_the_bearer()
    var t = table()
    var s = server()
    var trace = new_log()
    let first = gatt_client.begin_read(var t, link_a(), 0, 0x001A)
    let queued = gatt_client.begin_read(var t, link_a(), 0, 0x0020)
    var out: gatt_client.ClientPdu = Vec.new()
    test.assert_eq(gatt_client.take_tx(var t, link_a(), 0, 1000, var out), gatt_client.TX_REQUEST)
    test.assert_eq(gatt_client.tick(var t, link_a(), 0, 30999), gatt_client.EV_NONE)
    test.assert(not gatt_client.is_dead(var t, link_a(), 0))
    test.assert_eq(gatt_client.tick(var t, link_a(), 0, 31000), gatt_client.EV_DONE)
    test.assert_eq(gatt_client.result_ticket(var t, link_a(), 0), first)
    test.assert_eq(gatt_client.result_status(var t, link_a(), 0), gatt_client.STATUS_TIMEOUT)
    test.assert(gatt_client.is_dead(var t, link_a(), 0))
    test.assert(queued > first)
    // The queue is dropped, nothing more is sent, nothing more is accepted,
    // and a late answer is not heard.
    test.assert(not gatt_client.is_busy(var t, link_a(), 0))
    test.assert_eq(gatt_client.take_tx(var t, link_a(), 0, 31000, var out), gatt_client.TX_NONE)
    test.assert_eq(gatt_client.begin_read(var t, link_a(), 0, 0x001A), gatt_client.ERR_DEAD)
    deliver(var t, link_a(), 0, [0x0B, 0x01], var trace)
    test.assert_eq(trace.events, [])
    test.assert_eq(gatt_client.tick(var t, link_a(), 0, 99999), gatt_client.EV_NONE)

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_the_timer_runs_from_the_moment_the_request_is_sent()
    var t = table()
    let _ = gatt_client.begin_read(var t, link_a(), 0, 0x001A)
    // Queued and not yet sent: no timer.
    test.assert_eq(gatt_client.tick(var t, link_a(), 0, 100000), gatt_client.EV_NONE)
    var out: gatt_client.ClientPdu = Vec.new()
    test.assert_eq(gatt_client.take_tx(var t, link_a(), 0, 100000, var out), gatt_client.TX_REQUEST)
    test.assert_eq(gatt_client.tick(var t, link_a(), 0, 129999), gatt_client.EV_NONE)
    test.assert_eq(gatt_client.tick(var t, link_a(), 0, 130000), gatt_client.EV_DONE)

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_an_answered_request_does_not_time_out()
    var t = table()
    var s = server()
    var trace = new_log()
    let _ = gatt_client.begin_read(var t, link_a(), 0, 0x001A)
