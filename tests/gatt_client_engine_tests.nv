// ── What a bridge to another protocol needs ─────────────────────────
//
// The BTP GATT Client service (src/btp/btp_gatt_client.nv) runs on the engine:
// it names the Rx MTU it offers, sets the MTU of the bearer the next PDU leaves
// on, reads a long value from an offset, reads several values at once, signs
// the writes it sends and writes values of no octets.

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_caller_can_lift_the_refusal_of_a_second_mtu_exchange()
    var t = table()
    var s = server()
    test.assert_eq(run(var t, link_a(), var s, gatt_client.begin_exchange_mtu(var t, link_a(), 0)), 0)
    test.assert_eq(gatt_client.begin_exchange_mtu(var t, link_a(), 0), gatt_client.ERR_REPEAT)
    test.assert(gatt_client.allow_another_mtu_exchange(var t, link_a(), 0))
    test.assert(gatt_client.begin_exchange_mtu(var t, link_a(), 0) > 0)
    test.assert(not gatt_client.allow_another_mtu_exchange(var t, link_a(), 1))
    test.assert(not gatt_client.allow_another_mtu_exchange(var t, link_b(), 0))

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_the_rx_mtu_offered_is_the_one_the_caller_names()
    var t = table()
    var s = server()
    test.assert(gatt_client.set_rx_mtu(var t, link_a(), 0, 40))
    var trace = new_log()
    let _ = gatt_client.begin_exchange_mtu(var t, link_a(), 0)
    pump(var t, link_a(), var s, var trace)
    test.assert_eq(trace.sent[0], [0x02, 40, 0])
    // The server's own Rx MTU is 65, so the smaller of the two is the client's.
    test.assert_eq(gatt_client.mtu(var t, link_a(), 0), 40)

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_an_rx_mtu_or_an_mtu_out_of_range_or_for_a_bearer_that_is_not_open_is_refused()
    var t = table()
    test.assert(not gatt_client.set_rx_mtu(var t, link_a(), 0, 22))
    test.assert(not gatt_client.set_rx_mtu(var t, link_a(), 0, noble.CONFIG.MAX_ATT_MTU + 1))
    test.assert(not gatt_client.set_rx_mtu(var t, link_a(), 1, 40))
    test.assert(not gatt_client.set_rx_mtu(var t, link_b(), 0, 40))
    test.assert(not gatt_client.set_mtu(var t, link_a(), 0, 22))
    test.assert(not gatt_client.set_mtu(var t, link_a(), 0, noble.CONFIG.MAX_ATT_MTU + 1))
    test.assert(not gatt_client.set_mtu(var t, link_a(), 1, 40))
    test.assert(not gatt_client.set_mtu(var t, link_b(), 0, 40))
    test.assert(gatt_client.set_mtu(var t, link_a(), 0, noble.CONFIG.MAX_ATT_MTU))
    test.assert_eq(gatt_client.mtu(var t, link_a(), 0), noble.CONFIG.MAX_ATT_MTU)

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_the_mtu_set_for_a_bearer_shapes_the_requests_built_after_it()
    var t = table()
    test.assert(gatt_client.set_mtu(var t, link_a(), 0, 65))
    let _ = gatt_client.begin_write_long(var t, link_a(), 0, 0x001A, payload(ramp(100)), 100)
    var out: gatt_client.ClientPdu = Vec.new()
    test.assert_eq(gatt_client.take_tx(var t, link_a(), 0, 0, var out), gatt_client.TX_REQUEST)
    // A Prepare Write Request of ATT_MTU - 5 = 60 octets of value.
    test.assert_eq(out.len(), 65)

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_long_read_from_an_offset_opens_with_a_blob_and_reads_to_the_end()
