    let req: [u8] = [
        ATT_OP_READ_BY_GROUP_TYPE_REQ,
        0x01, 0x00,
        0xFF, 0xFF,
        0x00, 0x28]
    test.assert_eq(read_read_by_group_type_req_start(req), 0x0001)
    test.assert_eq(read_read_by_group_type_req_type16(req), 0x2800)

