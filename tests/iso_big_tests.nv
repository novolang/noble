@when(noble_config.MAX_BIG >= 1 and noble_config.MAX_BIS >= 2)
@test
@satisfies("REQ-BLE-ISO-004")
fn test_big_create_sync_takes_a_row_and_claims_its_streams()
    var t = big_table_new()
    test.assert_eq(big_sync_create(var t, 2, 0x0020, true, some_code(), 3, 0x0C80, [1, 2]), 0)
    let at = big_row(var t, 2)
    test.assert(t.state[at] == BigState.Syncing)
    test.assert(not t.broadcaster[at])
    test.assert_eq(t.link_handle[at] as Int, 0x0020)
    test.assert_eq(t.stream_count[at] as Int, 2)
    test.assert(t.encrypted[at])
    test.assert_eq(t.pending_numbers[1] as Int, 2)
    test.assert(t.pending == BigPending.CreateSync)
    test.assert_eq(bis_free_rows(var t), noble_config.MAX_BIS - 2)
    test.assert(big_sync_status(var t, 0).kind == iso_event.IsoEventKind.CommandDone)
    test.assert(t.pending == BigPending.NoCommand)

@when(noble_config.MAX_BIG >= 1 and noble_config.MAX_BIS >= 2)
@test
@satisfies("REQ-BLE-ISO-004")
fn test_big_create_sync_refuses_a_parameter_out_of_range()
    var t = big_table_new()
    let invalid = iso_event.STATUS_INVALID_COMMAND_PARAMETERS
    let z = zero_code()
    test.assert_eq(big_sync_create(var t, 0xF0, 0x20, false, z, 0, 100, [1]), invalid)
    test.assert_eq(big_sync_create(var t, -1, 0x20, false, z, 0, 100, [1]), invalid)
    test.assert_eq(big_sync_create(var t, 1, 0x0F00, false, z, 0, 100, [1]), invalid)
    test.assert_eq(big_sync_create(var t, 1, -1, false, z, 0, 100, [1]), invalid)
    // MSE 0x00 to 0x1F; BIG_Sync_Timeout 0x000A to 0x4000.
    test.assert_eq(big_sync_create(var t, 1, 0x20, false, z, 0x20, 100, [1]), invalid)
    test.assert_eq(big_sync_create(var t, 1, 0x20, false, z, -1, 100, [1]), invalid)
    test.assert_eq(big_sync_create(var t, 1, 0x20, false, z, 0, 9, [1]), invalid)
    test.assert_eq(big_sync_create(var t, 1, 0x20, false, z, 0, 0x4001, [1]), invalid)
    // Num_BIS 0x01 to 0x1F; the code is 16 octets.
    test.assert_eq(big_sync_create(var t, 1, 0x20, false, z, 0, 100, []), invalid)
    test.assert_eq(big_sync_create(var t, 1, 0x20, false, z[0:15], 0, 100, [1]), invalid)
    // BIS_Number 0x01 to 0x1F, ascending, no duplicates.
    test.assert_eq(big_sync_create(var t, 1, 0x20, false, z, 0, 100, [0]), invalid)
    test.assert_eq(big_sync_create(var t, 1, 0x20, false, z, 0, 100, [0x20]), invalid)
    test.assert_eq(big_sync_create(var t, 1, 0x20, false, z, 0, 100, [2, 1]), invalid)
    test.assert_eq(big_sync_create(var t, 1, 0x20, false, z, 0, 100, [1, 1]), invalid)
    test.assert(t.pending == BigPending.NoCommand)
    // The bounds are accepted.
    test.assert_eq(big_sync_create(var t, 0xEF, 0x0EFF, true, some_code(), 0x1F, 0x4000, [0x1F]), 0)

@when(noble_config.MAX_BIG >= 1 and noble_config.MAX_BIS >= 2 and noble_config.MAX_BIG == 1 and noble_config.MAX_BIS == 2)
@test
@satisfies("REQ-BLE-ISO-004")
fn test_big_create_sync_refusals_from_the_state_of_the_table()
    var t = big_table_new()
    let z = zero_code()
    test.assert_eq(big_sync_create(var t, 1, 0x20, false, z, 0, 100, [1]), 0)
    // A command in flight.
    test.assert_eq(big_sync_create(var t, 2, 0x21, false, z, 0, 100, [1]), iso_event.STATUS_COMMAND_DISALLOWED)
    test.assert(big_sync_status(var t, 0).kind == iso_event.IsoEventKind.CommandDone)
    // Synchronizing to a BIG whose LE BIG Sync Established event is awaited.
    test.assert_eq(big_sync_create(var t, 2, 0x21, false, z, 0, 100, [1]), iso_event.STATUS_COMMAND_DISALLOWED)
    // The same BIG_Handle.
    test.assert_eq(big_sync_create(var t, 1, 0x21, false, z, 0, 100, [1]), iso_event.STATUS_COMMAND_DISALLOWED)
    test.assert(big_sync_established(var t, sync_established_event(1, 0, [0x0100])).kind == iso_event.IsoEventKind.BigSynced)
    // Already synchronized to the BIG of that train.
    test.assert_eq(big_sync_create(var t, 2, 0x20, false, z, 0, 100, [1]), iso_event.STATUS_COMMAND_DISALLOWED)
    // No free group row, and too many streams.
    test.assert_eq(big_sync_create(var t, 2, 0x21, false, z, 0, 100, [1]),
        iso_event.STATUS_REJECTED_LIMITED_RESOURCES)
    var u = big_table_new()
    var many: [Int] = []
    for i in 0..noble_config.MAX_BIS + 1
        list.push(many, i + 1)
    test.assert_eq(big_sync_create(var u, 1, 0x20, false, z, 0, 100, many),
        iso_event.STATUS_REJECTED_LIMITED_RESOURCES)

@when(noble_config.MAX_BIG >= 1 and noble_config.MAX_BIS >= 2)
@test
@satisfies("REQ-BLE-ISO-004")
fn test_big_create_sync_command_status_failure_frees_the_row()
    var t = big_table_new()
    test.assert_eq(big_sync_create(var t, 1, 0x20, false, zero_code(), 0, 100, [1, 2]), 0)
    let e = big_sync_status(var t, iso_event.STATUS_COMMAND_DISALLOWED)
    test.assert(e.kind == iso_event.IsoEventKind.CommandFailed)
    test.assert_eq(big_row(var t, 1), -1)
    test.assert_eq(bis_free_rows(var t), noble_config.MAX_BIS)
    test.assert(big_sync_status(var t, 0).kind == iso_event.IsoEventKind.Unrelated)

