// encrypted_data.nv — Encrypted Advertising Data: the Encrypted Data
// AD type (0x31) and the Encrypted Data Key Material characteristic (0x2B88).
//
// A Broadcaster may wrap its advertising data in an Encrypted Data structure
// ([Core 6.3] Vol 1 Part A, Section 5.4.6, and Vol 3 Part C, Section 10.10).
// The structure is protected with AES-CCM under a session key and an
// initialization vector, the Key Material, that a scanning device reads from
// the Encrypted Data Key Material characteristic ([Vol 3] Part C, Section
// 12.6) or receives out of band.  The structure's data is
//
//   Randomizer   5 octets, new whenever the nonce must change (with every
//                private address change)
//   ciphertext   the encrypted AD structures
//   MIC          4 octets
//
// The CCM parameters are those of RFC 3610 with a 2-octet length field and a
// 4-octet MIC (the same as the Link Layer's, [Vol 6] Part E, Section 2): the
// nonce is the Randomizer followed by the 8 octets of the IV, 13 octets, and the
// additional authenticated data is the single octet 0xEA.  The session key and
// the IV are used in the order of the octets of the Key Material value.
//
// The Key Material is a 16-octet session key and an 8-octet IV (Table 12.10).
// The characteristic is readable only on an authenticated link and by an
// authorized client, is not writable, and is indicated when the server updates
// the material and the client has subscribed.
//
// Mechanism and policy.  What the specification fixes belongs here: the
// structure, the cipher, the order of the octets, the permissions and the
// indication.  What it leaves to a product is asked of an `EadPolicy`: which
// key material a scanner holds for an advertiser, which material and which
// Randomizer the device itself advertises with, and which peers are authorized
// to read the material.  The GATT server has no authorization hook (an
// attribute that needs authorization is refused to every client), so the
// characteristic requires authentication in the attribute table and keeps the
// value per connection: `serve_key_material` stores the material the policy
// releases to a peer, and a peer the policy does not release it to reads a
// zero-length value, which is no Key Material.
//
// The Core Specification Supplement, Part A, Section 1.23.3, defines the data
// type; its text is not part of the Core text this module was checked against,
// so the tests check the cipher against RFC 3610 values computed with an
// independent AES-CCM implementation.
//
// Satisfies: REQ-BLE-GAP-026.

use std.test
use att
use gatt_server
use links
use profile_builder
use wire
use prims.aes128

// The Encrypted Data AD type and the Encrypted Data Key Material characteristic.
const AD_TYPE_ENCRYPTED_DATA = 0x31
const UUID_ENCRYPTED_DATA_KEY_MATERIAL = 0x2B88

const RANDOMIZER_OCTETS = 5
const MIC_OCTETS = 4
const KEY_OCTETS = 16
const IV_OCTETS = 8
// The octets of the Encrypted Data Key Material characteristic: a 16-octet session key and an 8-octet initialization
// vector.
pub const KEY_MATERIAL_OCTETS = 24
const NONCE_OCTETS = 13

// The additional authenticated data of an Encrypted Data structure.
const ADDITIONAL_DATA = 0xEA

// The most significant bit of the Randomizer, the direction bit of the nonce.
const DIRECTION_BIT = 0x80

// The octets that frame an Encrypted Data structure inside its AD structure:
// the Randomizer and the MIC.
const OVERHEAD_OCTETS = 9

// The most octets of AD structures one Encrypted Data structure holds: its
// Length octet covers the type, the Randomizer, the data and the MIC.
const PLAIN_MAX = 245

// The session key and the IV.
struct KeyMaterial
    key: [u8]
    iv: [u8]

// The Key Material of the 24 octets of a characteristic value; none for another length.
pub @tier(app)
fn key_material_parse(value: [u8]) -> ?KeyMaterial
    if list.len(value) != KEY_MATERIAL_OCTETS
        return None
    Some(KeyMaterial { key: value[0:KEY_OCTETS], iv: value[KEY_OCTETS:KEY_MATERIAL_OCTETS] })

// The characteristic value of `km`: the session key, then the IV.
@tier(app)
fn key_material_value(km: KeyMaterial) -> [u8]
    join(km.key, km.iv)

// Whether `km` has a 16-octet key and an 8-octet IV.
@tier(app)
fn key_material_valid(km: KeyMaterial) -> Bool
    list.len(km.key) == KEY_OCTETS and list.len(km.iv) == IV_OCTETS

// ── AES-CCM (RFC 3610, L = 2, M = 4) ────────────────────────────────

// `a` followed by `b`, as a new list.
@tier(app)
fn join(a: [u8], b: [u8]) -> [u8]
    var out = a[:]
    for x in b
        list.push(out, x)
    out

@tier(app)
fn xor_into(a: [u8], b: [u8]) -> [u8]
    var out: [u8] = []
    for i in 0..list.len(a)
        list.push(out, ((a[i] as Int) ^ (b[i] as Int)) as u8)
    out

// `v` followed by zeros up to a multiple of 16 octets.
@tier(app)
fn pad16(v: [u8]) -> [u8]
    var out = v[:]
    while list.len(out) % 16 != 0
        list.push(out, 0)
    out

// Block `A` of counter `i`: the flags (L - 1), the nonce and the counter.
@tier(app)
fn ctr_block(nonce: [u8], i: Int) -> [u8]
    var out: [u8] = join([0x01], nonce)
    list.push(out, ((i >>> 8) & 0xFF) as u8)
    list.push(out, (i & 0xFF) as u8)
    out

// The CBC-MAC of RFC 3610 over the additional data octet and `plain`, cut to the MIC.
@tier(app)
fn cbc_mac(key: [u8], nonce: [u8], aad: [u8], plain: [u8]) -> [u8]
    let n = list.len(plain)
    // B0: the flags (Adata, M = 4, L = 2), the nonce and the message length.
    var b0: [u8] = [0x49]
    b0 = join(b0, nonce)
    list.push(b0, ((n >>> 8) & 0xFF) as u8)
    list.push(b0, (n & 0xFF) as u8)
    // B1...: the length of the additional data and the data, then the message.
    var rest: [u8] = [((list.len(aad) >>> 8) & 0xFF) as u8, (list.len(aad) & 0xFF) as u8]
    rest = join(rest, aad)
    rest = pad16(rest)
    rest = join(rest, pad16(plain))
    var x = aes128.aes128_encrypt(b0, key)
    var at = 0
    while at < list.len(rest)
        x = aes128.aes128_encrypt(xor_into(x, rest[at:at + 16]), key)
        at = at + 16
    x[0:MIC_OCTETS]

// The counter-mode transform of `data` from counter 1 (encrypts and decrypts alike).
@tier(app)
fn ctr_apply(key: [u8], nonce: [u8], data: [u8]) -> [u8]
    var out: [u8] = []
    var at = 0
    var counter = 1
    while at < list.len(data)
        let s = aes128.aes128_encrypt(ctr_block(nonce, counter), key)
        let stop = if at + 16 < list.len(data) then at + 16 else list.len(data)
        for i in at..stop
            list.push(out, ((data[i] as Int) ^ (s[i - at] as Int)) as u8)
        at = at + 16
        counter = counter + 1
    out

// The ciphertext of `plain` followed by its MIC.
@tier(app)
fn ccm_seal(key: [u8], nonce: [u8], aad: [u8], plain: [u8]) -> [u8]
    let mac = cbc_mac(key, nonce, aad, plain)
    let s0 = aes128.aes128_encrypt(ctr_block(nonce, 0), key)
    join(ctr_apply(key, nonce, plain), xor_into(mac, s0[0:MIC_OCTETS]))

// The plaintext of `sealed` (ciphertext then MIC); none when the MIC does not match.
@tier(app)
fn ccm_open(key: [u8], nonce: [u8], aad: [u8], sealed: [u8]) -> ?[u8]
    let n = list.len(sealed) - MIC_OCTETS
    if n < 0
        return None
    let plain = ctr_apply(key, nonce, sealed[0:n])
    let s0 = aes128.aes128_encrypt(ctr_block(nonce, 0), key)
    let want = xor_into(cbc_mac(key, nonce, aad, plain), s0[0:MIC_OCTETS])
    // The comparison visits every octet, so its time does not depend on where they differ.
    var diff = 0
    for i in 0..MIC_OCTETS
        diff = diff | ((want[i] as Int) ^ (sealed[n + i] as Int))
    if diff != 0
        return None
    Some(plain)

// ── The Encrypted Data structure ────────────────────────────────────

@tier(app)
fn nonce_of(randomizer: [u8], iv: [u8]) -> [u8]
    join(randomizer, iv)

// The data of an Encrypted Data structure (Randomizer, ciphertext, MIC) that
// carries `plain` under `km`.  The most significant bit of the Randomizer is
// the direction bit of the CCM nonce and is set, so the octet sent is the one
// the nonce holds.  None when the material or the Randomizer has the wrong
// size or `plain` is longer than `PLAIN_MAX`.
pub @tier(app)
fn encrypt_data(km: KeyMaterial, randomizer: [u8], plain: [u8]) -> ?[u8]
    if not key_material_valid(km) or list.len(randomizer) != RANDOMIZER_OCTETS or list.len(plain) > PLAIN_MAX
        return None
    var r = randomizer[:]
    r[RANDOMIZER_OCTETS - 1] = ((r[RANDOMIZER_OCTETS - 1] as Int) | DIRECTION_BIT) as u8
    Some(join(r, ccm_seal(km.key, nonce_of(r, km.iv), [ADDITIONAL_DATA as u8], plain)))

// The AD structure (Length, type 0x31, data) that carries `ad`, the AD
// structures to hide, under `km` with `randomizer` (`encrypt_data`).
@tier(app)
fn encrypt_ad(km: KeyMaterial, randomizer: [u8], ad: [u8]) -> ?[u8]
    match encrypt_data(km, randomizer, ad)
        None => None
        Some(data) => Some(join([(1 + list.len(data)) as u8, AD_TYPE_ENCRYPTED_DATA as u8], data))

// The Randomizer of the `n`th encryption under one key: `n` in five octets,
// least significant first, so no two encryptions share a nonce.
pub @tier(app)
fn counter_randomizer(n: Int) -> [u8]
    var out: [u8] = []
    for i in 0..RANDOMIZER_OCTETS
        list.push(out, ((n >>> (8 * i)) & 0xFF) as u8)
    out

// The AD structures inside the data of an Encrypted Data structure (the octets
// after the type): none when the data is too short or the MIC does not match.
pub @tier(app)
fn decrypt_data(km: KeyMaterial, data: [u8]) -> ?[u8]
    if not key_material_valid(km) or list.len(data) < OVERHEAD_OCTETS
        return None
    ccm_open(km.key, nonce_of(data[0:RANDOMIZER_OCTETS], km.iv), [ADDITIONAL_DATA as u8], data[RANDOMIZER_OCTETS:list.len(data)])

// The data of every Encrypted Data structure in `ad`, in order.  A structure
// that runs past the end of `ad` ends the scan.
@tier(app)
fn encrypted_structures(ad: [u8]) -> [[u8]]
    var out: [[u8]] = []
    var at = 0
    while at < list.len(ad)
        let len = ad[at] as Int
        if len == 0 or at + 1 + len > list.len(ad)
            return out
        if len >= 2 and ad[at + 1] as Int == AD_TYPE_ENCRYPTED_DATA
            list.push(out, ad[at + 2:at + 1 + len])
        at = at + 1 + len
    out

// The decrypted AD structures of the first Encrypted Data structure in `ad`
// that `km` authenticates; none when there is none.
@tier(app)
fn decrypt_ad(km: KeyMaterial, ad: [u8]) -> ?[u8]
    for data in encrypted_structures(ad)
        match decrypt_data(km, data)
            Some(plain) => return Some(plain)
            None => ()
    None

// ── The product's say ───────────────────────────────────────────────

// The questions a product answers.
trait EadPolicy[e]
    // The Key Material a scanner holds for the advertiser at `address` (six
    // octets), none when it holds none.
    fn key_for_advertiser(var self, address: [u8]) -> ?KeyMaterial [e]
    // The Key Material the device advertises with, none to advertise in the clear.
    fn advertising_key(var self) -> ?KeyMaterial [e]
    // A Randomizer of five octets for the next advertising data.  It must not
    // repeat while the key and the IV stay the same.
    fn next_randomizer(var self) -> [u8] [e]
    // The Key Material to release to `peer`, none when the peer is not authorized.
    fn release_key(var self, peer: links.LinkId) -> ?KeyMaterial [e]

// A policy that holds no key, advertises in the clear and releases nothing.
struct NoKeys
    placeholder: Int

@tier(app)
fn no_keys() -> NoKeys
    NoKeys { placeholder: 0 }

impl EadPolicy[] for NoKeys
    @tier(app)
    fn key_for_advertiser(var self, address: [u8]) -> ?KeyMaterial
        let _ = address
        None

    @tier(app)
    fn advertising_key(var self) -> ?KeyMaterial
        None

    @tier(app)
    fn next_randomizer(var self) -> [u8]
        [0, 0, 0, 0, 0]

    @tier(app)
    fn release_key(var self, peer: links.LinkId) -> ?KeyMaterial
        let _ = peer
        None

// The advertising data to send for `ad`: the Encrypted Data structure when the
// policy has key material, `ad` itself when it has none; none when `ad` is too
// long to encrypt or the policy's material or Randomizer is malformed.
@tier(app)
fn protect_advertising<P: EadPolicy[e]>(var policy: P, ad: [u8]) -> ?[u8] [e, mutate]
    match policy.advertising_key()
        None => Some(ad[:])
        Some(km) => encrypt_ad(km, policy.next_randomizer(), ad)

// The AD structures of a received report from the advertiser at `address`: the
// decrypted ones when the report holds an Encrypted Data structure the policy's
// key for the advertiser authenticates, none when it holds one and no key opens
// it, `ad` itself when it holds none.
@tier(app)
fn reveal_advertising<P: EadPolicy[e]>(var policy: P, address: [u8], ad: [u8]) -> ?[u8] [e, mutate]
    if list.len(encrypted_structures(ad)) == 0
        return Some(ad[:])
    match policy.key_for_advertiser(address)
        None => None
        Some(km) => decrypt_ad(km, ad)

// ── The characteristic ──────────────────────────────────────────────

@value
struct KeyMaterialHandles
    service: u16
    value: u16
    cccd: u16

// Add a service of `service_uuid` (16-bit, as an Int) with an Encrypted Data
// Key Material characteristic after the last attribute of `db`: readable and
// indicated on an authenticated link, not writable, the value per connection
// (`serve_key_material`).  A service of another specification that has the
// characteristic (Section 12.6) adds it to its own service with
// `add_key_material_characteristic`.
@tier(app)
fn add_key_material_service(var db: GattDb, service_uuid: Int) -> Result<KeyMaterialHandles, profile_builder.ProfileError>
    let service = profile_builder.start_service(var db, gatt_server.le16(service_uuid))!
    let c = add_key_material_characteristic(var db)!
    Ok(KeyMaterialHandles { service: service as u16, value: c.value, cccd: c.cccd })

// Add the characteristic to the last service of `db`.  The service handle of
// the answer is 0.
@tier(app)
fn add_key_material_characteristic(var db: GattDb) -> Result<KeyMaterialHandles, profile_builder.ProfileError>
    let value = profile_builder.add_value(
        var db, gatt_server.PROP_READ | gatt_server.PROP_INDICATE, profile_builder.read_only(gatt_server.Access.Authenticated),
        gatt_server.le16(UUID_ENCRYPTED_DATA_KEY_MATERIAL), [])!
    // The handle was just added, so the attribute can be made per connection.
    let _ = gatt_server.make_per_link(var db, value)
    let cccd = profile_builder.add_cccd(var db, gatt_server.Permissions { read: gatt_server.Access.Authenticated, write: gatt_server.Access.Authenticated })!
    Ok(KeyMaterialHandles { service: 0, value: value as u16, cccd: cccd as u16 })

// Give the connection of `peer` the Key Material the policy releases to it:
// the 24 octets, or no octet when the policy releases none.  True when the
// peer was released the material.
@tier(app)
fn serve_key_material<P: EadPolicy[e]>(db: GattDb, var link: AttLink, handles: KeyMaterialHandles, var policy: P, peer: links.LinkId) -> Bool [e, mutate]
    match policy.release_key(peer)
        Some(km) =>
            if not key_material_valid(km)
                let _ = gatt_server.set_link_value(db, var link, handles.value, [])
                return false
            gatt_server.set_link_value(db, var link, handles.value, key_material_value(km))
        None =>
            let _ = gatt_server.set_link_value(db, var link, handles.value, [])
            false

// The indication of the Key Material the server updated, for the client of
// `link` when it subscribed; the PDUs to send (none without a subscription).
@tier(app)
fn indicate_key_material(var db: GattDb, var link: AttLink, handles: KeyMaterialHandles, km: KeyMaterial, now_ms: Int) -> [[u8]]
    if not key_material_valid(km) or not gatt_server.set_link_value(db, var link, handles.value, key_material_value(km))
        return []
    gatt_server.send_value(var db, var link, handles.value, now_ms)

// ── Tests ───────────────────────────────────────────────────────────

// An ATT request PDU: opcode, handle (little endian) and parameter octets.
@tier(app)
fn req(op: Int, handle: Int, value: [Int]) -> [u8]
    var pdu = wire.octets([op, handle & 0xFF, handle >>> 8])
    list.append(pdu, wire.octets(value))
    pdu

// The values below were computed with an independent AES-CCM implementation
// (RFC 3610, 13-octet nonce, 4-octet tag, additional data 0xEA).
@tier(app)
fn sample_key() -> [u8]
    [0x99, 0xAD, 0x1B, 0x52, 0x26, 0xA3, 0x7E, 0x3E, 0x05, 0x8E, 0x3B, 0x8E, 0x27, 0xC2, 0xC6, 0x66]

@tier(app)
fn sample_iv() -> [u8]
    [0xDE, 0xAF, 0xBA, 0xBE, 0xBA, 0xDC, 0xAB, 0x24]

@tier(app)
fn sample_km() -> KeyMaterial
    KeyMaterial { key: sample_key(), iv: sample_iv() }

@tier(app)
fn sample_randomizer() -> [u8]
    [1, 2, 3, 4, 0x85]

@tier(app)
fn sample_name() -> [u8]
    [0x05, 0x09, 0x4E, 0x6F, 0x76, 0x6F]

@tier(app)
fn sample_structure() -> [u8]
    [0x10, 0x31, 1, 2, 3, 4, 0x85, 0x40, 0xB4, 0x88, 0xA6, 0xEF, 0x4D, 0xB9, 0x4B, 0x55, 0xD4]

@tier(app)
fn counting(n: Int) -> [u8]
    var out: [u8] = []
    for i in 0..n
        list.push(out, i as u8)
    out

struct TestPolicy
    km: ?KeyMaterial
    release: ?KeyMaterial
    var seen: Int

impl EadPolicy[] for TestPolicy
    @tier(app)
    fn key_for_advertiser(var self, address: [u8]) -> ?KeyMaterial
        self.seen = self.seen + list.len(address)
        self.km

    @tier(app)
    fn advertising_key(var self) -> ?KeyMaterial
        self.km

    @tier(app)
    fn next_randomizer(var self) -> [u8]
        sample_randomizer()

    @tier(app)
    fn release_key(var self, peer: links.LinkId) -> ?KeyMaterial
        let _ = peer
        self.release

@test
@satisfies("REQ-BLE-GAP-026")
fn test_ccm_matches_the_rfc_3610_values_of_an_independent_implementation()
    let nonce = join(sample_randomizer(), sample_iv())
    let aad: [u8] = [0xEA]
    test.assert_eq(ccm_seal(sample_key(), nonce, aad, sample_name()), [0x40, 0xB4, 0x88, 0xA6, 0xEF, 0x4D, 0xB9, 0x4B, 0x55, 0xD4])
    test.assert_eq(ccm_seal(sample_key(), nonce, aad, []), [0x6D, 0x86, 0x5B, 0x00])
    test.assert_eq(ccm_seal(sample_key(), nonce, aad, counting(40)),
        [0x45, 0xBC, 0xC4, 0xCA, 0x9D, 0x27, 0x25, 0xBD, 0xD8, 0x16, 0x44, 0x82, 0xE0, 0xDA, 0xDE, 0x03, 0x2E, 0xF0, 0x16, 0xD7,
         0x0F, 0xF5, 0x18, 0x2E, 0x03, 0x13, 0x55, 0x87, 0x45, 0xE9, 0xE4, 0x2A, 0xAA, 0xFE, 0xE9, 0xC9, 0xEF, 0xA8, 0x63, 0x09,
         0x8A, 0x52, 0x55, 0xED])

@test
@satisfies("REQ-BLE-GAP-026")
fn test_ccm_opens_what_it_seals_and_refuses_a_changed_octet()
    let nonce = join(sample_randomizer(), sample_iv())
    let aad: [u8] = [0xEA]
    for n in [0, 1, 15, 16, 17, 40]
        let sealed = ccm_seal(sample_key(), nonce, aad, counting(n))
        test.assert_eq(ccm_open(sample_key(), nonce, aad, sealed)!, counting(n))
        if n > 0
            var bad = sealed[:]
            bad[0] = (bad[0] as Int ^ 1) as u8
            test.assert(ccm_open(sample_key(), nonce, aad, bad) == None)
        var badmic = sealed[:]
        badmic[list.len(badmic) - 1] = (badmic[list.len(badmic) - 1] as Int ^ 0x80) as u8
        test.assert(ccm_open(sample_key(), nonce, aad, badmic) == None)
    test.assert(ccm_open(sample_key(), nonce, [0xEB], ccm_seal(sample_key(), nonce, aad, [1, 2])) == None)
    test.assert(ccm_open(sample_key(), nonce, aad, [1, 2, 3]) == None)

@test
@satisfies("REQ-BLE-GAP-026")
fn test_the_structure_is_length_type_randomizer_ciphertext_and_mic()
    test.assert_eq(encrypt_ad(sample_km(), sample_randomizer(), sample_name())!, sample_structure())
    test.assert_eq(decrypt_ad(sample_km(), sample_structure())!, sample_name())

@test
@satisfies("REQ-BLE-GAP-026")
fn test_the_direction_bit_of_the_randomizer_is_set_and_the_data_has_no_framing()
    // The same data as the structure, from a Randomizer whose top bit is clear.
    let data = encrypt_data(sample_km(), [1, 2, 3, 4, 5], sample_name())!
    test.assert_eq(data, sample_structure()[2:17])
    test.assert_eq(data[4] as Int, 0x85)
    test.assert_eq(counter_randomizer(0x0102030405), [5, 4, 3, 2, 1])
    test.assert_eq(counter_randomizer(0), [0, 0, 0, 0, 0])

@test
@satisfies("REQ-BLE-GAP-026")
fn test_encrypting_refuses_a_malformed_key_randomizer_or_too_much_data()
    test.assert(encrypt_ad(KeyMaterial { key: [1], iv: sample_iv() }, sample_randomizer(), []) == None)
    test.assert(encrypt_ad(KeyMaterial { key: sample_key(), iv: [] }, sample_randomizer(), []) == None)
    test.assert(encrypt_ad(sample_km(), [1, 2, 3], []) == None)
    test.assert(encrypt_ad(sample_km(), sample_randomizer(), counting(PLAIN_MAX + 1)) == None)
    let longest = encrypt_ad(sample_km(), sample_randomizer(), counting(PLAIN_MAX))!
    test.assert_eq(list.len(longest), 256)
    test.assert_eq(longest[0] as Int, 255)

@test
@satisfies("REQ-BLE-GAP-026")
fn test_decrypting_refuses_a_wrong_key_a_short_structure_and_a_changed_octet()
    var other = sample_key()
    other[3] = 0
    test.assert(decrypt_ad(KeyMaterial { key: other, iv: sample_iv() }, sample_structure()) == None)
    test.assert(decrypt_ad(KeyMaterial { key: sample_key(), iv: sample_iv() }, [0x08, 0x31, 1, 2, 3, 4, 5, 6, 7]) == None)
    test.assert(decrypt_ad(KeyMaterial { key: [1], iv: [] }, sample_structure()) == None)
    var changed = sample_structure()
    changed[8] = 0
    test.assert(decrypt_ad(sample_km(), changed) == None)
    test.assert(decrypt_ad(sample_km(), sample_name()) == None)

@test
@satisfies("REQ-BLE-GAP-026")
fn test_the_scan_skips_other_structures_and_stops_at_a_truncated_one()
    // Flags, the Encrypted Data structure, then a structure that runs past the end.
    let ad = join(join([0x02, 0x01, 0x06], sample_structure()), [0x09, 0x09, 1])
    test.assert_eq(list.len(encrypted_structures(ad)), 1)
    test.assert_eq(decrypt_ad(sample_km(), ad)!, sample_name())
    // Two structures: the first is under another key, the second opens.
    var wrong = sample_structure()
    wrong[10] = 0
    let two = join(wrong, sample_structure())
    test.assert_eq(list.len(encrypted_structures(two)), 2)
    test.assert(decrypt_ad(sample_km(), two) != None)
    // A zero Length ends the scan, and a structure of length 1 has no data.
    test.assert_eq(list.len(encrypted_structures([0x00, 0x31, 0x01])), 0)
    test.assert_eq(list.len(encrypted_structures([0x01, 0x31])), 0)

@test
@satisfies("REQ-BLE-GAP-026")
fn test_key_material_is_a_16_octet_key_then_an_8_octet_iv()
    let value = key_material_value(sample_km())
    test.assert_eq(list.len(value), 24)
    let km = key_material_parse(value)!
    test.assert_eq(km.key, sample_key())
    test.assert_eq(km.iv, sample_iv())
    test.assert(key_material_parse(value[0:23]) == None)
    test.assert(key_material_valid(sample_km()))
    test.assert(not key_material_valid(KeyMaterial { key: sample_key(), iv: [1] }))

@test
@satisfies("REQ-BLE-GAP-026")
fn test_a_device_without_a_key_advertises_in_the_clear_and_opens_nothing()
    var none = no_keys()
    test.assert_eq(none.next_randomizer(), [0, 0, 0, 0, 0])
    test.assert_eq(protect_advertising(var none, sample_name())!, sample_name())
    test.assert_eq(reveal_advertising(var none, [1, 2, 3, 4, 5, 6], sample_name())!, sample_name())
    test.assert(reveal_advertising(var none, [1, 2, 3, 4, 5, 6], sample_structure()) == None)
    test.assert(none.release_key(links.link_id(0, 0)) == None)
    test.assert(none.key_for_advertiser([1, 2, 3, 4, 5, 6]) == None)

@test
@satisfies("REQ-BLE-GAP-026")
fn test_the_policy_decides_the_key_of_both_sides()
    var p = TestPolicy { km: Some(sample_km()), release: None, seen: 0 }
    test.assert_eq(protect_advertising(var p, sample_name())!, sample_structure())
    test.assert_eq(reveal_advertising(var p, [1, 2, 3, 4, 5, 6], sample_structure())!, sample_name())
    test.assert_eq(p.seen, 6)
    // The data of the clear report is returned unchanged even with a key.
    test.assert_eq(reveal_advertising(var p, [1, 2, 3, 4, 5, 6], sample_name())!, sample_name())
    var q = TestPolicy { km: Some(KeyMaterial { key: [1], iv: [] }), release: None, seen: 0 }
    test.assert(protect_advertising(var q, sample_name()) == None)

// Whether `r` is the refusal for a table with no handle left.
@tier(app)
fn is_no_room(r: Result<KeyMaterialHandles, profile_builder.ProfileError>) -> Bool
    match r
        Ok(_) => false
        Err(e) => e == profile_builder.ProfileError.NoRoom

@tier(app)
fn authenticated_server() -> GattServer
    var s = gatt_server.new_server([], 65)
    gatt_server.set_security(var s.link, gatt_server.link_security(true, 3, 16, true))
    gatt_server.set_mtu(var s.link, 0, 65)
    s

@test
@satisfies("REQ-BLE-GAP-026")
fn test_the_characteristic_is_readable_and_indicatable_on_an_authenticated_link_and_not_writable()
    var s = gatt_server.new_server([], 65)
    gatt_server.set_mtu(var s.link, 0, 65)
    let h = add_key_material_service(var s.db, 0x1800)!
    test.assert_eq(h.service, 1)
    test.assert_eq(h.value, 3)
    test.assert_eq(h.cccd, 4)
    test.assert_eq(s.db.attributes[1].value, [0x22, 0x03, 0x00, 0x88, 0x2B])
    var p = TestPolicy { km: None, release: Some(sample_km()), seen: 0 }
    test.assert(serve_key_material(s.db, var s.link, h, var p, links.link_id(0, 0)))
    // Unauthenticated: refused with Insufficient Authentication.
    test.assert_eq(gatt_server.receive(var s.db, var s.link, req(0x0A, h.value, []), 0)[0][4] as Int, att.ATT_ERR_INSUFFICIENT_AUTHENTICATION)
    test.assert_eq(gatt_server.receive(var s.db, var s.link, req(0x12, h.cccd, [2, 0]), 0)[0][4] as Int, att.ATT_ERR_INSUFFICIENT_AUTHENTICATION)
    // Encrypted without authentication: still refused.
    gatt_server.set_security(var s.link, gatt_server.link_security(true, 2, 16, true))
    test.assert_eq(gatt_server.receive(var s.db, var s.link, req(0x0A, h.value, []), 0)[0][4] as Int, att.ATT_ERR_INSUFFICIENT_AUTHENTICATION)
    gatt_server.set_security(var s.link, gatt_server.link_security(true, 3, 16, true))
    let got = gatt_server.receive(var s.db, var s.link, req(0x0A, h.value, []), 0)[0]
    test.assert_eq(got[0] as Int, 0x0B)
    test.assert_eq(got[1:25], key_material_value(sample_km()))
    test.assert_eq(gatt_server.receive(var s.db, var s.link, req(0x12, h.value, [1]), 0)[0][4] as Int, att.ATT_ERR_WRITE_NOT_PERMITTED)

@test
@satisfies("REQ-BLE-GAP-026")
fn test_a_peer_the_policy_does_not_release_reads_no_key_material()
    var s = authenticated_server()
    let h = add_key_material_service(var s.db, 0x1800)!
    var p = TestPolicy { km: None, release: None, seen: 0 }
    test.assert(not serve_key_material(s.db, var s.link, h, var p, links.link_id(0, 0)))
    test.assert_eq(gatt_server.receive(var s.db, var s.link, req(0x0A, h.value, []), 0)[0], [0x0B])
    // Material of the wrong size is not released either.
    var bad = TestPolicy { km: None, release: Some(KeyMaterial { key: [1], iv: [] }), seen: 0 }
    test.assert(not serve_key_material(s.db, var s.link, h, var bad, links.link_id(0, 0)))
    test.assert_eq(gatt_server.receive(var s.db, var s.link, req(0x0A, h.value, []), 0)[0], [0x0B])

@test
@satisfies("REQ-BLE-GAP-026")
fn test_an_updated_key_is_indicated_to_a_subscribed_client_only()
    var s = authenticated_server()
    gatt_server.set_mtu(var s.link, 0, 65)
    let h = add_key_material_service(var s.db, 0x1800)!
    test.assert_eq(list.len(indicate_key_material(var s.db, var s.link, h, sample_km(), 0)), 0)
    let _ = gatt_server.receive(var s.db, var s.link, req(0x12, h.cccd, [2, 0]), 0)
    let out = indicate_key_material(var s.db, var s.link, h, sample_km(), 0)
    test.assert_eq(list.len(out), 1)
    test.assert_eq(out[0][0] as Int, 0x1D)
    test.assert_eq(out[0][3:27], key_material_value(sample_km()))
    test.assert_eq(list.len(indicate_key_material(var s.db, var s.link, h, KeyMaterial { key: [1], iv: [] }, 0)), 0)

@test
@satisfies("REQ-BLE-GAP-026")
fn test_the_characteristic_joins_a_service_and_stops_when_the_table_is_full()
    var s = gatt_server.new_server([], 65)
    let a = profile_builder.start_service(var s.db, gatt_server.le16(0xAA00))!
    test.assert_eq(a, 1)
    let h = add_key_material_characteristic(var s.db)!
    test.assert_eq(h.service, 0)
    test.assert_eq(h.value, 3)
    var r = gatt_server.new_server([], 65)
    test.assert_eq(gatt_server.add_service(var r.db, false, gatt_server.le16(0xAA00)), 1)
    r.db.attributes[0] = gatt_server.GattAttribute {
        handle: 0xFFFF, type_uuid: gatt_server.le16(gatt_server.UUID_PRIMARY_SERVICE), value: gatt_server.le16(0xAA00),
        max_len: 2, permissions: gatt_server.PERM_READ, key_size: 0, tester: false, included: 0, per_link: false }
    test.assert(is_no_room(add_key_material_service(var r.db, 0x1800)))
    var t = gatt_server.new_server([], 65)
    test.assert_eq(gatt_server.add_service(var t.db, false, gatt_server.le16(0xAA00)), 1)
    t.db.attributes[0] = gatt_server.GattAttribute {
        handle: 0xFFFF, type_uuid: gatt_server.le16(gatt_server.UUID_PRIMARY_SERVICE), value: gatt_server.le16(0xAA00),
        max_len: 2, permissions: gatt_server.PERM_READ, key_size: 0, tester: false, included: 0, per_link: false }
    test.assert(is_no_room(add_key_material_characteristic(var t.db)))
    var ok = gatt_server.new_server([], 65)
    test.assert(not is_no_room(add_key_material_service(var ok.db, 0x1800)))
