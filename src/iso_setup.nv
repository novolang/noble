// iso_setup.nv -- what the Host does at start to use isochronous
// channels.
//
// A Controller that carries isochronous channels reports it in its LE
// feature set ([Vol 6] Part B, Section 4.6): bit 28 Connected Isochronous
// Stream - Central, bit 29 Connected Isochronous Stream - Peripheral, bit 30
// Isochronous Broadcaster and bit 31 Synchronized Receiver.  Four things
// follow from what it reports, and none of them is done for a Controller that
// reports none of the four bits:
//
//   1. LE Read Buffer Size [v2] gives the size and the number of the
//      Controller's HCI ISO Data packet buffers ([Vol 4] Part E, Section
//      7.8.2); `iso_flow.iso_credits_configure` takes the answer.
//   2. LE Set Event Mask enables the isochronous events, the ones of the
//      roles the Controller reports ([Vol 4] Part E, Section 7.8.1).  The
//      Controller sends none of them while its bit is clear.
//   3. LE Set Host Feature sets bit 32, Connected Isochronous Stream (Host
//      Support), in the Controller's feature set ([Vol 4] Part E, Section
//      7.8.115, and [Vol 6] Part B, Section 4.6.33.1).  A Controller sets
//      that bit only if it supports one of the two CIS roles, so the command
//      is sent for those and not for a Controller that is only a
//      Broadcaster or a Receiver.  It is Command Disallowed while the
//      Controller has a connection to another device, so it goes before any
//      connection exists.
//   4. The CIS table (`iso_cis.cis_host_support`) learns that the bit is set,
//      which LE Create CIS needs.
//
// `IsoBringUp` walks the steps in that order, one command at a time; the
// caller sends the command a step names and hands the answer back.  A
// refused command ends the bring-up in `Failed`: a Controller that refuses
// to enable the events or to take the feature cannot be used for
// isochronous channels, and the Host carries on without them.
//
// Satisfies: REQ-BLE-ISO-006.

use std.test
use hci_commands
use hci_frame
use hci_codec
use iso_cis
use iso_flow
// The bits of the LE feature set the bring-up reads ([Vol 6] Part B,
// Section 4.6).
const FEATURE_CIS_CENTRAL = 28

const FEATURE_CIS_PERIPHERAL = 29

const FEATURE_ISOCHRONOUS_BROADCASTER = 30

const FEATURE_SYNCHRONIZED_RECEIVER = 31

// What the Controller reports.
@value
struct IsoFeatures
    cis_central: Bool
    cis_peripheral: Bool
    broadcaster: Bool
    receiver: Bool

// Whether bit `bit` of the 8-octet LE feature set `features` is set: bit N
// is bit N mod 8 of octet N / 8.  A feature set shorter than the bit needs
// reports it clear.
@tier(embedded)
@no_alloc
fn le_feature_bit(features: [u8], bit: Int) -> Bool
    let octet = bit / 8
    octet >= 0 and octet < list.len(features) and (((features[octet] as Int) >> (bit % 8)) & 1) == 1

@satisfies("REQ-BLE-ISO-006")
@tier(embedded)
fn iso_features(features: [u8]) -> IsoFeatures
    IsoFeatures {
        cis_central: le_feature_bit(features, FEATURE_CIS_CENTRAL),
        cis_peripheral: le_feature_bit(features, FEATURE_CIS_PERIPHERAL),
        broadcaster: le_feature_bit(features, FEATURE_ISOCHRONOUS_BROADCASTER),
        receiver: le_feature_bit(features, FEATURE_SYNCHRONIZED_RECEIVER) }

// Whether the Controller supports any isochronous channel.
@tier(embedded)
@no_alloc
fn iso_supported(f: IsoFeatures) -> Bool
    f.cis_central or f.cis_peripheral or f.broadcaster or f.receiver

// Whether the Controller supports a CIS role, which the Host Support bit
// needs.
@tier(embedded)
@no_alloc
fn iso_has_cis(f: IsoFeatures) -> Bool
    f.cis_central or f.cis_peripheral

// The LE event mask: `base`, the events the Host enables already, with the
// events of the roles in `f` added.  CIS Established is enabled in both of
// its forms, [v1] and [v2] (bits 24 and 41), because the specification does
// not say which a Controller sends when both are enabled and the Host reads
// either; LE CIS Request (bit 25) only for a Peripheral; the Broadcaster's
// two BIG events (bits 26 and 27) for a Broadcaster; the Receiver's two
// (bits 28 and 29) and the BIGInfo Advertising Report (bit 33) for a
// Receiver.  A role the Controller does not report adds nothing.
@satisfies("REQ-BLE-ISO-006")
@tier(embedded)
@no_alloc
fn iso_event_mask(base: Int, f: IsoFeatures) -> Int
    var mask = base
    if iso_has_cis(f)
        mask = mask | hci_commands.LE_EVENT_MASK_CIS_ESTABLISHED | hci_commands.LE_EVENT_MASK_CIS_ESTABLISHED_V2
    if f.cis_peripheral
        mask = mask | hci_commands.LE_EVENT_MASK_CIS_REQUEST
    if f.broadcaster
        mask = mask | hci_commands.LE_EVENT_MASK_BIG_BROADCASTER
    if f.receiver
        mask = mask | hci_commands.LE_EVENT_MASK_BIG_RECEIVER | hci_commands.LE_EVENT_MASK_BIG_INFO_ADVERTISING_REPORT
    mask

// The command the isochronous bring-up sends next, or that it is done or failed.
pub @value
enum BringUpStep
    // LE Read Buffer Size [v2] is next.
    ReadBufferSize
    // LE Set Event Mask is next.
    SetEventMask
    // LE Set Host Feature is next.
    SetHostFeature
    // Nothing more to send: the bring-up is complete, or the Controller
    // reports no isochronous channel and there was nothing to do.
    Done
    // A command was refused.
    Failed

// The state of the isochronous bring-up: the step it is at, the features the Controller reported and the LE event
// mask to set.
pub @value
struct IsoBringUp
    step: BringUpStep
    features: IsoFeatures
    mask: Int
    // The step that was refused, when `step` is `Failed`.
    failed_at: BringUpStep
    // Whether a Controller with a CIS role took the Host Support bit.
    host_support: Bool

// The bring-up for a Controller whose LE feature set is `le_features`, with
// `base_mask` as the LE event mask the Host enables already.  A Controller
// that reports no isochronous channel starts at `Done`, with the mask as it
// was.
pub @satisfies("REQ-BLE-ISO-006")
@tier(embedded)
fn iso_bringup_new(le_features: [u8], base_mask: Int) -> IsoBringUp
    let f = iso_features(le_features)
    let step = if iso_supported(f) then BringUpStep.ReadBufferSize else BringUpStep.Done
    IsoBringUp {
        step: step, features: f, mask: iso_event_mask(base_mask, f),
        failed_at: BringUpStep.Done, host_support: false }

// The step after `step`: the Host Support bit is for a Controller with a CIS
// role only.
@tier(embedded)
fn iso_bringup_after(b: IsoBringUp, step: BringUpStep) -> BringUpStep
    match step
        BringUpStep.ReadBufferSize => BringUpStep.SetEventMask
        BringUpStep.SetEventMask => if iso_has_cis(b.features) then BringUpStep.SetHostFeature else BringUpStep.Done
        _ => BringUpStep.Done

// The answer to the command the current step names, as its Status.  A
// failure ends the bring-up and keeps the step it failed in; a success moves
// to the next step.  An answer when no command is waiting changes nothing.
pub @satisfies("REQ-BLE-ISO-006")
@tier(embedded)
fn iso_bringup_answer(var b: IsoBringUp, status: Int) -> BringUpStep
    if b.step == BringUpStep.Done or b.step == BringUpStep.Failed
        return b.step
    if status != 0
        b.failed_at = b.step
        b.step = BringUpStep.Failed
        return b.step
    if b.step == BringUpStep.SetHostFeature
        b.host_support = true
    b.step = iso_bringup_after(b, b.step)
    b.step

// The answer to LE Read Buffer Size [v2], as the Command Complete event.  A
// refused command, an answer that is too short, and one that leaves the ISO
// buffer length or count at 0 (the Controller carries no HCI ISO Data
// packet) fail the step; otherwise the pool takes the sizes.
pub @satisfies("REQ-BLE-ISO-006")
@tier(embedded)
fn iso_bringup_buffer_size(var b: IsoBringUp, var credits: iso_flow.IsoCredits, evt: [u8]) -> BringUpStep
    if b.step != BringUpStep.ReadBufferSize
        return b.step
    let status = hci_codec.command_complete_status(evt)
    if status != 0
        return iso_bringup_answer(var b, if status < 0 then 0xFF else status)
    match hci_codec.le_buffer_size_v2(hci_codec.command_complete_return_parameters(evt))
        None => iso_bringup_answer(var b, 0xFF)
        Some(sizes) =>
            if iso_flow.iso_credits_configure(var credits, sizes)
                iso_bringup_answer(var b, 0)
            else
                iso_bringup_answer(var b, 0xFF)

// Hand the outcome of the bring-up to the CIS table: Create CIS is allowed
// when the Controller took the Host Support bit.
pub @satisfies("REQ-BLE-ISO-006")
@tier(embedded)
@no_alloc
fn iso_bringup_finish(b: IsoBringUp, var cis: iso_cis.CisTable)
    iso_cis.cis_host_support(var cis, b.host_support)

// The command the current step sends, or None at `Done` and `Failed`.
// It builds lists, so it is application-tier; a program without a heap
// builds the same parameter octets with the builders of `hci_commands`.
pub @satisfies("REQ-BLE-ISO-006")
@tier(app)
fn iso_bringup_command(b: IsoBringUp) -> ?HciCmdMsg
    match b.step
        BringUpStep.ReadBufferSize => Some(HciCmdMsg { opcode: hci_commands.opcode_le_read_buffer_size_v2(), params: [] })
        BringUpStep.SetEventMask => Some(HciCmdMsg { opcode: hci_commands.opcode_le_set_event_mask(), params: hci_commands.build_set_event_mask(b.mask) })
        BringUpStep.SetHostFeature => Some(HciCmdMsg { opcode: hci_commands.opcode_le_set_host_feature(), params: hci_commands.build_le_set_host_feature(hci_commands.FEATURE_CONNECTED_ISOCHRONOUS_STREAM_HOST_SUPPORT, true) })
        _ => None

// ── Tests ────────────────────────────────────────────────────────────

// An LE feature set with the bits `bits` set.
pub @tier(app)
fn feature_set(bits: [Int]) -> [u8]
    var out: [u8] = [0, 0, 0, 0, 0, 0, 0, 0]
    for b in bits
        out[b / 8] = ((out[b / 8] as Int) | (1 << (b % 8))) as u8
    out

// A Command Complete event for `opcode` with `status` and the return
// parameters `rp`.
pub @tier(app)
fn complete(opcode: Int, status: Int, rp: [u8]) -> [u8]
    var evt: [u8] = [0x0E, (4 + list.len(rp)) as u8, 0x01, (opcode & 0xFF) as u8, ((opcode >>> 8) & 0xFF) as u8, status as u8]
    list.append(evt, rp)
    evt

// The return parameters of LE Read Buffer Size [v2] after Status: ACL
// 251 octets and 3 packets, ISO `iso_length` octets and `iso_total` packets.
pub @tier(app)
fn buffer_size_return(iso_length: Int, iso_total: Int) -> [u8]
    [0xFB, 0x00, 0x03, (iso_length & 0xFF) as u8, ((iso_length >>> 8) & 0xFF) as u8, iso_total as u8]

@test
@satisfies("REQ-BLE-ISO-006")
fn test_the_four_feature_bits_are_28_to_31()
    let none = iso_features(feature_set([]))
    test.assert(not iso_supported(none))
    let c = iso_features(feature_set([28]))
    test.assert(c.cis_central and not c.cis_peripheral and not c.broadcaster and not c.receiver)
    let p = iso_features(feature_set([29]))
    test.assert(not p.cis_central and p.cis_peripheral and not p.broadcaster and not p.receiver)
    let b = iso_features(feature_set([30]))
    test.assert(not b.cis_central and not b.cis_peripheral and b.broadcaster and not b.receiver)
    let r = iso_features(feature_set([31]))
    test.assert(not r.cis_central and not r.cis_peripheral and not r.broadcaster and r.receiver)
    // The neighbouring bits are other features.
    let other = iso_features(feature_set([27, 32, 33]))
    test.assert(not iso_supported(other))
    // The bit is in octet 3 for 24 to 31, and a short set reports none.
    test.assert_eq(feature_set([28])[3] as Int, 0x10)
    test.assert(not iso_supported(iso_features([0xFF, 0xFF, 0xFF])))
    test.assert(iso_has_cis(c) and iso_has_cis(p) and not iso_has_cis(b) and not iso_has_cis(r))

@test
@satisfies("REQ-BLE-ISO-006")
fn test_the_event_mask_gains_only_the_bits_of_the_reported_roles()
    let base = hci_commands.LE_EVENT_MASK_DEFAULT
    test.assert_eq(iso_event_mask(base, iso_features(feature_set([]))), base)
    // A Central: CIS Established in both forms, no CIS Request.
    test.assert_eq(iso_event_mask(base, iso_features(feature_set([28]))), base | (1 << 24) | (1 << 41))
    // A Peripheral adds CIS Request.
    test.assert_eq(iso_event_mask(base, iso_features(feature_set([29]))), base | (1 << 24) | (1 << 25) | (1 << 41))
    // A Broadcaster: bits 26 and 27.
    test.assert_eq(iso_event_mask(base, iso_features(feature_set([30]))), base | (1 << 26) | (1 << 27))
    // A Receiver: bits 28, 29 and 33.
    test.assert_eq(iso_event_mask(base, iso_features(feature_set([31]))), base | (1 << 28) | (1 << 29) | (1 << 33))
    // Every role is the whole isochronous set, and the base is kept.
    let all = iso_event_mask(base, iso_features(feature_set([28, 29, 30, 31])))
    test.assert_eq(all, base | hci_commands.LE_EVENT_MASK_ISOCHRONOUS)
    test.assert_eq(all & base, base)

@test
@satisfies("REQ-BLE-ISO-006")
fn test_a_controller_without_isochronous_channels_needs_no_command()
    var b = iso_bringup_new(feature_set([]), hci_commands.LE_EVENT_MASK_DEFAULT)
    test.assert(b.step == BringUpStep.Done)
    test.assert_eq(b.mask, hci_commands.LE_EVENT_MASK_DEFAULT)
    test.assert(iso_bringup_command(b) == None)
    // A Controller with other LE Audio features only, such as the Host
    // Support bit itself, is still without a role.
    var o = iso_bringup_new(feature_set([32]), hci_commands.LE_EVENT_MASK_DEFAULT)
    test.assert(o.step == BringUpStep.Done)
    // An answer with nothing waiting changes nothing.
    test.assert(iso_bringup_answer(var b, 0) == BringUpStep.Done)
    test.assert(iso_bringup_answer(var b, 0x0C) == BringUpStep.Done)
    var cis = iso_cis.cis_table_new()
    iso_bringup_finish(b, var cis)
    test.assert(not cis.host_support)

@test
@satisfies("REQ-BLE-ISO-006")
fn test_the_bring_up_of_a_cis_controller_runs_three_commands_in_order()
    var b = iso_bringup_new(feature_set([28, 29, 30, 31]), hci_commands.LE_EVENT_MASK_DEFAULT)
    var credits = iso_flow.iso_credits_new()
    var cis = iso_cis.cis_table_new()
    test.assert(b.step == BringUpStep.ReadBufferSize)
    match iso_bringup_command(b)
        None => test.fail("a command is waiting")
        Some(c) =>
            test.assert_eq(c.opcode, 0x2060)
            test.assert_eq(list.len(c.params), 0)
    let after_sizes = iso_bringup_buffer_size(var b, var credits, complete(0x2060, 0, buffer_size_return(255, 3)))
    test.assert(after_sizes == BringUpStep.SetEventMask)
    test.assert(iso_flow.iso_credits_ready(var credits))
    test.assert_eq(iso_flow.iso_packet_length(var credits), 255)
    match iso_bringup_command(b)
        None => test.fail("a command is waiting")
        Some(c) =>
            test.assert_eq(c.opcode, 0x2001)
            test.assert_eq(list.len(c.params), 8)
            // The mask: the default and bits 24 to 29, 33 and 41.
            test.assert_eq(c.params[0] as Int, 0x1F)
            test.assert_eq(c.params[3] as Int, 0x3F)
            test.assert_eq(c.params[4] as Int, 0x02)
            test.assert_eq(c.params[5] as Int, 0x02)
    test.assert(iso_bringup_answer(var b, 0) == BringUpStep.SetHostFeature)
    match iso_bringup_command(b)
        None => test.fail("a command is waiting")
        Some(c) =>
            test.assert_eq(c.opcode, 0x2074)
            test.assert_eq(c.params[0] as Int, 32)
            test.assert_eq(c.params[1] as Int, 1)
    test.assert(iso_bringup_answer(var b, 0) == BringUpStep.Done)
    test.assert(b.host_support)
    test.assert(iso_bringup_command(b) == None)
    iso_bringup_finish(b, var cis)
    test.assert(cis.host_support)

@test
@satisfies("REQ-BLE-ISO-006")
fn test_a_broadcaster_or_receiver_alone_does_not_set_the_host_support_bit()
    var credits = iso_flow.iso_credits_new()
    for bit in [30, 31]
        var b = iso_bringup_new(feature_set([bit]), 0)
        test.assert(b.step == BringUpStep.ReadBufferSize)
        test.assert(iso_bringup_buffer_size(var b, var credits, complete(0x2060, 0, buffer_size_return(255, 3))) == BringUpStep.SetEventMask)
        test.assert(iso_bringup_answer(var b, 0) == BringUpStep.Done)
        test.assert(not b.host_support)
        var cis = iso_cis.cis_table_new()
        iso_bringup_finish(b, var cis)
        test.assert(not cis.host_support)

@test
@satisfies("REQ-BLE-ISO-006")
fn test_a_refused_command_ends_the_bring_up_at_the_step_it_failed_in()
    var credits = iso_flow.iso_credits_new()
    // Read Buffer Size refused.
    var a = iso_bringup_new(feature_set([28]), 0)
    test.assert(iso_bringup_buffer_size(var a, var credits, complete(0x2060, 0x01, [])) == BringUpStep.Failed)
    test.assert(a.failed_at == BringUpStep.ReadBufferSize)
    test.assert(iso_bringup_command(a) == None)
    // The mask refused.
    var b = iso_bringup_new(feature_set([28]), 0)
    test.assert(iso_bringup_buffer_size(var b, var credits, complete(0x2060, 0, buffer_size_return(255, 3))) == BringUpStep.SetEventMask)
    test.assert(iso_bringup_answer(var b, 0x12) == BringUpStep.Failed)
    test.assert(b.failed_at == BringUpStep.SetEventMask)
    // Set Host Feature refused with Command Disallowed: a connection exists.
    var c = iso_bringup_new(feature_set([29]), 0)
    test.assert(iso_bringup_buffer_size(var c, var credits, complete(0x2060, 0, buffer_size_return(255, 3))) == BringUpStep.SetEventMask)
    test.assert(iso_bringup_answer(var c, 0) == BringUpStep.SetHostFeature)
    test.assert(iso_bringup_answer(var c, 0x0C) == BringUpStep.Failed)
    test.assert(c.failed_at == BringUpStep.SetHostFeature)
    test.assert(not c.host_support)
    // A failed bring-up stays failed.
    test.assert(iso_bringup_answer(var c, 0) == BringUpStep.Failed)
    var cis = iso_cis.cis_table_new()
    iso_bringup_finish(c, var cis)
    test.assert(not cis.host_support)

@test
@satisfies("REQ-BLE-ISO-006")
fn test_read_buffer_size_with_no_iso_buffer_fails_the_step()
    var credits = iso_flow.iso_credits_new()
    // ISO_Data_Packet_Length 0: the Controller has no dedicated ISO buffer.
    var a = iso_bringup_new(feature_set([28]), 0)
    test.assert(iso_bringup_buffer_size(var a, var credits, complete(0x2060, 0, buffer_size_return(0, 3))) == BringUpStep.Failed)
    test.assert(a.failed_at == BringUpStep.ReadBufferSize)
    test.assert(not iso_flow.iso_credits_ready(var credits))
    // Zero packets.
    var b = iso_bringup_new(feature_set([28]), 0)
    test.assert(iso_bringup_buffer_size(var b, var credits, complete(0x2060, 0, buffer_size_return(255, 0))) == BringUpStep.Failed)
    // A [v1] answer, too short for the ISO half.
    var c = iso_bringup_new(feature_set([28]), 0)
    test.assert(iso_bringup_buffer_size(var c, var credits, complete(0x2060, 0, [0xFB, 0x00, 0x03])) == BringUpStep.Failed)
    test.assert(not iso_flow.iso_credits_ready(var credits))
    // A truncated event.
    var d = iso_bringup_new(feature_set([28]), 0)
    test.assert(iso_bringup_buffer_size(var d, var credits, [0x0E, 0x03, 0x01]) == BringUpStep.Failed)

@test
@satisfies("REQ-BLE-ISO-006")
fn test_the_buffer_answer_is_read_only_in_its_own_step()
    var credits = iso_flow.iso_credits_new()
    var b = iso_bringup_new(feature_set([28]), 0)
    test.assert(iso_bringup_answer(var b, 0) == BringUpStep.SetEventMask)
    test.assert(iso_bringup_buffer_size(var b, var credits, complete(0x2060, 0, buffer_size_return(255, 3))) == BringUpStep.SetEventMask)
    test.assert(not iso_flow.iso_credits_ready(var credits))
