    var bare = new_server([], 65)
    test.assert_eq(list.len(service_changed(var bare.db, var bare.link, 1, 2, 0)), 0)

@test
fn test_tester_reads()
    var s = test_server()
    let r = tester_read(s.db, s.link, 0x000A, false)
    test.assert_eq(r.0, 0)
    test.assert_eq(tester_read(s.db, s.link, 0x0999, false).0, att.ATT_ERR_INVALID_HANDLE)
    test.assert_eq(tester_read(s.db, s.link, 0x0010, true).0, att.ATT_ERR_INSUFFICIENT_AUTHORIZATION)
    test.assert_eq(tester_read(s.db, s.link, 0x0015, false).0, att.ATT_ERR_INSUFFICIENT_ENC_KEY_SIZE)
    test.assert_eq(tester_read(s.db, s.link, 0x0015, true).0, att.ATT_ERR_INSUFFICIENT_ENC_KEY_SIZE)
    set_security(var s.link, encrypted(4, 16))
    test.assert_eq(tester_read(s.db, s.link, 0x0015, true).0, 0)
    // No security check: the value needing encryption reads as it is.
    test.assert_eq(tester_read(s.db, s.link, 0x000C, true).0, 0)
    let _ = add_characteristic(var s.db, 0x08, PERM_WRITE, le16(0xAA0C))
    test.assert_eq(tester_read(s.db, s.link, 0x0017, true).0, att.ATT_ERR_READ_NOT_PERMITTED)
    // An include declaration that lost its service reads empty.
    let _ = add_included(var s.db, 0x0008)
    remove_range(var s.db, 0x0008, 0x0008)
    test.assert_eq(list.len(tester_read(s.db, s.link, 0x0018, true).1), 0)


@test
fn test_edges_of_the_tables()
    var s = test_server()
    // Two UUIDs of one width that differ, and values of two lengths.
    test.assert_eq(uuid_equal(le16(0x2800), le16(0x2801)), false)
    test.assert_eq(same_bytes(octets([1]), octets([1, 2])), false)
    // The last value has no descriptor after it.
    test.assert_eq(list.len(send_value(var s.db, var s.link, 0x0015, 0)), 0)
    // A second configuration descriptor in one characteristic.
    let _ = add_characteristic(var s.db, 0x12, PERM_READ, le16(0xAA0D))
    test.assert(add_descriptor(s.db, PERM_READ | PERM_WRITE, le16(UUID_CLIENT_CHARACTERISTIC_CONFIGURATION)) > 0)
    test.assert_eq(add_descriptor(s.db, PERM_READ | PERM_WRITE, le16(UUID_CLIENT_CHARACTERISTIC_CONFIGURATION)), -1)
    // Configuration of two descriptors at once.
    set_configuration(var s.link, 0x0013, CCC_NOTIFICATION)
    set_configuration(var s.link, 0x0018, CCC_INDICATION)
    set_configuration(var s.link, 0x0013, 0)
    test.assert_eq(configuration(s.link, 0x0018), CCC_INDICATION)
    // Two bonded clients are kept apart.
    save_configuration(var s.db, s.link, 0, octets([1, 2, 3, 4, 5, 6]))
    save_configuration(var s.db, s.link, 1, octets([1, 2, 3, 4, 5, 6]))
    test.assert_eq(list.len(s.db.saved), 2)

@test
fn test_find_by_type_value_stops_when_full()
    var s = new_server(records(), 65)
    for _ in 0..7
        let _ = add_service(var s.db, false, le16(0xCC00))
    // ATT_MTU 23 holds five Handles Information entries.
    let rsp = one(receive(var s.db, var s.link, octets([0x06, 0x01, 0x00, 0xFF, 0xFF, 0x00, 0x28, 0x00, 0xCC]), 0))
    test.assert_eq(list.len(rsp), 1 + 5 * 4)

@test
fn test_read_multiple_variable_leaves_out_a_tuple_with_no_room()
    var s = new_server(records(), 65)
    let _ = add_service(var s.db, false, le16(0xDD00))
    let _ = add_characteristic(var s.db, 0x02, PERM_READ, le16(0xDD01))
    let _ = set_value(var s.db, 0, [0x07])
    // Seven 3-octet tuples fill 21 of the 22 octets: the eighth's length
    // does not fit.
    var req = octets([0x20])
    for _ in 0..8
        list.append(req, octets([0x0A, 0x00]))
    test.assert_eq(list.len(one(receive(var s.db, var s.link, req, 0))), 1 + 21)

// ── Tests: the Database Hash, Robust Caching and signed writes ──────
//
// The GAP and GATT services the Host itself holds, as
// `gatt_db.build_gap_server` lays them out: the readable Device Name
// value at 0x0003, the Service Changed characteristic at 0x000C with its
// configuration descriptor at 0x000D, the Client Supported Features
// value at 0x000F and the Database Hash value at 0x0011.

// A GATT server for a PC Host or a test: the GAP service with the Device Name `Test`, the Appearance and the
// Peripheral Preferred Connection Parameters, none of them writable.
pub @tier(app)
fn host_server() -> GattServer
    host_server_with(false)

// The same database with the Device Name and the Appearance writable or not.
@tier(app)
fn host_server_with(writable_identity: Bool) -> GattServer
    let name: [u8] = ['T', 'e', 's', 't']
    new_server(gatt_db.build_gap_server(name, gatt_db.appearance_bytes(),
        gatt_db.ppcp_value(0x0018, 0x0028, 0, 0x01F4), writable_identity), 65)

@tier(app)
fn host_service_changed_handle(s: GattServer) -> Int
    handle_of_type(s.db, le16(UUID_SERVICE_CHANGED))

@tier(app)
fn host_hash_handle() -> Int
    gatt_db.GAP_SERVER_DATABASE_HASH_HANDLE

@tier(app)
fn host_csf_request(value: Int) -> [u8]
    octets([0x12, gatt_db.GAP_SERVER_CLIENT_SUPPORTED_FEATURES_HANDLE & 0xFF,
        gatt_db.GAP_SERVER_CLIENT_SUPPORTED_FEATURES_HANDLE >>> 8, value])

// The example database of [Vol 3] Part G, Appendix B, in the record
// format: the GAP and GATT services with both new characteristics, a
// Client Characteristic Configuration descriptor and a Characteristic
// Extended Properties descriptor, an include declaration and a secondary
// service.
@tier(app)
fn appendix_records() -> [u8]
    var db = att_server.build_db_record(0x0001, UUID_PRIMARY_SERVICE, 0x0003, le16(0x1800))
    list.append(db, att_server.build_db_record(0x0002, UUID_CHARACTERISTIC, 0x0002, [0x0A, 0x03, 0x00, 0x00, 0x2A]))
    list.append(db, att_server.build_db_record(0x0003, 0x2A00, 0x0003, ['N', 'o']))
    list.append(db, att_server.build_db_record(0x0004, UUID_CHARACTERISTIC, 0x0004, [0x02, 0x05, 0x00, 0x01, 0x2A]))
    list.append(db, att_server.build_db_record(0x0005, 0x2A01, 0x0005, [0x00, 0x00]))
    list.append(db, att_server.build_db_record(0x0006, UUID_PRIMARY_SERVICE, 0x000D, le16(0x1801)))
    list.append(db, att_server.build_db_record(0x0007, UUID_CHARACTERISTIC, 0x0007, [0x20, 0x08, 0x00, 0x05, 0x2A]))
    list.append(db, att_server.build_db_record(0x0008, 0x2A05, 0x0008, [0x01, 0x00, 0xFF, 0xFF]))
    list.append(db, att_server.build_db_record(0x0009, UUID_CLIENT_CHARACTERISTIC_CONFIGURATION, 0x0009, [0x02, 0x00]))
    list.append(db, att_server.build_db_record(0x000A, UUID_CHARACTERISTIC, 0x000A, [0x0A, 0x0B, 0x00, 0x29, 0x2B]))
    list.append(db, att_server.build_db_record(0x000B, UUID_CLIENT_SUPPORTED_FEATURES, 0x000B, [0x01]))
    list.append(db, att_server.build_db_record(0x000C, UUID_CHARACTERISTIC, 0x000C, [0x02, 0x0D, 0x00, 0x2A, 0x2B]))
    list.append(db, att_server.build_db_record(0x000D, UUID_DATABASE_HASH, 0x000D, [0x00]))
    list.append(db, att_server.build_db_record(0x000E, UUID_PRIMARY_SERVICE, 0x0016, le16(0x1808)))
    list.append(db, att_server.build_db_record(0x000F, UUID_INCLUDE, 0x0014, [0x14, 0x00, 0x16, 0x00, 0x0F, 0x18]))
    list.append(db, att_server.build_db_record(0x0010, UUID_CHARACTERISTIC, 0x0010, [0xA2, 0x11, 0x00, 0x18, 0x2A]))
    list.append(db, att_server.build_db_record(0x0011, 0x2A18, 0x0011, [0x00]))
    list.append(db, att_server.build_db_record(0x0012, UUID_CLIENT_CHARACTERISTIC_CONFIGURATION, 0x0012, [0x02, 0x00]))
    list.append(db, att_server.build_db_record(0x0013, UUID_CHARACTERISTIC_EXTENDED_PROPERTIES, 0x0013, [0x00, 0x00]))
    list.append(db, att_server.build_db_record(0x0014, UUID_SECONDARY_SERVICE, 0x0016, le16(0x180F)))
    list.append(db, att_server.build_db_record(0x0015, UUID_CHARACTERISTIC, 0x0015, [0x02, 0x16, 0x00, 0x19, 0x2A]))
    list.append(db, att_server.build_db_record(0x0016, 0x2A19, 0x0016, [0x00]))
    db

// The Connection Signature Resolving Key of the worked example of
// [Vol 3] Part F, Section 3.4.5.4: the message 'D212001337' signed with
// SignCounter 1 gives the CMAC F20F903C931E87F159B64F012574B4D0 and the
// Authentication Signature '01000000F1871E933C900FF2'.  The example
// writes the key 611B64EBFBCD1FD372EC9196DF425E50, most significant
// octet first; a Signing Information command carries it the other way
// round, and that is the order this is.
@tier(app)
fn example_csrk() -> [u8]
    [0x50, 0x5E, 0x42, 0xDF, 0x96, 0x91, 0xEC, 0x72,
     0xD3, 0x1F, 0xCD, 0xFB, 0xEB, 0x64, 0x1B, 0x61]

// A server with a characteristic that may be written only by an
// authenticated client, and the peer's CSRK of the example.
@tier(app)
fn signed_server() -> GattServer
    var s = host_server()
    let _ = add_service(var s.db, false, le16(0xAA00))
    let _ = add_characteristic(var s.db, 0x0A, PERM_READ_AUTHEN | PERM_WRITE_AUTHEN, le16(0xAA01))
    let _ = set_value(var s.db, 0, [0x00, 0x00])
    set_peer_csrk(var s.link, example_csrk())
    s

// An ATT_SIGNED_WRITE_CMD for `handle` with `value` and SignCounter
// `counter`, signed with the example's CSRK.
@tier(app)
fn signed_pdu(handle: Int, value: [u8], counter: Int) -> [u8]
    var m = octets([0xD2, handle & 0xFF, (handle >>> 8) & 0xFF])
    list.append(m, value)
    list.append(m, octets([counter & 0xFF, (counter >>> 8) & 0xFF, (counter >>> 16) & 0xFF, (counter >>> 24) & 0xFF]))
    list.append(m, signature_mac(m, example_csrk()))
    m

@test
fn test_database_hash_matches_appendix_b()
    var s = new_server(appendix_records(), 65)
    // An include declaration's record carries the included service in the
    // table's end group field, which `from_records` does not read; the
    // attribute it makes keeps the handle the record was built with.
    let include = s.db.attributes[14]
    s.db.attributes[14] = GattAttribute {
        handle: include.handle, type_uuid: include.type_uuid, value: include.value[:],
        max_len: include.max_len, permissions: include.permissions, key_size: include.key_size,
        tester: include.tester, included: 0x0014, per_link: false }
    refresh_hash(var s.db)
    // The example of Appendix B: m from 0x0001 to 0x0016 hashes to
    // F1CA2D48ECF58BAC8A8830BBB9FBA990 (most significant octet first),
    // so the characteristic value, a 128-bit little-endian integer, is
    // the same octets reversed.
    assert_bytes(database_hash(s.db),
        [0x90, 0xA9, 0xFB, 0xB9, 0xBB, 0x30, 0x88, 0x8A, 0xAC, 0x8B, 0xF5, 0xEC, 0x48, 0x2D, 0xCA, 0xF1])

@test
fn test_database_hash_follows_the_definitions()
    var s = host_server()
    let before = database_hash(s.db)
    test.assert_eq(list.len(before), HASH_OCTETS)
    test.assert(same_bytes(value_at(s.db, s.link, index_of(s.db, host_hash_handle())), before))
    // A service the tester adds enters the hash.
    let added = add_service(var s.db, false, le16(0xAA00))
    test.assert_eq(same_bytes(before, database_hash(s.db)), false)
    test.assert(same_bytes(value_at(s.db, s.link, index_of(s.db, host_hash_handle())), database_hash(s.db)))
    // So does a removal, and back again the hash is what it was.  The
    // range starts where the tester's service did: the host's own tables
    // end at the handle the GAP service's layout names.
    let after_add = database_hash(s.db)
    test.assert_eq(added, gatt_db.GAP_SERVER_GATT_END + 1)
    remove_range(var s.db, added, 0xFFFF)
    test.assert_eq(same_bytes(after_add, database_hash(s.db)), false)
    test.assert_eq(same_bytes(before, database_hash(s.db)), true)

// The Device Name and the Appearance of the GAP service take a write,
// with or without a response, and the value read back is the new one
// (GAP/GAT/BV-05-C and BV-06-C, [Vol 3] Part C, Section 12.1), when the
// program asked for them writable.
@test
fn test_the_device_name_and_appearance_are_writable()
    var s = host_server_with(true)
    let name = gatt_db.GAP_SERVER_DEVICE_NAME_HANDLE
    let appearance = gatt_db.GAP_SERVER_APPEARANCE_HANDLE
    // A Write Command, then a Write Request: both land.
    let _ = receive(var s.db, var s.link, octets([0x52, name & 0xFF, (name >>> 8) & 0xFF, 'A', 'B']), 0)
    assert_bytes(value_at(s.db, s.link, index_of(s.db, name)), ['A', 'B'])
    assert_bytes(one(receive(var s.db, var s.link, octets([0x12, name & 0xFF, (name >>> 8) & 0xFF, 'C']), 0)), [0x13])
    assert_bytes(value_at(s.db, s.link, index_of(s.db, name)), ['C'])
    assert_bytes(one(receive(var s.db, var s.link, octets([0x0A, name & 0xFF, (name >>> 8) & 0xFF]), 0)), [0x0B, 'C'])
    // The Appearance is two octets, and the declaration says so.
    assert_bytes(one(receive(var s.db, var s.link, octets([0x12, appearance & 0xFF, (appearance >>> 8) & 0xFF, 0x40, 0x00]), 0)), [0x13])
    assert_bytes(value_at(s.db, s.link, index_of(s.db, appearance)), [0x40, 0x00])

// The database a program gets by default refuses a client's write to the
// Device Name and the Appearance with Write Not Permitted, and keeps them.
@test
fn test_the_device_name_and_appearance_are_read_only_by_default()
    var s = host_server()
    let name = gatt_db.GAP_SERVER_DEVICE_NAME_HANDLE
    let appearance = gatt_db.GAP_SERVER_APPEARANCE_HANDLE
    assert_error(receive(var s.db, var s.link, octets([0x12, name & 0xFF, (name >>> 8) & 0xFF, 'C']), 0), 0x12, name, 0x03)
    assert_error(receive(var s.db, var s.link, octets([0x12, appearance & 0xFF, (appearance >>> 8) & 0xFF, 0x40, 0x00]), 0), 0x12, appearance, 0x03)
    assert_bytes(value_at(s.db, s.link, index_of(s.db, name)), ['T', 'e', 's', 't'])

@test
fn test_client_supported_features_values()
    var s = host_server()
    // The default is all bits zero, one octet of value.
    let csf = gatt_db.GAP_SERVER_CLIENT_SUPPORTED_FEATURES_HANDLE
    assert_bytes(one(receive(var s.db, var s.link, octets([0x0A, csf & 0xFF, (csf >>> 8) & 0xFF]), 0)), [0x0B, 0x00])
    // The client sets the Robust Caching bit and all RFU bits; the RFU
    // bits are not features the server offers and stay zero.
    assert_bytes(one(receive(var s.db, var s.link, host_csf_request(0xF9), 0)), [0x13])
    test.assert_eq(s.link.csf, CSF_ROBUST_CACHING)
    assert_bytes(one(receive(var s.db, var s.link, octets([0x0A, csf & 0xFF, (csf >>> 8) & 0xFF]), 0)), [0x0B, 0x01])
    // A client shall not clear a bit it has set.
    assert_error(receive(var s.db, var s.link, host_csf_request(0x00), 0), 0x12, csf, att.ATT_ERR_VALUE_NOT_ALLOWED)
    test.assert_eq(s.link.csf, CSF_ROBUST_CACHING)
    // Setting the bit again is no change, and a value that is not the
    // one octet of the bit field has no length.
    assert_bytes(one(receive(var s.db, var s.link, host_csf_request(0x01), 0)), [0x13])
    assert_error(receive(var s.db, var s.link, octets([0x12, csf & 0xFF, (csf >>> 8) & 0xFF]), 0), 0x12, csf, att.ATT_ERR_INVALID_ATTRIBUTE_VALUE_LEN)
    assert_error(receive(var s.db, var s.link, octets([0x12, csf & 0xFF, (csf >>> 8) & 0xFF, 0x32, 0x32]), 0), 0x12, csf, att.ATT_ERR_INVALID_ATTRIBUTE_VALUE_LEN)
    test.assert_eq(s.link.csf, CSF_ROBUST_CACHING)
    // The value a tester reads over BTP is the client's.
    test.assert_eq(tester_read(s.db, s.link, csf, true).1[0] as Int, CSF_ROBUST_CACHING)

@test
fn test_robust_caching_refuses_a_request_once_per_change()
    var s = host_server()
    let _ = add_service(var s.db, false, le16(0xAA00))
    let _ = add_characteristic(var s.db, 0x0A, PERM_READ | PERM_WRITE, le16(0xAA01))
    let _ = set_value(var s.db, 0, [0x11, 0x22])
    let value_handle = last_handle(s.db)
    // Robust caching off: a change leaves the client alone.
    let read = octets([0x0A, 0x03, 0x00])
    let _ = add_service(var s.db, false, le16(0xBB00))
    assert_bytes(one(receive(var s.db, var s.link, read, 0)), [0x0B, 'T' as Int, 'e' as Int, 's' as Int, 't' as Int])
    // Robust caching on: the change makes the client change-unaware and
    // the first request hears Database Out Of Sync.
    let _ = receive(var s.db, var s.link, host_csf_request(0x01), 0)
    let _ = add_service(var s.db, false, le16(0xCC00))
    assert_error(receive(var s.db, var s.link, read, 0), 0x0A, 0x0003, att.ATT_ERR_DATABASE_OUT_OF_SYNC)
    // The response goes out once; the next request is answered and makes
    // the client change-aware.
    assert_bytes(one(receive(var s.db, var s.link, read, 0)), [0x0B, 'T' as Int, 'e' as Int, 's' as Int, 't' as Int])
    // A change-unaware client's ATT command is ignored.
    let _ = add_service(var s.db, false, le16(0xDD00))
    assert_error(receive(var s.db, var s.link, read, 0), 0x0A, 0x0003, att.ATT_ERR_DATABASE_OUT_OF_SYNC)
    let _ = receive(var s.db, var s.link, octets([0x52, value_handle & 0xFF, (value_handle >>> 8) & 0xFF, 0x99, 0x99]), 0)
    assert_bytes(one(receive(var s.db, var s.link, octets([0x0A, value_handle & 0xFF, (value_handle >>> 8) & 0xFF]), 0)), [0x0B, 0x11, 0x22])

@test
fn test_robust_caching_hash_read_clears_the_refusal()
    var s = host_server()
    let _ = receive(var s.db, var s.link, host_csf_request(0x01), 0)
    let _ = add_service(var s.db, false, le16(0xAA00))
    // The hash is read with Read Using Characteristic UUID, which a
    // change-unaware client hears whatever its range.
    let rsp = one(receive(var s.db, var s.link, octets([0x08, 0x01, 0x00, 0xFF, 0xFF, 0x2A, 0x2B]), 0))
    test.assert_eq(rsp[1] as Int, 2 + HASH_OCTETS)
    test.assert_eq(rsp[2] as Int, host_hash_handle() & 0xFF)
    assert_bytes(rsp[4:4 + HASH_OCTETS], database_hash(s.db))
    // The request after the hash read makes the client change-aware.
    assert_bytes(one(receive(var s.db, var s.link, octets([0x0A, 0x03, 0x00]), 0)), [0x0B, 'T' as Int, 'e' as Int, 's' as Int, 't' as Int])

@test
fn test_robust_caching_refuses_a_narrow_read_by_type()
    var s = host_server()
    let _ = receive(var s.db, var s.link, host_csf_request(0x01), 0)
    let _ = add_service(var s.db, false, le16(0xAA00))
    // Read By Type of a type that is neither «Include» nor
    // «Characteristic», over a range other than the whole database.
    assert_error(receive(var s.db, var s.link, octets([0x08, 0x01, 0x00, 0x10, 0x00, 0x00, 0xAA]), 0), 0x08, 0x0001, att.ATT_ERR_DATABASE_OUT_OF_SYNC)
    // Service discovery is answered even then: the whole range, and the
    // «Characteristic» type.
    let _ = add_service(var s.db, false, le16(0xBB00))
    test.assert_eq(list.len(one(receive(var s.db, var s.link, octets([0x08, 0x01, 0x00, 0xFF, 0xFF, 0x00, 0x28]), 0))) > 2, true)
    let _ = add_service(var s.db, false, le16(0xCC00))
    test.assert_eq(list.len(one(receive(var s.db, var s.link, octets([0x08, 0x01, 0x00, 0x10, 0x00, 0x03, 0x28]), 0))) > 2, true)
    // So are the other procedures that discover a service, and an MTU
    // exchange, which names no attribute.
    let _ = add_service(var s.db, false, le16(0xDD00))
    test.assert_eq(list.len(one(receive(var s.db, var s.link, octets([0x10, 0x01, 0x00, 0xFF, 0xFF, 0x00, 0x28]), 0))) > 2, true)
    let _ = add_service(var s.db, false, le16(0xEE00))
    test.assert_eq(list.len(one(receive(var s.db, var s.link, octets([0x04, 0x01, 0x00, 0xFF, 0xFF]), 0))) > 2, true)
    let _ = add_service(var s.db, false, le16(0xEF00))
    assert_bytes(one(receive(var s.db, var s.link, octets([0x02, 0x00, 0x01]), 0)), [0x03, 65, 0x00])

@test
fn test_robust_caching_holds_notifications_but_not_service_changed()
    var s = host_server()
    let _ = add_service(var s.db, false, le16(0xAA00))
    let _ = add_characteristic(var s.db, 0x12, PERM_READ | PERM_WRITE, le16(0xAA01))
    let _ = set_value(var s.db, 0, [0x07])
    let value_handle = last_handle(s.db)
    let cccd = add_descriptor(s.db, PERM_READ | PERM_WRITE, le16(UUID_CLIENT_CHARACTERISTIC_CONFIGURATION))
    let _ = receive(var s.db, var s.link, octets([0x12, cccd & 0xFF, (cccd >>> 8) & 0xFF, 0x01, 0x00]), 0)
    let sc_cccd = gatt_db.GAP_SERVER_SERVICE_CHANGED_CCCD_HANDLE
    let _ = receive(var s.db, var s.link, octets([0x12, sc_cccd & 0xFF, (sc_cccd >>> 8) & 0xFF, 0x02, 0x00]), 0)
    let _ = receive(var s.db, var s.link, host_csf_request(0x01), 0)
    // The change makes the client change-unaware: a notification waits,
    // the Service Changed indication does not.
    let _ = add_service(var s.db, false, le16(0xBB00))
    test.assert_eq(list.len(send_value(var s.db, var s.link, value_handle, 0)), 0)
    test.assert_eq(list.len(service_changed(var s.db, var s.link, 0x0012, 0x0012, 0)), 1)
    assert_bytes(value_at(s.db, s.link, index_of(s.db, host_service_changed_handle(s))), [0x12, 0x00, 0x12, 0x00])
    // Confirming that indication makes the client change-aware.
    test.assert_eq(list.len(receive(var s.db, var s.link, octets([0x1E]), 0)), 0)
    test.assert_eq(s.link.change_unaware, false)
    assert_bytes(one(receive(var s.db, var s.link, octets([0x0A, 0x03, 0x00]), 0)), [0x0B, 'T' as Int, 'e' as Int, 's' as Int, 't' as Int])

@test
fn test_signature_matches_the_spec_example()
    // m = D2 12 00 13 37 with SignCounter 1, key 611B64EBFBCD1FD372EC9196DF425E50.
    let message = octets([0xD2, 0x12, 0x00, 0x13, 0x37, 0x01, 0x00, 0x00, 0x00])
    assert_bytes(signature_mac(message, example_csrk()), [0xF1, 0x87, 0x1E, 0x93, 0x3C, 0x90, 0x0F, 0xF2])

@test
fn test_signed_write_applies_a_verified_value()
    var s = signed_server()
    let handle = last_handle(s.db)
    // The link is not encrypted and the value needs authentication: a
    // Write Request is refused, the signature authenticates the client.
    assert_error(receive(var s.db, var s.link, octets([0x12, handle & 0xFF, (handle >>> 8) & 0xFF, 0x01]), 0), 0x12, handle, att.ATT_ERR_INSUFFICIENT_AUTHENTICATION)
    let _ = receive(var s.db, var s.link, signed_pdu(handle, [0x13, 0x37], 1), 0)
    assert_bytes(value_at(s.db, s.link, index_of(s.db, handle)), [0x13, 0x37])
    test.assert_eq(s.link.sign_counter, 1)

// A signed write of the rig: GATT/SR/GAW/BV-02-C on 2026-10-11, where PTS
// signed the command D2 2F 00 02 23 45 67 89 AB CD EF with SignCounter 0
// and its CSRK E9E8E52FFF3782FAF49013B9ABD73797, carried least
// significant octet first, and the Authentication Signature came out
// 00000000 9BC0E7D6A285D709.  The example of Part F writes its key the
// way AES-CMAC takes it; a CSRK off the wire is the other way round, and
// reading one as the other is what this pins.
@test
fn test_signature_mac_of_a_pts_signed_write()
    let csrk: [u8] = [0xE9, 0xE8, 0xE5, 0x2F, 0xFF, 0x37, 0x82, 0xFA,
                      0xF4, 0x90, 0x13, 0xB9, 0xAB, 0xD7, 0x37, 0x97]
    let message: [u8] = [0xD2, 0x2F, 0x00, 0x02, 0x23, 0x45, 0x67,
                         0x89, 0xAB, 0xCD, 0xEF, 0x00, 0x00, 0x00, 0x00]
    assert_bytes(signature_mac(message, csrk), octets([0x9B, 0xC0, 0xE7, 0xD6, 0xA2, 0x85, 0xD7, 0x09]))
    // The server applies the write the signature authenticates.
    var s = signed_server()
    set_peer_csrk(var s.link, csrk)
    let handle = last_handle(s.db)
    var pdu = octets([0xD2, handle & 0xFF, (handle >>> 8) & 0xFF, 0x02])
    list.append(pdu, octets([0x00, 0x00, 0x00, 0x00]))
    list.append(pdu, signature_mac(pdu, csrk))
    let _ = receive(var s.db, var s.link, pdu, 0)
    assert_bytes(value_at(s.db, s.link, index_of(s.db, handle)), [0x02])

// The first signed command a client sends carries SignCounter 0 ([Vol 3]
// Part H, Section 2.4.5), so a server whose stored counter started at 0
// refused the first thing an authenticated client ever wrote --
// GATT/SR/GAW/BV-02-C, where PTS signed its first write with counter 0
// and read back the value it did not find.  The stored counter starts at
// -1: with nothing verified yet, any counter passes, 0 included, and a
// second command with a counter that is not greater is still refused.
@test
fn test_the_first_signed_write_uses_counter_zero()
    var s = signed_server()
    let handle = last_handle(s.db)
    test.assert_eq(s.link.sign_counter, -1)
    let _ = receive(var s.db, var s.link, signed_pdu(handle, [0x02], 0), 0)
    assert_bytes(value_at(s.db, s.link, index_of(s.db, handle)), [0x02])
    test.assert_eq(s.link.sign_counter, 0)
    let _ = receive(var s.db, var s.link, signed_pdu(handle, [0x03], 0), 0)
    assert_bytes(value_at(s.db, s.link, index_of(s.db, handle)), [0x02])
    let _ = receive(var s.db, var s.link, signed_pdu(handle, [0x04], 1), 0)
    assert_bytes(value_at(s.db, s.link, index_of(s.db, handle)), [0x04])
    test.assert_eq(s.link.sign_counter, 1)
    // A bearer that starts afresh has verified nothing again.
    reset_bearer(s.db, var s.link)
    set_peer_csrk(var s.link, example_csrk())
    test.assert_eq(s.link.sign_counter, -1)
    let _ = receive(var s.db, var s.link, signed_pdu(handle, [0x05], 0), 0)
    assert_bytes(value_at(s.db, s.link, index_of(s.db, handle)), [0x05])

@test
fn test_signed_write_refuses_what_it_cannot_verify()
    var s = signed_server()
    let handle = last_handle(s.db)
    let _ = receive(var s.db, var s.link, signed_pdu(handle, [0x13, 0x37], 7), 0)
    assert_bytes(value_at(s.db, s.link, index_of(s.db, handle)), [0x13, 0x37])
    // The same SignCounter again is a replay: the signature verifies but
    // the message has been seen.
    let _ = receive(var s.db, var s.link, signed_pdu(handle, [0x99, 0x99], 7), 0)
    assert_bytes(value_at(s.db, s.link, index_of(s.db, handle)), [0x13, 0x37])
    // A signature that does not verify.
    var bad = signed_pdu(handle, [0x77, 0x77], 8)
    bad[list.len(bad) - 1] = ((bad[list.len(bad) - 1] as Int) ^ 0xFF) as u8
    let _ = receive(var s.db, var s.link, bad, 0)
    assert_bytes(value_at(s.db, s.link, index_of(s.db, handle)), [0x13, 0x37])
    // A value longer than the characteristic.
    let _ = receive(var s.db, var s.link, signed_pdu(handle, [0x01, 0x02, 0x03], 9), 0)
    assert_bytes(value_at(s.db, s.link, index_of(s.db, handle)), [0x13, 0x37])
    // A handle that is no attribute.
    let _ = receive(var s.db, var s.link, signed_pdu(0x0999, [0x01], 10), 0)
    assert_bytes(value_at(s.db, s.link, index_of(s.db, handle)), [0x13, 0x37])
    // None of them is answered.
    test.assert_eq(list.len(receive(var s.db, var s.link, signed_pdu(handle, [0x01, 0x02], 11), 0)), 0)
    assert_bytes(value_at(s.db, s.link, index_of(s.db, handle)), [0x01, 0x02])
    test.assert_eq(s.link.sign_counter, 11)

@test
fn test_signed_write_without_a_csrk_is_ignored()
    var s = signed_server()
    let handle = last_handle(s.db)
    set_peer_csrk(var s.link, [])
    let _ = receive(var s.db, var s.link, signed_pdu(handle, [0x13, 0x37], 1), 0)
    assert_bytes(value_at(s.db, s.link, index_of(s.db, handle)), [0x00, 0x00])

@test
fn test_the_clients_state_survives_a_bond()
    var s = host_server()
    let _ = receive(var s.db, var s.link, host_csf_request(0x01), 0)
    let address = octets([1, 2, 3, 4, 5, 6])
    // A change during the connection, which the client catches up with by
    // reading the hash.
    let _ = add_service(var s.db, false, le16(0xAA00))
    let _ = receive(var s.db, var s.link, octets([0x08, 0x01, 0x00, 0xFF, 0xFF, 0x2A, 0x2B]), 0)
    let _ = receive(var s.db, var s.link, octets([0x0A, 0x03, 0x00]), 0)
    test.assert_eq(s.link.change_unaware, false)
    save_configuration(var s.db, s.link, 1, address)
    reset_bearer(s.db, var s.link)
    restore_configuration(s.db, var s.link, 1, address)
    test.assert_eq(s.link.csf, CSF_ROBUST_CACHING)
    test.assert_eq(s.link.change_unaware, false)
    // The database changes while the client is away: it comes back
    // change-unaware.
    let _ = add_service(var s.db, false, le16(0xBB00))
    reset_bearer(s.db, var s.link)
    restore_configuration(s.db, var s.link, 1, address)
    test.assert_eq(s.link.change_unaware, true)
    // A client without a trusted relationship starts change-aware, with
    // the default value.
    reset_bearer(s.db, var s.link)
    test.assert_eq(s.link.change_unaware, false)
    test.assert_eq(s.link.csf, 0)

// ── The ATT bearers of one connection ───────────────────────────────
//
// The unenhanced bearer is the table's first entry, and every channel of
// the Enhanced ATT PSM is another one ([Vol 3] Part G, Section 5.3).  The
// cases these tests follow are GATT/SR/GAC/BI-01-C (an MTU exchange is
// not one of an enhanced bearer's procedures), GATT/SR/GAW/BI-38-C (a
// signed write is not to be used on one) and GATT/SR/GAW/BV-12-C (queued
// writes of several bearers are written by one Execute Write Request).

// A server with an enhanced bearer at index 1, its channel number 0 and
// its ATT_MTU 100, and a characteristic that may be read and written.
@tier(app)
fn enhanced_server() -> GattServer
    var s = test_server()
    let _ = open_bearer(s.link, 0, true, 100)
    s

// The value of the characteristic the test service's first characteristic
// holds, as the bearer `index` reads it.
@tier(app)
fn read_on(var s: GattServer, index: Int, handle: Int) -> [u8]
    let out = receive_on(var s.db, var s.link, index, octets([0x0A, handle & 0xFF, handle >>> 8]), 0)
    if list.len(out) == 0
        []
    else
        out[0]

// A server with a 200-octet readable value (its handle), an enhanced
// bearer at index 1 with the ATT_MTU `mtu`, and the unenhanced bearer.
@tier(app)
fn long_value_server(mtu: Int) -> (GattServer, Int)
    var s = new_server(records(), 65)
    let _ = add_service(var s.db, false, le16(0xAA00))
    let _ = add_characteristic(var s.db, 0x02, PERM_READ, le16(0xAA01))
    var long: [u8] = []
    for i in 0..200
        list.push(long, (i & 0xFF) as u8)
    let _ = set_value(var s.db, 0, long)
    let _ = open_bearer(s.link, 0, true, mtu)
    (s, last_handle(s.db))

@test
fn test_an_enhanced_bearer_has_an_att_mtu_of_its_own()
    var setup = long_value_server(100)
    var s = setup.0
    let handle = setup.1
    test.assert_eq(bearer_count(s.link), 2)
    test.assert_eq(bearer_of_channel(s.link, 0, true), 1)
    test.assert_eq(channel_of_bearer(s.link, 1), 0)
    test.assert_eq(mtu_of(s.link, 1), 100)
    test.assert_eq(mtu_of(s.link, 0), ATT_DEFAULT_MTU)
    // The MTU exchange of the unenhanced bearer leaves the enhanced one
    // alone.
    let _ = receive(var s.db, var s.link, octets([0x02, 0x41, 0x00]), 0)
    test.assert_eq(mtu_of(s.link, 0), 65)
    test.assert_eq(mtu_of(s.link, 1), 100)
    // The same value read over the two bearers: each bearer's answer is
    // cut to its own ATT_MTU - 1 octets ([Vol 3] Part F, Section 3.4.4.4).
    let by_enhanced = read_on(var s, 1, handle)
    test.assert_eq(list.len(by_enhanced), 1 + 99)
    test.assert_eq(by_enhanced[1] as Int, 0x00)
    test.assert_eq(by_enhanced[99] as Int, 98)
    let by_unenhanced = read_on(var s, 0, handle)
    test.assert_eq(list.len(by_unenhanced), 1 + 64)
    test.assert_eq(by_unenhanced[64] as Int, 63)

@test
fn test_the_mtu_exchange_is_not_an_enhanced_bearers_procedure()
    var s = enhanced_server()
    // GATT/SR/GAC/BI-01-C: the request is answered Request Not Supported,
    // naming the request opcode and handle 0x0000.
    assert_error(receive_on(var s.db, var s.link, 1, octets([0x02, 0x00, 0x02]), 0), 0x02, 0, att.ATT_ERR_REQUEST_NOT_SUPPORTED)
    test.assert_eq(mtu_of(s.link, 1), 100)
    // A malformed one is answered the same way, not Invalid PDU.
    assert_error(receive_on(var s.db, var s.link, 1, octets([0x02, 0x41]), 0), 0x02, 0, att.ATT_ERR_REQUEST_NOT_SUPPORTED)
    // The unenhanced bearer's own exchange still answers with the Server
    // Rx MTU.
    assert_bytes(one(receive_on(var s.db, var s.link, 0, octets([0x02, 0x00, 0x02]), 0)), [0x03, 65, 0x00])

@test
fn test_a_signed_write_is_ignored_on_an_enhanced_bearer()
    var s = signed_server()
    let handle = last_handle(s.db)
    // GATT/SR/GAW/BI-38-C: the command is a valid one, signed with the
    // bond's CSRK and a counter this server has not seen, and it is
    // ignored all the same ([Vol 3] Part F, Section 3.4.5.4: "This
    // command shall not be used on an Enhanced ATT bearer").
    let _ = open_bearer(s.link, 0, true, 100)
    let _ = receive_on(var s.db, var s.link, 1, signed_pdu(handle, [0x11, 0x22], 1), 0)
    assert_bytes(value_at(s.db, s.link, index_of(s.db, handle)), [0x00, 0x00])
    test.assert_eq(s.link.sign_counter, -1)
    // The same command on the unenhanced bearer is verified and written.
    let _ = receive_on(var s.db, var s.link, 0, signed_pdu(handle, [0x11, 0x22], 1), 0)
    assert_bytes(value_at(s.db, s.link, index_of(s.db, handle)), [0x11, 0x22])
    test.assert_eq(s.link.sign_counter, 1)

@test
fn test_each_bearer_keeps_its_own_outstanding_indication()
    var s = test_server()
    let _ = open_bearer(s.link, 0, true, 100)
    set_configuration(var s.link, 0x0013, CCC_INDICATION)
    // One indication waits on each bearer, and each is confirmed on its
    // own ([Vol 3] Part F, Section 3.2.11: an ATT bearer has its own
    // transaction state, and one outstanding request per bearer is what
    // that means).
    assert_bytes(one(send_value_on(s.db, var s.link, 1, 0x0012, 0)), [0x1D, 0x12, 0x00, 0x44, 0x45])
    assert_bytes(one(send_value_on(s.db, var s.link, 0, 0x0012, 0)), [0x1D, 0x12, 0x00, 0x44, 0x45])
    // A second indication on one bearer waits behind the one that is
    // outstanding there, and the other bearer is none of its business.
    test.assert_eq(list.len(send_value_on(s.db, var s.link, 1, 0x0012, 0)), 0)
    test.assert_eq(list.len(send_value_on(s.db, var s.link, 0, 0x0012, 0)), 0)
    // Each confirmation releases what waited on its own bearer, and the
    // next confirmation of an idle bearer is answered with nothing.
    assert_bytes(one(receive_on(var s.db, var s.link, 1, octets([0x1E]), 0)), [0x1D, 0x12, 0x00, 0x44, 0x45])
    assert_bytes(one(receive_on(var s.db, var s.link, 0, octets([0x1E]), 0)), [0x1D, 0x12, 0x00, 0x44, 0x45])
    test.assert_eq(list.len(receive_on(var s.db, var s.link, 0, octets([0x1E]), 0)), 0)
    // A transaction that times out ends that bearer alone: the ATT_MTU of
    // an enhanced bearer comes from its channel, but its transaction state
    // is its own ([Vol 3] Part F, Section 3.2.11).
    test.assert_eq(s.link.bearers[1].indicating, 0x0012)
    tick(s.link, ATT_TRANSACTION_TIMEOUT_MS)
    test.assert_eq(s.link.bearers[1].timed_out, true)
    test.assert_eq(s.link.bearers[0].timed_out, false)
    test.assert_eq(list.len(receive_on(var s.db, var s.link, 1, octets([0x0A, 0x0A, 0x00]), 0)), 0)
    test.assert(list.len(receive_on(var s.db, var s.link, 0, octets([0x0A, 0x0A, 0x00]), 0)) > 0)

@test
fn test_the_prepare_queue_belongs_to_the_client_not_to_a_bearer()
    var s = test_server()
    let _ = open_bearer(s.link, 0, true, 100)
    // GATT/SR/GAW/BV-12-C: the parts are prepared with roll-over over the
    // bearers, and the Execute Write Request on any of them writes all of
    // them ([Vol 3] Part F, Section 3.4.6.4).
    let part_one = octets([0x16, 0x0A, 0x00, 0x00, 0x00, 0x01, 0x02])
    let part_two = octets([0x16, 0x0A, 0x00, 0x02, 0x00, 0x03, 0x04])
    let first = receive_on(var s.db, var s.link, 1, part_one, 0)
    test.assert_eq(list.len(first), 1)
    test.assert_eq(list.len(s.link.prepare_queue), 1)
    let second = receive_on(var s.db, var s.link, 0, part_two, 0)
    test.assert_eq(list.len(second), 1)
    test.assert_eq(list.len(s.link.prepare_queue), 2)
    let done = receive_on(var s.db, var s.link, 0, octets([0x18, 0x01]), 0)
    assert_bytes(one(done), [0x19])
    test.assert_eq(list.len(s.link.prepare_queue), 0)
    assert_bytes(value_at(s.db, s.link, index_of(s.db, 0x000A)), [0x01, 0x02, 0x03, 0x04])

@test
fn test_an_execute_write_after_a_database_change_is_database_out_of_sync()
    // GATT/SR/GAW/BI-41-C: the Lower Tester prepares a write, the IUT's
    // database changes -- the attribute the part names is removed -- and
    // the Execute Write Request that follows is answered Database Out Of
    // Sync (0x12) with the handle of the part, and nothing is written
    // ([Vol 3] Part F, Section 3.4.6.3 as the ATT v6.1 text has it).
    var s = test_server()
    let prepared = receive(var s.db, var s.link, octets([0x16, 0x0A, 0x00, 0x00, 0x00, 0x09]), 0)
    assert_bytes(one(prepared), [0x17, 0x0A, 0x00, 0x00, 0x00, 0x09])
    test.assert_eq(list.len(s.link.prepare_queue), 1)
    remove_range(var s.db, 0x000A, 0x000A)
    assert_error(receive(var s.db, var s.link, octets([0x18, 0x01]), 0), 0x18, 0x000A, att.ATT_ERR_DATABASE_OUT_OF_SYNC)
    test.assert_eq(list.len(s.link.prepare_queue), 0)
    // A queue the definitions did not move under is written as always:
    // the check above is the change alone.
    let again = receive(var s.db, var s.link, octets([0x16, 0x12, 0x00, 0x00, 0x00, 0x09]), 0)
    assert_bytes(one(again), [0x17, 0x12, 0x00, 0x00, 0x00, 0x09])
    let written = receive(var s.db, var s.link, octets([0x18, 0x01]), 0)
    assert_bytes(one(written), [0x19])
    assert_bytes(value_at(s.db, s.link, index_of(s.db, 0x0012)), [0x09])

@test
fn test_the_bearer_table_follows_the_channels_the_link_holds()
    var s = test_server()
    test.assert_eq(bearer_count(s.link), 1)
    test.assert_eq(bearer_of_channel(s.link, 0, true), -1)
    test.assert_eq(open_bearer(s.link, 2, true, 64), 1)
    test.assert_eq(open_bearer(s.link, 3, true, 64), 2)
    test.assert_eq(bearer_count(s.link), 3)
    // Opening a bearer that is there only moves its ATT_MTU: a channel
    // whose L2CAP MTU was reconfigured moves the bearer's with it.
    test.assert_eq(open_bearer(s.link, 2, true, 128), 1)
    test.assert_eq(bearer_count(s.link), 3)
    test.assert_eq(mtu_of(s.link, 1), 128)
    // The bearer of a channel the link no longer holds is gone; the
    // unenhanced bearer stays whatever the list says.
    retain_bearers(var s.link, [3])
    test.assert_eq(bearer_count(s.link), 2)
    test.assert_eq(bearer_of_channel(s.link, 2, true), -1)
    test.assert_eq(bearer_of_channel(s.link, 3, true), 1)
    retain_bearers(var s.link, [])
    test.assert_eq(bearer_count(s.link), 1)
    test.assert_eq(mtu_of(s.link, 0), ATT_DEFAULT_MTU)
    // A bearer index outside the table reads as the default and no
    // channel.
    test.assert_eq(bearer_of_channel(s.link, 9, true), -1)
    test.assert_eq(mtu_of(s.link, 7), ATT_DEFAULT_MTU)
    test.assert_eq(channel_of_bearer(s.link, 7), 0)

@test
fn test_the_enhanced_att_bit_is_what_the_client_sets()
    var s = host_server()
    // GATT/SR/GAC/BI-01-C's preamble: the client writes 0x0002, "The
    // client supports Enhanced ATT bearer" ([Vol 3] Part G, Table 7.6,
    // bit 1 of octet 0).
    let _ = receive(var s.db, var s.link, host_csf_request(CSF_ENHANCED_ATT), 0)
    test.assert_eq(s.link.csf, CSF_ENHANCED_ATT)
    // Robust Caching and it together, and a bit this device does not
    // support is dropped from the value it keeps.
    let _ = receive(var s.db, var s.link, host_csf_request(CSF_ROBUST_CACHING | CSF_ENHANCED_ATT | 0x04), 0)
    test.assert_eq(s.link.csf, CSF_ROBUST_CACHING | CSF_ENHANCED_ATT)

// ── Access levels and the configuration descriptor's own access ─────

@test
fn test_access_levels_map_to_permission_bits()
    test.assert_eq(permission_bits(Permissions { read: Access.Denied, write: Access.Denied }), 0)
    test.assert_eq(permission_bits(open_permissions()), PERM_READ | PERM_WRITE)
    test.assert_eq(permission_bits(Permissions { read: Access.Encrypted, write: Access.Open }), PERM_READ_ENCRYPT | PERM_WRITE)
    test.assert_eq(permission_bits(Permissions { read: Access.Open, write: Access.Authenticated }), PERM_READ | PERM_WRITE_AUTHEN)
    test.assert_eq(permission_bits(both_ways(Access.Authorized)), PERM_READ_AUTHOR | PERM_WRITE_AUTHOR)
    test.assert_eq(permission_bits(both_ways(Access.SecureConnections)),
        PERM_READ_AUTHEN | PERM_READ_SC | PERM_WRITE_AUTHEN | PERM_WRITE_SC)

@tier(app)
fn level_server(read: Access, write: Access) -> GattServer
    var s = new_server([], 65)
    test.assert_eq(add_service(var s.db, false, le16(0xAA00)), 1)
    test.assert_eq(add_characteristic(var s.db, 0x0A, permission_bits(Permissions { read: read, write: write }), le16(0xAA01)), 2)
    test.assert(set_value(var s.db, 0, [0x07]))
    s

@tier(app)
fn read_of(var s: GattServer) -> [[u8]]
    receive(var s.db, var s.link, octets([0x0A, 0x03, 0x00]), 0)

@tier(app)
fn write_of(var s: GattServer) -> [[u8]]
    receive(var s.db, var s.link, octets([0x12, 0x03, 0x00, 0x09]), 0)

@test
fn test_every_access_level_is_enforced_for_reads()
    // Denied.
    var denied = level_server(Access.Denied, Access.Denied)
    assert_error(read_of(var denied), 0x0A, 3, att.ATT_ERR_READ_NOT_PERMITTED)
    // Open.
    var open = level_server(Access.Open, Access.Open)
    assert_bytes(one(read_of(var open)), [0x0B, 0x07])
    // Authorized: no client is.
    var authorized = level_server(Access.Authorized, Access.Open)
    assert_error(read_of(var authorized), 0x0A, 3, att.ATT_ERR_INSUFFICIENT_AUTHORIZATION)
    // Encrypted: no key, a key but no encryption, encryption.
    var enc = level_server(Access.Encrypted, Access.Open)
    assert_error(read_of(var enc), 0x0A, 3, att.ATT_ERR_INSUFFICIENT_AUTHENTICATION)
    set_security(var enc.link, link_security(false, 1, 0, true))
    assert_error(read_of(var enc), 0x0A, 3, att.ATT_ERR_INSUFFICIENT_ENCRYPTION)
    set_security(var enc.link, encrypted(2, 16))
    assert_bytes(one(read_of(var enc)), [0x0B, 0x07])
    // Authenticated: level 2 is not enough, level 3 is.
    var auth = level_server(Access.Authenticated, Access.Open)
    set_security(var auth.link, encrypted(2, 16))
    assert_error(read_of(var auth), 0x0A, 3, att.ATT_ERR_INSUFFICIENT_AUTHENTICATION)
    set_security(var auth.link, encrypted(3, 16))
    assert_bytes(one(read_of(var auth)), [0x0B, 0x07])
    // Secure Connections: level 3 is not enough, level 4 is.
    var sc = level_server(Access.SecureConnections, Access.Open)
    assert_error(read_of(var sc), 0x0A, 3, att.ATT_ERR_INSUFFICIENT_AUTHENTICATION)
    set_security(var sc.link, encrypted(3, 16))
    assert_error(read_of(var sc), 0x0A, 3, att.ATT_ERR_INSUFFICIENT_AUTHENTICATION)
    set_security(var sc.link, encrypted(4, 16))
    assert_bytes(one(read_of(var sc)), [0x0B, 0x07])

@test
fn test_every_access_level_is_enforced_for_writes()
    var denied = level_server(Access.Open, Access.Denied)
    assert_error(write_of(var denied), 0x12, 3, att.ATT_ERR_WRITE_NOT_PERMITTED)
    var open = level_server(Access.Open, Access.Open)
    assert_bytes(one(write_of(var open)), [0x13])
    var authorized = level_server(Access.Open, Access.Authorized)
    assert_error(write_of(var authorized), 0x12, 3, att.ATT_ERR_INSUFFICIENT_AUTHORIZATION)
    var enc = level_server(Access.Open, Access.Encrypted)
    assert_error(write_of(var enc), 0x12, 3, att.ATT_ERR_INSUFFICIENT_AUTHENTICATION)
    set_security(var enc.link, link_security(false, 1, 0, true))
    assert_error(write_of(var enc), 0x12, 3, att.ATT_ERR_INSUFFICIENT_ENCRYPTION)
    set_security(var enc.link, encrypted(2, 16))
    assert_bytes(one(write_of(var enc)), [0x13])
    var auth = level_server(Access.Open, Access.Authenticated)
    set_security(var auth.link, encrypted(2, 16))
    assert_error(write_of(var auth), 0x12, 3, att.ATT_ERR_INSUFFICIENT_AUTHENTICATION)
    set_security(var auth.link, encrypted(3, 16))
    assert_bytes(one(write_of(var auth)), [0x13])
    var sc = level_server(Access.Open, Access.SecureConnections)
    set_security(var sc.link, encrypted(3, 16))
    assert_error(write_of(var sc), 0x12, 3, att.ATT_ERR_INSUFFICIENT_AUTHENTICATION)
    set_security(var sc.link, encrypted(4, 16))
    assert_bytes(one(write_of(var sc)), [0x13])

@tier(app)
fn notify_server(cccd: Permissions) -> GattServer
    var s = new_server([], 65)
    test.assert_eq(add_service(var s.db, false, le16(0xAA00)), 1)
    test.assert_eq(add_characteristic(var s.db, PROP_NOTIFY, 0, le16(0xAA01)), 2)
    test.assert(set_value(var s.db, 0, [0x05]))
    test.assert_eq(add_configuration(var s.db, cccd), 4)
    s

@tier(app)
fn subscribe(var s: GattServer) -> [[u8]]
    receive(var s.db, var s.link, octets([0x12, 0x04, 0x00, 0x01, 0x00]), 0)

@test
fn test_a_configuration_descriptor_takes_its_own_access()
    // Write needs encryption, read is open: a client in the clear can read
    // the descriptor but not subscribe.
    var s = notify_server(Permissions { read: Access.Open, write: Access.Encrypted })
    test.assert_eq(permission_bits_of(s, 4), PERM_READ | PERM_WRITE_ENCRYPT)
    assert_bytes(one(receive(var s.db, var s.link, octets([0x0A, 0x04, 0x00]), 0)), [0x0B, 0x00, 0x00])
    assert_error(subscribe(s), 0x12, 4, att.ATT_ERR_INSUFFICIENT_AUTHENTICATION)
    set_security(var s.link, link_security(false, 1, 0, true))
    assert_error(subscribe(s), 0x12, 4, att.ATT_ERR_INSUFFICIENT_ENCRYPTION)
    test.assert_eq(configuration(s.link, 4), 0)
    set_security(var s.link, encrypted(2, 16))
    assert_bytes(one(subscribe(s)), [0x13])
    test.assert_eq(configuration(s.link, 4), CCC_NOTIFICATION)
    // The value is notify-only, yet it goes out once subscribed.
    assert_bytes(one(send_value(var s.db, var s.link, 3, 0)), [0x1B, 0x03, 0x00, 0x05])
    assert_error(receive(var s.db, var s.link, octets([0x0A, 0x03, 0x00]), 0), 0x0A, 3, att.ATT_ERR_READ_NOT_PERMITTED)

@tier(app)
fn permission_bits_of(s: GattServer, handle: Int) -> Int
    s.db.attributes[index_of(s.db, handle)].permissions

@test
fn test_a_configuration_descriptor_refuses_each_level()
    var enc = notify_server(Permissions { read: Access.Encrypted, write: Access.Encrypted })
    assert_error(receive(var enc.db, var enc.link, octets([0x0A, 0x04, 0x00]), 0), 0x0A, 4, att.ATT_ERR_INSUFFICIENT_AUTHENTICATION)
    var auth = notify_server(Permissions { read: Access.Open, write: Access.Authenticated })
    set_security(var auth.link, encrypted(2, 16))
    assert_error(subscribe(auth), 0x12, 4, att.ATT_ERR_INSUFFICIENT_AUTHENTICATION)
    set_security(var auth.link, encrypted(3, 16))
    assert_bytes(one(subscribe(auth)), [0x13])
    var sc = notify_server(Permissions { read: Access.Open, write: Access.SecureConnections })
    set_security(var sc.link, encrypted(3, 16))
    assert_error(subscribe(sc), 0x12, 4, att.ATT_ERR_INSUFFICIENT_AUTHENTICATION)
    set_security(var sc.link, encrypted(4, 16))
    assert_bytes(one(subscribe(sc)), [0x13])
    var authorized = notify_server(Permissions { read: Access.Open, write: Access.Authorized })
    assert_error(subscribe(authorized), 0x12, 4, att.ATT_ERR_INSUFFICIENT_AUTHORIZATION)
    var denied = notify_server(Permissions { read: Access.Open, write: Access.Denied })
    assert_error(subscribe(denied), 0x12, 4, att.ATT_ERR_WRITE_NOT_PERMITTED)

@test
fn test_a_subscription_is_not_served_on_a_weaker_link()
    var s = notify_server(Permissions { read: Access.Open, write: Access.Encrypted })
    // A subscription kept from an earlier encrypted link does not make the
    // value go out on a link that is not encrypted.
    set_configuration(var s.link, 4, CCC_NOTIFICATION)
    test.assert_eq(list.len(send_value(var s.db, var s.link, 3, 0)), 0)
    set_security(var s.link, encrypted(2, 16))
    test.assert_eq(list.len(send_value(var s.db, var s.link, 3, 0)), 1)

@test
fn test_add_configuration_checks_the_characteristic()
    var s = new_server([], 65)
    test.assert_eq(add_configuration(var s.db, open_permissions()), -1)
    test.assert_eq(add_service(var s.db, false, le16(0xAA00)), 1)
    test.assert_eq(add_configuration(var s.db, open_permissions()), -1)
    // A characteristic that neither notifies nor indicates takes none.
    test.assert_eq(add_characteristic(var s.db, PROP_READ, PERM_READ, le16(0xAA01)), 2)
    test.assert_eq(add_configuration(var s.db, open_permissions()), -1)
    test.assert_eq(add_characteristic(var s.db, PROP_INDICATE, 0, le16(0xAA02)), 4)
    test.assert_eq(add_configuration(var s.db, open_permissions()), 6)
    // Only one per characteristic.
    test.assert_eq(add_configuration(var s.db, open_permissions()), -1)

@tier(app)
fn control_point_server() -> GattServer
    var s = new_server([], 65)
    test.assert_eq(add_service(var s.db, false, le16(0xAA00)), 1)
    test.assert_eq(add_characteristic(var s.db, PROP_WRITE | PROP_INDICATE, PERM_WRITE, le16(0xAA01)), 2)
    test.assert_eq(add_configuration(var s.db, open_permissions()), 4)
    test.assert(require_indication(var s.db, 3, 0x81, 0x80))
    s

@test
fn test_a_control_point_write_needs_an_indication_subscription()
    var s = control_point_server()
    assert_error(receive(var s.db, var s.link, octets([0x12, 0x03, 0x00, 0x01]), 0), 0x12, 3, 0x81)
    test.assert_eq(list.len(take_changed(s.link)), 0)
    // A subscription to notifications is not one to indications.
    set_configuration(var s.link, 4, CCC_NOTIFICATION)
    assert_error(receive(var s.db, var s.link, octets([0x12, 0x03, 0x00, 0x01]), 0), 0x12, 3, 0x81)
    // A command is dropped without a response.
    set_configuration(var s.link, 4, 0)
    test.assert_eq(list.len(receive(var s.db, var s.link, octets([0x52, 0x03, 0x00, 0x01]), 0)), 0)
    set_configuration(var s.link, 4, CCC_INDICATION)
    assert_bytes(one(receive(var s.db, var s.link, octets([0x12, 0x03, 0x00, 0x01]), 0)), [0x13])
    test.assert_eq(take_changed(s.link)[0], 3)

@test
fn test_a_control_point_write_waits_for_the_unconfirmed_indication()
    var s = control_point_server()
    set_configuration(var s.link, 4, CCC_INDICATION)
    let _ = receive(var s.db, var s.link, octets([0x12, 0x03, 0x00, 0x01]), 0)
    assert_bytes(one(send_value(var s.db, var s.link, 3, 0)), [0x1D, 0x03, 0x00, 0x01])
    assert_error(receive(var s.db, var s.link, octets([0x12, 0x03, 0x00, 0x02]), 0), 0x12, 3, 0x80)
    // The confirmation ends the wait.
    test.assert_eq(list.len(receive(var s.db, var s.link, octets([0x1E]), 0)), 0)
    assert_bytes(one(receive(var s.db, var s.link, octets([0x12, 0x03, 0x00, 0x02]), 0)), [0x13])
    // A prepared write is held to the same rule.
    set_configuration(var s.link, 4, 0)
    assert_error(receive(var s.db, var s.link, octets([0x16, 0x03, 0x00, 0x00, 0x00, 0x01]), 0), 0x16, 3, 0x81)

@test
fn test_a_write_is_restricted_to_the_first_octets_allowed()
    var s = new_server([], 65)
    test.assert_eq(add_service(var s.db, false, le16(0xAA00)), 1)
    test.assert_eq(add_characteristic(var s.db, PROP_WRITE, PERM_WRITE, le16(0xAA01)), 2)
    test.assert(restrict_first_octet(var s.db, 3, [1, 2], 0x80))
    test.assert_eq(restrict_first_octet(var s.db, 0x99, [1], 0x80), false)
    assert_bytes(one(receive(var s.db, var s.link, octets([0x12, 0x03, 0x00, 0x02]), 0)), [0x13])
    assert_error(receive(var s.db, var s.link, octets([0x12, 0x03, 0x00, 0x03]), 0), 0x12, 3, 0x80)
    assert_error(receive(var s.db, var s.link, octets([0x12, 0x03, 0x00]), 0), 0x12, 3, 0x80)
    test.assert_eq(require_indication(var s.db, 3, 0x81, 0x80), false)

@test
@satisfies("REQ-BLE-GAF-008")
fn test_a_write_is_held_to_the_format_rule_of_its_attribute()
    var s = new_server([], 65)
    test.assert_eq(add_service(var s.db, false, le16(0xAA00)), 1)
    test.assert_eq(add_characteristic(var s.db, PROP_READ | PROP_WRITE, PERM_READ | PERM_WRITE, le16(0xAA01)), 2)
    test.assert(set_value(var s.db, 3, octets([1, 0, 0, 0])))
    // Four octets, the top four bits clear, Write Request Rejected otherwise.
    test.assert(require_value_format(var s.db, 3, 4, 0xF0000000, 0xFC))
    test.assert_eq(require_value_format(var s.db, 0x99, 4, 0, 0xFC), false)
    assert_bytes(one(receive(var s.db, var s.link, octets([0x12, 0x03, 0x00, 0x00, 0x00, 0x00, 0x08]), 0)), [0x13])
    assert_bytes(s.db.attributes[2].value, [0x00, 0x00, 0x00, 0x08])
    assert_error(receive(var s.db, var s.link, octets([0x12, 0x03, 0x00, 0x00, 0x00, 0x00, 0x10]), 0), 0x12, 3, 0xFC)
    assert_error(receive(var s.db, var s.link, octets([0x12, 0x03, 0x00, 0x01, 0x00, 0x00]), 0), 0x12, 3, 0xFC)
    assert_error(receive(var s.db, var s.link, octets([0x12, 0x03, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00]), 0), 0x12, 3, 0xFC)
    assert_error(receive(var s.db, var s.link, octets([0x12, 0x03, 0x00]), 0), 0x12, 3, 0xFC)
    // A command is held to it too, and so is a prepared write, when the
    // queue is executed.
    test.assert_eq(list.len(receive(var s.db, var s.link, octets([0x52, 0x03, 0x00, 0x01]), 0)), 0)
    assert_bytes(s.db.attributes[2].value, [0x00, 0x00, 0x00, 0x08])
    assert_bytes(one(receive(var s.db, var s.link, octets([0x16, 0x03, 0x00, 0x01, 0x00, 0x05]), 0)), [0x17, 0x03, 0x00, 0x01, 0x00, 0x05])
    assert_error(receive(var s.db, var s.link, octets([0x18, 0x01]), 0), 0x18, 3, 0xFC)
    // A rule of length -1 checks only the reserved bits.
    test.assert(require_value_format(var s.db, 3, -1, 0x80, 0xFC))
    assert_bytes(value_format_octets(s.db), [0xFC])

// The Error Code a write of one octet with the reserved bit set is answered
// with under the rules of attribute 3, for a test to read.
@tier(app)
fn value_format_octets(db: GattDb) -> [u8]
    [value_format_error(db, 3, 0, octets([0x80])) as u8]
