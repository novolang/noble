// tests/host_api_tests.nv -- the unit tests of src/host_api.nv and src/noble.nv (the Host API, Layer A).
//
//   novo test --config configs/layer_a.toml tests/host_api_tests.nv
//
// The default configuration has no event queue (`event_queue` is 0, because a Host that does not use the API pays for
// none), so the cases that need one carry `@when` on that key and run under `configs/layer_a.toml`, which gives four
// events; the others (the status values, the policy defaults, the bond store) run under every configuration.
//
// A `Host` is driven through `begin`, `poll`, `result` and `next_event` over `ScriptLink`, a
// transport that plays a Controller: it answers each HCI command with the Command Complete or Command
// Status event the specification gives and, for the commands that start a procedure, with the event
// that ends it.  The packets the Host writes are kept in `sent`, and a test puts what the peer would
// send in `inbox`.  Two Hosts with a link between them (`Pair`) run a pairing end to end.

use std.test
use hci_codec
use hci_commands
use host.{ Host, host_blank, host_config }
use host_api
use le_link
use noble
use noble.{ Action, Addr, Bond, BondStore, ConnId, ConnParams, DefaultPolicy, Event, HostPolicy, IoCap, RamBonds, Request, Role, Security, Status }
use noble_config
use profile_builder
use smp

// ── The Controller ──────────────────────────────────────────────────

// A transport that plays a Controller.  `inbox` holds the packets the Host reads, `sent` the packets it
// wrote, `now` is the virtual clock, `handle` the Connection_Handle the next link gets, `peer` the
// address an LE Create Connection is answered for, `connect_status` the status of the connection
// complete event that answers it (0 for a link), and `mute` makes the Controller answer nothing.
struct ScriptLink
    var inbox: [[u8]]
    var sent: [[u8]]
    var now: Int
    var handle: Int
    var connect_status: Int
    var mute: Bool
    var commands: [Int]
    var acl: [[u8]]
    var cmdlog: [[u8]]
    var seed: Int
    var addr: Int

fn script_link() -> ScriptLink
    ScriptLink { inbox: [], sent: [], now: 0, handle: 0x40, connect_status: 0, mute: false, commands: [], acl: [], cmdlog: [], seed: 1, addr: 0xA1 }

// An HCI event packet, H4 indicator first.
fn event_packet(code: Int, params: [u8]) -> [u8]
    var pkt: [u8] = [0x04, code as u8, list.len(params) as u8]
    list.append(pkt, params)
    pkt

fn complete(opcode: Int, status: Int, rp: [u8]) -> [u8]
    var params: [u8] = [1, (opcode & 0xFF) as u8, ((opcode >>> 8) & 0xFF) as u8, status as u8]
    list.append(params, rp)
    event_packet(0x0E, params)

fn status_event(opcode: Int, status: Int) -> [u8]
    event_packet(0x0F, [status as u8, 1, (opcode & 0xFF) as u8, ((opcode >>> 8) & 0xFF) as u8])

fn le_meta(sub: Int, params: [u8]) -> [u8]
    var pkt: [u8] = [0x04]
    list.append(pkt, hci_codec.le_meta_event(sub, params))
    pkt

fn le16(v: Int) -> [u8]
    [(v & 0xFF) as u8, ((v >>> 8) & 0xFF) as u8]

fn peer_octets(n: Int) -> [u8]
    [n as u8, 0x22, 0x33, 0x44, 0x55, 0x66]

// The LE Connection Complete event of a link `handle` with `peer` in `role` (0 Central, 1 Peripheral).
fn connection_complete(status: Int, handle: Int, role: Int, peer: [u8]) -> [u8]
    connection_complete_kind(status, handle, role, 1, peer)

fn connection_complete_kind(status: Int, handle: Int, role: Int, kind: Int, peer: [u8]) -> [u8]
    var params: [u8] = [status as u8]
    list.append(params, le16(handle))
    list.push(params, role as u8)
    list.push(params, kind as u8)
    list.append(params, peer)
    list.append(params, le16(24))
    list.append(params, le16(0))
    list.append(params, le16(400))
    list.push(params, 0)
    le_meta(0x01, params)

fn disconnection_complete(handle: Int, reason: Int) -> [u8]
    var params: [u8] = [0]
    list.append(params, le16(handle))
    list.push(params, reason as u8)
    event_packet(0x05, params)

fn update_complete(handle: Int, interval: Int, latency: Int, timeout: Int) -> [u8]
    var params: [u8] = [0]
    list.append(params, le16(handle))
    list.append(params, le16(interval))
    list.append(params, le16(latency))
    list.append(params, le16(timeout))
    le_meta(0x03, params)

fn remote_request(handle: Int, lo: Int, hi: Int, latency: Int, timeout: Int) -> [u8]
    var params: [u8] = []
    list.append(params, le16(handle))
    list.append(params, le16(lo))
    list.append(params, le16(hi))
    list.append(params, le16(latency))
    list.append(params, le16(timeout))
    le_meta(0x06, params)

// The answer of the Controller to the command `opcode` with `params`.
fn answer(var l: ScriptLink, opcode: Int, params: [u8])
    if l.mute
        return
    let ok_status = 0
    if opcode == hci_commands.opcode_hci_reset() or opcode == hci_commands.opcode_hci_set_event_mask() or opcode == hci_commands.opcode_le_set_event_mask()
        list.push(l.inbox, complete(opcode, ok_status, []))
    else if opcode == hci_commands.opcode_le_read_buffer_size()
        list.push(l.inbox, complete(opcode, ok_status, [251, 0, 4]))
    else if opcode == hci_commands.opcode_le_rand()
        list.push(l.inbox, complete(opcode, ok_status, [l.seed as u8, 2, 3, 4, 5, 6, 7, 8]))
        l.seed = l.seed + 1
    else if opcode == hci_commands.opcode_read_bd_addr()
        list.push(l.inbox, complete(opcode, ok_status, [l.addr as u8, 0xA2, 0xA3, 0xA4, 0xA5, 0xA6]))
    else if opcode == hci_commands.opcode_le_create_connection()
        list.push(l.inbox, status_event(opcode, ok_status))
        // The peer address is at octets 6 to 11 of the command.
        list.push(l.inbox, connection_complete_kind(l.connect_status, l.handle, 0, params[5] as Int, params[6:12]))
    else if opcode == hci_commands.opcode_le_create_connection_cancel()
        list.push(l.inbox, complete(opcode, ok_status, []))
    else if opcode == hci_commands.opcode_le_start_encryption()
        list.push(l.inbox, status_event(opcode, ok_status))
    else if opcode == hci_commands.opcode_hci_disconnect()
        list.push(l.inbox, status_event(opcode, ok_status))
        list.push(l.inbox, disconnection_complete((params[0] as Int) | ((params[1] as Int) << 8), 0x16))
    else if opcode == hci_commands.opcode_le_connection_update()
        list.push(l.inbox, status_event(opcode, ok_status))
        let handle = (params[0] as Int) | ((params[1] as Int) << 8)
        list.push(l.inbox, update_complete(handle, (params[2] as Int) | ((params[3] as Int) << 8), (params[6] as Int) | ((params[7] as Int) << 8), (params[8] as Int) | ((params[9] as Int) << 8)))
    else
        list.push(l.inbox, complete(opcode, ok_status, []))

impl HciLink[mutate] for ScriptLink
    fn send_packet(var self, pkt: [u8]) -> Bool
        if list.len(pkt) >= 1 and (pkt[0] as Int) == 2
            list.push(self.acl, pkt[:])
            return true
        list.push(self.sent, pkt[:])
        if list.len(pkt) >= 4 and (pkt[0] as Int) == 1
            list.push(self.cmdlog, pkt[:])
            let opcode = (pkt[1] as Int) | ((pkt[2] as Int) << 8)
            list.push(self.commands, opcode)
            answer(var self, opcode, pkt[4:])
        true

    fn recv_packet(var self, timeout_ms: Int) -> ?[u8] [mutate]
        if list.len(self.inbox) == 0
            return None
        let p = self.inbox[0][:]
        self.inbox = self.inbox[1:]
        Some(p)

    fn now_ms(var self) -> Int [mutate, time]
        self.now

    fn park(var self, ms: Int) [mutate, async]
        self.now = self.now + ms

// ── Drivers ─────────────────────────────────────────────────────────

fn new_host(slots: Int) -> Host
    host_blank(host_config(slots, ['n', 'o', 'b', 'l', 'e']))

// Run the Host `n` times, advancing the clock by 10 ms each time.
fn run<P: HostPolicy[f], B: BondStore[g]>(var h: Host, var l: ScriptLink, var p: P, var b: B, n: Int) [f, g, mutate]
    for _ in 0..n
        l.now = l.now + 10
        host_api.poll(var h, var l, var p, var b, l.now)

// Start a call and run the Host until it ends; the answer is the outcome.
fn call<P: HostPolicy[f], B: BondStore[g]>(var h: Host, var l: ScriptLink, var p: P, var b: B, req: Request) -> Status [f, g, mutate]
    let st = host_api.begin(var h, req)
    if not st.is_ok()
        return st
    for _ in 0..40
        l.now = l.now + 10
        host_api.poll(var h, var l, var p, var b, l.now)
        match host_api.result(var h)
            Some(done) => return done
            None => ()
    noble.failed(noble.LAYER_LOCAL, noble.E_TIMEOUT)

// A Host that has started: the Controller answered the bring-up commands.
fn started<P: HostPolicy[f], B: BondStore[g]>(var h: Host, var l: ScriptLink, var p: P, var b: B) [f, g, mutate]
    let st = call(var h, var l, var p, var b, Request.Start)
    test.assert(st.is_ok())
    // workaround(a-variant-pattern-inside-some-does-not-match-an-optional-value-enum): the event is matched
    // in two levels, `Some(e)` and then `match e`, in every case of this file.
    match host_api.next_event(var h)
        Some(e) =>
            match e
                Ready => ()
                _ => test.fail("Ready is queued when the Host has started")
        None => test.fail("Ready is queued when the Host has started")

fn peer_addr(n: Int) -> Addr
    Addr { kind: 1, octets: [n as u8, 0x22, 0x33, 0x44, 0x55, 0x66] }

// ── Start ───────────────────────────────────────────────────────────

@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_start_brings_the_controller_up_and_queues_ready()
    var h = new_host(2)
    var l = script_link()
    var p = DefaultPolicy { placeholder: 0 }
    var b = RamBonds { rows: Vec.new() }
    test.assert(not h.api.ready)
    started(var h, var l, var p, var b)
    test.assert(h.api.ready)
    // Reset first, then the masks, the buffers, two draws of the seed and the address.
    test.assert_eq(l.commands[0], hci_commands.opcode_hci_reset())
    test.assert_eq(list.len(l.commands), 7)
    test.assert(h.security.ready)
    test.assert_eq(h.own_address[0] as Int, 0xA1)

// ── A policy that records its calls and answers as a test says ──────

struct TestPolicy
    var allow_connect: Bool
    var allow_params: Bool
    var allow_pairing: Bool
    var io: IoCap
    var passkey: Int
    var numeric: Int
    var on_disc: Int
    var on_conn: Int
    var connect_asked: Int
    var connect_role_central: Bool
    var params_asked: Int
    var pairing_asked: Int
    var pairing_level: Int
    var pairing_bonding: Bool
    var shown: Int
    var compared: Int
    var disconnected: Int
    var disc_attempts: Int
    var disc_reason: Int
    var connected: Int
    var connected_links: Int
    var done: Int
    var done_ok: Bool
    var done_bonded: Bool
    var adverts: Int
    var keep_adverts: Bool

fn test_policy() -> TestPolicy
    TestPolicy {
        allow_connect: true, allow_params: true, allow_pairing: true, io: IoCap.NoInputNoOutput, passkey: 0, numeric: 1,
        on_disc: 0, on_conn: 0, connect_asked: 0, connect_role_central: false, params_asked: 0, pairing_asked: 0,
        pairing_level: 0, pairing_bonding: false, shown: -1, compared: -1, disconnected: 0, disc_attempts: -1,
        disc_reason: 0, connected: 0, connected_links: 0, done: 0, done_ok: false, done_bonded: false, adverts: 0,
        keep_adverts: true }

fn role_is_central(r: Role) -> Bool
    match r
        Role.Central => true
        Role.Peripheral => false

fn level_number(s: Security) -> Int
    match s
        Security.Open => 1
        Security.Encrypted => 2
        Security.Authenticated => 3
        Security.SecureConnections => 4

impl HostPolicy[] for TestPolicy
    fn io_capability(self, conn: ConnId) -> IoCap
        self.io

    fn accept_pairing(var self, conn: ConnId, peer: Addr, level: Security, bonding: Bool) -> Bool
        self.pairing_asked = self.pairing_asked + 1
        self.pairing_level = level_number(level)
        self.pairing_bonding = bonding
        self.allow_pairing

    fn show_passkey(var self, conn: ConnId, passkey: Int)
        self.shown = passkey

    fn ask_passkey(var self, conn: ConnId) -> Int
        self.passkey

    fn confirm_numeric(var self, conn: ConnId, value: Int) -> Int
        self.compared = value
        self.numeric

    fn accept_params(var self, conn: ConnId, p: ConnParams) -> Bool
        self.params_asked = self.params_asked + 1
        self.allow_params

    fn accept_connect(var self, peer: Addr, role: Role) -> Bool
        self.connect_asked = self.connect_asked + 1
        self.connect_role_central = role_is_central(role)
        self.allow_connect

    fn on_advert(var self, r: noble.AdvReport) -> Bool
        self.adverts = self.adverts + 1
        self.keep_adverts

    fn on_disconnected(var self, conn: ConnId, reason: Status, role: Role, attempts: Int) -> Action
        self.disconnected = self.disconnected + 1
        self.disc_attempts = attempts
        self.disc_reason = reason.code as Int
        if self.on_disc > 0
            Action.Reconnect(self.on_disc)
        else if self.on_disc < 0
            Action.Readvertise
        else
            Action.Stay

    fn on_connected(var self, conn: ConnId, role: Role, links: Int) -> Action
        self.connected = self.connected + 1
        self.connected_links = links
        if self.on_conn == 1
            Action.Readvertise
        else if self.on_conn == 2
            Action.AdvertiseNonConnectable
        else
            Action.Stay

    fn pairing_done(var self, conn: ConnId, st: Status, level: Security, bonded: Bool)
        self.done = self.done + 1
        self.done_ok = st.is_ok()
        self.done_bonded = bonded

fn new_store() -> RamBonds
    RamBonds { rows: Vec.new() }

// The events in the queue, in order, as a count.
fn drain(var h: Host) -> Int
    var n = 0
    for _ in 0..64
        match host_api.next_event(var h)
            Some(_) => n = n + 1
            None => return n
    n

// ── A connection as the Central ─────────────────────────────────────

@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_connect_as_the_central_makes_a_link_and_queues_connected()
    var h = new_host(2)
    var l = script_link()
    var p = test_policy()
    var b = new_store()
    started(var h, var l, var p, var b)
    let st = call(var h, var l, var p, var b, Request.Connect(peer_addr(0x77), noble.conn_params_default()))
    test.assert(st.is_ok())
    test.assert_eq(p.connect_asked, 1)
    test.assert(p.connect_role_central)
    let conn = host_api.op_conn(h)
    match host_api.conn_info(h, conn)
        Some(info) =>
            test.assert(role_is_central(info.role))
            test.assert_eq(info.peer.octets[0] as Int, 0x77)
            test.assert_eq(level_number(info.level), 1)
            test.assert(not info.bonded)
        None => test.fail("the link has a name")
    test.assert_eq(host_api.link_count(h), 1)
    match host_api.next_event(var h)
        Some(e) =>
            match e
                Connected(c, role, peer, params) =>
                    test.assert_eq(c.slot as Int, conn.slot as Int)
                    test.assert(role_is_central(role))
                    test.assert_eq(peer.octets[0] as Int, 0x77)
                    test.assert_eq(params.interval_min as Int, 24)
                _ => test.fail("Connected is queued")
        None => test.fail("an event is queued")
    test.assert_eq(p.connected, 1)
    test.assert_eq(p.connected_links, 1)

@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_connect_the_policy_refuses_sends_nothing_and_answers_refused()
    var h = new_host(2)
    var l = script_link()
    var p = test_policy()
    var b = new_store()
    started(var h, var l, var p, var b)
    p.allow_connect = false
    let before = list.len(l.commands)
    let st = call(var h, var l, var p, var b, Request.Connect(peer_addr(1), noble.conn_params_default()))
    test.assert(st.is(noble.LAYER_LOCAL, noble.E_REFUSED))
    test.assert_eq(list.len(l.commands), before)
    test.assert_eq(host_api.link_count(h), 0)

// The kind of the next event: its position in the list of `Event`, or -1 for none.
fn next_kind(var h: Host) -> Int
    match host_api.next_event(var h)
        Some(e) =>
            match e
                Ready => 0
                Advert(_) => 1
                Connected(_, _, _, _) => 2
                Disconnected(_, _) => 3
                ParamsUpdated(_, _) => 4
                SecurityChanged(_, _, _) => 5
                PasskeyRequested(_) => 6
                NumericRequested(_, _) => 7
                Notification(_, _, _, _) => 8
                Written(_, _) => 9
                AttrRead(_, _, _) => 10
                AttrWrite(_, _, _, _) => 11
                Subscribed(_, _, _) => 12
                CocOpened(_, _, _) => 13
                CocData(_, _, _) => 14
                CocClosed(_, _, _) => 15
                DatabaseChanged(_) => 16
                Dropped(_) => 17
        None => -1

const EV_ADVERT = 1
const EV_CONNECTED = 2
const EV_DISCONNECTED = 3
const EV_PARAMS = 4
const EV_SECURITY = 5
const EV_PASSKEY = 6
const EV_NUMERIC = 7
const EV_COC_OPENED = 13
const EV_COC_DATA = 14
const EV_COC_CLOSED = 15
const EV_DROPPED = 17

// The LE Advertising Report event with one report from `peer`.
fn report_event(peer: Int, rssi: Int) -> [u8]
    var params: [u8] = [1, 0, 1]
    list.append(params, peer_octets(peer))
    list.push(params, 3)
    list.append(params, [2, 1, 6])
    list.push(params, rssi as u8)
    le_meta(0x02, params)

// The number of times `opcode` was sent to the Controller.
fn times_sent(l: ScriptLink, opcode: Int) -> Int
    var n = 0
    for c in l.commands
        if c == opcode
            n = n + 1
    n

// ── A connection as the Peripheral ──────────────────────────────────

@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_a_link_a_peer_made_is_kept_and_queued_as_connected_in_the_peripheral_role()
    var h = new_host(2)
    var l = script_link()
    var p = test_policy()
    var b = new_store()
    started(var h, var l, var p, var b)
    list.push(l.inbox, connection_complete(0, 0x41, 1, peer_octets(0x31)))
    run(var h, var l, var p, var b, 1)
    test.assert_eq(p.connect_asked, 1)
    test.assert(not p.connect_role_central)
    test.assert_eq(p.connected, 1)
    test.assert_eq(host_api.link_count(h), 1)
    match host_api.next_event(var h)
        Some(e) =>
            match e
                Connected(c, role, peer, params) =>
                    test.assert(not role_is_central(role))
                    test.assert_eq(peer.octets[0] as Int, 0x31)
                    match host_api.conn_info(h, c)
                        Some(info) => test.assert(not role_is_central(info.role))
                        None => test.fail("the link has a name")
                _ => test.fail("Connected is queued")
        None => test.fail("an event is queued")

@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_a_link_the_policy_does_not_accept_is_disconnected_and_makes_no_event()
    var h = new_host(2)
    var l = script_link()
    var p = test_policy()
    var b = new_store()
    started(var h, var l, var p, var b)
    p.allow_connect = false
    list.push(l.inbox, connection_complete(0, 0x41, 1, peer_octets(0x31)))
    run(var h, var l, var p, var b, 2)
    test.assert_eq(p.connect_asked, 1)
    test.assert_eq(host_api.link_count(h), 0)
    test.assert_eq(times_sent(l, hci_commands.opcode_hci_disconnect()), 1)
    // The reason of the Disconnect command is the remote user terminated one.
    let c = l.cmdlog[list.len(l.cmdlog) - 1]
    test.assert_eq(c[6] as Int, noble.HCI_REMOTE_USER_TERMINATED)
    test.assert_eq(next_kind(var h), -1)
    test.assert_eq(p.connected, 0)

@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_a_link_over_max_links_is_disconnected_for_low_resources()
    var h = new_host(2)
    var l = script_link()
    var p = test_policy()
    var b = new_store()
    started(var h, var l, var p, var b)
    host_api.host_set_max_links(var h, 1)
    list.push(l.inbox, connection_complete(0, 0x41, 1, peer_octets(1)))
    run(var h, var l, var p, var b, 1)
    list.push(l.inbox, connection_complete(0, 0x42, 1, peer_octets(2)))
    run(var h, var l, var p, var b, 2)
    test.assert_eq(host_api.link_count(h), 1)
    test.assert_eq(times_sent(l, hci_commands.opcode_hci_disconnect()), 1)
    let c = l.cmdlog[list.len(l.cmdlog) - 1]
    test.assert_eq(c[6] as Int, noble.HCI_REMOTE_LOW_RESOURCES)
    // A `connect` at the limit is refused at once.
    let st = host_api.begin(var h, Request.Connect(peer_addr(9), noble.conn_params_default()))
    test.assert(st.is(noble.LAYER_LOCAL, noble.E_NO_ROOM))

// ── Disconnect, and what the policy does next ───────────────────────

@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_disconnect_ends_the_link_and_queues_disconnected_and_a_stale_name_is_refused()
    var h = new_host(2)
    var l = script_link()
    var p = test_policy()
    var b = new_store()
    started(var h, var l, var p, var b)
    let up = call(var h, var l, var p, var b, Request.Connect(peer_addr(0x55), noble.conn_params_default()))
    test.assert(up.is_ok())
    let conn = host_api.op_conn(h)
    test.assert_eq(next_kind(var h), EV_CONNECTED)
    let st = call(var h, var l, var p, var b, Request.Disconnect(conn, noble.HCI_REMOTE_USER_TERMINATED))
    test.assert(st.is_ok())
    test.assert_eq(host_api.link_count(h), 0)
    match host_api.next_event(var h)
        Some(e) =>
            match e
                Disconnected(c, reason) =>
                    test.assert_eq(c.slot as Int, conn.slot as Int)
                    test.assert(reason.is(noble.LAYER_HCI, noble.HCI_CONNECTION_TERMINATED_BY_LOCAL_HOST))
                    test.assert_eq(reason.name(), "connection terminated by local host")
                _ => test.fail("Disconnected is queued")
        None => test.fail("an event is queued")
    test.assert_eq(p.disconnected, 1)
    test.assert_eq(p.disc_attempts, 0)
    // The name of the ended link is stale, and so is the name of a slot that holds no link.
    test.assert(host_api.begin(var h, Request.Disconnect(conn, 0x13)).is(noble.LAYER_LOCAL, noble.E_STALE))
    test.assert(host_api.conn_info(h, conn) == None)

@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_reconnect_after_a_delay_waits_for_the_time_then_connects_again_and_counts_the_attempt()
    var h = new_host(2)
    var l = script_link()
    var p = test_policy()
    var b = new_store()
    started(var h, var l, var p, var b)
    p.on_disc = 500
    let up = call(var h, var l, var p, var b, Request.Connect(peer_addr(0x55), noble.conn_params_default()))
    test.assert(up.is_ok())
    test.assert_eq(times_sent(l, hci_commands.opcode_le_create_connection()), 1)
    // The peer drops the link: the policy asks for a reconnection in 500 ms.
    list.push(l.inbox, disconnection_complete(0x40, 0x08))
    run(var h, var l, var p, var b, 1)
    test.assert_eq(p.disconnected, 1)
    test.assert_eq(p.disc_reason, 0x08)
    run(var h, var l, var p, var b, 20)
    test.assert_eq(times_sent(l, hci_commands.opcode_le_create_connection()), 1)
    run(var h, var l, var p, var b, 40)
    test.assert_eq(times_sent(l, hci_commands.opcode_le_create_connection()), 2)
    // The link is made again: the attempts count starts over.
    test.assert_eq(host_api.link_count(h), 1)
    test.assert_eq(h.api.attempts, 0)

@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_a_reconnection_that_fails_reports_a_disconnected_event_and_calls_the_hook_with_one_attempt_more()
    var h = new_host(2)
    var l = script_link()
    var p = test_policy()
    var b = new_store()
    started(var h, var l, var p, var b)
    p.on_disc = 100
    let up = call(var h, var l, var p, var b, Request.Connect(peer_addr(0x55), noble.conn_params_default()))
    test.assert(up.is_ok())
    test.assert_eq(next_kind(var h), EV_CONNECTED)
    list.push(l.inbox, disconnection_complete(0x40, 0x08))
    run(var h, var l, var p, var b, 1)
    test.assert_eq(next_kind(var h), EV_DISCONNECTED)
    // The reconnection finds nobody: LE Connection Complete with status 0x3E.
    l.connect_status = noble.HCI_CONNECTION_FAILED_TO_ESTABLISH
    for _ in 0..40
        if p.disconnected < 2
            run(var h, var l, var p, var b, 1)
    test.assert_eq(times_sent(l, hci_commands.opcode_le_create_connection()), 2)
    test.assert_eq(p.disconnected, 2)
    test.assert_eq(p.disc_attempts, 1)
    test.assert_eq(next_kind(var h), EV_DISCONNECTED)
    // The hook asks again, and the third attempt is counted two.
    for _ in 0..40
        if p.disconnected < 3
            run(var h, var l, var p, var b, 1)
    test.assert_eq(p.disc_attempts, 2)

