@test
fn test_a_read_multiple_asks_for_the_handles_it_can_carry()
    var t = table()
    test.assert_eq(gatt_client.begin_read_multiple(var t, link_a(), 0, payload([]), 0), gatt_client.ERR_ARGUMENT)
    test.assert_eq(gatt_client.begin_read_multiple(var t, link_a(), 0, payload([0x1A, 0x00, 0x26]), 3),
        gatt_client.ERR_ARGUMENT)
    test.assert_eq(gatt_client.begin_read_multiple_variable(var t, link_a(), 0, payload([0x1A, 0x00]), 2),
        gatt_client.ERR_ARGUMENT)
    // Eleven handles are 22 octets and the request is 23, the whole ATT_MTU.
    test.assert(gatt_client.begin_read_multiple(var t, link_a(), 0, payload(fill(22, 1)), 22) > 0)
    test.assert_eq(gatt_client.begin_read_multiple(var t, link_a(), 0, payload(fill(24, 1)), 24),
        gatt_client.ERR_ARGUMENT)
    test.assert_eq(gatt_client.begin_read_multiple(var t, link_b(), 0, payload([0x1A, 0x00]), 2),
        gatt_client.ERR_NO_LINK)

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_signed_write_goes_out_as_a_command_the_server_verifies()
    var t = table()
    var s = server()
    let csrk = gatt_server.example_csrk()
    gatt_server.set_client_csrk(var s.link, csrk)
    gatt_server.set_peer_csrk(var s.link, csrk)
    let handle = open_value(var s, 0xAA10)
    let signed = gatt_server.build_signed_write(s.link, handle, [0x13, 0x37], 1)
    test.assert_eq(list.len(signed), 3 + 2 + 12)
    var data: [Int] = []
    for x in signed[3:]
        list.push(data, x as Int)
    var trace = new_log()
    let ticket = gatt_client.begin_signed_write(var t, link_a(), 0, handle, payload(data), list.len(data))
    test.assert(ticket > 0)
    pump(var t, link_a(), var s, var trace)
    test.assert_eq(trace.kinds, [gatt_client.TX_COMMAND])
    test.assert_eq(trace.sent[0], ints(signed))
    test.assert_eq(served(var s, handle), [0x13, 0x37])
    test.assert(not gatt_client.is_busy(var t, link_a(), 0))

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_signed_write_carries_at_least_a_signature_and_what_the_mtu_allows()
    var t = table()
    test.assert_eq(gatt_client.begin_signed_write(var t, link_a(), 0, 0x001A, payload(fill(11, 1)), 11),
        gatt_client.ERR_ARGUMENT)
    test.assert(gatt_client.begin_signed_write(var t, link_a(), 0, 0x001A, payload(fill(12, 1)), 12) > 0)
    test.assert_eq(gatt_client.begin_signed_write(var t, link_b(), 0, 0x001A, payload(fill(12, 1)), 12),
        gatt_client.ERR_NO_LINK)
    var u = table()
    test.assert_eq(gatt_client.begin_signed_write(var u, link_a(), 0, 0x001A, payload(fill(21, 1)), 21),
        gatt_client.ERR_ARGUMENT)

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_value_of_no_octets_is_written()
    var t = table()
    var s = server()
    var trace = new_log()
    let handle = open_value(var s, 0xAA10)
    let _ = gatt_client.begin_write(var t, link_a(), 0, handle, payload([]), 0)
    pump(var t, link_a(), var s, var trace)
    test.assert_eq(trace.sent[0], [0x12, handle & 0xFF, handle >>> 8])
    test.assert_eq(trace.statuses, [0])
    test.assert_eq(served(var s, handle), [])

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_write_command_of_no_octets_is_sent()
    var t = table()
    var s = server()
    var trace = new_log()
    let _ = gatt_client.begin_write_command(var t, link_a(), 0, 0x0022, payload([]), 0)
    pump(var t, link_a(), var s, var trace)
    test.assert_eq(trace.sent[0], [0x52, 0x22, 0x00])
    test.assert_eq(trace.kinds, [gatt_client.TX_COMMAND])

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_long_write_from_an_offset_carries_it_in_every_part()
    var t = table()
    var s = server()
    let handle = open_value(var s, 0xAA10)
    var trace = new_log()
    let _ = gatt_client.begin_write_long_at(var t, link_a(), 0, handle, 5, payload(ramp(30)), 30)
    pump(var t, link_a(), var s, var trace)
    // Parts of 18 and 12 octets from offset 5, then the Execute Write Request.
    test.assert_eq(trace.sent[0][0:5], [0x16, handle & 0xFF, handle >>> 8, 5, 0])
    test.assert_eq(trace.sent[1][0:5], [0x16, handle & 0xFF, handle >>> 8, 23, 0])
    test.assert_eq(trace.sent[2], [0x18, 0x01])
    test.assert_eq(list.len(trace.statuses), 1)

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_reliable_write_from_an_offset_checks_the_echo_against_it()
    var t = table()
    var s = server()
    let handle = open_value(var s, 0xAA10)
    var trace = new_log()
    let _ = gatt_client.begin_reliable_write_at(var t, link_a(), 0, handle, 7, payload(ramp(10)), 10)
    pump(var t, link_a(), var s, var trace)
    test.assert_eq(trace.sent[0][0:5], [0x16, handle & 0xFF, handle >>> 8, 7, 0])
    // The server echoed offset 7, and the part matched, so the Execute Write Request went out.
    test.assert_eq(trace.sent[1], [0x18, 0x01])
    test.assert_eq(gatt_client.begin_write_long_at(var t, link_a(), 0, handle, 0x10000, payload(ramp(10)), 10),
        gatt_client.ERR_ARGUMENT)
    test.assert_eq(gatt_client.begin_reliable_write_at(var t, link_a(), 0, handle, -1, payload(ramp(10)), 10),
        gatt_client.ERR_ARGUMENT)

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_long_or_reliable_write_of_no_octets_is_not_queued()
    var t = table()
    test.assert_eq(gatt_client.begin_write_long(var t, link_a(), 0, 0x001A, payload([]), 0),
        gatt_client.ERR_ARGUMENT)
    test.assert_eq(gatt_client.begin_reliable_write(var t, link_a(), 0, 0x001A, payload([]), 0),
        gatt_client.ERR_ARGUMENT)
    test.assert(not gatt_client.is_busy(var t, link_a(), 0))

// The tests above need the client limits of a device or more (two links, two bearers, a queue of four, a value of 256
// octets and the ATT_MTU 247); this one holds at every configuration, the smallest included, where a table of an absent
// feature keeps one record of each kind.
@test
fn test_the_table_is_sized_by_the_configuration_and_serves_a_link_at_every_size()
    var t = table()
    test.assert_eq(gatt_client.links(),
        (if noble.CONFIG.MAX_CLIENT_LINKS > 1 then noble.CONFIG.MAX_CLIENT_LINKS else 1))
    test.assert_eq(gatt_client.bearers(),
        (if noble.CONFIG.CLIENT_BEARERS > 1 then noble.CONFIG.CLIENT_BEARERS else 1))
    test.assert_eq(gatt_client.cache(),
        (if noble.CONFIG.CLIENT_CACHE_RECORDS > 1 then noble.CONFIG.CLIENT_CACHE_RECORDS else 1))
    test.assert_eq(gatt_client.queue(), (if noble.CONFIG.CLIENT_QUEUE > 1 then noble.CONFIG.CLIENT_QUEUE else 1))
    test.assert_eq(gatt_client.value_octets(),
        (if noble.CONFIG.CLIENT_VALUE_BYTES > 1 then noble.CONFIG.CLIENT_VALUE_BYTES else 1))
    test.assert_eq(gatt_client.slot_of(var t, link_a()), 0)
