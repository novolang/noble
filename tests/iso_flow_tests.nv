// tests/iso_flow_tests.nv — the unit tests of src/iso_flow.nv.
//
//   novo test tests/iso_flow_tests.nv

use std.test
use hci_codec
use isoal
use noble.CONFIG
use iso_flow.{ IsoCredits, iso_credits_close, iso_credits_completed, iso_credits_configure, iso_credits_new, iso_credits_on_completed, iso_credits_open, iso_credits_ready, iso_credits_take, iso_in_flight, iso_may_send, iso_next_sequence, iso_packet_length, iso_packets_for_sdu, sizes }
use iso_flow

// The pool holds `MAX_CIS + MAX_BIS` streams, so a test that opens `k` streams carries @when on `MAX_CIS + MAX_BIS >= k` and runs in every
// configuration whose pool is that large.  A pool of no stream (both keys 0) refuses every open, which the first test and the
// full-table test check.
@tier(app)
fn streams() -> Int
    noble.CONFIG.MAX_CIS + noble.CONFIG.MAX_BIS

// A configured pool of 3 buffers of 255 octets.
@tier(app)
fn pool() -> IsoCredits
    var c = iso_credits_new()
    test.assert(iso_credits_configure(var c, sizes(255, 3)))
    c

@test
@satisfies("REQ-BLE-ISO-005")
fn test_a_new_pool_is_empty_and_unconfigured()
    var c = iso_credits_new()
    // The tables hold at least one record, whatever the keys are; the pool holds as many streams as the keys add up to.
    let capacity = if streams() > 1
        streams()
    else
        1
    test.assert_eq(c.used.capacity(), capacity)
    test.assert_eq(c.handles.capacity(), capacity)
    test.assert_eq(c.in_flight.capacity(), capacity)
    test.assert_eq(c.sequence.capacity(), capacity)
    test.assert_eq(c.used.len(), streams())
    test.assert(not iso_credits_ready(var c))
    test.assert_eq(iso_packet_length(var c), 0)
    // Nothing is sent before the sizes are known; a pool of no stream refuses the open.
    test.assert_eq(iso_credits_open(var c, 0x0040), streams() >= 1)
    test.assert(not iso_credits_take(var c, 0x0040, 1))
    test.assert(not iso_may_send(var c, 0x0040))

@test
@satisfies("REQ-BLE-ISO-005")
fn test_the_pool_takes_the_iso_half_of_read_buffer_size_v2()
    var c = iso_credits_new()
    test.assert(iso_credits_configure(var c, sizes(255, 3)))
    test.assert(iso_credits_ready(var c))
    test.assert_eq(iso_packet_length(var c), 255)
    test.assert_eq(c.total as Int, 3)
    test.assert_eq(c.free as Int, 3)
    // The bounds: one octet and one buffer, the 14-bit length and 255 buffers.
    test.assert(iso_credits_configure(var c, sizes(1, 1)))
    test.assert(iso_credits_configure(var c, sizes(0x3FFF, 255)))

@test
@satisfies("REQ-BLE-ISO-005")
fn test_a_controller_without_iso_buffers_leaves_the_pool_unconfigured()
    var c = pool()
    // ISO_Data_Packet_Length 0: no dedicated ISO buffer exists.
    test.assert(not iso_credits_configure(var c, sizes(0, 3)))
    test.assert(not iso_credits_ready(var c))
    test.assert_eq(c.free as Int, 0)
    test.assert(not iso_credits_configure(var c, sizes(255, 0)))
    test.assert(not iso_credits_configure(var c, sizes(0x4000, 3)))
    test.assert(not iso_credits_configure(var c, sizes(255, 256)))
    test.assert(not iso_credits_ready(var c))
    test.assert_eq(iso_credits_open(var c, 0x0040), streams() >= 1)
    test.assert(not iso_credits_take(var c, 0x0040, 1))

@test
@satisfies("REQ-BLE-ISO-005")
fn test_open_refuses_a_handle_out_of_range_a_duplicate_and_a_full_table()
    var c = pool()
    test.assert(not iso_credits_open(var c, -1))
    test.assert(not iso_credits_open(var c, 0x0F00))
    test.assert_eq(iso_credits_open(var c, 0x0EFF), streams() >= 1)
    test.assert(not iso_credits_open(var c, 0x0EFF))
    for i in 1..streams()
        test.assert(iso_credits_open(var c, 0x0040 + i))
    test.assert(not iso_credits_open(var c, 0x0100))

@when(noble.CONFIG.MAX_CIS + noble.CONFIG.MAX_BIS >= 2)
@test
@satisfies("REQ-BLE-ISO-005")
fn test_take_gives_a_credit_per_buffer_and_refuses_when_none_is_free()
    var c = pool()
    test.assert(iso_credits_open(var c, 0x0040))
    test.assert(iso_credits_open(var c, 0x0041))
    test.assert(iso_credits_take(var c, 0x0040, 2))
    test.assert_eq(c.free as Int, 1)
    test.assert_eq(iso_in_flight(var c, 0x0040), 2)
    // All or none: two packets do not fit one free buffer.
    test.assert(not iso_credits_take(var c, 0x0041, 2))
    test.assert_eq(c.free as Int, 1)
    test.assert_eq(iso_in_flight(var c, 0x0041), 0)
    test.assert(iso_may_send(var c, 0x0041))
    test.assert(iso_credits_take(var c, 0x0041, 1))
    test.assert_eq(c.free as Int, 0)
    test.assert(not iso_may_send(var c, 0x0040))
    test.assert(not iso_credits_take(var c, 0x0040, 1))

@when(noble.CONFIG.MAX_CIS + noble.CONFIG.MAX_BIS >= 1)
@test
@satisfies("REQ-BLE-ISO-005")
fn test_take_refuses_a_stream_the_pool_does_not_hold_and_less_than_one_packet()
    var c = pool()
    test.assert(not iso_credits_take(var c, 0x0040, 1))
    test.assert(not iso_may_send(var c, 0x0040))
    test.assert(iso_credits_open(var c, 0x0040))
    test.assert(not iso_credits_take(var c, 0x0040, 0))
    test.assert(not iso_credits_take(var c, 0x0040, -1))
    test.assert_eq(c.free as Int, 3)

@when(noble.CONFIG.MAX_CIS + noble.CONFIG.MAX_BIS >= 2)
@test
@satisfies("REQ-BLE-ISO-005")
fn test_number_of_completed_packets_returns_credits_to_the_stream_it_names()
    var c = pool()
    test.assert(iso_credits_open(var c, 0x0040))
    test.assert(iso_credits_open(var c, 0x0041))
    test.assert(iso_credits_take(var c, 0x0040, 2))
    test.assert(iso_credits_take(var c, 0x0041, 1))
    test.assert_eq(iso_credits_completed(var c, 0x0040, 1), 1)
    test.assert_eq(c.free as Int, 1)
    test.assert_eq(iso_in_flight(var c, 0x0040), 1)
    test.assert_eq(iso_in_flight(var c, 0x0041), 1)
    // The pairs of an event, in order, ACL handles among them.
    let pairs = [
        hci_codec.CompletedPackets { connection_handle: 0x0001, count: 3 },
        hci_codec.CompletedPackets { connection_handle: 0x0040, count: 1 },
        hci_codec.CompletedPackets { connection_handle: 0x0041, count: 1 }]
    test.assert_eq(iso_credits_on_completed(var c, pairs), 2)
    test.assert_eq(c.free as Int, 3)
    test.assert_eq(iso_in_flight(var c, 0x0040), 0)

@when(noble.CONFIG.MAX_CIS + noble.CONFIG.MAX_BIS >= 1)
@test
@satisfies("REQ-BLE-ISO-005")
fn test_completed_packets_never_return_more_than_the_stream_took()
    var c = pool()
    test.assert(iso_credits_open(var c, 0x0040))
    test.assert(iso_credits_take(var c, 0x0040, 1))
    // The Controller reports 5 for 1 in flight.
    test.assert_eq(iso_credits_completed(var c, 0x0040, 5), 1)
    test.assert_eq(c.free as Int, 3)
    test.assert_eq(iso_credits_completed(var c, 0x0040, 1), 0)
    test.assert_eq(c.free as Int, 3)
    // An unknown handle, and a count of none.
    test.assert_eq(iso_credits_completed(var c, 0x0099, 1), 0)
    test.assert(iso_credits_take(var c, 0x0040, 1))
    test.assert_eq(iso_credits_completed(var c, 0x0040, 0), 0)
    test.assert_eq(iso_credits_completed(var c, 0x0040, -1), 0)
    test.assert_eq(c.free as Int, 2)

@when(noble.CONFIG.MAX_CIS + noble.CONFIG.MAX_BIS >= 2)
@test
@satisfies("REQ-BLE-ISO-005")
fn test_a_stream_that_ends_gives_its_buffers_back()
    var c = pool()
    test.assert(iso_credits_open(var c, 0x0040))
    test.assert(iso_credits_open(var c, 0x0041))
    test.assert(iso_credits_take(var c, 0x0040, 2))
    test.assert(iso_credits_take(var c, 0x0041, 1))
    test.assert_eq(c.free as Int, 0)
    test.assert_eq(iso_credits_close(var c, 0x0040), 2)
    test.assert_eq(c.free as Int, 2)
    test.assert_eq(iso_in_flight(var c, 0x0040), -1)
    // Closed twice, or never opened: nothing returns.
    test.assert_eq(iso_credits_close(var c, 0x0040), 0)
    test.assert_eq(iso_credits_close(var c, 0x0099), 0)
    test.assert_eq(c.free as Int, 2)
    // The slot and the handle are free to be used again, with no history.
    test.assert(iso_credits_open(var c, 0x0040))
    test.assert_eq(iso_in_flight(var c, 0x0040), 0)
    // A completed-packets event for the closed stream returns nothing more.
    test.assert_eq(iso_credits_completed(var c, 0x0042, 1), 0)

@when(noble.CONFIG.MAX_CIS + noble.CONFIG.MAX_BIS >= 1)
@test
@satisfies("REQ-BLE-ISO-005")
fn test_configuring_again_starts_with_every_buffer_free()
    var c = pool()
    test.assert(iso_credits_open(var c, 0x0040))
    test.assert(iso_credits_take(var c, 0x0040, 3))
    test.assert(iso_credits_configure(var c, sizes(100, 7)))
    test.assert_eq(c.free as Int, 7)
    test.assert_eq(iso_in_flight(var c, 0x0040), 0)

@when(noble.CONFIG.MAX_CIS + noble.CONFIG.MAX_BIS >= 2)
@test
@satisfies("REQ-BLE-ISO-005")
fn test_the_sequence_number_counts_sdus_and_wraps_at_16_bits()
    var c = pool()
    test.assert(iso_credits_open(var c, 0x0040))
    test.assert(iso_credits_open(var c, 0x0041))
    test.assert_eq(iso_next_sequence(var c, 0x0040), 0)
    test.assert_eq(iso_next_sequence(var c, 0x0040), 1)
    test.assert_eq(iso_next_sequence(var c, 0x0041), 0)
    test.assert_eq(iso_next_sequence(var c, 0x0099), -1)
    for _ in 0..0xFFFD
        let _s = iso_next_sequence(var c, 0x0040)
    test.assert_eq(iso_next_sequence(var c, 0x0040), 0xFFFF)
    test.assert_eq(iso_next_sequence(var c, 0x0040), 0)
    // A stream opened again starts at 0.
    test.assert_eq(iso_credits_close(var c, 0x0040), 0)
    test.assert(iso_credits_open(var c, 0x0040))
    test.assert_eq(iso_next_sequence(var c, 0x0040), 0)

// The packet count agrees with the cut `isoal_fragments` makes.
@test
@satisfies("REQ-BLE-ISO-005")
fn test_packets_for_sdu_counts_the_fragments()
    // 255 octets: an SDU of up to 251 octets fits one packet with its header.
    test.assert_eq(iso_packets_for_sdu(0, 255, false), 1)
    test.assert_eq(iso_packets_for_sdu(251, 255, false), 1)
    test.assert_eq(iso_packets_for_sdu(252, 255, false), 2)
    // The first fragment holds 251, each later one 255.
    test.assert_eq(iso_packets_for_sdu(251 + 255, 255, false), 2)
    test.assert_eq(iso_packets_for_sdu(251 + 256, 255, false), 3)
    // A Time_Stamp widens the header to 8 octets.
    test.assert_eq(iso_packets_for_sdu(247, 255, true), 1)
    test.assert_eq(iso_packets_for_sdu(248, 255, true), 2)
    // The largest SDU.
    test.assert_eq(iso_packets_for_sdu(4095, 255, false), 1 + (4095 - 251 + 254) / 255)
    // Refusals: no room beside the header, an SDU too long, a length too long.
    test.assert_eq(iso_packets_for_sdu(1, 4, false), 0)
    test.assert_eq(iso_packets_for_sdu(1, 8, true), 0)
    test.assert_eq(iso_packets_for_sdu(4096, 255, false), 0)
    test.assert_eq(iso_packets_for_sdu(-1, 255, false), 0)
    test.assert_eq(iso_packets_for_sdu(1, 0x4000, false), 0)

@test
@satisfies("REQ-BLE-ISO-005")
fn test_packets_for_sdu_is_the_length_of_the_cut_isoal_makes()
    for max in [5, 9, 12, 27, 251, 255]
        for n in [0, 1, 4, 5, 11, 12, 13, 26, 27, 28, 100, 251, 252, 255, 256, 510, 511, 1000, 4095]
            for ts in [false, true]
                let stamp = if ts
                    Some(7)
                else
                    None
                match isoal.isoal_fragments(0x0040, 1, stamp, isoal.sdu_of(n), max)
                    None          => test.assert_eq(iso_packets_for_sdu(n, max, ts), 0)
                    Some(packets) => test.assert_eq(iso_packets_for_sdu(n, max, ts), list.len(packets))

@when(noble.CONFIG.MAX_CIS + noble.CONFIG.MAX_BIS >= 2)
@test
fn test_a_stream_is_found_by_its_handle_in_the_pool()
    var c = pool()
    test.assert_eq(iso_flow.iso_stream_slot(var c, 0x0040), -1)
    test.assert(iso_flow.iso_credits_open(var c, 0x0040))
    test.assert(iso_flow.iso_credits_open(var c, 0x0041))
    test.assert_eq(iso_flow.iso_stream_slot(var c, 0x0040), 0)
    test.assert_eq(iso_flow.iso_stream_slot(var c, 0x0041), 1)
    test.assert_eq(iso_flow.iso_stream_slot(var c, 0x0042), -1)
