@test
fn test_a_value_longer_than_the_buffer_is_cut_and_says_so()
    var t = table()
    var s = server()
    test.assert_eq(run(var t, link_a(), var s, gatt_client.begin_exchange_mtu(var t, link_a(), 0)), 0)
    let handle = open_value(var s, 0xAA10)
    test.assert(gatt_server.set_value(var s.db, 0, gatt_server.octets(ramp(300))))
    var trace = new_log()
    let _ = gatt_client.begin_read_long(var t, link_a(), 0, handle)
    pump(var t, link_a(), var s, var trace)
    test.assert_eq(trace.statuses, [gatt_client.STATUS_TRUNCATED])
    test.assert_eq(list.len(trace.values[0]), gatt_client.value_octets())
    test.assert_eq(trace.values[0], ramp(gatt_client.value_octets()))
    test.assert(gatt_client.is_local(gatt_client.STATUS_TRUNCATED))

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_read_blob_the_peer_refuses_at_the_end_ends_the_value()
    var t = table()
    var trace = new_log()
    let _ = gatt_client.begin_read_long(var t, link_a(), 0, 0x0020)
    var out: gatt_client.ClientPdu = Vec.new()
    test.assert_eq(gatt_client.take_tx(var t, link_a(), 0, 0, var out), gatt_client.TX_REQUEST)
    var full: [u8] = [0x0B]
    for x in ramp(22)
        list.push(full, x as u8)
    deliver(var t, link_a(), 0, full, var trace)
    test.assert_eq(gatt_client.take_tx(var t, link_a(), 0, 0, var out), gatt_client.TX_REQUEST)
    test.assert_eq(out[0] as Int, 0x0C)
    deliver(var t, link_a(), 0, [0x01, 0x0C, 0x20, 0x00, 0x07], var trace)
    test.assert_eq(trace.statuses, [0])
    test.assert_eq(trace.values[0], ramp(22))

