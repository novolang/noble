// encrypted_data.nv — Encrypted Advertising Data: the Encrypted Data
// AD type (0x31) and the Encrypted Data Key Material characteristic (0x2B88).
//
// A Broadcaster may wrap its advertising data in an Encrypted Data structure
// ([Core 6.3] Vol 1 Part A, Section 5.4.6, and Vol 3 Part C, Section 10.10).
// The structure is protected with AES-CCM under a session key and an
// initialization vector, the Key Material, that a scanning device reads from
// the Encrypted Data Key Material characteristic ([Vol 3] Part C, Section
// 12.6) or receives out of band.  The structure's data is
//
//   Randomizer   5 octets, new whenever the nonce must change (with every
//                private address change)
//   ciphertext   the encrypted AD structures
//   MIC          4 octets
//
// The CCM parameters are those of RFC 3610 with a 2-octet length field and a
// 4-octet MIC (the same as the Link Layer's, [Vol 6] Part E, Section 2): the
// nonce is the Randomizer followed by the 8 octets of the IV, 13 octets, and the
// additional authenticated data is the single octet 0xEA.  The session key and
// the IV are used in the order of the octets of the Key Material value.
//
// The Key Material is a 16-octet session key and an 8-octet IV (Table 12.10).
// The characteristic is readable only on an authenticated link and by an
// authorized client, is not writable, and is indicated when the server updates
// the material and the client has subscribed.
//
// Mechanism and policy.  What the specification fixes belongs here: the
// structure, the cipher, the order of the octets, the permissions and the
// indication.  What it leaves to a product is asked of an `EadPolicy`: which
// key material a scanner holds for an advertiser, which material and which
// Randomizer the device itself advertises with, and which peers are authorized
// to read the material.  The GATT server has no authorization hook (an
// attribute that needs authorization is refused to every client), so the
// characteristic requires authentication in the attribute table and keeps the
// value per connection: `serve_key_material` stores the material the policy
// releases to a peer, and a peer the policy does not release it to reads a
// zero-length value, which is no Key Material.
//
// The Core Specification Supplement, Part A, Section 1.23.3, defines the data
// type; its text is not part of the Core text this module was checked against,
// so the tests check the cipher against RFC 3610 values computed with an
// independent AES-CCM implementation.
//
// Satisfies: REQ-BLE-GAP-026.

use gatt_server
use links
use profile_builder
use prims.aes128

// The Encrypted Data AD type and the Encrypted Data Key Material characteristic.
const AD_TYPE_ENCRYPTED_DATA = 0x31
const UUID_ENCRYPTED_DATA_KEY_MATERIAL = 0x2B88

const RANDOMIZER_OCTETS = 5
const MIC_OCTETS = 4
const KEY_OCTETS = 16
const IV_OCTETS = 8
// The octets of the Encrypted Data Key Material characteristic: a 16-octet session key and an 8-octet initialization
// vector.
pub const KEY_MATERIAL_OCTETS = 24
const NONCE_OCTETS = 13

// The additional authenticated data of an Encrypted Data structure.
const ADDITIONAL_DATA = 0xEA

// The most significant bit of the Randomizer, the direction bit of the nonce.
const DIRECTION_BIT = 0x80

// The octets that frame an Encrypted Data structure inside its AD structure:
// the Randomizer and the MIC.
const OVERHEAD_OCTETS = 9

// The most octets of AD structures one Encrypted Data structure holds: its
// Length octet covers the type, the Randomizer, the data and the MIC.
const PLAIN_MAX = 245

// The session key and the IV.
struct KeyMaterial
    key: [u8]
    iv: [u8]

// The Key Material of the 24 octets of a characteristic value; none for another length.
pub @tier(app)
fn key_material_parse(value: [u8]) -> ?KeyMaterial
    if list.len(value) != KEY_MATERIAL_OCTETS
        return None
    Some(KeyMaterial { key: value[0:KEY_OCTETS], iv: value[KEY_OCTETS:KEY_MATERIAL_OCTETS] })

// The characteristic value of `km`: the session key, then the IV.
@tier(app)
fn key_material_value(km: KeyMaterial) -> [u8]
    join(km.key, km.iv)

// Whether `km` has a 16-octet key and an 8-octet IV.
@tier(app)
fn key_material_valid(km: KeyMaterial) -> Bool
    list.len(km.key) == KEY_OCTETS and list.len(km.iv) == IV_OCTETS

// ── AES-CCM (RFC 3610, L = 2, M = 4) ────────────────────────────────

// `a` followed by `b`, as a new list.
@tier(app)
fn join(a: [u8], b: [u8]) -> [u8]
    var out = a[:]
    for x in b
        list.push(out, x)
    out

@tier(app)
fn xor_into(a: [u8], b: [u8]) -> [u8]
    var out: [u8] = []
    for i in 0..list.len(a)
        list.push(out, (a[i] as Int ^ b[i] as Int) as u8)
    out

// `v` followed by zeros up to a multiple of 16 octets.
@tier(app)
fn pad16(v: [u8]) -> [u8]
    var out = v[:]
    while list.len(out) % 16 != 0
        list.push(out, 0)
    out

// Block `A` of counter `i`: the flags (L - 1), the nonce and the counter.
@tier(app)
fn ctr_block(nonce: [u8], i: Int) -> [u8]
    var out: [u8] = join([0x01], nonce)
    list.push(out, ((i >>> 8) & 0xFF) as u8)
    list.push(out, (i & 0xFF) as u8)
    out

// The CBC-MAC of RFC 3610 over the additional data octet and `plain`, cut to the MIC.
@tier(app)
fn cbc_mac(key: [u8], nonce: [u8], aad: [u8], plain: [u8]) -> [u8]
    let n = list.len(plain)
    // B0: the flags (Adata, M = 4, L = 2), the nonce and the message length.
    var b0: [u8] = [0x49]
    b0 = join(b0, nonce)
    list.push(b0, ((n >>> 8) & 0xFF) as u8)
    list.push(b0, (n & 0xFF) as u8)
    // B1...: the length of the additional data and the data, then the message.
    var rest: [u8] = [((list.len(aad) >>> 8) & 0xFF) as u8, (list.len(aad) & 0xFF) as u8]
    rest = join(rest, aad)
    rest = pad16(rest)
    rest = join(rest, pad16(plain))
    var x = aes128.aes128_encrypt(b0, key)
    var at = 0
    while at < list.len(rest)
        x = aes128.aes128_encrypt(xor_into(x, rest[at:at + 16]), key)
        at = at + 16
    x[0:MIC_OCTETS]

// The counter-mode transform of `data` from counter 1 (encrypts and decrypts alike).
@tier(app)
fn ctr_apply(key: [u8], nonce: [u8], data: [u8]) -> [u8]
    var out: [u8] = []
    var at = 0
    var counter = 1
    while at < list.len(data)
        let s = aes128.aes128_encrypt(ctr_block(nonce, counter), key)
        let stop = if at + 16 < list.len(data)
            at + 16
        else
            list.len(data)
        for i in at..stop
            list.push(out, (data[i] as Int ^ s[i - at] as Int) as u8)
        at = at + 16
        counter = counter + 1
    out

// The ciphertext of `plain` followed by its MIC.
@tier(app)
fn ccm_seal(key: [u8], nonce: [u8], aad: [u8], plain: [u8]) -> [u8]
    let mac = cbc_mac(key, nonce, aad, plain)
    let s0 = aes128.aes128_encrypt(ctr_block(nonce, 0), key)
    join(ctr_apply(key, nonce, plain), xor_into(mac, s0[0:MIC_OCTETS]))

// The plaintext of `sealed` (ciphertext then MIC); none when the MIC does not match.
@tier(app)
fn ccm_open(key: [u8], nonce: [u8], aad: [u8], sealed: [u8]) -> ?[u8]
    let n = list.len(sealed) - MIC_OCTETS
    if n < 0
        return None
    let plain = ctr_apply(key, nonce, sealed[0:n])
    let s0 = aes128.aes128_encrypt(ctr_block(nonce, 0), key)
    let want = xor_into(cbc_mac(key, nonce, aad, plain), s0[0:MIC_OCTETS])
    // The comparison visits every octet, so its time does not depend on where they differ.
    var diff = 0
    for i in 0..MIC_OCTETS
        diff = diff | (want[i] as Int ^ sealed[n + i] as Int)
    if diff != 0
        return None
    Some(plain)

// ── The Encrypted Data structure ────────────────────────────────────

@tier(app)
fn nonce_of(randomizer: [u8], iv: [u8]) -> [u8]
    join(randomizer, iv)

// The data of an Encrypted Data structure (Randomizer, ciphertext, MIC) that
// carries `plain` under `km`.  The most significant bit of the Randomizer is
// the direction bit of the CCM nonce and is set, so the octet sent is the one
// the nonce holds.  None when the material or the Randomizer has the wrong
// size or `plain` is longer than `PLAIN_MAX`.
pub @tier(app)
fn encrypt_data(km: KeyMaterial, randomizer: [u8], plain: [u8]) -> ?[u8]
    if not key_material_valid(km) or list.len(randomizer) != RANDOMIZER_OCTETS or list.len(plain) > PLAIN_MAX
        return None
    var r = randomizer[:]
    r[RANDOMIZER_OCTETS - 1] = (r[RANDOMIZER_OCTETS - 1] as Int | DIRECTION_BIT) as u8
    Some(join(r, ccm_seal(km.key, nonce_of(r, km.iv), [ADDITIONAL_DATA as u8], plain)))

// The AD structure (Length, type 0x31, data) that carries `ad`, the AD
// structures to hide, under `km` with `randomizer` (`encrypt_data`).
@tier(app)
fn encrypt_ad(km: KeyMaterial, randomizer: [u8], ad: [u8]) -> ?[u8]
    match encrypt_data(km, randomizer, ad)
        None       => None
        Some(data) => Some(join([(1 + list.len(data)) as u8, AD_TYPE_ENCRYPTED_DATA as u8], data))

// The Randomizer of the `n`th encryption under one key: `n` in five octets,
// least significant first, so no two encryptions share a nonce.
pub @tier(app)
fn counter_randomizer(n: Int) -> [u8]
    var out: [u8] = []
    for i in 0..RANDOMIZER_OCTETS
        list.push(out, ((n >>> (8 * i)) & 0xFF) as u8)
    out

// The AD structures inside the data of an Encrypted Data structure (the octets
// after the type): none when the data is too short or the MIC does not match.
pub @tier(app)
fn decrypt_data(km: KeyMaterial, data: [u8]) -> ?[u8]
    if not key_material_valid(km) or list.len(data) < OVERHEAD_OCTETS
        return None
    ccm_open(km.key,
        nonce_of(data[0:RANDOMIZER_OCTETS], km.iv),
        [ADDITIONAL_DATA as u8],
        data[RANDOMIZER_OCTETS:list.len(data)])

// The data of every Encrypted Data structure in `ad`, in order.  A structure
// that runs past the end of `ad` ends the scan.
@tier(app)
fn encrypted_structures(ad: [u8]) -> [[u8]]
    var out: [[u8]] = []
    var at = 0
    while at < list.len(ad)
        let len = ad[at] as Int
        if len == 0 or at + 1 + len > list.len(ad)
            return out
        if len >= 2 and (ad[at + 1] as Int) == AD_TYPE_ENCRYPTED_DATA
            list.push(out, ad[at + 2:at + 1 + len])
        at = at + 1 + len
    out

// The decrypted AD structures of the first Encrypted Data structure in `ad`
// that `km` authenticates; none when there is none.
@tier(app)
fn decrypt_ad(km: KeyMaterial, ad: [u8]) -> ?[u8]
    for data in encrypted_structures(ad)
        match decrypt_data(km, data)
            Some(plain) =>
                return Some(plain)
            None        => ()
    None

// ── The product's say ───────────────────────────────────────────────

// The questions a product answers.
trait EadPolicy[e]
    // The Key Material a scanner holds for the advertiser at `address` (six
    // octets), none when it holds none.
    fn key_for_advertiser(var self, address: [u8]) -> ?KeyMaterial [e]
    // The Key Material the device advertises with, none to advertise in the clear.
    fn advertising_key(var self) -> ?KeyMaterial [e]
    // A Randomizer of five octets for the next advertising data.  It must not
    // repeat while the key and the IV stay the same.
    fn next_randomizer(var self) -> [u8] [e]
    // The Key Material to release to `peer`, none when the peer is not authorized.
    fn release_key(var self, peer: links.LinkId) -> ?KeyMaterial [e]

// A policy that holds no key, advertises in the clear and releases nothing.
struct NoKeys
    placeholder: Int

@tier(app)
fn no_keys() -> NoKeys
    NoKeys { placeholder: 0 }

impl EadPolicy[] for NoKeys
    @tier(app)
    fn key_for_advertiser(var self, address: [u8]) -> ?KeyMaterial
        let _ = address
        None

    @tier(app)
    fn advertising_key(var self) -> ?KeyMaterial
        None

    @tier(app)
    fn next_randomizer(var self) -> [u8]
        [0, 0, 0, 0, 0]

    @tier(app)
    fn release_key(var self, peer: links.LinkId) -> ?KeyMaterial
        let _ = peer
        None

// The advertising data to send for `ad`: the Encrypted Data structure when the
// policy has key material, `ad` itself when it has none; none when `ad` is too
// long to encrypt or the policy's material or Randomizer is malformed.
@tier(app)
fn protect_advertising<P: EadPolicy[e]>(var policy: P, ad: [u8]) -> ?[u8] [e, mutate]
    match policy.advertising_key()
        None     => Some(ad[:])
        Some(km) => encrypt_ad(km, policy.next_randomizer(), ad)

// The AD structures of a received report from the advertiser at `address`: the
// decrypted ones when the report holds an Encrypted Data structure the policy's
// key for the advertiser authenticates, none when it holds one and no key opens
// it, `ad` itself when it holds none.
@tier(app)
fn reveal_advertising<P: EadPolicy[e]>(var policy: P, address: [u8], ad: [u8]) -> ?[u8] [e, mutate]
    if list.len(encrypted_structures(ad)) == 0
        return Some(ad[:])
    match policy.key_for_advertiser(address)
        None     => None
        Some(km) => decrypt_ad(km, ad)

// ── The characteristic ──────────────────────────────────────────────

@value
struct KeyMaterialHandles
    service: u16
    value: u16
    cccd: u16

// Add a service of `service_uuid` (16-bit, as an Int) with an Encrypted Data
// Key Material characteristic after the last attribute of `db`: readable and
// indicated on an authenticated link, not writable, the value per connection
// (`serve_key_material`).  A service of another specification that has the
// characteristic (Section 12.6) adds it to its own service with
// `add_key_material_characteristic`.
@tier(app)
fn add_key_material_service(var db: GattDb,
                            service_uuid: Int) -> Result<KeyMaterialHandles, profile_builder.ProfileError>
    let service = profile_builder.start_service(var db, gatt_server.le16(service_uuid))!
    let c = add_key_material_characteristic(var db)!
    Ok(KeyMaterialHandles { service: service as u16, value: c.value, cccd: c.cccd })

// Add the characteristic to the last service of `db`.  The service handle of
// the answer is 0.
@tier(app)
fn add_key_material_characteristic(var db: GattDb) -> Result<KeyMaterialHandles, profile_builder.ProfileError>
    let value = profile_builder.add_value(
        var db, gatt_server.PROP_READ | gatt_server.PROP_INDICATE, profile_builder.read_only(gatt_server.Access.Authenticated),
        gatt_server.le16(UUID_ENCRYPTED_DATA_KEY_MATERIAL), [])!
    // The handle was just added, so the attribute can be made per connection.
    let _ = gatt_server.make_per_link(var db, value)
    let cccd = profile_builder.add_cccd(var db, gatt_server.Permissions { read: gatt_server.Access.Authenticated,
        write: gatt_server.Access.Authenticated })!
    Ok(KeyMaterialHandles { service: 0, value: value as u16, cccd: cccd as u16 })

// Give the connection of `peer` the Key Material the policy releases to it:
// the 24 octets, or no octet when the policy releases none.  True when the
// peer was released the material.
@tier(app)
fn serve_key_material<P: EadPolicy[e]>(db: GattDb, var link: AttLink, handles: KeyMaterialHandles,
                                       var policy: P, peer: links.LinkId) -> Bool [e, mutate]
    match policy.release_key(peer)
        Some(km) =>
            if not key_material_valid(km)
                let _ = gatt_server.set_link_value(db, var link, handles.value, [])
                return false
            gatt_server.set_link_value(db, var link, handles.value, key_material_value(km))
        None     =>
            let _ = gatt_server.set_link_value(db, var link, handles.value, [])
            false

// The indication of the Key Material the server updated, for the client of
// `link` when it subscribed; the PDUs to send (none without a subscription).
@tier(app)
fn indicate_key_material(var db: GattDb, var link: AttLink, handles: KeyMaterialHandles,
                         km: KeyMaterial, now_ms: Int) -> [[u8]]
    if not key_material_valid(km) or not gatt_server.set_link_value(db, var link, handles.value, key_material_value(km))
        return []
    gatt_server.send_value(var db, var link, handles.value, now_ms)
