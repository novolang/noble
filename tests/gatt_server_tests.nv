use gatt_server

@test
fn test_records_become_readable_attributes()
    var s = new_server(records(), 65)
    test.assert_eq(list.len(s.db.attributes), 7)
    assert_bytes(one(receive(var s.db, var s.link, octets([0x0A, 0x03, 0x00]), 0)),
        [0x0B, 'N' as Int, 'o' as Int, 'v' as Int, 'o' as Int])
    // Only the configuration descriptor is writable.
    assert_error(receive(var s.db, var s.link, octets([0x12, 0x03, 0x00, 0x41]), 0),
        0x12,
        0x0003,
        att.ATT_ERR_WRITE_NOT_PERMITTED)
    test.assert_eq(last_handle(s.db), 7)

@test
fn test_building_the_database()
    var s = test_server()
    test.assert_eq(last_handle(s.db), 0x0015)
    // The declaration names the value handle and the UUID.
    assert_bytes(s.db.attributes[index_of(s.db, 0x0009)].value, [0x0A, 0x0A, 0x00, 0x01, 0xAA])
    // Refusals: a bad UUID, a descriptor nothing allows, a second
    // configuration descriptor, a service handle that is not one.
    test.assert_eq(add_service(var s.db, false, [0x01]), -1)
    test.assert_eq(add_characteristic(var s.db, 0x02, PERM_READ, [0x01, 0x02, 0x03]), -1)
    test.assert_eq(add_included(var s.db, 0x0009), -1)
    test.assert_eq(add_included(var s.db, 0x0999), -1)
    test.assert_eq(add_descriptor(var s.db, PERM_READ, le16(UUID_CLIENT_CHARACTERISTIC_CONFIGURATION)), -1)
    test.assert_eq(add_descriptor(var s.db, PERM_READ, le16(UUID_CHARACTERISTIC_EXTENDED_PROPERTIES)), -1)
    test.assert_eq(add_descriptor(var s.db, PERM_READ, [0x01]), -1)
    test.assert_eq(set_value(var s.db, 0x0999, [0x00]), false)
    test.assert_eq(set_value(var s.db, 0x0008, [0x00]), false)
    test.assert_eq(set_key_size(var s.db, 0x000A, 16), false)
    test.assert_eq(set_key_size(var s.db, 0x000C, 6), false)
    test.assert_eq(set_key_size(var s.db, 0x0999, 7), false)
    var long: [u8] = []
    for _ in 0..ATT_VALUE_MAX + 1
        list.push(long, 0x00)
    test.assert_eq(set_value(var s.db, 0x000A, long), false)
    // Setting a configuration descriptor's value leaves the client's.
    test.assert(set_value(var s.db, 0x0013, [0x01, 0x00]))
    test.assert_eq(configuration(s.link, 0x0013), 0)
    // A secondary service, an include declaration, an extended
    // properties descriptor and a plain descriptor.
    test.assert_eq(add_service(var s.db, true, le16(0xBB00)), 0x0016)
    test.assert_eq(add_included(var s.db, 0x0008), 0x0017)
    test.assert_eq(add_characteristic(var s.db, 0x82, PERM_READ, le16(0xBB01)), 0x0018)
    test.assert_eq(add_descriptor(var s.db, PERM_READ, le16(UUID_CHARACTERISTIC_EXTENDED_PROPERTIES)), 0x001A)
    test.assert_eq(add_descriptor(var s.db, PERM_READ | PERM_WRITE, le16(0x2901)), 0x001B)
    test.assert_eq(handle_of_type(s.db, le16(0x2901)), 0x001B)
    test.assert_eq(handle_of_type(s.db, le16(0x2999)), 0)
    // The include declaration: the service handle, its end and its UUID.
    assert_bytes(value_at(s.db, s.link, index_of(s.db, 0x0017)), [0x08, 0x00, 0x15, 0x00, 0x00, 0xAA])
    remove_range(var s.db, 0x0016, 0x001B)
    test.assert_eq(last_handle(s.db), 0x0015)

@test
fn test_no_characteristic_before_a_service()
    var s = new_server([], 65)
    test.assert_eq(last_handle(s.db), 0)
    test.assert_eq(has_service(s.db), false)
    test.assert_eq(add_characteristic(var s.db, 0x02, PERM_READ, le16(0x1234)), -1)
    test.assert_eq(add_descriptor(var s.db, PERM_READ, le16(0x2901)), -1)
    test.assert_eq(add_included(var s.db, 0x0001), -1)
    test.assert_eq(add_service(var s.db, false, le16(0x1234)), 0x0001)
    test.assert_eq(has_service(s.db), true)
    test.assert_eq(add_descriptor(var s.db, PERM_READ, le16(0x2901)), -1)

@test
fn test_uuids_compare_across_widths()
    let full = uuid.uuid16_to_128(0x2800)
    test.assert(uuid_equal(le16(0x2800), full))
    test.assert(uuid_equal(full, le16(0x2800)))
    test.assert_eq(uuid_equal(le16(0x2801), full), false)
    test.assert_eq(uuid_equal([0x00], full), false)

@test
fn test_exchange_mtu()
    var s = test_server()
    assert_bytes(one(receive(var s.db, var s.link, octets([0x02, 0x00, 0x01]), 0)), [0x03, 65, 0x00])
    test.assert_eq(mtu_of(s.link, 0), 65)
    var t = test_server()
    let _ = receive(var t.db, var t.link, octets([0x02, 0x30, 0x00]), 0)
    test.assert_eq(mtu_of(t.link, 0), 0x30)
    var u = test_server()
    let _ = receive(var u.db, var u.link, octets([0x02, 0x10, 0x00]), 0)
    test.assert_eq(mtu_of(u.link, 0), 23)
    assert_error(receive(var u.db, var u.link, octets([0x02, 0x10]), 0), 0x02, 0, att.ATT_ERR_INVALID_PDU)

@test
fn test_discover_all_primary_services()
    var s = test_server()
    // Read By Group Type for «Primary Service»: GAP and GATT, then the
    // added service from 0x0008.
    assert_bytes(one(receive(var s.db, var s.link, octets([0x10, 0x01, 0x00, 0xFF, 0xFF, 0x00, 0x28]), 0)),
        [0x11,
        6,
        0x01,
        0x00,
        0x03,
        0x00,
        0x00,
        0x18,
        0x04,
        0x00,
        0x07,
        0x00,
        0x01,
        0x18,
        0x08,
        0x00,
        0x15,
        0x00,
        0x00,
        0xAA])
    assert_error(receive(var s.db, var s.link, octets([0x10, 0x16, 0x00, 0xFF, 0xFF, 0x00, 0x28]), 0),
        0x10,
        0x0016,
        att.ATT_ERR_ATTRIBUTE_NOT_FOUND)
    assert_error(receive(var s.db, var s.link, octets([0x10, 0x01, 0x00, 0xFF, 0xFF, 0x03, 0x28]), 0),
        0x10,
        0x0001,
        att.ATT_ERR_UNSUPPORTED_GROUP_TYPE)
    assert_error(receive(var s.db, var s.link, octets([0x10, 0x00, 0x00, 0xFF, 0xFF, 0x00, 0x28]), 0),
        0x10,
        0x0000,
        att.ATT_ERR_INVALID_HANDLE)
    assert_error(receive(var s.db, var s.link, octets([0x10, 0x05, 0x00, 0x04, 0x00, 0x00, 0x28]), 0),
        0x10,
        0x0005,
        att.ATT_ERR_INVALID_HANDLE)
    assert_error(receive(var s.db, var s.link, octets([0x10, 0x01, 0x00]), 0), 0x10, 0, att.ATT_ERR_INVALID_PDU)
    // The 128-bit form of «Primary Service» asks the same.
    var req = octets([0x10, 0x08, 0x00, 0xFF, 0xFF])
    list.append(req, uuid.uuid16_to_128(UUID_PRIMARY_SERVICE))
    assert_bytes(one(receive(var s.db, var s.link, req, 0)), [0x11, 6, 0x08, 0x00, 0x15, 0x00, 0x00, 0xAA])

@test
fn test_services_of_both_widths_are_listed_apart()
    var s = new_server(records(), 65)
    let _ = add_service(var s.db, false, uuid128(0x07))
    let first = one(receive(var s.db, var s.link, octets([0x10, 0x01, 0x00, 0xFF, 0xFF, 0x00, 0x28]), 0))
    test.assert_eq(first[1] as Int, 6)
    test.assert_eq(list.len(first), 2 + 2 * 6)
    let second = one(receive(var s.db, var s.link, octets([0x10, 0x08, 0x00, 0xFF, 0xFF, 0x00, 0x28]), 0))
    test.assert_eq(second[1] as Int, 20)
    test.assert_eq(list.len(second), 2 + 20)

@test
fn test_find_by_type_value()
    var s = test_server()
    assert_bytes(one(receive(var s.db, var s.link, octets([0x06, 0x01, 0x00, 0xFF, 0xFF, 0x00, 0x28, 0x00, 0xAA]), 0)),
        [0x07, 0x08, 0x00, 0x15, 0x00])
    // A non-grouping attribute ends at its own handle.
    assert_bytes(one(receive(var s.db,
        var s.link,
        octets([0x06, 0x01, 0x00, 0xFF, 0xFF, 0x00, 0x2A, 'N' as Int, 'o' as Int, 'v' as Int, 'o' as Int]),
        0)),
    [0x07, 0x03, 0x00, 0x03, 0x00])
    assert_error(receive(var s.db, var s.link, octets([0x06, 0x01, 0x00, 0xFF, 0xFF, 0x00, 0x28, 0x99, 0x99]), 0),
        0x06,
        0x0001,
        att.ATT_ERR_ATTRIBUTE_NOT_FOUND)
    assert_error(receive(var s.db, var s.link, octets([0x06, 0x02, 0x00, 0x01, 0x00, 0x00, 0x28]), 0),
        0x06,
        0x0002,
        att.ATT_ERR_INVALID_HANDLE)
    assert_error(receive(var s.db, var s.link, octets([0x06, 0x01, 0x00, 0xFF, 0xFF, 0x00]), 0),
        0x06,
        0,
        att.ATT_ERR_INVALID_PDU)

@test
fn test_find_information()
    var s = test_server()
    assert_bytes(one(receive(var s.db, var s.link, octets([0x04, 0x12, 0x00, 0x13, 0x00]), 0)),
        [0x05, 0x01, 0x12, 0x00, 0x05, 0xAA, 0x13, 0x00, 0x02, 0x29])
    // A 128-bit type after 16-bit ones ends the list; alone it uses format 2.
    let mixed = one(receive(var s.db, var s.link, octets([0x04, 0x13, 0x00, 0x15, 0x00]), 0))
    test.assert_eq(list.len(mixed), 2 + 4 + 4)
    let wide = one(receive(var s.db, var s.link, octets([0x04, 0x15, 0x00, 0x15, 0x00]), 0))
    test.assert_eq(wide[1] as Int, 0x02)
    test.assert_eq(list.len(wide), 2 + 2 + 16)
    // ATT_MTU 23 holds five 16-bit pairs.
    test.assert_eq(list.len(one(receive(var s.db, var s.link, octets([0x04, 0x01, 0x00, 0xFF, 0xFF]), 0))),
        2 + 5 * 4)
    assert_error(receive(var s.db, var s.link, octets([0x04, 0x16, 0x00, 0xFF, 0xFF]), 0),
        0x04,
        0x0016,
        att.ATT_ERR_ATTRIBUTE_NOT_FOUND)
    assert_error(receive(var s.db, var s.link, octets([0x04, 0x00, 0x00, 0xFF, 0xFF]), 0),
        0x04,
        0x0000,
        att.ATT_ERR_INVALID_HANDLE)
    assert_error(receive(var s.db, var s.link, octets([0x04, 0x01]), 0), 0x04, 0, att.ATT_ERR_INVALID_PDU)

@test
fn test_read_by_type_discovers_characteristics()
    var s = test_server()
    // Characteristic declarations of 5 octets; the 128-bit one at 0x0014
    // is of another length and would not fit anyway.
    let rsp = one(receive(var s.db, var s.link, octets([0x08, 0x08, 0x00, 0x15, 0x00, 0x03, 0x28]), 0))
    test.assert_eq(rsp[1] as Int, 7)
    test.assert_eq(list.len(rsp), 2 + 3 * 7)
    let wide = one(receive(var s.db, var s.link, octets([0x08, 0x14, 0x00, 0x15, 0x00, 0x03, 0x28]), 0))
    test.assert_eq(wide[1] as Int, 21)
    assert_error(receive(var s.db, var s.link, octets([0x08, 0x16, 0x00, 0xFF, 0xFF, 0x03, 0x28]), 0),
        0x08,
        0x0016,
        att.ATT_ERR_ATTRIBUTE_NOT_FOUND)
    assert_error(receive(var s.db, var s.link, octets([0x08, 0x02, 0x00, 0x01, 0x00, 0x03, 0x28]), 0),
        0x08,
        0x0002,
        att.ATT_ERR_INVALID_HANDLE)
    assert_error(receive(var s.db, var s.link, octets([0x08, 0x01, 0x00, 0xFF, 0xFF, 0x03]), 0),
        0x08,
        0,
        att.ATT_ERR_INVALID_PDU)

@test
fn test_read_by_type_checks_access()
    var s = test_server()
    // The first match refused: the error names it.
    assert_error(receive(var s.db, var s.link, octets([0x08, 0x01, 0x00, 0xFF, 0xFF, 0x02, 0xAA]), 0),
        0x08,
        0x000C,
        att.ATT_ERR_INSUFFICIENT_AUTHENTICATION)
    // A refused match after a readable one ends the list.
    let _ = add_characteristic(var s.db, 0x02, PERM_READ, le16(0xAA01))
    let _ = set_value(var s.db, 0, [0x09, 0x09, 0x09, 0x09])
    let _ = add_characteristic(var s.db, 0x02, PERM_READ_AUTHOR, le16(0xAA01))
    let _ = set_value(var s.db, 0, [0x08, 0x08, 0x08, 0x08])
    let rsp = one(receive(var s.db, var s.link, octets([0x08, 0x01, 0x00, 0xFF, 0xFF, 0x01, 0xAA]), 0))
    test.assert_eq(list.len(rsp), 2 + 2 * 6)
    // A value of another length ends it too.
    let _ = add_characteristic(var s.db, 0x02, PERM_READ, le16(0xAA06))
    let _ = set_value(var s.db, 0, [0x01])
    let _ = add_characteristic(var s.db, 0x02, PERM_READ, le16(0xAA06))
    let _ = set_value(var s.db, 0, [0x01, 0x02])
    test.assert_eq(list.len(one(receive(var s.db, var s.link, octets([0x08, 0x01, 0x00, 0xFF, 0xFF, 0x06, 0xAA]), 0))),
        2 + 3)

@test
fn test_read_by_type_cuts_a_long_value()
    var s = test_server()
    let _ = add_characteristic(var s.db, 0x02, PERM_READ, le16(0xAA07))
    var long: [u8] = []
    for k in 0..40
        list.push(long, k as u8)
    let _ = set_value(var s.db, 0, long)
    let rsp = one(receive(var s.db, var s.link, octets([0x08, 0x01, 0x00, 0xFF, 0xFF, 0x07, 0xAA]), 0))
    test.assert_eq(rsp[1] as Int, 2 + 19)
    test.assert_eq(list.len(rsp), 23)

@test
fn test_read_and_security()
    var s = test_server()
    assert_bytes(one(receive(var s.db, var s.link, octets([0x0A, 0x0A, 0x00]), 0)),
        [0x0B, 0x01, 0x02, 0x03, 0x04])
    assert_error(receive(var s.db, var s.link, octets([0x0A, 0x99, 0x00]), 0),
        0x0A,
        0x0099,
        att.ATT_ERR_INVALID_HANDLE)
    assert_error(receive(var s.db, var s.link, octets([0x0A, 0x99]), 0), 0x0A, 0, att.ATT_ERR_INVALID_PDU)
    // Unencrypted with no key: Insufficient Authentication, for
    // encryption and authentication alike.
    assert_error(receive(var s.db, var s.link, octets([0x0A, 0x0C, 0x00]), 0),
        0x0A,
        0x000C,
        att.ATT_ERR_INSUFFICIENT_AUTHENTICATION)
    assert_error(receive(var s.db, var s.link, octets([0x0A, 0x0E, 0x00]), 0),
        0x0A,
        0x000E,
        att.ATT_ERR_INSUFFICIENT_AUTHENTICATION)
    assert_error(receive(var s.db, var s.link, octets([0x0A, 0x10, 0x00]), 0),
        0x0A,
        0x0010,
        att.ATT_ERR_INSUFFICIENT_AUTHORIZATION)
    // With a key for the peer: Insufficient Encryption.
    set_security(var s.link, LinkSecurity { encrypted: false, level: 1, key_size: 0, has_ltk: true })
    assert_error(receive(var s.db, var s.link, octets([0x0A, 0x0C, 0x00]), 0),
        0x0A,
        0x000C,
        att.ATT_ERR_INSUFFICIENT_ENCRYPTION)
    // Encrypted, unauthenticated: encryption is enough, authentication not.
    set_security(var s.link, encrypted(2, 16))
    assert_bytes(one(receive(var s.db, var s.link, octets([0x0A, 0x0C, 0x00]), 0)), [0x0B, 0x11])
    assert_error(receive(var s.db, var s.link, octets([0x0A, 0x0E, 0x00]), 0),
        0x0A,
        0x000E,
        att.ATT_ERR_INSUFFICIENT_AUTHENTICATION)
    // Authenticated: both; the 128-bit value still needs a 16-octet key.
    set_security(var s.link, encrypted(3, 7))
    assert_bytes(one(receive(var s.db, var s.link, octets([0x0A, 0x0E, 0x00]), 0)), [0x0B, 0x22])
    assert_error(receive(var s.db, var s.link, octets([0x0A, 0x15, 0x00]), 0),
        0x0A,
        0x0015,
        att.ATT_ERR_INSUFFICIENT_ENC_KEY_SIZE)
    set_security(var s.link, encrypted(4, 16))
    assert_bytes(one(receive(var s.db, var s.link, octets([0x0A, 0x15, 0x00]), 0)), [0x0B, 0x55])
    // The Service Changed value is indicated, not read.
    assert_error(receive(var s.db, var s.link, octets([0x0A, 0x06, 0x00]), 0),
        0x0A,
        0x0006,
        att.ATT_ERR_READ_NOT_PERMITTED)

@test
fn test_read_not_permitted()
    var s = test_server()
    let _ = add_characteristic(var s.db, 0x08, PERM_WRITE, le16(0xAA08))
    let _ = set_value(var s.db, 0, [0x01])
    assert_error(receive(var s.db, var s.link, octets([0x0A, 0x17, 0x00]), 0),
        0x0A,
        0x0017,
        att.ATT_ERR_READ_NOT_PERMITTED)
    assert_error(receive(var s.db, var s.link, octets([0x0C, 0x17, 0x00, 0x00, 0x00]), 0),
        0x0C,
        0x0017,
        att.ATT_ERR_READ_NOT_PERMITTED)

@test
fn test_read_blob()
    var s = test_server()
    let _ = add_characteristic(var s.db, 0x02, PERM_READ, le16(0xAA09))
    var long: [u8] = []
    for k in 0..30
        list.push(long, k as u8)
    let _ = set_value(var s.db, 0, long)
    let first = one(receive(var s.db, var s.link, octets([0x0A, 0x17, 0x00]), 0))
    test.assert_eq(list.len(first), 23)
    let rest = one(receive(var s.db, var s.link, octets([0x0C, 0x17, 0x00, 22, 0x00]), 0))
    assert_bytes(rest, [0x0D, 22, 23, 24, 25, 26, 27, 28, 29])
    let middle = one(receive(var s.db, var s.link, octets([0x0C, 0x17, 0x00, 1, 0x00]), 0))
    test.assert_eq(list.len(middle), 23)
    assert_bytes(one(receive(var s.db, var s.link, octets([0x0C, 0x17, 0x00, 30, 0x00]), 0)), [0x0D])
    assert_error(receive(var s.db, var s.link, octets([0x0C, 0x17, 0x00, 31, 0x00]), 0),
        0x0C,
        0x0017,
        att.ATT_ERR_INVALID_OFFSET)
    assert_error(receive(var s.db, var s.link, octets([0x0C, 0x99, 0x00, 0x00, 0x00]), 0),
        0x0C,
        0x0099,
        att.ATT_ERR_INVALID_HANDLE)
    assert_error(receive(var s.db, var s.link, octets([0x0C, 0x0C, 0x00, 0x00, 0x00]), 0),
        0x0C,
        0x000C,
        att.ATT_ERR_INSUFFICIENT_AUTHENTICATION)
    assert_error(receive(var s.db, var s.link, octets([0x0C, 0x17, 0x00]), 0), 0x0C, 0, att.ATT_ERR_INVALID_PDU)

@test
@satisfies("REQ-BLE-GAF-080")
fn test_a_read_blob_after_the_value_changed_is_value_changed_during_read_long()
    var s = test_server()
    let _ = add_characteristic(var s.db, 0x02, PERM_READ, le16(0xAA09))
    test.assert(add_read_long_rule(var s.db, 0x17))
    test.assert(add_read_long_rule(var s.db, 0x17))
    test.assert_eq(list.len(s.db.long_reads), 1)
    var long: [u8] = []
    for k in 0..30
        list.push(long, k as u8)
    let _ = set_value(var s.db, 0, long)
    // A part before any read from offset 0 is served: no value changed under the client.
    assert_bytes(one(receive(var s.db, var s.link, octets([0x0C, 0x17, 0x00, 22, 0x00]), 0)),
        [0x0D, 22, 23, 24, 25, 26, 27, 28, 29])
    test.assert_eq(list.len(one(receive(var s.db, var s.link, octets([0x0A, 0x17, 0x00]), 0))), 23)
    assert_bytes(one(receive(var s.db, var s.link, octets([0x0C, 0x17, 0x00, 22, 0x00]), 0)),
        [0x0D, 22, 23, 24, 25, 26, 27, 28, 29])
    // The value changes: the continuation is refused, and a new read from offset 0 restarts.
    list.push(long, 30)
    let _ = set_value(var s.db, 0, long)
    assert_error(receive(var s.db, var s.link, octets([0x0C, 0x17, 0x00, 22, 0x00]), 0),
        0x0C,
        0x0017,
        ERR_VALUE_CHANGED_DURING_READ_LONG)
    test.assert_eq(list.len(one(receive(var s.db, var s.link, octets([0x0C, 0x17, 0x00, 0, 0x00]), 0))), 23)
    assert_bytes(one(receive(var s.db, var s.link, octets([0x0C, 0x17, 0x00, 22, 0x00]), 0)),
        [0x0D, 22, 23, 24, 25, 26, 27, 28, 29, 30])
    // Another client has its own stamp, and an attribute without the rule has none.
    var other = new_att_link(s.db)
    set_security(var other, link_security(true, 2, 16, true))
    assert_bytes(one(receive(var s.db, var other, octets([0x0C, 0x17, 0x00, 22, 0x00]), 0)),
        [0x0D, 22, 23, 24, 25, 26, 27, 28, 29, 30])
    test.assert(not add_read_long_rule(var s.db, 1))
    test.assert(not add_read_long_rule(var s.db, 0x0999))
    test.assert_eq(long_read_error(s.db, s.link, 0x0A, []), 0)
    // An attribute with the rule that the client has not read from offset 0 is served although
    // the client has read another one.
    test.assert(add_read_long_rule(var s.db, 0x0A))
    test.assert_eq(long_read_error(s.db, s.link, 0x0A, []), 0)

@test
fn test_read_multiple()
    var s = test_server()
    assert_bytes(one(receive(var s.db, var s.link, octets([0x0E, 0x0A, 0x00, 0x03, 0x00]), 0)),
        [0x0F, 0x01, 0x02, 0x03, 0x04, 'N' as Int, 'o' as Int, 'v' as Int, 'o' as Int])
    assert_error(receive(var s.db, var s.link, octets([0x0E, 0x0A, 0x00, 0x99, 0x00]), 0),
        0x0E,
        0x0099,
        att.ATT_ERR_INVALID_HANDLE)
    assert_error(receive(var s.db, var s.link, octets([0x0E, 0x0A, 0x00, 0x10, 0x00]), 0),
        0x0E,
        0x0010,
        att.ATT_ERR_INSUFFICIENT_AUTHORIZATION)
    assert_error(receive(var s.db, var s.link, octets([0x0E, 0x0A, 0x00]), 0), 0x0E, 0, att.ATT_ERR_INVALID_PDU)
    assert_error(receive(var s.db, var s.link, octets([0x0E, 0x0A, 0x00, 0x03]), 0),
        0x0E,
        0,
        att.ATT_ERR_INVALID_PDU)
    // Cut to ATT_MTU - 1.
    var req = octets([0x0E])
    for _ in 0..8
        list.append(req, octets([0x0A, 0x00]))
    test.assert_eq(list.len(one(receive(var s.db, var s.link, req, 0))), 23)

@test
fn test_read_multiple_variable()
    var s = test_server()
    assert_bytes(one(receive(var s.db, var s.link, octets([0x20, 0x0A, 0x00, 0x12, 0x00]), 0)),
        [0x21, 0x04, 0x00, 0x01, 0x02, 0x03, 0x04, 0x02, 0x00, 0x44, 0x45])
    assert_error(receive(var s.db, var s.link, octets([0x20, 0x0A, 0x00, 0x0C, 0x00]), 0),
        0x20,
        0x000C,
        att.ATT_ERR_INSUFFICIENT_AUTHENTICATION)
    // A tuple whose length would be cut is left out; a value is cut.
    var req = octets([0x20])
    for _ in 0..4
        list.append(req, octets([0x0A, 0x00]))
    test.assert_eq(list.len(one(receive(var s.db, var s.link, req, 0))), 1 + 3 * 6 + 2 + 2)
    var two = octets([0x20])
    for _ in 0..4
        list.append(two, octets([0x03, 0x00]))
    let rsp = one(receive(var s.db, var s.link, two, 0))
    test.assert_eq(list.len(rsp), 1 + 3 * 6 + 2 + 2)

@test
fn test_write_request_and_command()
    var s = test_server()
    assert_bytes(one(receive(var s.db, var s.link, octets([0x12, 0x0A, 0x00, 0x09, 0x08]), 0)), [0x13])
    assert_bytes(s.db.attributes[index_of(s.db, 0x000A)].value, [0x09, 0x08])
    // Up to the length the tester set; longer is refused.
    assert_error(receive(var s.db, var s.link, octets([0x12, 0x0A, 0x00, 1, 2, 3, 4, 5]), 0),
        0x12,
        0x000A,
        att.ATT_ERR_INVALID_ATTRIBUTE_VALUE_LEN)
    assert_error(receive(var s.db, var s.link, octets([0x12, 0x99, 0x00, 0x00]), 0),
        0x12,
        0x0099,
        att.ATT_ERR_INVALID_HANDLE)
    assert_error(receive(var s.db, var s.link, octets([0x12, 0x0C, 0x00, 0x00]), 0),
        0x12,
        0x000C,
        att.ATT_ERR_INSUFFICIENT_AUTHENTICATION)
    assert_error(receive(var s.db, var s.link, octets([0x12, 0x10, 0x00, 0x00]), 0),
        0x12,
        0x0010,
        att.ATT_ERR_INSUFFICIENT_AUTHORIZATION)
    assert_error(receive(var s.db, var s.link, octets([0x12, 0x0A]), 0), 0x12, 0, att.ATT_ERR_INVALID_PDU)
    test.assert_eq(list.len(take_changed(var s.link)), 1)
    test.assert_eq(list.len(take_changed(var s.link)), 0)
    // A command answers nothing, applied or not.
    test.assert_eq(list.len(receive(var s.db, var s.link, octets([0x52, 0x0A, 0x00, 0x07]), 0)), 0)
    assert_bytes(s.db.attributes[index_of(s.db, 0x000A)].value, [0x07])
    test.assert_eq(list.len(receive(var s.db, var s.link, octets([0x52, 0x0C, 0x00, 0x07]), 0)), 0)
    test.assert_eq(list.len(receive(var s.db, var s.link, octets([0x52, 0x0C]), 0)), 0)
    assert_bytes(s.db.attributes[index_of(s.db, 0x000C)].value, [0x11])
    // A value that may only be read.
    set_security(var s.link, encrypted(4, 7))
    assert_error(receive(var s.db, var s.link, octets([0x12, 0x15, 0x00, 0x00]), 0),
        0x12,
        0x0015,
        att.ATT_ERR_WRITE_NOT_PERMITTED)

@test
fn test_configuration_descriptor()
    var s = test_server()
    assert_bytes(one(receive(var s.db, var s.link, octets([0x0A, 0x13, 0x00]), 0)), [0x0B, 0x00, 0x00])
    assert_bytes(one(receive(var s.db, var s.link, octets([0x12, 0x13, 0x00, 0x01, 0x00]), 0)), [0x13])
    assert_bytes(one(receive(var s.db, var s.link, octets([0x0A, 0x13, 0x00]), 0)), [0x0B, 0x01, 0x00])
    assert_error(receive(var s.db, var s.link, octets([0x12, 0x13, 0x00]), 0),
        0x12,
        0x0013,
        att.ATT_ERR_INVALID_ATTRIBUTE_VALUE_LEN)
    assert_error(receive(var s.db, var s.link, octets([0x12, 0x13, 0x00, 0x01, 0x00, 0x00]), 0),
        0x12,
        0x0013,
        att.ATT_ERR_INVALID_ATTRIBUTE_VALUE_LEN)
    // One octet is taken as the low one.
    assert_bytes(one(receive(var s.db, var s.link, octets([0x12, 0x13, 0x00, 0x03]), 0)), [0x13])
    test.assert_eq(configuration(s.link, 0x0013), 3)
    // A queued write of the whole value, then one at an offset.
    let _ = receive(var s.db, var s.link, octets([0x16, 0x13, 0x00, 0x00, 0x00, 0x02, 0x00]), 0)
    assert_bytes(one(receive(var s.db, var s.link, octets([0x18, 0x01]), 0)), [0x19])
    test.assert_eq(configuration(s.link, 0x0013), 2)
    let _ = receive(var s.db, var s.link, octets([0x16, 0x13, 0x00, 0x01, 0x00, 0x00]), 0)
    assert_error(receive(var s.db, var s.link, octets([0x18, 0x01]), 0),
        0x18,
        0x0013,
        att.ATT_ERR_INVALID_OFFSET)
    // The configuration is the client's: a new connection starts at 0,
    // a bonded one gets back what it had.
    save_configuration(var s.db, s.link, 1, octets([1, 2, 3, 4, 5, 6]))
    save_configuration(var s.db, s.link, 1, octets([1, 2, 3, 4, 5, 6]))
    test.assert_eq(list.len(s.db.saved), 1)
    reset_bearer(s.db, var s.link)
    test.assert_eq(configuration(s.link, 0x0013), 0)
    restore_configuration(s.db, var s.link, 0, octets([1, 2, 3, 4, 5, 6]))
    test.assert_eq(configuration(s.link, 0x0013), 0)
    restore_configuration(s.db, var s.link, 1, octets([1, 2, 3, 4, 5, 6]))
    test.assert_eq(configuration(s.link, 0x0013), 2)
    set_configuration(var s.link, 0x0013, 0)
    test.assert_eq(list.len(s.link.cccd), 0)

@test
fn test_queued_writes()
    var s = test_server()
    let _ = add_characteristic(var s.db, 0x0A, PERM_READ | PERM_WRITE, le16(0xAA0A))
    var long: [u8] = []
    for _ in 0..40
        list.push(long, 0x00)
    let _ = set_value(var s.db, 0, long)
    // Prepare, echo, execute: the value becomes the parts in order.
    assert_bytes(one(receive(var s.db, var s.link, octets([0x16, 0x17, 0x00, 0x00, 0x00, 1, 2, 3]), 0)),
        [0x17, 0x17, 0x00, 0x00, 0x00, 1, 2, 3])
    let _ = receive(var s.db, var s.link, octets([0x16, 0x17, 0x00, 0x03, 0x00, 4, 5]), 0)
    assert_bytes(one(receive(var s.db, var s.link, octets([0x18, 0x01]), 0)), [0x19])
    assert_bytes(s.db.attributes[index_of(s.db, 0x0017)].value, [1, 2, 3, 4, 5])
    test.assert_eq(list.len(take_changed(var s.link)), 1)
    // Cancel discards the queue.
    let _ = receive(var s.db, var s.link, octets([0x16, 0x17, 0x00, 0x00, 0x00, 9]), 0)
    assert_bytes(one(receive(var s.db, var s.link, octets([0x18, 0x00]), 0)), [0x19])
    assert_bytes(s.db.attributes[index_of(s.db, 0x0017)].value, [1, 2, 3, 4, 5])
    // An empty queue executes to a response.
    assert_bytes(one(receive(var s.db, var s.link, octets([0x18, 0x01]), 0)), [0x19])
    // An offset past the value, or a value past its longest: an error
    // naming the handle, and nothing written.
    let _ = receive(var s.db, var s.link, octets([0x16, 0x17, 0x00, 0x09, 0x00, 1]), 0)
    assert_error(receive(var s.db, var s.link, octets([0x18, 0x01]), 0),
        0x18,
        0x0017,
        att.ATT_ERR_INVALID_OFFSET)
    let _ = receive(var s.db, var s.link, octets([0x16, 0x17, 0x00, 0x00, 0x00, 7]), 0)
    let _ = receive(var s.db, var s.link, octets([0x16, 0x17, 0x00, 0x27, 0x00, 1, 2]), 0)
    assert_error(receive(var s.db, var s.link, octets([0x18, 0x01]), 0),
        0x18,
        0x0017,
        att.ATT_ERR_INVALID_OFFSET)
    let _ = receive(var s.db, var s.link, octets([0x16, 0x0A, 0x00, 0x00, 0x00, 1, 2, 3, 4, 5]), 0)
    assert_error(receive(var s.db, var s.link, octets([0x18, 0x01]), 0),
        0x18,
        0x000A,
        att.ATT_ERR_INVALID_ATTRIBUTE_VALUE_LEN)
    assert_bytes(s.db.attributes[index_of(s.db, 0x0017)].value, [1, 2, 3, 4, 5])
    // Checks at prepare time.
    assert_error(receive(var s.db, var s.link, octets([0x16, 0x99, 0x00, 0x00, 0x00]), 0),
        0x16,
        0x0099,
        att.ATT_ERR_INVALID_HANDLE)
    assert_error(receive(var s.db, var s.link, octets([0x16, 0x0C, 0x00, 0x00, 0x00]), 0),
        0x16,
        0x000C,
        att.ATT_ERR_INSUFFICIENT_AUTHENTICATION)
    assert_error(receive(var s.db, var s.link, octets([0x16, 0x0C, 0x00]), 0), 0x16, 0, att.ATT_ERR_INVALID_PDU)
    assert_error(receive(var s.db, var s.link, octets([0x18, 0x02]), 0), 0x18, 0, att.ATT_ERR_INVALID_PDU)
    for _ in 0..PREPARE_QUEUE_CAPACITY
        let _ = receive(var s.db, var s.link, octets([0x16, 0x17, 0x00, 0x00, 0x00, 1]), 0)
    assert_error(receive(var s.db, var s.link, octets([0x16, 0x17, 0x00, 0x00, 0x00, 1]), 0),
        0x16,
        0x0017,
        att.ATT_ERR_PREPARE_QUEUE_FULL)

@test
fn test_unsupported_and_client_pdus()
    var s = test_server()
    assert_error(receive(var s.db, var s.link, octets([0x3F]), 0), 0x3F, 0, att.ATT_ERR_REQUEST_NOT_SUPPORTED)
    test.assert_eq(list.len(receive(var s.db, var s.link, octets([0x7F]), 0)), 0)
    test.assert_eq(list.len(receive(var s.db, var s.link, octets([0xD2, 0x0A, 0x00]), 0)), 0)
    test.assert_eq(list.len(receive(var s.db, var s.link, [], 0)), 0)
    test.assert_eq(list.len(receive(var s.db, var s.link, octets([0x1B, 0x03, 0x00, 0x01]), 0)), 0)
    test.assert_eq(list.len(take_client_pdus(var s.link)), 1)
    test.assert_eq(list.len(take_client_pdus(var s.link)), 0)

@test
fn test_notifications_and_indications()
    var s = test_server()
    // Nothing until the client configures it; a value with no descriptor
    // never goes.
    test.assert_eq(list.len(send_value(var s.db, var s.link, 0x0012, 0)), 0)
    test.assert_eq(list.len(send_value(var s.db, var s.link, 0x000A, 0)), 0)
    test.assert_eq(list.len(send_value(var s.db, var s.link, 0x0999, 0)), 0)
    set_configuration(var s.link, 0x0013, CCC_NOTIFICATION)
    assert_bytes(one(send_value(var s.db, var s.link, 0x0012, 0)), [0x1B, 0x12, 0x00, 0x44, 0x45])
    // Indications wait for their confirmation, one at a time.
    set_configuration(var s.link, 0x0013, CCC_INDICATION)
    assert_bytes(one(send_value(var s.db, var s.link, 0x0012, 0)), [0x1D, 0x12, 0x00, 0x44, 0x45])
    test.assert_eq(list.len(send_value(var s.db, var s.link, 0x0012, 0)), 0)
    assert_bytes(one(receive(var s.db, var s.link, octets([0x1E]), 10)), [0x1D, 0x12, 0x00, 0x44, 0x45])
    test.assert_eq(list.len(receive(var s.db, var s.link, octets([0x1E]), 20)), 0)
    test.assert_eq(list.len(receive(var s.db, var s.link, octets([0x1E]), 20)), 0)
    // No confirmation within the transaction timeout: the bearer is done.
    let _ = send_value(var s.db, var s.link, 0x0012, 100)
    tick(var s.link, 100 + ATT_TRANSACTION_TIMEOUT_MS - 1)
    test.assert_eq(s.link.bearers[0].timed_out, false)
    tick(var s.link, 100 + ATT_TRANSACTION_TIMEOUT_MS)
    test.assert(s.link.bearers[0].timed_out)
    test.assert_eq(list.len(receive(var s.db, var s.link, octets([0x0A, 0x0A, 0x00]), 0)), 0)
    test.assert_eq(list.len(send_value(var s.db, var s.link, 0x0012, 0)), 0)
    reset_bearer(s.db, var s.link)
    test.assert_eq(s.link.bearers[0].timed_out, false)

@test
fn test_values_that_need_encryption_are_not_sent_in_the_clear()
    var s = test_server()
    let _ = add_characteristic(var s.db, 0x12, PERM_READ_ENCRYPT, le16(0xAA0B))
    let _ = set_value(var s.db, 0, [0x01])
    let _ = add_descriptor(var s.db, PERM_READ | PERM_WRITE, le16(UUID_CLIENT_CHARACTERISTIC_CONFIGURATION))
    set_configuration(var s.link, 0x0018, CCC_NOTIFICATION)
    test.assert_eq(list.len(send_value(var s.db, var s.link, 0x0017, 0)), 0)
    set_security(var s.link, encrypted(2, 16))
    test.assert_eq(list.len(send_value(var s.db, var s.link, 0x0017, 0)), 1)

@test
fn test_service_changed()
    var s = test_server()
    test.assert_eq(list.len(service_changed(var s.db, var s.link, 0x0008, 0x0015, 0)), 0)
    set_configuration(var s.link, 0x0007, CCC_INDICATION)
    assert_bytes(one(service_changed(var s.db, var s.link, 0x0016, 0x0020, 0)),
        [0x1D, 0x06, 0x00, 0x16, 0x00, 0x20, 0x00])
    var bare = new_server([], 65)
    test.assert_eq(list.len(service_changed(var bare.db, var bare.link, 1, 2, 0)), 0)

@test
fn test_tester_reads()
    var s = test_server()
    let r = tester_read(s.db, s.link, 0x000A, false)
    test.assert_eq(r.0, 0)
    test.assert_eq(tester_read(s.db, s.link, 0x0999, false).0, att.ATT_ERR_INVALID_HANDLE)
    test.assert_eq(tester_read(s.db, s.link, 0x0010, true).0, att.ATT_ERR_INSUFFICIENT_AUTHORIZATION)
    test.assert_eq(tester_read(s.db, s.link, 0x0015, false).0, att.ATT_ERR_INSUFFICIENT_ENC_KEY_SIZE)
    test.assert_eq(tester_read(s.db, s.link, 0x0015, true).0, att.ATT_ERR_INSUFFICIENT_ENC_KEY_SIZE)
    set_security(var s.link, encrypted(4, 16))
    test.assert_eq(tester_read(s.db, s.link, 0x0015, true).0, 0)
    // No security check: the value needing encryption reads as it is.
    test.assert_eq(tester_read(s.db, s.link, 0x000C, true).0, 0)
    let _ = add_characteristic(var s.db, 0x08, PERM_WRITE, le16(0xAA0C))
    test.assert_eq(tester_read(s.db, s.link, 0x0017, true).0, att.ATT_ERR_READ_NOT_PERMITTED)
    // An include declaration that lost its service reads empty.
    let _ = add_included(var s.db, 0x0008)
    remove_range(var s.db, 0x0008, 0x0008)
    test.assert_eq(list.len(tester_read(s.db, s.link, 0x0018, true).1), 0)

@test
fn test_edges_of_the_tables()
    var s = test_server()
    // Two UUIDs of one width that differ, and values of two lengths.
    test.assert_eq(uuid_equal(le16(0x2800), le16(0x2801)), false)
    test.assert_eq(same_bytes(octets([1]), octets([1, 2])), false)
    // The last value has no descriptor after it.
    test.assert_eq(list.len(send_value(var s.db, var s.link, 0x0015, 0)), 0)
    // A second configuration descriptor in one characteristic.
    let _ = add_characteristic(var s.db, 0x12, PERM_READ, le16(0xAA0D))
    test.assert(add_descriptor(var s.db, PERM_READ | PERM_WRITE, le16(UUID_CLIENT_CHARACTERISTIC_CONFIGURATION)) > 0)
    test.assert_eq(add_descriptor(var s.db, PERM_READ | PERM_WRITE, le16(UUID_CLIENT_CHARACTERISTIC_CONFIGURATION)),
        -1)
    // Configuration of two descriptors at once.
    set_configuration(var s.link, 0x0013, CCC_NOTIFICATION)
    set_configuration(var s.link, 0x0018, CCC_INDICATION)
    set_configuration(var s.link, 0x0013, 0)
    test.assert_eq(configuration(s.link, 0x0018), CCC_INDICATION)
    // Two bonded clients are kept apart.
    save_configuration(var s.db, s.link, 0, octets([1, 2, 3, 4, 5, 6]))
    save_configuration(var s.db, s.link, 1, octets([1, 2, 3, 4, 5, 6]))
    test.assert_eq(list.len(s.db.saved), 2)

@test
fn test_find_by_type_value_stops_when_full()
    var s = new_server(records(), 65)
    for _ in 0..7
        let _ = add_service(var s.db, false, le16(0xCC00))
    // ATT_MTU 23 holds five Handles Information entries.
    let rsp = one(receive(var s.db, var s.link, octets([0x06, 0x01, 0x00, 0xFF, 0xFF, 0x00, 0x28, 0x00, 0xCC]), 0))
    test.assert_eq(list.len(rsp), 1 + 5 * 4)

@test
fn test_read_multiple_variable_leaves_out_a_tuple_with_no_room()
    var s = new_server(records(), 65)
    let _ = add_service(var s.db, false, le16(0xDD00))
    let _ = add_characteristic(var s.db, 0x02, PERM_READ, le16(0xDD01))
    let _ = set_value(var s.db, 0, [0x07])
    // Seven 3-octet tuples fill 21 of the 22 octets: the eighth's length
    // does not fit.
    var req = octets([0x20])
    for _ in 0..8
        list.append(req, octets([0x0A, 0x00]))
    test.assert_eq(list.len(one(receive(var s.db, var s.link, req, 0))), 1 + 21)

@tier(app)
fn host_service_changed_handle(s: GattServer) -> Int
    handle_of_type(s.db, le16(UUID_SERVICE_CHANGED))

@tier(app)
fn host_hash_handle() -> Int
    gatt_db.GAP_SERVER_DATABASE_HASH_HANDLE

@tier(app)
fn host_csf_request(value: Int) -> [u8]
    octets([0x12, gatt_db.GAP_SERVER_CLIENT_SUPPORTED_FEATURES_HANDLE & 0xFF,
        gatt_db.GAP_SERVER_CLIENT_SUPPORTED_FEATURES_HANDLE >>> 8, value])

// The example database of [Vol 3] Part G, Appendix B, in the record
// format: the GAP and GATT services with both new characteristics, a
// Client Characteristic Configuration descriptor and a Characteristic
// Extended Properties descriptor, an include declaration and a secondary
// service.
@tier(app)
fn appendix_records() -> [u8]
    var db = att_server.build_db_record(0x0001, UUID_PRIMARY_SERVICE, 0x0003, le16(0x1800))
    list.append(db,
        att_server.build_db_record(0x0002, UUID_CHARACTERISTIC, 0x0002, [0x0A, 0x03, 0x00, 0x00, 0x2A]))
    list.append(db, att_server.build_db_record(0x0003, 0x2A00, 0x0003, ['N', 'o']))
    list.append(db,
        att_server.build_db_record(0x0004, UUID_CHARACTERISTIC, 0x0004, [0x02, 0x05, 0x00, 0x01, 0x2A]))
    list.append(db, att_server.build_db_record(0x0005, 0x2A01, 0x0005, [0x00, 0x00]))
    list.append(db, att_server.build_db_record(0x0006, UUID_PRIMARY_SERVICE, 0x000D, le16(0x1801)))
    list.append(db,
        att_server.build_db_record(0x0007, UUID_CHARACTERISTIC, 0x0007, [0x20, 0x08, 0x00, 0x05, 0x2A]))
    list.append(db, att_server.build_db_record(0x0008, 0x2A05, 0x0008, [0x01, 0x00, 0xFF, 0xFF]))
    list.append(db,
        att_server.build_db_record(0x0009, UUID_CLIENT_CHARACTERISTIC_CONFIGURATION, 0x0009, [0x02, 0x00]))
    list.append(db,
        att_server.build_db_record(0x000A, UUID_CHARACTERISTIC, 0x000A, [0x0A, 0x0B, 0x00, 0x29, 0x2B]))
    list.append(db, att_server.build_db_record(0x000B, UUID_CLIENT_SUPPORTED_FEATURES, 0x000B, [0x01]))
    list.append(db,
        att_server.build_db_record(0x000C, UUID_CHARACTERISTIC, 0x000C, [0x02, 0x0D, 0x00, 0x2A, 0x2B]))
    list.append(db, att_server.build_db_record(0x000D, UUID_DATABASE_HASH, 0x000D, [0x00]))
    list.append(db, att_server.build_db_record(0x000E, UUID_PRIMARY_SERVICE, 0x0016, le16(0x1808)))
    list.append(db,
        att_server.build_db_record(0x000F, UUID_INCLUDE, 0x0014, [0x14, 0x00, 0x16, 0x00, 0x0F, 0x18]))
    list.append(db,
        att_server.build_db_record(0x0010, UUID_CHARACTERISTIC, 0x0010, [0xA2, 0x11, 0x00, 0x18, 0x2A]))
    list.append(db, att_server.build_db_record(0x0011, 0x2A18, 0x0011, [0x00]))
    list.append(db,
        att_server.build_db_record(0x0012, UUID_CLIENT_CHARACTERISTIC_CONFIGURATION, 0x0012, [0x02, 0x00]))
    list.append(db,
        att_server.build_db_record(0x0013, UUID_CHARACTERISTIC_EXTENDED_PROPERTIES, 0x0013, [0x00, 0x00]))
    list.append(db, att_server.build_db_record(0x0014, UUID_SECONDARY_SERVICE, 0x0016, le16(0x180F)))
    list.append(db,
        att_server.build_db_record(0x0015, UUID_CHARACTERISTIC, 0x0015, [0x02, 0x16, 0x00, 0x19, 0x2A]))
    list.append(db, att_server.build_db_record(0x0016, 0x2A19, 0x0016, [0x00]))
    db

// A server with a characteristic that may be written only by an
// authenticated client, and the peer's CSRK of the example.
@tier(app)
fn signed_server() -> GattServer
    var s = host_server()
    let _ = add_service(var s.db, false, le16(0xAA00))
    let _ = add_characteristic(var s.db, 0x0A, PERM_READ_AUTHEN | PERM_WRITE_AUTHEN, le16(0xAA01))
    let _ = set_value(var s.db, 0, [0x00, 0x00])
    set_peer_csrk(var s.link, example_csrk())
    s

// An ATT_SIGNED_WRITE_CMD for `handle` with `value` and SignCounter
// `counter`, signed with the example's CSRK.
@tier(app)
fn signed_pdu(handle: Int, value: [u8], counter: Int) -> [u8]
    var m = octets([0xD2, handle & 0xFF, (handle >>> 8) & 0xFF])
    list.append(m, value)
    list.append(m,
        octets([counter & 0xFF, (counter >>> 8) & 0xFF, (counter >>> 16) & 0xFF, (counter >>> 24) & 0xFF]))
    list.append(m, signature_mac(m, example_csrk()))
    m

@test
fn test_database_hash_matches_appendix_b()
    var s = new_server(appendix_records(), 65)
    // An include declaration's record carries the included service in the
    // table's end group field, which `from_records` does not read; the
    // attribute it makes keeps the handle the record was built with.
    let include = s.db.attributes[14]
    s.db.attributes[14] = GattAttribute {
        handle: include.handle, type_uuid: include.type_uuid, value: include.value[:],
        max_len: include.max_len, permissions: include.permissions, key_size: include.key_size,
        tester: include.tester, included: 0x0014, per_link: false }
    refresh_hash(var s.db)
    // The example of Appendix B: m from 0x0001 to 0x0016 hashes to
    // F1CA2D48ECF58BAC8A8830BBB9FBA990 (most significant octet first),
    // so the characteristic value, a 128-bit little-endian integer, is
    // the same octets reversed.
    assert_bytes(database_hash(s.db),
        [0x90, 0xA9, 0xFB, 0xB9, 0xBB, 0x30, 0x88, 0x8A, 0xAC, 0x8B, 0xF5, 0xEC, 0x48, 0x2D, 0xCA, 0xF1])

@test
fn test_database_hash_follows_the_definitions()
    var s = host_server()
    let before = database_hash(s.db)
    test.assert_eq(list.len(before), HASH_OCTETS)
    test.assert(same_bytes(value_at(s.db, s.link, index_of(s.db, host_hash_handle())), before))
    // A service the tester adds enters the hash.
    let added = add_service(var s.db, false, le16(0xAA00))
    test.assert_eq(same_bytes(before, database_hash(s.db)), false)
    test.assert(same_bytes(value_at(s.db, s.link, index_of(s.db, host_hash_handle())), database_hash(s.db)))
    // So does a removal, and back again the hash is what it was.  The
    // range starts where the tester's service did: the host's own tables
    // end at the handle the GAP service's layout names.
    let after_add = database_hash(s.db)
    test.assert_eq(added, gatt_db.GAP_SERVER_GATT_END + 1)
    remove_range(var s.db, added, 0xFFFF)
    test.assert_eq(same_bytes(after_add, database_hash(s.db)), false)
    test.assert_eq(same_bytes(before, database_hash(s.db)), true)

// The Device Name and the Appearance of the GAP service take a write,
// with or without a response, and the value read back is the new one
// (GAP/GAT/BV-05-C and BV-06-C, [Vol 3] Part C, Section 12.1), when the
// program asked for them writable.
@test
fn test_the_device_name_and_appearance_are_writable()
    var s = host_server_with(true)
    let name = gatt_db.GAP_SERVER_DEVICE_NAME_HANDLE
    let appearance = gatt_db.GAP_SERVER_APPEARANCE_HANDLE
    // A Write Command, then a Write Request: both land.
    let _ = receive(var s.db, var s.link, octets([0x52, name & 0xFF, (name >>> 8) & 0xFF, 'A', 'B']), 0)
    assert_bytes(value_at(s.db, s.link, index_of(s.db, name)), ['A', 'B'])
    assert_bytes(one(receive(var s.db, var s.link, octets([0x12, name & 0xFF, (name >>> 8) & 0xFF, 'C']), 0)),
        [0x13])
    assert_bytes(value_at(s.db, s.link, index_of(s.db, name)), ['C'])
    assert_bytes(one(receive(var s.db, var s.link, octets([0x0A, name & 0xFF, (name >>> 8) & 0xFF]), 0)),
        [0x0B, 'C'])
    // The Appearance is two octets, and the declaration says so.
    assert_bytes(one(receive(var s.db,
        var s.link,
        octets([0x12, appearance & 0xFF, (appearance >>> 8) & 0xFF, 0x40, 0x00]),
        0)),
    [0x13])
    assert_bytes(value_at(s.db, s.link, index_of(s.db, appearance)), [0x40, 0x00])

// The database a program gets by default refuses a client's write to the
// Device Name and the Appearance with Write Not Permitted, and keeps them.
@test
fn test_the_device_name_and_appearance_are_read_only_by_default()
    var s = host_server()
    let name = gatt_db.GAP_SERVER_DEVICE_NAME_HANDLE
    let appearance = gatt_db.GAP_SERVER_APPEARANCE_HANDLE
    assert_error(receive(var s.db, var s.link, octets([0x12, name & 0xFF, (name >>> 8) & 0xFF, 'C']), 0),
        0x12,
        name,
        0x03)
    assert_error(receive(var s.db,
        var s.link,
        octets([0x12, appearance & 0xFF, (appearance >>> 8) & 0xFF, 0x40, 0x00]),
        0),
    0x12, appearance, 0x03)
    assert_bytes(value_at(s.db, s.link, index_of(s.db, name)), ['T', 'e', 's', 't'])

@test
fn test_client_supported_features_values()
    var s = host_server()
    // The default is all bits zero, one octet of value.
    let csf = gatt_db.GAP_SERVER_CLIENT_SUPPORTED_FEATURES_HANDLE
    assert_bytes(one(receive(var s.db, var s.link, octets([0x0A, csf & 0xFF, (csf >>> 8) & 0xFF]), 0)),
        [0x0B, 0x00])
    // The client sets the Robust Caching bit and all RFU bits; the RFU
    // bits are not features the server offers and stay zero.
    assert_bytes(one(receive(var s.db, var s.link, host_csf_request(0xF9), 0)), [0x13])
    test.assert_eq(s.link.csf, CSF_ROBUST_CACHING)
    assert_bytes(one(receive(var s.db, var s.link, octets([0x0A, csf & 0xFF, (csf >>> 8) & 0xFF]), 0)),
        [0x0B, 0x01])
    // A client shall not clear a bit it has set.
    assert_error(receive(var s.db, var s.link, host_csf_request(0x00), 0),
        0x12,
        csf,
        att.ATT_ERR_VALUE_NOT_ALLOWED)
    test.assert_eq(s.link.csf, CSF_ROBUST_CACHING)
    // Setting the bit again is no change, and a value that is not the
    // one octet of the bit field has no length.
    assert_bytes(one(receive(var s.db, var s.link, host_csf_request(0x01), 0)), [0x13])
    assert_error(receive(var s.db, var s.link, octets([0x12, csf & 0xFF, (csf >>> 8) & 0xFF]), 0),
        0x12,
        csf,
        att.ATT_ERR_INVALID_ATTRIBUTE_VALUE_LEN)
    assert_error(receive(var s.db, var s.link, octets([0x12, csf & 0xFF, (csf >>> 8) & 0xFF, 0x32, 0x32]), 0),
        0x12,
        csf,
        att.ATT_ERR_INVALID_ATTRIBUTE_VALUE_LEN)
    test.assert_eq(s.link.csf, CSF_ROBUST_CACHING)
    // The value a tester reads over BTP is the client's.
    test.assert_eq(tester_read(s.db, s.link, csf, true).1[0] as Int, CSF_ROBUST_CACHING)

@test
fn test_robust_caching_refuses_a_request_once_per_change()
    var s = host_server()
    let _ = add_service(var s.db, false, le16(0xAA00))
    let _ = add_characteristic(var s.db, 0x0A, PERM_READ | PERM_WRITE, le16(0xAA01))
    let _ = set_value(var s.db, 0, [0x11, 0x22])
    let value_handle = last_handle(s.db)
    // Robust caching off: a change leaves the client alone.
    let read = octets([0x0A, 0x03, 0x00])
    let _ = add_service(var s.db, false, le16(0xBB00))
    assert_bytes(one(receive(var s.db, var s.link, read, 0)),
        [0x0B, 'T' as Int, 'e' as Int, 's' as Int, 't' as Int])
    // Robust caching on: the change makes the client change-unaware and
    // the first request hears Database Out Of Sync.
    let _ = receive(var s.db, var s.link, host_csf_request(0x01), 0)
    let _ = add_service(var s.db, false, le16(0xCC00))
    assert_error(receive(var s.db, var s.link, read, 0), 0x0A, 0x0003, att.ATT_ERR_DATABASE_OUT_OF_SYNC)
    // The response goes out once; the next request is answered and makes
    // the client change-aware.
    assert_bytes(one(receive(var s.db, var s.link, read, 0)),
        [0x0B, 'T' as Int, 'e' as Int, 's' as Int, 't' as Int])
    // A change-unaware client's ATT command is ignored.
    let _ = add_service(var s.db, false, le16(0xDD00))
    assert_error(receive(var s.db, var s.link, read, 0), 0x0A, 0x0003, att.ATT_ERR_DATABASE_OUT_OF_SYNC)
    let _ = receive(var s.db,
        var s.link,
        octets([0x52, value_handle & 0xFF, (value_handle >>> 8) & 0xFF, 0x99, 0x99]),
        0)
    assert_bytes(one(receive(var s.db, var s.link, octets([0x0A, value_handle & 0xFF, (value_handle >>> 8) & 0xFF]), 0)),
        [0x0B, 0x11, 0x22])

@test
fn test_robust_caching_hash_read_clears_the_refusal()
    var s = host_server()
    let _ = receive(var s.db, var s.link, host_csf_request(0x01), 0)
    let _ = add_service(var s.db, false, le16(0xAA00))
    // The hash is read with Read Using Characteristic UUID, which a
    // change-unaware client hears whatever its range.
    let rsp = one(receive(var s.db, var s.link, octets([0x08, 0x01, 0x00, 0xFF, 0xFF, 0x2A, 0x2B]), 0))
    test.assert_eq(rsp[1] as Int, 2 + HASH_OCTETS)
    test.assert_eq(rsp[2] as Int, host_hash_handle() & 0xFF)
    assert_bytes(rsp[4:4 + HASH_OCTETS], database_hash(s.db))
    // The request after the hash read makes the client change-aware.
    assert_bytes(one(receive(var s.db, var s.link, octets([0x0A, 0x03, 0x00]), 0)),
        [0x0B, 'T' as Int, 'e' as Int, 's' as Int, 't' as Int])

@test
fn test_robust_caching_refuses_a_narrow_read_by_type()
    var s = host_server()
    let _ = receive(var s.db, var s.link, host_csf_request(0x01), 0)
    let _ = add_service(var s.db, false, le16(0xAA00))
    // Read By Type of a type that is neither «Include» nor
    // «Characteristic», over a range other than the whole database.
    assert_error(receive(var s.db, var s.link, octets([0x08, 0x01, 0x00, 0x10, 0x00, 0x00, 0xAA]), 0),
        0x08,
        0x0001,
        att.ATT_ERR_DATABASE_OUT_OF_SYNC)
    // Service discovery is answered even then: the whole range, and the
    // «Characteristic» type.
    let _ = add_service(var s.db, false, le16(0xBB00))
    test.assert_eq(list.len(one(receive(var s.db, var s.link, octets([0x08, 0x01, 0x00, 0xFF, 0xFF, 0x00, 0x28]), 0))) > 2,
        true)
    let _ = add_service(var s.db, false, le16(0xCC00))
    test.assert_eq(list.len(one(receive(var s.db, var s.link, octets([0x08, 0x01, 0x00, 0x10, 0x00, 0x03, 0x28]), 0))) > 2,
        true)
    // So are the other procedures that discover a service, and an MTU
    // exchange, which names no attribute.
    let _ = add_service(var s.db, false, le16(0xDD00))
    test.assert_eq(list.len(one(receive(var s.db, var s.link, octets([0x10, 0x01, 0x00, 0xFF, 0xFF, 0x00, 0x28]), 0))) > 2,
        true)
    let _ = add_service(var s.db, false, le16(0xEE00))
    test.assert_eq(list.len(one(receive(var s.db, var s.link, octets([0x04, 0x01, 0x00, 0xFF, 0xFF]), 0))) > 2,
        true)
    let _ = add_service(var s.db, false, le16(0xEF00))
    assert_bytes(one(receive(var s.db, var s.link, octets([0x02, 0x00, 0x01]), 0)), [0x03, 65, 0x00])

@test
fn test_robust_caching_holds_notifications_but_not_service_changed()
    var s = host_server()
    let _ = add_service(var s.db, false, le16(0xAA00))
    let _ = add_characteristic(var s.db, 0x12, PERM_READ | PERM_WRITE, le16(0xAA01))
    let _ = set_value(var s.db, 0, [0x07])
    let value_handle = last_handle(s.db)
    let cccd = add_descriptor(var s.db, PERM_READ | PERM_WRITE, le16(UUID_CLIENT_CHARACTERISTIC_CONFIGURATION))
    let _ = receive(var s.db, var s.link, octets([0x12, cccd & 0xFF, (cccd >>> 8) & 0xFF, 0x01, 0x00]), 0)
    let sc_cccd = gatt_db.GAP_SERVER_SERVICE_CHANGED_CCCD_HANDLE
    let _ = receive(var s.db, var s.link, octets([0x12, sc_cccd & 0xFF, (sc_cccd >>> 8) & 0xFF, 0x02, 0x00]), 0)
    let _ = receive(var s.db, var s.link, host_csf_request(0x01), 0)
    // The change makes the client change-unaware: a notification waits,
    // the Service Changed indication does not.
    let _ = add_service(var s.db, false, le16(0xBB00))
    test.assert_eq(list.len(send_value(var s.db, var s.link, value_handle, 0)), 0)
    test.assert_eq(list.len(service_changed(var s.db, var s.link, 0x0012, 0x0012, 0)), 1)
    assert_bytes(value_at(s.db, s.link, index_of(s.db, host_service_changed_handle(s))),
        [0x12, 0x00, 0x12, 0x00])
    // Confirming that indication makes the client change-aware.
    test.assert_eq(list.len(receive(var s.db, var s.link, octets([0x1E]), 0)), 0)
    test.assert_eq(s.link.change_unaware, false)
    assert_bytes(one(receive(var s.db, var s.link, octets([0x0A, 0x03, 0x00]), 0)),
        [0x0B, 'T' as Int, 'e' as Int, 's' as Int, 't' as Int])

@test
fn test_signature_matches_the_spec_example()
    // m = D2 12 00 13 37 with SignCounter 1, key 611B64EBFBCD1FD372EC9196DF425E50.
    let message = octets([0xD2, 0x12, 0x00, 0x13, 0x37, 0x01, 0x00, 0x00, 0x00])
    assert_bytes(signature_mac(message, example_csrk()), [0xF1, 0x87, 0x1E, 0x93, 0x3C, 0x90, 0x0F, 0xF2])

@test
fn test_signed_write_applies_a_verified_value()
    var s = signed_server()
    let handle = last_handle(s.db)
    // The link is not encrypted and the value needs authentication: a
    // Write Request is refused, the signature authenticates the client.
    assert_error(receive(var s.db, var s.link, octets([0x12, handle & 0xFF, (handle >>> 8) & 0xFF, 0x01]), 0),
        0x12,
        handle,
        att.ATT_ERR_INSUFFICIENT_AUTHENTICATION)
    let _ = receive(var s.db, var s.link, signed_pdu(handle, [0x13, 0x37], 1), 0)
    assert_bytes(value_at(s.db, s.link, index_of(s.db, handle)), [0x13, 0x37])
    test.assert_eq(s.link.sign_counter, 1)

// A signed write of the rig: GATT/SR/GAW/BV-02-C on 2026-10-11, where PTS
// signed the command D2 2F 00 02 23 45 67 89 AB CD EF with SignCounter 0
// and its CSRK E9E8E52FFF3782FAF49013B9ABD73797, carried least
// significant octet first, and the Authentication Signature came out
// 00000000 9BC0E7D6A285D709.  The example of Part F writes its key the
// way AES-CMAC takes it; a CSRK off the wire is the other way round, and
// reading one as the other is what this pins.
@test
fn test_signature_mac_of_a_pts_signed_write()
    let csrk: [u8] = [0xE9, 0xE8, 0xE5, 0x2F, 0xFF, 0x37, 0x82, 0xFA,
                      0xF4, 0x90, 0x13, 0xB9, 0xAB, 0xD7, 0x37, 0x97]
    let message: [u8] = [0xD2, 0x2F, 0x00, 0x02, 0x23, 0x45, 0x67,
                         0x89, 0xAB, 0xCD, 0xEF, 0x00, 0x00, 0x00, 0x00]
    assert_bytes(signature_mac(message, csrk), octets([0x9B, 0xC0, 0xE7, 0xD6, 0xA2, 0x85, 0xD7, 0x09]))
    // The server applies the write the signature authenticates.
    var s = signed_server()
    set_peer_csrk(var s.link, csrk)
    let handle = last_handle(s.db)
    var pdu = octets([0xD2, handle & 0xFF, (handle >>> 8) & 0xFF, 0x02])
    list.append(pdu, octets([0x00, 0x00, 0x00, 0x00]))
    list.append(pdu, signature_mac(pdu, csrk))
    let _ = receive(var s.db, var s.link, pdu, 0)
    assert_bytes(value_at(s.db, s.link, index_of(s.db, handle)), [0x02])

// The first signed command a client sends carries SignCounter 0 ([Vol 3]
// Part H, Section 2.4.5), so a server whose stored counter started at 0
// refused the first thing an authenticated client ever wrote --
// GATT/SR/GAW/BV-02-C, where PTS signed its first write with counter 0
// and read back the value it did not find.  The stored counter starts at
// -1: with nothing verified yet, any counter passes, 0 included, and a
// second command with a counter that is not greater is still refused.
@test
fn test_the_first_signed_write_uses_counter_zero()
    var s = signed_server()
    let handle = last_handle(s.db)
    test.assert_eq(s.link.sign_counter, -1)
    let _ = receive(var s.db, var s.link, signed_pdu(handle, [0x02], 0), 0)
    assert_bytes(value_at(s.db, s.link, index_of(s.db, handle)), [0x02])
    test.assert_eq(s.link.sign_counter, 0)
    let _ = receive(var s.db, var s.link, signed_pdu(handle, [0x03], 0), 0)
    assert_bytes(value_at(s.db, s.link, index_of(s.db, handle)), [0x02])
    let _ = receive(var s.db, var s.link, signed_pdu(handle, [0x04], 1), 0)
    assert_bytes(value_at(s.db, s.link, index_of(s.db, handle)), [0x04])
    test.assert_eq(s.link.sign_counter, 1)
    // A bearer that starts afresh has verified nothing again.
    reset_bearer(s.db, var s.link)
    set_peer_csrk(var s.link, example_csrk())
    test.assert_eq(s.link.sign_counter, -1)
    let _ = receive(var s.db, var s.link, signed_pdu(handle, [0x05], 0), 0)
    assert_bytes(value_at(s.db, s.link, index_of(s.db, handle)), [0x05])

@test
fn test_signed_write_refuses_what_it_cannot_verify()
    var s = signed_server()
    let handle = last_handle(s.db)
    let _ = receive(var s.db, var s.link, signed_pdu(handle, [0x13, 0x37], 7), 0)
    assert_bytes(value_at(s.db, s.link, index_of(s.db, handle)), [0x13, 0x37])
    // The same SignCounter again is a replay: the signature verifies but
    // the message has been seen.
    let _ = receive(var s.db, var s.link, signed_pdu(handle, [0x99, 0x99], 7), 0)
    assert_bytes(value_at(s.db, s.link, index_of(s.db, handle)), [0x13, 0x37])
    // A signature that does not verify.
    var bad = signed_pdu(handle, [0x77, 0x77], 8)
    bad[list.len(bad) - 1] = (bad[list.len(bad) - 1] as Int ^ 0xFF) as u8
    let _ = receive(var s.db, var s.link, bad, 0)
    assert_bytes(value_at(s.db, s.link, index_of(s.db, handle)), [0x13, 0x37])
    // A value longer than the characteristic.
    let _ = receive(var s.db, var s.link, signed_pdu(handle, [0x01, 0x02, 0x03], 9), 0)
    assert_bytes(value_at(s.db, s.link, index_of(s.db, handle)), [0x13, 0x37])
    // A handle that is no attribute.
    let _ = receive(var s.db, var s.link, signed_pdu(0x0999, [0x01], 10), 0)
    assert_bytes(value_at(s.db, s.link, index_of(s.db, handle)), [0x13, 0x37])
    // None of them is answered.
    test.assert_eq(list.len(receive(var s.db, var s.link, signed_pdu(handle, [0x01, 0x02], 11), 0)), 0)
    assert_bytes(value_at(s.db, s.link, index_of(s.db, handle)), [0x01, 0x02])
    test.assert_eq(s.link.sign_counter, 11)

@test
fn test_signed_write_without_a_csrk_is_ignored()
    var s = signed_server()
    let handle = last_handle(s.db)
    set_peer_csrk(var s.link, [])
    let _ = receive(var s.db, var s.link, signed_pdu(handle, [0x13, 0x37], 1), 0)
    assert_bytes(value_at(s.db, s.link, index_of(s.db, handle)), [0x00, 0x00])

@test
fn test_the_clients_state_survives_a_bond()
    var s = host_server()
    let _ = receive(var s.db, var s.link, host_csf_request(0x01), 0)
    let address = octets([1, 2, 3, 4, 5, 6])
    // A change during the connection, which the client catches up with by
    // reading the hash.
    let _ = add_service(var s.db, false, le16(0xAA00))
    let _ = receive(var s.db, var s.link, octets([0x08, 0x01, 0x00, 0xFF, 0xFF, 0x2A, 0x2B]), 0)
    let _ = receive(var s.db, var s.link, octets([0x0A, 0x03, 0x00]), 0)
    test.assert_eq(s.link.change_unaware, false)
    save_configuration(var s.db, s.link, 1, address)
    reset_bearer(s.db, var s.link)
    restore_configuration(s.db, var s.link, 1, address)
    test.assert_eq(s.link.csf, CSF_ROBUST_CACHING)
    test.assert_eq(s.link.change_unaware, false)
    // The database changes while the client is away: it comes back
    // change-unaware.
    let _ = add_service(var s.db, false, le16(0xBB00))
    reset_bearer(s.db, var s.link)
    restore_configuration(s.db, var s.link, 1, address)
    test.assert_eq(s.link.change_unaware, true)
    // A client without a trusted relationship starts change-aware, with
    // the default value.
    reset_bearer(s.db, var s.link)
    test.assert_eq(s.link.change_unaware, false)
    test.assert_eq(s.link.csf, 0)

// ── The ATT bearers of one connection ───────────────────────────────
//
// The unenhanced bearer is the table's first entry, and every channel of
// the Enhanced ATT PSM is another one ([Vol 3] Part G, Section 5.3).  The
// cases these tests follow are GATT/SR/GAC/BI-01-C (an MTU exchange is
// not one of an enhanced bearer's procedures), GATT/SR/GAW/BI-38-C (a
// signed write is not to be used on one) and GATT/SR/GAW/BV-12-C (queued
// writes of several bearers are written by one Execute Write Request).

// A server with an enhanced bearer at index 1, its channel number 0 and
// its ATT_MTU 100, and a characteristic that may be read and written.
@tier(app)
fn enhanced_server() -> GattServer
    var s = test_server()
    let _ = open_bearer(var s.link, 0, true, 100)
    s

// The value of the characteristic the test service's first characteristic
// holds, as the bearer `index` reads it.
@tier(app)
fn read_on(var s: GattServer, index: Int, handle: Int) -> [u8]
    let out = receive_on(var s.db, var s.link, index, octets([0x0A, handle & 0xFF, handle >>> 8]), 0)
    if list.len(out) == 0
        []
    else
        out[0]

// A server with a 200-octet readable value (its handle), an enhanced
// bearer at index 1 with the ATT_MTU `mtu`, and the unenhanced bearer.
@tier(app)
fn long_value_server(mtu: Int) -> (GattServer, Int)
    var s = new_server(records(), 65)
    let _ = add_service(var s.db, false, le16(0xAA00))
    let _ = add_characteristic(var s.db, 0x02, PERM_READ, le16(0xAA01))
    var long: [u8] = []
    for i in 0..200
        list.push(long, (i & 0xFF) as u8)
    let _ = set_value(var s.db, 0, long)
    let _ = open_bearer(var s.link, 0, true, mtu)
    (s, last_handle(s.db))

@test
fn test_an_enhanced_bearer_has_an_att_mtu_of_its_own()
    var setup = long_value_server(100)
    var s = setup.0
    let handle = setup.1
    test.assert_eq(bearer_count(s.link), 2)
    test.assert_eq(bearer_of_channel(s.link, 0, true), 1)
    test.assert_eq(channel_of_bearer(s.link, 1), 0)
    test.assert_eq(mtu_of(s.link, 1), 100)
    test.assert_eq(mtu_of(s.link, 0), ATT_DEFAULT_MTU)
    // The MTU exchange of the unenhanced bearer leaves the enhanced one
    // alone.
    let _ = receive(var s.db, var s.link, octets([0x02, 0x41, 0x00]), 0)
    test.assert_eq(mtu_of(s.link, 0), 65)
    test.assert_eq(mtu_of(s.link, 1), 100)
    // The same value read over the two bearers: each bearer's answer is
    // cut to its own ATT_MTU - 1 octets ([Vol 3] Part F, Section 3.4.4.4).
    let by_enhanced = read_on(var s, 1, handle)
    test.assert_eq(list.len(by_enhanced), 1 + 99)
    test.assert_eq(by_enhanced[1] as Int, 0x00)
    test.assert_eq(by_enhanced[99] as Int, 98)
    let by_unenhanced = read_on(var s, 0, handle)
    test.assert_eq(list.len(by_unenhanced), 1 + 64)
    test.assert_eq(by_unenhanced[64] as Int, 63)

@test
fn test_the_mtu_exchange_is_not_an_enhanced_bearers_procedure()
    var s = enhanced_server()
    // GATT/SR/GAC/BI-01-C: the request is answered Request Not Supported,
    // naming the request opcode and handle 0x0000.
    assert_error(receive_on(var s.db, var s.link, 1, octets([0x02, 0x00, 0x02]), 0),
        0x02,
        0,
        att.ATT_ERR_REQUEST_NOT_SUPPORTED)
    test.assert_eq(mtu_of(s.link, 1), 100)
    // A malformed one is answered the same way, not Invalid PDU.
    assert_error(receive_on(var s.db, var s.link, 1, octets([0x02, 0x41]), 0),
        0x02,
        0,
        att.ATT_ERR_REQUEST_NOT_SUPPORTED)
    // The unenhanced bearer's own exchange still answers with the Server
    // Rx MTU.
    assert_bytes(one(receive_on(var s.db, var s.link, 0, octets([0x02, 0x00, 0x02]), 0)), [0x03, 65, 0x00])

@test
fn test_a_signed_write_is_ignored_on_an_enhanced_bearer()
    var s = signed_server()
    let handle = last_handle(s.db)
    // GATT/SR/GAW/BI-38-C: the command is a valid one, signed with the
    // bond's CSRK and a counter this server has not seen, and it is
    // ignored all the same ([Vol 3] Part F, Section 3.4.5.4: "This
    // command shall not be used on an Enhanced ATT bearer").
    let _ = open_bearer(var s.link, 0, true, 100)
    let _ = receive_on(var s.db, var s.link, 1, signed_pdu(handle, [0x11, 0x22], 1), 0)
    assert_bytes(value_at(s.db, s.link, index_of(s.db, handle)), [0x00, 0x00])
    test.assert_eq(s.link.sign_counter, -1)
    // The same command on the unenhanced bearer is verified and written.
    let _ = receive_on(var s.db, var s.link, 0, signed_pdu(handle, [0x11, 0x22], 1), 0)
    assert_bytes(value_at(s.db, s.link, index_of(s.db, handle)), [0x11, 0x22])
    test.assert_eq(s.link.sign_counter, 1)

@test
fn test_each_bearer_keeps_its_own_outstanding_indication()
    var s = test_server()
    let _ = open_bearer(var s.link, 0, true, 100)
    set_configuration(var s.link, 0x0013, CCC_INDICATION)
    // One indication waits on each bearer, and each is confirmed on its
    // own ([Vol 3] Part F, Section 3.2.11: an ATT bearer has its own
    // transaction state, and one outstanding request per bearer is what
    // that means).
    assert_bytes(one(send_value_on(s.db, var s.link, 1, 0x0012, 0)), [0x1D, 0x12, 0x00, 0x44, 0x45])
    assert_bytes(one(send_value_on(s.db, var s.link, 0, 0x0012, 0)), [0x1D, 0x12, 0x00, 0x44, 0x45])
    // A second indication on one bearer waits behind the one that is
    // outstanding there, and the other bearer is none of its business.
    test.assert_eq(list.len(send_value_on(s.db, var s.link, 1, 0x0012, 0)), 0)
    test.assert_eq(list.len(send_value_on(s.db, var s.link, 0, 0x0012, 0)), 0)
    // Each confirmation releases what waited on its own bearer, and the
    // next confirmation of an idle bearer is answered with nothing.
    assert_bytes(one(receive_on(var s.db, var s.link, 1, octets([0x1E]), 0)), [0x1D, 0x12, 0x00, 0x44, 0x45])
    assert_bytes(one(receive_on(var s.db, var s.link, 0, octets([0x1E]), 0)), [0x1D, 0x12, 0x00, 0x44, 0x45])
    test.assert_eq(list.len(receive_on(var s.db, var s.link, 0, octets([0x1E]), 0)), 0)
    // A transaction that times out ends that bearer alone: the ATT_MTU of
    // an enhanced bearer comes from its channel, but its transaction state
    // is its own ([Vol 3] Part F, Section 3.2.11).
    test.assert_eq(s.link.bearers[1].indicating, 0x0012)
    tick(var s.link, ATT_TRANSACTION_TIMEOUT_MS)
    test.assert_eq(s.link.bearers[1].timed_out, true)
    test.assert_eq(s.link.bearers[0].timed_out, false)
    test.assert_eq(list.len(receive_on(var s.db, var s.link, 1, octets([0x0A, 0x0A, 0x00]), 0)), 0)
    test.assert(list.len(receive_on(var s.db, var s.link, 0, octets([0x0A, 0x0A, 0x00]), 0)) > 0)

@test
fn test_the_prepare_queue_belongs_to_the_client_not_to_a_bearer()
    var s = test_server()
    let _ = open_bearer(var s.link, 0, true, 100)
    // GATT/SR/GAW/BV-12-C: the parts are prepared with roll-over over the
    // bearers, and the Execute Write Request on any of them writes all of
    // them ([Vol 3] Part F, Section 3.4.6.4).
    let part_one = octets([0x16, 0x0A, 0x00, 0x00, 0x00, 0x01, 0x02])
    let part_two = octets([0x16, 0x0A, 0x00, 0x02, 0x00, 0x03, 0x04])
    let first = receive_on(var s.db, var s.link, 1, part_one, 0)
    test.assert_eq(list.len(first), 1)
    test.assert_eq(list.len(s.link.prepare_queue), 1)
    let second = receive_on(var s.db, var s.link, 0, part_two, 0)
    test.assert_eq(list.len(second), 1)
    test.assert_eq(list.len(s.link.prepare_queue), 2)
    let done = receive_on(var s.db, var s.link, 0, octets([0x18, 0x01]), 0)
    assert_bytes(one(done), [0x19])
    test.assert_eq(list.len(s.link.prepare_queue), 0)
    assert_bytes(value_at(s.db, s.link, index_of(s.db, 0x000A)), [0x01, 0x02, 0x03, 0x04])

@test
fn test_an_execute_write_after_a_database_change_is_database_out_of_sync()
    // GATT/SR/GAW/BI-41-C: the Lower Tester prepares a write, the IUT's
    // database changes -- the attribute the part names is removed -- and
    // the Execute Write Request that follows is answered Database Out Of
    // Sync (0x12) with the handle of the part, and nothing is written
    // ([Vol 3] Part F, Section 3.4.6.3 as the ATT v6.1 text has it).
    var s = test_server()
    let prepared = receive(var s.db, var s.link, octets([0x16, 0x0A, 0x00, 0x00, 0x00, 0x09]), 0)
    assert_bytes(one(prepared), [0x17, 0x0A, 0x00, 0x00, 0x00, 0x09])
    test.assert_eq(list.len(s.link.prepare_queue), 1)
    remove_range(var s.db, 0x000A, 0x000A)
    assert_error(receive(var s.db, var s.link, octets([0x18, 0x01]), 0),
        0x18,
        0x000A,
        att.ATT_ERR_DATABASE_OUT_OF_SYNC)
    test.assert_eq(list.len(s.link.prepare_queue), 0)
    // A queue the definitions did not move under is written as always:
    // the check above is the change alone.
    let again = receive(var s.db, var s.link, octets([0x16, 0x12, 0x00, 0x00, 0x00, 0x09]), 0)
    assert_bytes(one(again), [0x17, 0x12, 0x00, 0x00, 0x00, 0x09])
    let written = receive(var s.db, var s.link, octets([0x18, 0x01]), 0)
    assert_bytes(one(written), [0x19])
    assert_bytes(value_at(s.db, s.link, index_of(s.db, 0x0012)), [0x09])

@test
fn test_the_bearer_table_follows_the_channels_the_link_holds()
    var s = test_server()
    test.assert_eq(bearer_count(s.link), 1)
    test.assert_eq(bearer_of_channel(s.link, 0, true), -1)
    test.assert_eq(open_bearer(var s.link, 2, true, 64), 1)
    test.assert_eq(open_bearer(var s.link, 3, true, 64), 2)
    test.assert_eq(bearer_count(s.link), 3)
    // Opening a bearer that is there only moves its ATT_MTU: a channel
    // whose L2CAP MTU was reconfigured moves the bearer's with it.
    test.assert_eq(open_bearer(var s.link, 2, true, 128), 1)
    test.assert_eq(bearer_count(s.link), 3)
    test.assert_eq(mtu_of(s.link, 1), 128)
    // The bearer of a channel the link no longer holds is gone; the
    // unenhanced bearer stays whatever the list says.
    retain_bearers(var s.link, [3])
    test.assert_eq(bearer_count(s.link), 2)
    test.assert_eq(bearer_of_channel(s.link, 2, true), -1)
    test.assert_eq(bearer_of_channel(s.link, 3, true), 1)
    retain_bearers(var s.link, [])
    test.assert_eq(bearer_count(s.link), 1)
    test.assert_eq(mtu_of(s.link, 0), ATT_DEFAULT_MTU)
    // A bearer index outside the table reads as the default and no
    // channel.
    test.assert_eq(bearer_of_channel(s.link, 9, true), -1)
    test.assert_eq(mtu_of(s.link, 7), ATT_DEFAULT_MTU)
    test.assert_eq(channel_of_bearer(s.link, 7), 0)

@test
fn test_the_enhanced_att_bit_is_what_the_client_sets()
    var s = host_server()
    // GATT/SR/GAC/BI-01-C's preamble: the client writes 0x0002, "The
    // client supports Enhanced ATT bearer" ([Vol 3] Part G, Table 7.6,
    // bit 1 of octet 0).
    let _ = receive(var s.db, var s.link, host_csf_request(CSF_ENHANCED_ATT), 0)
    test.assert_eq(s.link.csf, CSF_ENHANCED_ATT)
    // Robust Caching and it together, and a bit this device does not
    // support is dropped from the value it keeps.
    let _ = receive(var s.db, var s.link, host_csf_request(CSF_ROBUST_CACHING | CSF_ENHANCED_ATT | 0x04), 0)
    test.assert_eq(s.link.csf, CSF_ROBUST_CACHING | CSF_ENHANCED_ATT)

// ── Access levels and the configuration descriptor's own access ─────

@test
fn test_access_levels_map_to_permission_bits()
    test.assert_eq(permission_bits(Permissions { read: Access.Denied, write: Access.Denied }), 0)
    test.assert_eq(permission_bits(open_permissions()), PERM_READ | PERM_WRITE)
    test.assert_eq(permission_bits(Permissions { read: Access.Encrypted, write: Access.Open }),
        PERM_READ_ENCRYPT | PERM_WRITE)
    test.assert_eq(permission_bits(Permissions { read: Access.Open, write: Access.Authenticated }),
        PERM_READ | PERM_WRITE_AUTHEN)
    test.assert_eq(permission_bits(both_ways(Access.Authorized)), PERM_READ_AUTHOR | PERM_WRITE_AUTHOR)
    test.assert_eq(permission_bits(both_ways(Access.SecureConnections)),
        PERM_READ_AUTHEN | PERM_READ_SC | PERM_WRITE_AUTHEN | PERM_WRITE_SC)

@tier(app)
fn level_server(read: Access, write: Access) -> GattServer
    var s = new_server([], 65)
    test.assert_eq(add_service(var s.db, false, le16(0xAA00)), 1)
    test.assert_eq(add_characteristic(var s.db, 0x0A, permission_bits(Permissions { read: read, write: write }), le16(0xAA01)),
        2)
    test.assert(set_value(var s.db, 0, [0x07]))
    s

@tier(app)
fn read_of(var s: GattServer) -> [[u8]]
    receive(var s.db, var s.link, octets([0x0A, 0x03, 0x00]), 0)

@tier(app)
fn write_of(var s: GattServer) -> [[u8]]
    receive(var s.db, var s.link, octets([0x12, 0x03, 0x00, 0x09]), 0)

@test
fn test_every_access_level_is_enforced_for_reads()
    // Denied.
    var denied = level_server(Access.Denied, Access.Denied)
    assert_error(read_of(var denied), 0x0A, 3, att.ATT_ERR_READ_NOT_PERMITTED)
    // Open.
    var open = level_server(Access.Open, Access.Open)
    assert_bytes(one(read_of(var open)), [0x0B, 0x07])
    // Authorized: no client is.
    var authorized = level_server(Access.Authorized, Access.Open)
    assert_error(read_of(var authorized), 0x0A, 3, att.ATT_ERR_INSUFFICIENT_AUTHORIZATION)
    // Encrypted: no key, a key but no encryption, encryption.
    var enc = level_server(Access.Encrypted, Access.Open)
    assert_error(read_of(var enc), 0x0A, 3, att.ATT_ERR_INSUFFICIENT_AUTHENTICATION)
    set_security(var enc.link, link_security(false, 1, 0, true))
    assert_error(read_of(var enc), 0x0A, 3, att.ATT_ERR_INSUFFICIENT_ENCRYPTION)
    set_security(var enc.link, encrypted(2, 16))
    assert_bytes(one(read_of(var enc)), [0x0B, 0x07])
    // Authenticated: level 2 is not enough, level 3 is.
    var auth = level_server(Access.Authenticated, Access.Open)
    set_security(var auth.link, encrypted(2, 16))
    assert_error(read_of(var auth), 0x0A, 3, att.ATT_ERR_INSUFFICIENT_AUTHENTICATION)
    set_security(var auth.link, encrypted(3, 16))
    assert_bytes(one(read_of(var auth)), [0x0B, 0x07])
    // Secure Connections: level 3 is not enough, level 4 is.
    var sc = level_server(Access.SecureConnections, Access.Open)
    assert_error(read_of(var sc), 0x0A, 3, att.ATT_ERR_INSUFFICIENT_AUTHENTICATION)
    set_security(var sc.link, encrypted(3, 16))
    assert_error(read_of(var sc), 0x0A, 3, att.ATT_ERR_INSUFFICIENT_AUTHENTICATION)
    set_security(var sc.link, encrypted(4, 16))
    assert_bytes(one(read_of(var sc)), [0x0B, 0x07])

@test
fn test_every_access_level_is_enforced_for_writes()
    var denied = level_server(Access.Open, Access.Denied)
    assert_error(write_of(var denied), 0x12, 3, att.ATT_ERR_WRITE_NOT_PERMITTED)
    var open = level_server(Access.Open, Access.Open)
    assert_bytes(one(write_of(var open)), [0x13])
    var authorized = level_server(Access.Open, Access.Authorized)
    assert_error(write_of(var authorized), 0x12, 3, att.ATT_ERR_INSUFFICIENT_AUTHORIZATION)
    var enc = level_server(Access.Open, Access.Encrypted)
    assert_error(write_of(var enc), 0x12, 3, att.ATT_ERR_INSUFFICIENT_AUTHENTICATION)
    set_security(var enc.link, link_security(false, 1, 0, true))
    assert_error(write_of(var enc), 0x12, 3, att.ATT_ERR_INSUFFICIENT_ENCRYPTION)
    set_security(var enc.link, encrypted(2, 16))
    assert_bytes(one(write_of(var enc)), [0x13])
    var auth = level_server(Access.Open, Access.Authenticated)
    set_security(var auth.link, encrypted(2, 16))
    assert_error(write_of(var auth), 0x12, 3, att.ATT_ERR_INSUFFICIENT_AUTHENTICATION)
    set_security(var auth.link, encrypted(3, 16))
    assert_bytes(one(write_of(var auth)), [0x13])
    var sc = level_server(Access.Open, Access.SecureConnections)
    set_security(var sc.link, encrypted(3, 16))
    assert_error(write_of(var sc), 0x12, 3, att.ATT_ERR_INSUFFICIENT_AUTHENTICATION)
    set_security(var sc.link, encrypted(4, 16))
    assert_bytes(one(write_of(var sc)), [0x13])

@tier(app)
fn notify_server(cccd: Permissions) -> GattServer
    var s = new_server([], 65)
    test.assert_eq(add_service(var s.db, false, le16(0xAA00)), 1)
    test.assert_eq(add_characteristic(var s.db, PROP_NOTIFY, 0, le16(0xAA01)), 2)
    test.assert(set_value(var s.db, 0, [0x05]))
    test.assert_eq(add_configuration(var s.db, cccd), 4)
    s

@tier(app)
fn subscribe(var s: GattServer) -> [[u8]]
    receive(var s.db, var s.link, octets([0x12, 0x04, 0x00, 0x01, 0x00]), 0)

@test
fn test_a_configuration_descriptor_takes_its_own_access()
    // Write needs encryption, read is open: a client in the clear can read
    // the descriptor but not subscribe.
    var s = notify_server(Permissions { read: Access.Open, write: Access.Encrypted })
    test.assert_eq(permission_bits_of(s, 4), PERM_READ | PERM_WRITE_ENCRYPT)
    assert_bytes(one(receive(var s.db, var s.link, octets([0x0A, 0x04, 0x00]), 0)), [0x0B, 0x00, 0x00])
    assert_error(subscribe(var s), 0x12, 4, att.ATT_ERR_INSUFFICIENT_AUTHENTICATION)
    set_security(var s.link, link_security(false, 1, 0, true))
    assert_error(subscribe(var s), 0x12, 4, att.ATT_ERR_INSUFFICIENT_ENCRYPTION)
    test.assert_eq(configuration(s.link, 4), 0)
    set_security(var s.link, encrypted(2, 16))
    assert_bytes(one(subscribe(var s)), [0x13])
    test.assert_eq(configuration(s.link, 4), CCC_NOTIFICATION)
    // The value is notify-only, yet it goes out once subscribed.
    assert_bytes(one(send_value(var s.db, var s.link, 3, 0)), [0x1B, 0x03, 0x00, 0x05])
    assert_error(receive(var s.db, var s.link, octets([0x0A, 0x03, 0x00]), 0),
        0x0A,
        3,
        att.ATT_ERR_READ_NOT_PERMITTED)

@tier(app)
fn permission_bits_of(s: GattServer, handle: Int) -> Int
    s.db.attributes[index_of(s.db, handle)].permissions

@test
fn test_a_configuration_descriptor_refuses_each_level()
    var enc = notify_server(Permissions { read: Access.Encrypted, write: Access.Encrypted })
    assert_error(receive(var enc.db, var enc.link, octets([0x0A, 0x04, 0x00]), 0),
        0x0A,
        4,
        att.ATT_ERR_INSUFFICIENT_AUTHENTICATION)
    var auth = notify_server(Permissions { read: Access.Open, write: Access.Authenticated })
    set_security(var auth.link, encrypted(2, 16))
    assert_error(subscribe(var auth), 0x12, 4, att.ATT_ERR_INSUFFICIENT_AUTHENTICATION)
    set_security(var auth.link, encrypted(3, 16))
    assert_bytes(one(subscribe(var auth)), [0x13])
    var sc = notify_server(Permissions { read: Access.Open, write: Access.SecureConnections })
    set_security(var sc.link, encrypted(3, 16))
    assert_error(subscribe(var sc), 0x12, 4, att.ATT_ERR_INSUFFICIENT_AUTHENTICATION)
    set_security(var sc.link, encrypted(4, 16))
    assert_bytes(one(subscribe(var sc)), [0x13])
    var authorized = notify_server(Permissions { read: Access.Open, write: Access.Authorized })
    assert_error(subscribe(var authorized), 0x12, 4, att.ATT_ERR_INSUFFICIENT_AUTHORIZATION)
    var denied = notify_server(Permissions { read: Access.Open, write: Access.Denied })
    assert_error(subscribe(var denied), 0x12, 4, att.ATT_ERR_WRITE_NOT_PERMITTED)

@test
fn test_a_subscription_is_not_served_on_a_weaker_link()
    var s = notify_server(Permissions { read: Access.Open, write: Access.Encrypted })
    // A subscription kept from an earlier encrypted link does not make the
    // value go out on a link that is not encrypted.
    set_configuration(var s.link, 4, CCC_NOTIFICATION)
    test.assert_eq(list.len(send_value(var s.db, var s.link, 3, 0)), 0)
    set_security(var s.link, encrypted(2, 16))
    test.assert_eq(list.len(send_value(var s.db, var s.link, 3, 0)), 1)

@test
fn test_add_configuration_checks_the_characteristic()
    var s = new_server([], 65)
    test.assert_eq(add_configuration(var s.db, open_permissions()), -1)
    test.assert_eq(add_service(var s.db, false, le16(0xAA00)), 1)
    test.assert_eq(add_configuration(var s.db, open_permissions()), -1)
    // A characteristic that neither notifies nor indicates takes none.
    test.assert_eq(add_characteristic(var s.db, PROP_READ, PERM_READ, le16(0xAA01)), 2)
    test.assert_eq(add_configuration(var s.db, open_permissions()), -1)
    test.assert_eq(add_characteristic(var s.db, PROP_INDICATE, 0, le16(0xAA02)), 4)
    test.assert_eq(add_configuration(var s.db, open_permissions()), 6)
    // Only one per characteristic.
    test.assert_eq(add_configuration(var s.db, open_permissions()), -1)

@tier(app)
fn control_point_server() -> GattServer
    var s = new_server([], 65)
    test.assert_eq(add_service(var s.db, false, le16(0xAA00)), 1)
    test.assert_eq(add_characteristic(var s.db, PROP_WRITE | PROP_INDICATE, PERM_WRITE, le16(0xAA01)), 2)
    test.assert_eq(add_configuration(var s.db, open_permissions()), 4)
    test.assert(require_indication(var s.db, 3, 0x81, 0x80))
    s

@test
fn test_a_control_point_write_needs_an_indication_subscription()
    var s = control_point_server()
    assert_error(receive(var s.db, var s.link, octets([0x12, 0x03, 0x00, 0x01]), 0), 0x12, 3, 0x81)
    test.assert_eq(list.len(take_changed(var s.link)), 0)
    // A subscription to notifications is not one to indications.
    set_configuration(var s.link, 4, CCC_NOTIFICATION)
    assert_error(receive(var s.db, var s.link, octets([0x12, 0x03, 0x00, 0x01]), 0), 0x12, 3, 0x81)
    // A command is dropped without a response.
    set_configuration(var s.link, 4, 0)
    test.assert_eq(list.len(receive(var s.db, var s.link, octets([0x52, 0x03, 0x00, 0x01]), 0)), 0)
    set_configuration(var s.link, 4, CCC_INDICATION)
    assert_bytes(one(receive(var s.db, var s.link, octets([0x12, 0x03, 0x00, 0x01]), 0)), [0x13])
    test.assert_eq(take_changed(var s.link)[0], 3)

@test
fn test_a_control_point_write_waits_for_the_unconfirmed_indication()
    var s = control_point_server()
    set_configuration(var s.link, 4, CCC_INDICATION)
    let _ = receive(var s.db, var s.link, octets([0x12, 0x03, 0x00, 0x01]), 0)
    assert_bytes(one(send_value(var s.db, var s.link, 3, 0)), [0x1D, 0x03, 0x00, 0x01])
    assert_error(receive(var s.db, var s.link, octets([0x12, 0x03, 0x00, 0x02]), 0), 0x12, 3, 0x80)
    // The confirmation ends the wait.
    test.assert_eq(list.len(receive(var s.db, var s.link, octets([0x1E]), 0)), 0)
    assert_bytes(one(receive(var s.db, var s.link, octets([0x12, 0x03, 0x00, 0x02]), 0)), [0x13])
    // A prepared write is held to the same rule.
    set_configuration(var s.link, 4, 0)
    assert_error(receive(var s.db, var s.link, octets([0x16, 0x03, 0x00, 0x00, 0x00, 0x01]), 0), 0x16, 3, 0x81)

@test
fn test_a_write_is_restricted_to_the_first_octets_allowed()
    var s = new_server([], 65)
    test.assert_eq(add_service(var s.db, false, le16(0xAA00)), 1)
    test.assert_eq(add_characteristic(var s.db, PROP_WRITE, PERM_WRITE, le16(0xAA01)), 2)
    test.assert(restrict_first_octet(var s.db, 3, [1, 2], 0x80))
    test.assert_eq(restrict_first_octet(var s.db, 0x99, [1], 0x80), false)
    assert_bytes(one(receive(var s.db, var s.link, octets([0x12, 0x03, 0x00, 0x02]), 0)), [0x13])
    assert_error(receive(var s.db, var s.link, octets([0x12, 0x03, 0x00, 0x03]), 0), 0x12, 3, 0x80)
    assert_error(receive(var s.db, var s.link, octets([0x12, 0x03, 0x00]), 0), 0x12, 3, 0x80)
    test.assert_eq(require_indication(var s.db, 3, 0x81, 0x80), false)

@test
@satisfies("REQ-BLE-GAF-008")
fn test_a_write_is_held_to_the_format_rule_of_its_attribute()
    var s = new_server([], 65)
    test.assert_eq(add_service(var s.db, false, le16(0xAA00)), 1)
    test.assert_eq(add_characteristic(var s.db, PROP_READ | PROP_WRITE, PERM_READ | PERM_WRITE, le16(0xAA01)), 2)
    test.assert(set_value(var s.db, 3, octets([1, 0, 0, 0])))
    // Four octets, the top four bits clear, Write Request Rejected otherwise.
    test.assert(require_value_format(var s.db, 3, 4, 0xF0000000, 0xFC))
    test.assert_eq(require_value_format(var s.db, 0x99, 4, 0, 0xFC), false)
    assert_bytes(one(receive(var s.db, var s.link, octets([0x12, 0x03, 0x00, 0x00, 0x00, 0x00, 0x08]), 0)),
        [0x13])
    assert_bytes(s.db.attributes[2].value, [0x00, 0x00, 0x00, 0x08])
    assert_error(receive(var s.db, var s.link, octets([0x12, 0x03, 0x00, 0x00, 0x00, 0x00, 0x10]), 0),
        0x12,
        3,
        0xFC)
    assert_error(receive(var s.db, var s.link, octets([0x12, 0x03, 0x00, 0x01, 0x00, 0x00]), 0), 0x12, 3, 0xFC)
    assert_error(receive(var s.db, var s.link, octets([0x12, 0x03, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00]), 0),
        0x12,
        3,
        0xFC)
    assert_error(receive(var s.db, var s.link, octets([0x12, 0x03, 0x00]), 0), 0x12, 3, 0xFC)
    // A command is held to it too, and so is a prepared write, when the
    // queue is executed.
    test.assert_eq(list.len(receive(var s.db, var s.link, octets([0x52, 0x03, 0x00, 0x01]), 0)), 0)
    assert_bytes(s.db.attributes[2].value, [0x00, 0x00, 0x00, 0x08])
    assert_bytes(one(receive(var s.db, var s.link, octets([0x16, 0x03, 0x00, 0x01, 0x00, 0x05]), 0)),
        [0x17, 0x03, 0x00, 0x01, 0x00, 0x05])
    assert_error(receive(var s.db, var s.link, octets([0x18, 0x01]), 0), 0x18, 3, 0xFC)
    // A rule of length -1 checks only the reserved bits.
    test.assert(require_value_format(var s.db, 3, -1, 0x80, 0xFC))
    assert_bytes(value_format_octets(s.db), [0xFC])

// The Error Code a write of one octet with the reserved bit set is answered
// with under the rules of attribute 3, for a test to read.
@tier(app)
fn value_format_octets(db: GattDb) -> [u8]
    [value_format_error(db, 3, 0, octets([0x80])) as u8]

// A write rule that lets every write through.
fn no_rule(kind: Int, write: Bool, value: [u8], offset: Int, a: [u8], b: [u8], c: [u8], x: Int,
           y: Int, z: Int) -> Int
    0

@test
fn test_a_new_link_is_not_encrypted_and_a_new_database_holds_its_records()
    let none = gatt_server.no_security()
    test.assert(not none.encrypted)
    test.assert_eq(none.level, 1)
    test.assert_eq(none.key_size, 0)
    test.assert(not none.has_ltk)
    let db = gatt_server.new_db(records(), 65)
    test.assert_eq(list.len(db.attributes), 7)
    test.assert_eq(db.rx_mtu, 65)
    var link = gatt_server.new_att_link(db)
    test.assert_eq(link.identity, 0)
    gatt_server.set_identity(var link, 7)
    test.assert_eq(link.identity, 7)

@test
fn test_an_attribute_is_of_the_type_its_declaration_names()
    let db = gatt_server.new_db(records(), 65)
    test.assert(gatt_server.is_type(db.attributes[0], gatt_server.UUID_PRIMARY_SERVICE))
    test.assert(not gatt_server.is_type(db.attributes[0], gatt_server.UUID_CHARACTERISTIC))
    test.assert(gatt_server.is_type(db.attributes[1], gatt_server.UUID_CHARACTERISTIC))

@test
fn test_access_error_names_the_refusal_a_link_earns()
    var s = test_server()
    let plain = gatt_server.index_of(s.db, 0x000A)
    let encrypted_only = gatt_server.index_of(s.db, 0x000C)
    let authenticated = gatt_server.index_of(s.db, 0x000E)
    let authorized = gatt_server.index_of(s.db, 0x0010)
    test.assert_eq(gatt_server.access_error(s.db, s.link, plain, false), 0)
    test.assert_eq(gatt_server.access_error(s.db, s.link, plain, true), 0)
    // A declaration cannot be written.
    test.assert_eq(gatt_server.access_error(s.db, s.link, gatt_server.index_of(s.db, 0x0009), true),
        att.ATT_ERR_WRITE_NOT_PERMITTED)
    // Encryption: a link with a key is asked to encrypt, one without is asked to pair.
    test.assert_eq(gatt_server.access_error(s.db, s.link, encrypted_only, false),
        att.ATT_ERR_INSUFFICIENT_AUTHENTICATION)
    gatt_server.set_security(var s.link, gatt_server.link_security(false, 1, 0, true))
    test.assert_eq(gatt_server.access_error(s.db, s.link, encrypted_only, false),
        att.ATT_ERR_INSUFFICIENT_ENCRYPTION)
    gatt_server.set_security(var s.link, gatt_server.link_security(true, 2, 16, true))
    test.assert_eq(gatt_server.access_error(s.db, s.link, encrypted_only, false), 0)
    test.assert_eq(gatt_server.access_error(s.db, s.link, authenticated, false),
        att.ATT_ERR_INSUFFICIENT_AUTHENTICATION)
    gatt_server.set_security(var s.link, gatt_server.link_security(true, 3, 16, true))
    test.assert_eq(gatt_server.access_error(s.db, s.link, authenticated, false), 0)
    test.assert_eq(gatt_server.access_error(s.db, s.link, authorized, false),
        att.ATT_ERR_INSUFFICIENT_AUTHORIZATION)

@test
fn test_a_write_guard_keeps_data_and_an_owner_for_its_handle()
    var s = control_point_server()
    test.assert(not gatt_server.add_write_guard(var s.db, 0x0099, no_rule, 1, 0, 0, [1]))
    test.assert(gatt_server.add_write_guard(var s.db, 3, no_rule, 1, 0, 0, [1, 2]))
    test.assert_eq(list.len(gatt_server.guard_data(s.db, 3)), 2)
    test.assert_eq(list.len(gatt_server.guard_data(s.db, 0x0099)), 0)
    test.assert(gatt_server.set_guard_data(var s.db, 3, [9]))
    test.assert_eq(gatt_server.guard_data(s.db, 3)[0] as Int, 9)
    test.assert(not gatt_server.set_guard_data(var s.db, 0x0099, [9]))
    test.assert_eq(gatt_server.guard_owner(s.db, 3), 0)
    test.assert(gatt_server.set_guard_owner(var s.db, 3, 5))
    test.assert_eq(gatt_server.guard_owner(s.db, 3), 5)
    test.assert(not gatt_server.set_guard_owner(var s.db, 0x0099, 5))
    test.assert_eq(gatt_server.guard_owner(s.db, 0x0099), 0)

@test
fn test_the_longest_value_a_client_may_write_is_set_for_a_value_and_refused_for_a_declaration()
    var s = new_server([], 65)
    test.assert_eq(add_service(var s.db, false, le16(0xAA00)), 1)
    test.assert_eq(add_characteristic(var s.db, PROP_WRITE, PERM_WRITE, le16(0xAA01)), 2)
    test.assert(gatt_server.set_max_length(var s.db, 3, 20))
    test.assert(gatt_server.set_max_length(var s.db, 3, 0))
    test.assert(not gatt_server.set_max_length(var s.db, 3, -1))
    test.assert(not gatt_server.set_max_length(var s.db, 3, gatt_server.ATT_VALUE_MAX + 1))
    test.assert(not gatt_server.set_max_length(var s.db, 0x0099, 4))
    // The service declaration and the characteristic declaration take no value.
    test.assert(not gatt_server.set_max_length(var s.db, 1, 4))
    test.assert(not gatt_server.set_max_length(var s.db, 2, 4))

@test
fn test_an_indication_is_pending_from_its_send_until_its_confirmation()
    var s = control_point_server()
    test.assert(not gatt_server.indication_pending(s.link, 3))
    set_configuration(var s.link, 4, CCC_INDICATION)
    let _ = send_value(var s.db, var s.link, 3, 0)
    test.assert(gatt_server.indication_pending(s.link, 3))
    test.assert(not gatt_server.indication_pending(s.link, 2))
    // A second one waits behind the first and is pending too.
    let _ = send_value(var s.db, var s.link, 3, 0)
    test.assert(gatt_server.indication_pending(s.link, 3))
    let _ = receive(var s.db, var s.link, octets([0x1E]), 0)
    let _ = receive(var s.db, var s.link, octets([0x1E]), 0)
    test.assert(not gatt_server.indication_pending(s.link, 3))

// A rule that tells what it was given in the Error Code it answers: 0x80 plus 1 for a state value, 2 for a properties value, 4 for a
// subscription and 8 for a recorded owner, 0 for a write of the value 0, and 0x82 for any read of a rule of the kind 9.
fn tagging_rule(kind: Int, read: Bool, value: [u8], offset: Int, state: [u8], props: [u8],
                data: [u8], ccc: Int, owner: Int, writer: Int) -> Int
    if read
        if kind == 9
            return 0x82
        return 0
    if list.len(value) > 0 and (value[0] as Int) == 0
        return 0
    var code = 0x80
    if list.len(state) > 0
        code = code + 1
    if list.len(props) > 0
        code = code + 2
    if ccc != 0
        code = code + 4
    if owner != 0
        code = code + 8
    code

@test
fn test_a_write_guard_is_given_the_state_the_properties_the_subscription_and_the_owner_of_its_attribute()
    // No state or properties attribute: the rule sees neither; the client is subscribed to the attribute's indications.
    var s = control_point_server()
    set_configuration(var s.link, 4, CCC_INDICATION)
    test.assert(gatt_server.add_write_guard(var s.db, 3, tagging_rule, 1, 0, 0, []))
    test.assert_eq(answer(var s, [0x12, 0x03, 0x00, 0x01]), "01 12 03 00 84")
    test.assert_eq(answer(var s, [0x12, 0x03, 0x00, 0x00]), "13")
    // State and properties attributes that hold values, and a recorded owner.
    var t = control_point_server()
    set_configuration(var t.link, 4, CCC_INDICATION)
    test.assert(set_value(var t.db, 3, [7]))
    test.assert(gatt_server.add_write_guard(var t.db, 3, tagging_rule, 1, 3, 3, []))
    test.assert(gatt_server.set_guard_owner(var t.db, 3, 5))
    test.assert_eq(answer(var t, [0x12, 0x03, 0x00, 0x01]), "01 12 03 00 8F")
    // A characteristic with no Client Characteristic Configuration: the rule sees no subscription.
    var u = control_point_server()
    let plain = add_characteristic(var u.db, PROP_WRITE, PERM_WRITE, le16(0xAA02)) + 1
    test.assert_eq(plain, 6)
    test.assert(gatt_server.add_write_guard(var u.db, plain, tagging_rule, 1, 0, 0, []))
    test.assert_eq(answer(var u, [0x12, 0x06, 0x00, 0x01]), "01 12 06 00 80")
    // The rule also decides the writes a Prepare Write and an Execute Write bring: a value of 0 goes ahead, any other is refused.
    test.assert_eq(answer(var u, [0x16, 0x06, 0x00, 0x00, 0x00, 0x00]), "17 06 00 00 00 00")
    test.assert_eq(answer(var u, [0x18, 0x01]), "19")
    test.assert_eq(answer(var u, [0x16, 0x06, 0x00, 0x00, 0x00, 0x05]), "17 06 00 00 00 05")
    test.assert_eq(answer(var u, [0x18, 0x01]), "01 18 06 00 80")

// The octets of the one response the server gives a request, as hexadecimal numbers.
fn answer(var s: GattServer, pdu: [Int]) -> Str
    hex_of(one(receive(var s.db, var s.link, octets(pdu), 0)))

@test
fn test_a_write_guard_of_a_read_rule_refuses_the_read_it_names()
    var s = control_point_server()
    let plain = add_characteristic(var s.db, PROP_READ | PROP_WRITE, PERM_READ | PERM_WRITE, le16(0xAA03)) + 1
    test.assert_eq(plain, 6)
    let at = index_of(s.db, plain)
    test.assert_eq(gatt_server.access_error(s.db, s.link, at, false), 0)
    test.assert(gatt_server.add_write_guard(var s.db, plain, tagging_rule, 9, 0, 0, []))
    test.assert_eq(gatt_server.access_error(s.db, s.link, at, false), 0x82)
    // A rule of another kind lets the read go ahead.
    var t = control_point_server()
    let other = add_characteristic(var t.db, PROP_READ | PROP_WRITE, PERM_READ | PERM_WRITE, le16(0xAA03)) + 1
    test.assert(gatt_server.add_write_guard(var t.db, other, tagging_rule, 1, 0, 0, []))
    test.assert_eq(gatt_server.access_error(t.db, t.link, index_of(t.db, other), false), 0)

fn hex_of(b: [u8]) -> Str
    var out = ""
    for i in 0..list.len(b)
        let v = b[i] as Int
        let digits = "0123456789ABCDEF"
        if i > 0
            out = out + " "
        out = out + str.slice(digits, v / 16, v / 16 + 1) + str.slice(digits, v % 16, v % 16 + 1)
    out
