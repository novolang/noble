@test
fn test_is_m6_request_classification()
    test.assert_eq(is_m6_request(ATT_OP_WRITE_REQ), true)
    test.assert_eq(is_m6_request(ATT_OP_PREPARE_WRITE_REQ), true)
    test.assert_eq(is_m6_request(ATT_OP_EXECUTE_WRITE_REQ), true)
    test.assert_eq(is_m6_request(ATT_OP_HANDLE_VALUE_CFM), true)
    test.assert_eq(is_m6_request(ATT_OP_READ_REQ), false)         // read side
    test.assert_eq(is_m6_request(ATT_OP_HANDLE_VALUE_NTF), false) // server-emitted
