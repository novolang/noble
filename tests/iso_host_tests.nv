// tests/iso_host_tests.nv — the unit tests of src/iso_host.nv.
//
//   novo test tests/iso_host_tests.nv

use std.test
use hci_codec
use iso_big
use iso_cis
use iso_event
use iso_flow
use noble_config
use links
use iso_host.{ IsoHost, big_sync_established_bytes, cis_established_bytes, command_complete, command_status, completed_packets_bytes, create_big_complete_bytes, disconnection_bytes, iso_host_acl_closed, iso_host_answer, iso_host_cis_request, iso_host_event, iso_host_new, iso_host_reserve_sdu }

@tier(app)
fn host_cig(var h: IsoHost)
    h.cis.host_support = true
    test.assert_eq(iso_cis.cig_set_parameters(var h.cis, iso_cis.cig_fixture(1), [iso_cis.cis_cfg(0, 100, 100)]),
        0)
    let a = iso_host_answer(var h, command_complete(0x2062, 0, [0x01, 0x01, 0x10, 0x00]))
    test.assert(a.kind == iso_event.IsoEventKind.CigConfigured)

@when(noble_config.MAX_CIS == 2 and noble_config.MAX_BIG == 1 and noble_config.MAX_BIS == 2)
@test
@satisfies("REQ-BLE-ISO-003")
fn test_a_new_iso_host_has_three_empty_tables()
    var h = iso_host_new()
    test.assert_eq(iso_cis.cis_free_rows(var h.cis), noble_config.MAX_CIS)
    test.assert_eq(iso_big.bis_free_rows(var h.big), noble_config.MAX_BIS)
    test.assert_eq(iso_big.big_count_in(var h.big, iso_big.BigState.Vacant), noble_config.MAX_BIG)
    test.assert(not iso_flow.iso_credits_ready(var h.credits))

@when(noble_config.MAX_CIS >= 2 and noble_config.MAX_BIG >= 1 and noble_config.MAX_BIS >= 2)
@test
@satisfies("REQ-BLE-ISO-003")
fn test_the_central_procedure_runs_from_events_alone()
    var h = iso_host_new()
    test.assert(iso_flow.iso_credits_configure(var h.credits, hci_codec.LeBufferSizeV2 {
        acl_data_packet_length: 251, total_acl_data_packets: 3, iso_data_packet_length: 255, total_iso_data_packets: 3 }))
    host_cig(var h)
    let acl = iso_cis.AclRef { handle: 1, link: links.link_id(0, 1), central: true }
    // Create CIS: Command Status, then the CIS Established event.
    test.assert_eq(iso_cis.cis_create(var h.cis, [0x0010], [acl]), 0)
    test.assert(iso_host_answer(var h, command_status(0x2064, 0)).kind == iso_event.IsoEventKind.CommandDone)
    let e = iso_host_event(var h, cis_established_bytes(0x0010, 0, 1, 1))
    test.assert(e.kind == iso_event.IsoEventKind.CisEstablished)
    // The pool holds the stream; the data path lets it send.
    test.assert_eq(iso_flow.iso_in_flight(var h.credits, 0x0010), 0)
    test.assert_eq(iso_host_reserve_sdu(var h, 0x0010, 100, false), 0)
    test.assert_eq(iso_cis.data_path_setup(var h.cis, 0x0010, iso_cis.PATH_INPUT, 0x06, 0), 0)
    let p = iso_host_answer(var h, command_complete(0x206E, 0, [0x10, 0x00]))
    test.assert(p.kind == iso_event.IsoEventKind.DataPathSet)
    // An SDU takes one packet; an SDU of 300 octets takes two, and one above the Host's buffer none.
    test.assert_eq(iso_host_reserve_sdu(var h, 0x0010, 100, false), 1)
    test.assert_eq(iso_flow.iso_in_flight(var h.credits, 0x0010), 1)
    test.assert_eq(iso_host_reserve_sdu(var h, 0x0010, 600, false), 0)
    test.assert_eq(iso_host_reserve_sdu(var h, 0x0010, 300, false), 2)
    // The Controller completes them.
    let n = iso_host_event(var h, completed_packets_bytes([0x0010, 3]))
    test.assert(n.kind == iso_event.IsoEventKind.Nothing)
    test.assert_eq(iso_flow.iso_in_flight(var h.credits, 0x0010), 0)
    test.assert_eq(h.credits.free as Int, 3)
    // The stream ends with Disconnection Complete: the entry goes.
    test.assert_eq(iso_host_reserve_sdu(var h, 0x0010, 100, false), 1)
    let d = iso_host_event(var h, disconnection_bytes(0x0010, 0x13))
    test.assert(d.kind == iso_event.IsoEventKind.CisClosed)
    test.assert_eq(iso_flow.iso_in_flight(var h.credits, 0x0010), -1)
    test.assert_eq(h.credits.free as Int, 3)

@when(noble_config.MAX_CIS >= 2 and noble_config.MAX_BIG >= 1 and noble_config.MAX_BIS >= 2)
@test
@satisfies("REQ-BLE-ISO-003")
fn test_a_failed_cis_gets_no_credit_entry()
    var h = iso_host_new()
    host_cig(var h)
    let acl = iso_cis.AclRef { handle: 1, link: links.link_id(0, 1), central: true }
    test.assert_eq(iso_cis.cis_create(var h.cis, [0x0010], [acl]), 0)
    test.assert(iso_host_answer(var h, command_status(0x2064, 0)).kind == iso_event.IsoEventKind.CommandDone)
    test.assert(iso_host_event(var h, cis_established_bytes(0x0010, 0x3E, 0, 0)).kind == iso_event.IsoEventKind.CisFailed)
    test.assert_eq(iso_flow.iso_in_flight(var h.credits, 0x0010), -1)

@when(noble_config.MAX_CIS >= 2 and noble_config.MAX_BIG >= 1 and noble_config.MAX_BIS >= 2)
@test
@satisfies("REQ-BLE-ISO-003")
fn test_the_peripheral_procedure_runs_from_events_alone()
    var h = iso_host_new()
    let acl = iso_cis.AclRef { handle: 1, link: links.link_id(0, 1), central: false }
    // LE CIS Request: ACL 1, CIS 0x0030, CIG 3, CIS 4.
    let req = hci_codec.le_meta_event(hci_codec.LE_SUBEVENT_CIS_REQUEST, [0x01, 0x00, 0x30, 0x00, 0x03, 0x04])
    let r = iso_host_cis_request(var h, req, acl)
    test.assert(r.kind == iso_event.IsoEventKind.CisRequested)
    test.assert_eq(iso_cis.cis_accept(var h.cis, 0x0030), 0)
    test.assert(iso_host_answer(var h, command_status(0x2066, 0)).kind == iso_event.IsoEventKind.CommandDone)
    test.assert(iso_host_event(var h, cis_established_bytes(0x0030, 0, 1, 1)).kind == iso_event.IsoEventKind.CisEstablished)
    test.assert_eq(iso_flow.iso_in_flight(var h.credits, 0x0030), 0)
    // A malformed request is ignored.
    test.assert(iso_host_cis_request(var h, [0x3E, 0x01, 0x1A], acl).kind == iso_event.IsoEventKind.Unrelated)
    // The link ending takes the stream with it, and the entry.
    test.assert_eq(iso_host_acl_closed(var h, links.link_id(0, 1)), 1)
    test.assert_eq(iso_flow.iso_in_flight(var h.credits, 0x0030), -1)

@when(noble_config.MAX_CIS >= 2 and noble_config.MAX_BIG >= 1 and noble_config.MAX_BIS >= 2)
@test
@satisfies("REQ-BLE-ISO-004")
fn test_the_broadcaster_procedure_runs_from_events_alone()
    var h = iso_host_new()
    test.assert(iso_flow.iso_credits_configure(var h.credits, hci_codec.LeBufferSizeV2 {
        acl_data_packet_length: 251, total_acl_data_packets: 3, iso_data_packet_length: 255, total_iso_data_packets: 3 }))
    test.assert_eq(iso_big.big_create(var h.big, 1, 1, 2, 10000, 100, 20, 2, 0x02, 0, 0, false, iso_big.zero_code()),
        0)
    test.assert(iso_host_answer(var h, command_status(0x2068, 0)).kind == iso_event.IsoEventKind.CommandDone)
    let e = iso_host_event(var h, create_big_complete_bytes(1, 0, [0x0100, 0x0101]))
    test.assert(e.kind == iso_event.IsoEventKind.BigCreated)
    test.assert_eq(iso_flow.iso_in_flight(var h.credits, 0x0100), 0)
    test.assert_eq(iso_flow.iso_in_flight(var h.credits, 0x0101), 0)
    test.assert_eq(iso_big.bis_data_path_setup(var h.big, 0x0100, iso_big.PATH_INPUT, 0x06, 0), 0)
    test.assert(iso_host_answer(var h, command_complete(0x206E, 0, [0x00, 0x01])).kind == iso_event.IsoEventKind.DataPathSet)
    test.assert_eq(iso_host_reserve_sdu(var h, 0x0100, 100, true), 1)
    test.assert_eq(iso_host_reserve_sdu(var h, 0x0101, 100, true), 0)
    // Terminate: Command Status, then the Complete event; the entries go.
    test.assert_eq(iso_big.big_terminate(var h.big, 1, 0x16), 0)
    test.assert(iso_host_answer(var h, command_status(0x206A, 0)).kind == iso_event.IsoEventKind.CommandDone)
    test.assert_eq(iso_flow.iso_in_flight(var h.credits, 0x0100), 1)
    let t = iso_host_event(var h, hci_codec.le_meta_event(hci_codec.LE_SUBEVENT_TERMINATE_BIG_COMPLETE, [0x01, 0x16]))
    test.assert(t.kind == iso_event.IsoEventKind.BigTerminated)
    test.assert_eq(iso_flow.iso_in_flight(var h.credits, 0x0100), -1)
    test.assert_eq(h.credits.free as Int, 3)

@when(noble_config.MAX_CIS >= 2 and noble_config.MAX_BIG >= 1 and noble_config.MAX_BIS >= 2)
@test
@satisfies("REQ-BLE-ISO-004")
fn test_the_receiver_procedure_runs_from_events_alone()
    var h = iso_host_new()
    test.assert_eq(iso_big.big_sync_create(var h.big, 1, 0x20, false, iso_big.zero_code(), 0, 100, [1, 2]), 0)
    test.assert(iso_host_answer(var h, command_status(0x206B, 0)).kind == iso_event.IsoEventKind.CommandDone)
    test.assert(iso_host_event(var h, big_sync_established_bytes(1, 0, [0x0100, 0x0101])).kind == iso_event.IsoEventKind.BigSynced)
    test.assert_eq(iso_flow.iso_in_flight(var h.credits, 0x0101), 0)
    test.assert_eq(iso_big.bis_data_path_setup(var h.big, 0x0100, iso_big.PATH_OUTPUT, 0x06, 0), 0)
    test.assert(iso_host_answer(var h, command_complete(0x206E, 0, [0x00, 0x01])).kind == iso_event.IsoEventKind.DataPathSet)
    test.assert_eq(iso_big.bis_data_path_remove(var h.big, 0x0100, 2), 0)
    test.assert(iso_host_answer(var h, command_complete(0x206F, 0, [0x00, 0x01])).kind == iso_event.IsoEventKind.DataPathRemoved)
    // The BIG is lost.
    let lost = iso_host_event(var h, hci_codec.le_meta_event(hci_codec.LE_SUBEVENT_BIG_SYNC_LOST, [0x01, 0x08]))
    test.assert(lost.kind == iso_event.IsoEventKind.BigSyncLost)
    test.assert_eq(iso_flow.iso_in_flight(var h.credits, 0x0100), -1)
    // Synchronize again and end it with Terminate Sync.
    test.assert_eq(iso_big.big_sync_create(var h.big, 1, 0x20, false, iso_big.zero_code(), 0, 100, [1]), 0)
    test.assert(iso_host_answer(var h, command_status(0x206B, 0)).kind == iso_event.IsoEventKind.CommandDone)
    test.assert(iso_host_event(var h, big_sync_established_bytes(1, 0, [0x0100])).kind == iso_event.IsoEventKind.BigSynced)
    test.assert_eq(iso_big.big_sync_terminate(var h.big, 1), 0)
    test.assert(iso_host_answer(var h, command_complete(0x206C, 0, [0x01])).kind == iso_event.IsoEventKind.BigSyncTerminated)
    test.assert_eq(iso_flow.iso_in_flight(var h.credits, 0x0100), -1)

@when(noble_config.MAX_CIS >= 2 and noble_config.MAX_BIG >= 1 and noble_config.MAX_BIS >= 2)
@test
@satisfies("REQ-BLE-ISO-003")
fn test_the_cig_commands_are_routed_by_opcode()
    var h = iso_host_new()
    host_cig(var h)
    // Set CIG Parameters Test answers the same way.
    test.assert_eq(iso_cis.cig_set_parameters(var h.cis, iso_cis.cig_fixture(1), [iso_cis.cis_cfg(0, 100, 100)]),
        0)
    test.assert(iso_host_answer(var h, command_complete(0x2063, 0, [0x01, 0x01, 0x10, 0x00])).kind == iso_event.IsoEventKind.CigConfigured)
    // A failure of Set CIG Parameters carries no return parameters.
    test.assert_eq(iso_cis.cig_set_parameters(var h.cis, iso_cis.cig_fixture(1), [iso_cis.cis_cfg(0, 100, 100)]),
        0)
    let f = iso_host_answer(var h, command_complete(0x2062, 0x0C, [0x01, 0x00]))
    test.assert(f.kind == iso_event.IsoEventKind.CommandFailed)
    test.assert_eq(f.status, 0x0C)
    // Remove CIG.
    test.assert_eq(iso_cis.cig_remove(var h.cis, 1), 0)
    test.assert(iso_host_answer(var h, command_complete(0x2065, 0, [0x01])).kind == iso_event.IsoEventKind.CigRemoved)
    // Reject CIS Request and Disconnect are routed to the CIS table too.
    let acl = iso_cis.AclRef { handle: 1, link: links.link_id(0, 1), central: false }
    let req = hci_codec.le_meta_event(hci_codec.LE_SUBEVENT_CIS_REQUEST, [0x01, 0x00, 0x30, 0x00, 0x03, 0x04])
    test.assert(iso_host_cis_request(var h, req, acl).kind == iso_event.IsoEventKind.CisRequested)
    test.assert_eq(iso_cis.cis_reject(var h.cis, 0x0030, 0x0D), 0)
    test.assert(iso_host_answer(var h, command_complete(0x2067, 0, [0x30, 0x00])).kind == iso_event.IsoEventKind.CommandDone)
    test.assert_eq(iso_cis.cis_row(var h.cis, 0x0030), -1)

@when(noble_config.MAX_CIS >= 2 and noble_config.MAX_BIG >= 1 and noble_config.MAX_BIS >= 2)
@test
@satisfies("REQ-BLE-ISO-003")
fn test_disconnect_status_is_routed_to_the_cis_table()
    var h = iso_host_new()
    host_cig(var h)
    let acl = iso_cis.AclRef { handle: 1, link: links.link_id(0, 1), central: true }
    test.assert_eq(iso_cis.cis_create(var h.cis, [0x0010], [acl]), 0)
    test.assert(iso_host_answer(var h, command_status(0x2064, 0)).kind == iso_event.IsoEventKind.CommandDone)
    test.assert(iso_host_event(var h, cis_established_bytes(0x0010, 0, 1, 1)).kind == iso_event.IsoEventKind.CisEstablished)
    test.assert_eq(iso_cis.cis_disconnect(var h.cis, 0x0010), 0)
    let f = iso_host_answer(var h, command_status(0x0406, 0x0C))
    test.assert(f.kind == iso_event.IsoEventKind.CommandFailed)
    test.assert(h.cis.state[iso_cis.cis_row(var h.cis, 0x0010)] == iso_cis.CisState.Established)

@test
@satisfies("REQ-BLE-ISO-003")
fn test_events_the_tables_do_not_follow_are_ignored()
    var h = iso_host_new()
    // Not isochronous events, a malformed Disconnection Complete, a failed
    // one, an event of a subevent that is not isochronous, a truncated one.
    test.assert(iso_host_event(var h, [0x0E, 0x04, 0x01, 0x01, 0x10, 0x00]).kind == iso_event.IsoEventKind.Unrelated)
    test.assert(iso_host_event(var h, [0x05, 0x01]).kind == iso_event.IsoEventKind.Unrelated)
    test.assert(iso_host_event(var h, [0x05, 0x04, 0x01, 0x10, 0x00, 0x13]).kind == iso_event.IsoEventKind.Unrelated)
    test.assert(iso_host_event(var h, hci_codec.le_meta_event(0x01, [0x00])).kind == iso_event.IsoEventKind.Unrelated)
    test.assert(iso_host_event(var h, [0x3E, 0x01, 0x1B]).kind == iso_event.IsoEventKind.Unrelated)
    test.assert(iso_host_event(var h, [0x13, 0x09, 0x02]).kind == iso_event.IsoEventKind.Unrelated)
    // Events for streams the tables do not hold.
    test.assert(iso_host_event(var h, cis_established_bytes(0x0010, 0, 1, 1)).kind == iso_event.IsoEventKind.Unrelated)
    test.assert(iso_host_event(var h, create_big_complete_bytes(1, 0, [0x0100])).kind == iso_event.IsoEventKind.Unrelated)
    test.assert(iso_host_event(var h, disconnection_bytes(0x0010, 0x13)).kind == iso_event.IsoEventKind.Unrelated)
    // Answers of commands that are not isochronous, and with nothing pending.
    test.assert(iso_host_answer(var h, command_complete(0x0C03, 0, [])).kind == iso_event.IsoEventKind.Unrelated)
    test.assert(iso_host_answer(var h, [0x0E]).kind == iso_event.IsoEventKind.Unrelated)
    test.assert(iso_host_answer(var h, command_status(0x2064, 0)).kind == iso_event.IsoEventKind.Unrelated)
    test.assert(iso_host_answer(var h, command_complete(0x206E, 0, [0x00, 0x00])).kind == iso_event.IsoEventKind.Unrelated)

@when(noble_config.MAX_CIS >= 2 and noble_config.MAX_BIG >= 1 and noble_config.MAX_BIS >= 2)
@test
@satisfies("REQ-BLE-ISO-005")
fn test_reserve_sdu_needs_a_stream_a_path_and_a_configured_pool()
    var h = iso_host_new()
    host_cig(var h)
    // No stream, no path, no pool: nothing is taken.
    test.assert_eq(iso_host_reserve_sdu(var h, 0x0010, 10, false), 0)
    let acl = iso_cis.AclRef { handle: 1, link: links.link_id(0, 1), central: true }
    test.assert_eq(iso_cis.cis_create(var h.cis, [0x0010], [acl]), 0)
    test.assert(iso_host_answer(var h, command_status(0x2064, 0)).kind == iso_event.IsoEventKind.CommandDone)
    test.assert(iso_host_event(var h, cis_established_bytes(0x0010, 0, 1, 1)).kind == iso_event.IsoEventKind.CisEstablished)
    test.assert_eq(iso_cis.data_path_setup(var h.cis, 0x0010, iso_cis.PATH_INPUT, 0x06, 0), 0)
    test.assert(iso_host_answer(var h, command_complete(0x206E, 0, [0x10, 0x00])).kind == iso_event.IsoEventKind.DataPathSet)
    // The pool is not configured: no ISO buffer is known.
    test.assert_eq(iso_host_reserve_sdu(var h, 0x0010, 10, false), 0)
    test.assert(iso_flow.iso_credits_configure(var h.credits, hci_codec.LeBufferSizeV2 {
        acl_data_packet_length: 251, total_acl_data_packets: 3, iso_data_packet_length: 255, total_iso_data_packets: 1 }))
    test.assert_eq(iso_host_reserve_sdu(var h, 0x0010, 10, false), 1)
    // The one buffer is taken: the next SDU waits.
    test.assert_eq(iso_host_reserve_sdu(var h, 0x0010, 10, false), 0)
    test.assert_eq(iso_flow.iso_in_flight(var h.credits, 0x0010), 1)
    // An SDU that cannot be cut at all.
    test.assert_eq(iso_host_reserve_sdu(var h, 0x0010, 5000, false), 0)

@when(noble_config.MAX_CIS >= 2 and noble_config.MAX_BIG >= 1 and noble_config.MAX_BIS >= 2)
@test
@satisfies("REQ-BLE-HCI-059")
fn test_reserve_sdu_refuses_an_sdu_longer_than_the_host_buffer_whatever_the_controller_takes()
    var h = iso_host_new()
    host_cig(var h)
    let acl = iso_cis.AclRef { handle: 1, link: links.link_id(0, 1), central: true }
    test.assert_eq(iso_cis.cis_create(var h.cis, [0x0010], [acl]), 0)
    test.assert(iso_host_answer(var h, command_status(0x2064, 0)).kind == iso_event.IsoEventKind.CommandDone)
    test.assert(iso_host_event(var h, cis_established_bytes(0x0010, 0, 1, 1)).kind == iso_event.IsoEventKind.CisEstablished)
    test.assert_eq(iso_cis.data_path_setup(var h.cis, 0x0010, iso_cis.PATH_INPUT, 0x06, 0), 0)
    test.assert(iso_host_answer(var h, command_complete(0x206E, 0, [0x10, 0x00])).kind == iso_event.IsoEventKind.DataPathSet)
    // A mock Controller whose ISO packets hold 0x3FFF octets and that has 8 buffers.
    test.assert(iso_flow.iso_credits_configure(var h.credits, hci_codec.LeBufferSizeV2 {
        acl_data_packet_length: 27, total_acl_data_packets: 3, iso_data_packet_length: 0x3FFF, total_iso_data_packets: 8 }))
    test.assert_eq(iso_host_reserve_sdu(var h, 0x0010, noble_config.ISO_SDU_OCTETS + 1, false), 0)
    test.assert_eq(iso_host_reserve_sdu(var h, 0x0010, noble_config.ISO_SDU_OCTETS, false), 1)
    // A mock Controller whose ISO packets hold 27 octets: the same SDU takes more packets.
    var g = iso_host_new()
    host_cig(var g)
    test.assert_eq(iso_cis.cis_create(var g.cis, [0x0010], [acl]), 0)
    test.assert(iso_host_answer(var g, command_status(0x2064, 0)).kind == iso_event.IsoEventKind.CommandDone)
    test.assert(iso_host_event(var g, cis_established_bytes(0x0010, 0, 1, 1)).kind == iso_event.IsoEventKind.CisEstablished)
    test.assert_eq(iso_cis.data_path_setup(var g.cis, 0x0010, iso_cis.PATH_INPUT, 0x06, 0), 0)
    test.assert(iso_host_answer(var g, command_complete(0x206E, 0, [0x10, 0x00])).kind == iso_event.IsoEventKind.DataPathSet)
    test.assert(iso_flow.iso_credits_configure(var g.credits, hci_codec.LeBufferSizeV2 {
        acl_data_packet_length: 27, total_acl_data_packets: 3, iso_data_packet_length: 27, total_iso_data_packets: 32 }))
    test.assert_eq(iso_host_reserve_sdu(var g, 0x0010, 100, false), 4)
