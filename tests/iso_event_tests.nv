// tests/iso_event_tests.nv — the unit tests of src/iso_event.nv.
//
//   novo test tests/iso_event_tests.nv

use std.test
use iso_event.{ IsoEventKind, STATUS_COMMAND_DISALLOWED, STATUS_CONNECTION_ACCEPT_TIMEOUT_EXCEEDED, STATUS_CONNECTION_ALREADY_EXISTS, STATUS_CONNECTION_TERMINATED_BY_LOCAL_HOST, STATUS_ENCRYPTION_MODE_NOT_ACCEPTABLE, STATUS_INVALID_COMMAND_PARAMETERS, STATUS_MEMORY_CAPACITY_EXCEEDED, STATUS_OPERATION_CANCELLED_BY_HOST, STATUS_REJECTED_LIMITED_RESOURCES, STATUS_UNKNOWN_ADVERTISING_IDENTIFIER, STATUS_UNKNOWN_CONNECTION_IDENTIFIER, STATUS_UNSUPPORTED_FEATURE_OR_PARAMETER, command_failed, iso_event, unrelated }

@test
fn test_an_event_carries_its_four_fields()
    let e = iso_event(IsoEventKind.CisEstablished, 1, 0x0040, 0)
    test.assert(e.kind == IsoEventKind.CisEstablished)
    test.assert_eq(e.slot, 1)
    test.assert_eq(e.handle, 0x0040)
    test.assert_eq(e.status, 0)

@test
fn test_an_unrelated_event_and_a_failed_command_name_no_row()
    let a = unrelated(0x0041)
    test.assert(a.kind == IsoEventKind.Unrelated)
    test.assert_eq(a.slot, -1)
    test.assert_eq(a.handle, 0x0041)
    let b = command_failed(0x0042, STATUS_COMMAND_DISALLOWED)
    test.assert(b.kind == IsoEventKind.CommandFailed)
    test.assert_eq(b.status, 0x0C)
    test.assert_eq(b.slot, -1)

// The codes are those of [Vol 1] Part F, Section 1.3.
@test
fn test_the_status_codes_are_the_specified_ones()
    test.assert_eq(STATUS_UNKNOWN_CONNECTION_IDENTIFIER, 0x02)
    test.assert_eq(STATUS_MEMORY_CAPACITY_EXCEEDED, 0x07)
    test.assert_eq(STATUS_CONNECTION_ALREADY_EXISTS, 0x0B)
    test.assert_eq(STATUS_COMMAND_DISALLOWED, 0x0C)
    test.assert_eq(STATUS_REJECTED_LIMITED_RESOURCES, 0x0D)
    test.assert_eq(STATUS_CONNECTION_ACCEPT_TIMEOUT_EXCEEDED, 0x10)
    test.assert_eq(STATUS_UNSUPPORTED_FEATURE_OR_PARAMETER, 0x11)
    test.assert_eq(STATUS_INVALID_COMMAND_PARAMETERS, 0x12)
    test.assert_eq(STATUS_CONNECTION_TERMINATED_BY_LOCAL_HOST, 0x16)
    test.assert_eq(STATUS_ENCRYPTION_MODE_NOT_ACCEPTABLE, 0x25)
    test.assert_eq(STATUS_UNKNOWN_ADVERTISING_IDENTIFIER, 0x42)
    test.assert_eq(STATUS_OPERATION_CANCELLED_BY_HOST, 0x44)
