@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_a_passkey_the_policy_answers_pending_is_asked_through_an_event_and_given_with_passkey_reply()
    var x = pair_up()
    // The Central shows the passkey, the Peripheral types it: Passkey Entry.
    x.pa.io = IoCap.DisplayOnly
    x.pb.io = IoCap.KeyboardOnly
    x.pb.passkey = noble.PENDING
    let st = host_api.begin(var x.a, Request.Secure(x.ca, Security.Authenticated))
    test.assert(st.is_ok())
    for _ in 0..200
        if x.b.api.ask[0] == 0
            pump(var x, 1)
    test.assert_eq(next_kind(var x.b), EV_PASSKEY)
    pump(var x, 6)
    // The Central's policy was handed the six digits to show.
    test.assert(x.pa.shown >= 0 and x.pa.shown <= 999999)
    test.assert(result_none(host_api.result(var x.a)))
    // A wrong call is refused and the right one is taken at the next poll.
    test.assert(host_api.passkey_reply(var x.b, x.cb, 1000000).is(noble.LAYER_LOCAL, noble.E_BAD_ARGUMENT))
    test.assert(host_api.passkey_reply(var x.b, x.cb, x.pa.shown).is_ok())
    var done = noble.failed(noble.LAYER_LOCAL, noble.E_TIMEOUT)
    for _ in 0..200
        pump(var x, 1)
        match host_api.result(var x.a)
            Some(r) =>
                done = r
                break
            None => ()
    test.assert(done.is_ok())
    pump(var x, 10)
    test.assert(level_of_conn(x.a, x.ca) >= 3)
    test.assert(level_of_conn(x.b, x.cb) >= 3)
    test.assert(x.pb.done_ok)
    // A second reply has nothing to answer.
    test.assert(host_api.passkey_reply(var x.b, x.cb, 5).is(noble.LAYER_LOCAL, noble.E_BAD_ARGUMENT))

@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_a_wrong_passkey_fails_the_pairing_with_passkey_entry_failed()
    var x = pair_up()
    x.pa.io = IoCap.DisplayOnly
    x.pb.io = IoCap.KeyboardOnly
    x.pb.passkey = noble.PENDING
    let st = host_api.begin(var x.a, Request.Secure(x.ca, Security.Authenticated))
    test.assert(st.is_ok())
    for _ in 0..200
        if x.b.api.ask[0] == 0
            pump(var x, 1)
    test.assert_eq(next_kind(var x.b), EV_PASSKEY)
    pump(var x, 6)
    test.assert(x.pa.shown >= 0)
    test.assert(host_api.passkey_reply(var x.b, x.cb, (x.pa.shown + 1) % 1000000).is_ok())
    var done = noble.failed(noble.LAYER_LOCAL, noble.E_TIMEOUT)
    for _ in 0..200
        pump(var x, 1)
        match host_api.result(var x.a)
            Some(r) =>
                done = r
                break
            None => ()
    test.assert(done.layer == noble.LAYER_SMP)
    test.assert_eq(level_of_conn(x.a, x.ca), 1)
    test.assert_eq(x.sa.count(), 0)

fn result_none(r: ?Status) -> Bool
    match r
        Some(_) => false
        None => true

