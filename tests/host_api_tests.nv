@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_disconnect_ends_the_link_and_queues_disconnected_and_a_stale_name_is_refused()
    var h = new_host(2)
    var l = script_link()
    var p = test_policy()
    var b = new_store()
    started(var h, var l, var p, var b)
    let up = call(var h, var l, var p, var b, Request.Connect(peer_addr(0x55), noble.conn_params_default()))
    test.assert(up.is_ok())
    let conn = host_api.op_conn(h)
    test.assert_eq(next_kind(var h), EV_CONNECTED)
    let st = call(var h, var l, var p, var b, Request.Disconnect(conn, noble.HCI_REMOTE_USER_TERMINATED))
    test.assert(st.is_ok())
    test.assert_eq(host_api.link_count(h), 0)
    match host_api.next_event(var h)
        Some(e) =>
            match e
                Disconnected(c, reason) =>
                    test.assert_eq(c.slot as Int, conn.slot as Int)
                    test.assert(reason.is(noble.LAYER_HCI, noble.HCI_CONNECTION_TERMINATED_BY_LOCAL_HOST))
                    test.assert_eq(reason.name(), "connection terminated by local host")
                _ => test.fail("Disconnected is queued")
        None => test.fail("an event is queued")
    test.assert_eq(p.disconnected, 1)
    test.assert_eq(p.disc_attempts, 0)
    // The name of the ended link is stale, and so is the name of a slot that holds no link.
    test.assert(host_api.begin(var h, Request.Disconnect(conn, 0x13)).is(noble.LAYER_LOCAL, noble.E_STALE))
    test.assert(host_api.conn_info(h, conn) == None)

@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_reconnect_after_a_delay_waits_for_the_time_then_connects_again_and_counts_the_attempt()
    var h = new_host(2)
    var l = script_link()
    var p = test_policy()
    var b = new_store()
    started(var h, var l, var p, var b)
    p.on_disc = 500
    let up = call(var h, var l, var p, var b, Request.Connect(peer_addr(0x55), noble.conn_params_default()))
    test.assert(up.is_ok())
    test.assert_eq(times_sent(l, hci_commands.opcode_le_create_connection()), 1)
    // The peer drops the link: the policy asks for a reconnection in 500 ms.
    list.push(l.inbox, disconnection_complete(0x40, 0x08))
    run(var h, var l, var p, var b, 1)
    test.assert_eq(p.disconnected, 1)
    test.assert_eq(p.disc_reason, 0x08)
    run(var h, var l, var p, var b, 20)
    test.assert_eq(times_sent(l, hci_commands.opcode_le_create_connection()), 1)
    run(var h, var l, var p, var b, 40)
    test.assert_eq(times_sent(l, hci_commands.opcode_le_create_connection()), 2)
    // The link is made again: the attempts count starts over.
    test.assert_eq(host_api.link_count(h), 1)
    test.assert_eq(h.api.attempts, 0)

@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_a_reconnection_that_fails_reports_a_disconnected_event_and_calls_the_hook_with_one_attempt_more()
    var h = new_host(2)
    var l = script_link()
    var p = test_policy()
    var b = new_store()
    started(var h, var l, var p, var b)
    p.on_disc = 100
    let up = call(var h, var l, var p, var b, Request.Connect(peer_addr(0x55), noble.conn_params_default()))
    test.assert(up.is_ok())
    test.assert_eq(next_kind(var h), EV_CONNECTED)
    list.push(l.inbox, disconnection_complete(0x40, 0x08))
    run(var h, var l, var p, var b, 1)
    test.assert_eq(next_kind(var h), EV_DISCONNECTED)
    // The reconnection finds nobody: LE Connection Complete with status 0x3E.
    l.connect_status = noble.HCI_CONNECTION_FAILED_TO_ESTABLISH
    for _ in 0..40
        if p.disconnected < 2
            run(var h, var l, var p, var b, 1)
    test.assert_eq(times_sent(l, hci_commands.opcode_le_create_connection()), 2)
    test.assert_eq(p.disconnected, 2)
    test.assert_eq(p.disc_attempts, 1)
    test.assert_eq(next_kind(var h), EV_DISCONNECTED)
    // The hook asks again, and the third attempt is counted two.
    for _ in 0..40
        if p.disconnected < 3
            run(var h, var l, var p, var b, 1)
    test.assert_eq(p.disc_attempts, 2)

