@test
@satisfies("REQ-BLE-ISO-004")
fn test_big_terminate_sync_while_syncing_cancels_the_attempt()
    var t = big_table_new()
    test.assert_eq(big_sync_create(var t, 1, 0x20, false, zero_code(), 0, 100, [1]), 0)
    test.assert(big_sync_status(var t, 0).kind == iso_event.IsoEventKind.CommandDone)
    test.assert_eq(big_sync_terminate(var t, 1), 0)
    // An answer for another BIG is not this command's.
    test.assert(big_sync_terminate_complete(var t, 0, 2).kind == iso_event.IsoEventKind.Unrelated)
    let c = big_sync_terminate_complete(var t, 0, 1)
    test.assert(c.kind == iso_event.IsoEventKind.CommandDone)
    test.assert(t.state[c.slot] == BigState.SyncCancelling)
    // Another synchronization waits until the cancelled one has reported.
    test.assert_eq(big_sync_create(var t, 2, 0x21, false, zero_code(), 0, 100, [1]), iso_event.STATUS_COMMAND_DISALLOWED)
    let e = big_sync_established(var t, sync_established_event(1, iso_event.STATUS_OPERATION_CANCELLED_BY_HOST, []))
    test.assert(e.kind == iso_event.IsoEventKind.BigSyncFailed)
    test.assert_eq(e.status, 0x44)
    test.assert_eq(big_row(var t, 1), -1)
    test.assert_eq(bis_free_rows(var t), noble_config.MAX_BIS)

@test
@satisfies("REQ-BLE-ISO-004")
fn test_big_terminate_sync_refusals_and_failure()
    var t = big_table_new()
    test.assert_eq(big_sync_terminate(var t, 1), iso_event.STATUS_UNKNOWN_ADVERTISING_IDENTIFIER)
    // A group this Host broadcasts is not one it synchronizes to.
    broadcasting(var t, 1, 1, [0x0100])
    test.assert_eq(big_sync_terminate(var t, 1), iso_event.STATUS_COMMAND_DISALLOWED)
    var r = big_table_new()
    synchronized(r, 1, 0x20, [1], [0x0100])
    test.assert_eq(big_sync_terminate(var r, 1), 0)
    // One command at a time; a failure changes nothing.
    test.assert_eq(big_sync_terminate(var r, 1), iso_event.STATUS_COMMAND_DISALLOWED)
    let f = big_sync_terminate_complete(var r, iso_event.STATUS_COMMAND_DISALLOWED, 1)
    test.assert(f.kind == iso_event.IsoEventKind.CommandFailed)
    test.assert(r.state[big_row(var r, 1)] == BigState.Synchronized)
    test.assert(big_sync_terminate_complete(var r, 0, 1).kind == iso_event.IsoEventKind.Unrelated)
    // A group whose synchronization was cancelled is neither.
    var c = big_table_new()
    test.assert_eq(big_sync_create(var c, 1, 0x20, false, zero_code(), 0, 100, [1]), 0)
    test.assert(big_sync_status(var c, 0).kind == iso_event.IsoEventKind.CommandDone)
    test.assert_eq(big_sync_terminate(var c, 1), 0)
    test.assert(big_sync_terminate_complete(var c, 0, 1).kind == iso_event.IsoEventKind.CommandDone)
    test.assert_eq(big_sync_terminate(var c, 1), iso_event.STATUS_COMMAND_DISALLOWED)

@test
@satisfies("REQ-BLE-ISO-004")
fn test_big_sync_lost_frees_the_group_with_the_reason()
    var t = big_table_new()
    synchronized(t, 1, 0x20, [1], [0x0100])
    // 0x08: connection timeout.
    let e = big_sync_lost(var t, hci_codec.BigSyncLost { big_handle: 1, reason: 0x08 })
    test.assert(e.kind == iso_event.IsoEventKind.BigSyncLost)
    test.assert_eq(e.status, 0x08)
    test.assert_eq(big_row(var t, 1), -1)
    test.assert_eq(bis_row(var t, 0x0100), -1)
    test.assert_eq(bis_free_rows(var t), noble_config.MAX_BIS)
    // The same BIG handle may be used again.
    synchronized(t, 1, 0x20, [1], [0x0100])

@test
@satisfies("REQ-BLE-ISO-004")
fn test_big_sync_lost_for_nothing_the_table_follows_is_ignored()
    var t = big_table_new()
    let lost = hci_codec.BigSyncLost { big_handle: 1, reason: 0x13 }
    test.assert(big_sync_lost(var t, lost).kind == iso_event.IsoEventKind.Unrelated)
    broadcasting(var t, 1, 1, [0x0100])
    test.assert(big_sync_lost(var t, lost).kind == iso_event.IsoEventKind.Unrelated)
    test.assert(t.state[big_row(var t, 1)] == BigState.Broadcasting)
    var s = big_table_new()
    test.assert_eq(big_sync_create(var s, 1, 0x20, false, zero_code(), 0, 100, [1]), 0)
    test.assert(big_sync_status(var s, 0).kind == iso_event.IsoEventKind.CommandDone)
    // Not yet synchronized: a loss is not possible.
    test.assert(big_sync_lost(var s, lost).kind == iso_event.IsoEventKind.Unrelated)

// ── ISO data paths of BISes ─────────────────────────────────────────

@test
@satisfies("REQ-BLE-ISO-004")
fn test_a_broadcasters_bis_takes_an_input_path_only()
    var t = big_table_new()
    broadcasting(var t, 1, 1, [0x0100, 0x0101])
    test.assert(not bis_may_send(var t, 0x0100))
    test.assert_eq(bis_data_path_setup(var t, 0x0100, PATH_OUTPUT, 0x06, 0), iso_event.STATUS_COMMAND_DISALLOWED)
    test.assert_eq(bis_data_path_setup(var t, 0x0100, PATH_INPUT, 0x06, 40), 0)
    test.assert(t.pending == BigPending.SetBisPath)
    // A command in flight, and an answer for another handle.
    test.assert_eq(bis_data_path_setup(var t, 0x0101, PATH_INPUT, 0x06, 0), iso_event.STATUS_COMMAND_DISALLOWED)
    test.assert(bis_data_path_setup_complete(var t, 0, 0x0101).kind == iso_event.IsoEventKind.Unrelated)
    let e = bis_data_path_setup_complete(var t, 0, 0x0100)
    test.assert(e.kind == iso_event.IsoEventKind.DataPathSet)
    test.assert(bis_may_send(var t, 0x0100))
    test.assert(not bis_may_send(var t, 0x0101))
    // The same direction twice.
    test.assert_eq(bis_data_path_setup(var t, 0x0100, PATH_INPUT, 0x06, 0), iso_event.STATUS_COMMAND_DISALLOWED)
    // Data does not flow while the group is being terminated.
    test.assert_eq(big_terminate(var t, 1, 0x16), 0)
    test.assert(not bis_may_send(var t, 0x0100))

@test
@satisfies("REQ-BLE-ISO-004")
fn test_a_receivers_bis_takes_an_output_path_only()
    var t = big_table_new()
    synchronized(t, 1, 0x20, [1], [0x0100])
    test.assert_eq(bis_data_path_setup(var t, 0x0100, PATH_INPUT, 0x06, 0), iso_event.STATUS_COMMAND_DISALLOWED)
    test.assert_eq(bis_data_path_setup(var t, 0x0100, PATH_OUTPUT, 0x06, 0), 0)
    test.assert(bis_data_path_setup_complete(var t, 0, 0x0100).kind == iso_event.IsoEventKind.DataPathSet)
    // A Receiver never sends.
    test.assert(not bis_may_send(var t, 0x0100))

@test
@satisfies("REQ-BLE-ISO-004")
fn test_setup_iso_data_path_for_a_bis_refusals()
    var t = big_table_new()
    test.assert_eq(bis_data_path_setup(var t, 0x0100, PATH_INPUT, 0x06, 0), iso_event.STATUS_UNKNOWN_CONNECTION_IDENTIFIER)
    broadcasting(var t, 1, 1, [0x0100])
    test.assert_eq(bis_data_path_setup(var t, 0x0100, 2, 0x06, 0), iso_event.STATUS_INVALID_COMMAND_PARAMETERS)
    test.assert_eq(bis_data_path_setup(var t, 0x0100, -1, 0x06, 0), iso_event.STATUS_INVALID_COMMAND_PARAMETERS)
    test.assert_eq(bis_data_path_setup(var t, 0x0100, PATH_INPUT, 0x06, 256), iso_event.STATUS_INVALID_COMMAND_PARAMETERS)
    test.assert_eq(bis_data_path_setup(var t, 0x0100, PATH_INPUT, hci_commands.ISO_CODING_FORMAT_TRANSPARENT, 1), iso_event.STATUS_INVALID_COMMAND_PARAMETERS)
    test.assert_eq(bis_data_path_setup(var t, 0x0100, PATH_INPUT, hci_commands.ISO_CODING_FORMAT_TRANSPARENT, 0), 0)
    // A failure leaves no path.
    let f = bis_data_path_setup_complete(var t, iso_event.STATUS_INVALID_COMMAND_PARAMETERS, 0x0100)
    test.assert(f.kind == iso_event.IsoEventKind.CommandFailed)
    test.assert_eq(t.bis_paths[bis_row(var t, 0x0100)] as Int, 0)
    test.assert(bis_data_path_setup_complete(var t, 0, 0x0100).kind == iso_event.IsoEventKind.Unrelated)

@test
@satisfies("REQ-BLE-ISO-004")
fn test_remove_iso_data_path_for_a_bis()
    var t = big_table_new()
    broadcasting(var t, 1, 1, [0x0100])
    test.assert_eq(bis_data_path_remove(var t, 0x0200, 1), iso_event.STATUS_UNKNOWN_CONNECTION_IDENTIFIER)
    test.assert_eq(bis_data_path_remove(var t, 0x0100, 1), iso_event.STATUS_COMMAND_DISALLOWED)
    test.assert_eq(bis_data_path_setup(var t, 0x0100, PATH_INPUT, 0x06, 0), 0)
    test.assert(bis_data_path_setup_complete(var t, 0, 0x0100).kind == iso_event.IsoEventKind.DataPathSet)
    test.assert_eq(bis_data_path_remove(var t, 0x0100, 0), iso_event.STATUS_INVALID_COMMAND_PARAMETERS)
    test.assert_eq(bis_data_path_remove(var t, 0x0100, 4), iso_event.STATUS_INVALID_COMMAND_PARAMETERS)
    test.assert_eq(bis_data_path_remove(var t, 0x0100, 3), iso_event.STATUS_COMMAND_DISALLOWED)
    test.assert_eq(bis_data_path_remove(var t, 0x0100, PATH_BIT_INPUT), 0)
    test.assert(bis_data_path_remove_complete(var t, 0, 0x0101).kind == iso_event.IsoEventKind.Unrelated)
    let f = bis_data_path_remove_complete(var t, iso_event.STATUS_COMMAND_DISALLOWED, 0x0100)
    test.assert(f.kind == iso_event.IsoEventKind.CommandFailed)
    test.assert(bis_may_send(var t, 0x0100))
    test.assert_eq(bis_data_path_remove(var t, 0x0100, PATH_BIT_INPUT), 0)
    let e = bis_data_path_remove_complete(var t, 0, 0x0100)
    test.assert(e.kind == iso_event.IsoEventKind.DataPathRemoved)
    test.assert(not bis_may_send(var t, 0x0100))
    test.assert(bis_data_path_remove_complete(var t, 0, 0x0100).kind == iso_event.IsoEventKind.Unrelated)
