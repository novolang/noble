    let c = handle(resp.state, Pdu(smp.build_pairing_confirm(peer.confirm_r)), 20)
    let done = handle(c.state, Pdu(smp.build_pairing_random(rand_r)), 30)
    test.assert_eq(action_name(done), "encrypt")
    let enc = handle(done.state, EncryptionChanged(true), 40)
    test.assert_eq(action_result(enc).level, 3)

// ── The Pairing Response checks ─────────────────────────────────────

@test
fn test_le_secure_connections_are_agreed_and_required_ones_fail_without_them()
    // A device that asks for LE Secure Connections and is answered
    // without the SC bit pairs in LE legacy; one that requires them
    // answers Authentication Requirements instead (Sections 2.3.5.1 and
    // 2.3.5.6).
    let s = connected(config_with(3), no_key_pair())
    let r = handle(s, StartPairing(2), 0)
    let legacy = handle(r.state, Pdu(pres_of(3, 0, smp.SMP_AUTHREQ_BONDING, 16, 0, 0)), 10)
    test.assert_eq(legacy.state.sc, false)
    test.assert(legacy.state.phase == Phase.LegacyConfirm)
    test.assert_eq(list.len(legacy.pdus), 1)
    test.assert_eq(legacy.pdus[0][0] as Int, smp.SMP_OP_PAIRING_CONFIRM)
    let only = connected(config_narrow(7, true), no_key_pair())
    let sc_only = SmpConfig {
        io_capability: only.config.io_capability, bondable: only.config.bondable, secure_connections: true,
        sc_only: true, required_level: 2, keypress: false, request_mitm: true, max_key_size: 16,
        min_key_size: 7, identity_irk: [], identity_address_type: 1, identity_address: [],
        distribute_csrk: false, accept_debug_key: false, pairing_supported: true,
        attempt_min_wait_ms: 0, attempt_max_wait_ms: 0 }
    let r2 = handle(connected(sc_only, no_key_pair()), StartPairing(2), 0)
    assert_failed_with(handle(r2.state, Pdu(pres_of(3, 0, smp.SMP_AUTHREQ_BONDING, 16, 0, 0)), 10), smp.SMP_FAIL_AUTH_REQUIREMENTS)

@test
fn test_the_key_size_is_the_smaller_of_the_two_and_below_the_minimum_fails()
    let s = connected(config_legacy(3), no_key_pair())
    let r = handle(s, StartPairing(2), 0)
    let small = handle(r.state, Pdu(pres_of(3, 0, smp.SMP_AUTHREQ_BONDING, 9, 0, 0)), 10)
    test.assert_eq(small.state.key_size, 9)
    assert_failed_with(handle(r.state, Pdu(pres_of(3, 0, smp.SMP_AUTHREQ_BONDING, 6, 0, 0)), 10), smp.SMP_FAIL_INVALID_PARAMETERS)
    let strict = connected(config_narrow(9, false), no_key_pair())
    let r2 = handle(strict, StartPairing(2), 0)
    assert_failed_with(handle(r2.state, Pdu(pres_of(3, 0, smp.SMP_AUTHREQ_BONDING, 8, 0, 0)), 10), smp.SMP_FAIL_ENC_KEY_SIZE)

@test
fn test_reserved_response_bits_are_ignored()
    // SM/CEN/JW/BI-04-C: every reserved AuthReq bit set by the responder.
    let s = connected(config_legacy(3), no_key_pair())
    let r = handle(s, StartPairing(2), 0)
    let resp = handle(r.state, Pdu(pres_of(3, 0, 0xC2, 16, 0xF0, 0xF0)), 10)
    test.assert_eq(action_name(resp), "none")
    test.assert_eq(resp.state.bonding, false)
    test.assert_eq(resp.state.init_dist, 0)
    test.assert_eq(resp.state.resp_dist, 0)
    test.assert(resp.state.method == Method.JustWorks)

@test
fn test_a_pairing_failed_from_the_peer_ends_the_pairing()
    let s = connected(config_legacy(3), no_key_pair())
    let r = handle(s, StartPairing(2), 0)
    let f = handle(r.state, Pdu(smp.build_pairing_failed(smp.SMP_FAIL_UNSPECIFIED_REASON)), 10)
    test.assert_eq(action_name(f), "failed")
    test.assert_eq(action_int(f), 0x100 + smp.SMP_FAIL_UNSPECIFIED_REASON)
    test.assert(not is_pairing(f.state))

// ── LE Secure Connections ───────────────────────────────────────────

// The PTS Central's own SC Just Works exchange, taken from the HCI log of
// a passing SM/PER/SCJW/BV-02-C run: Pairing Request, Pairing Public Key,
// Pairing Random, Pairing DHKey Check, and no Pairing Confirm at all.
fn sc_open(config: SmpConfig, io_cap: Int, auth: Int, init_dist: Int, resp_dist: Int) -> SmpInitStep
    let s = connected(config, smp_keys.key_pair_from_private(initiator_private()))
    let r = handle(s, StartPairing(2), 0)
    handle(r.state, Pdu(pres_of(io_cap, 0, auth, 16, init_dist, resp_dist)), 10)

fn sc_public_key(step: SmpInitStep, peer: KeyPair) -> SmpInitStep
    handle(step.state, Pdu(smp.build_pairing_public_key(peer.public_key.x, peer.public_key.y)), 20)

// [Vol 3] Part H, Section 2.3.6: the key pair is replaced when S + 3F > 8,
// so the Secure Connections pairing that follows runs on a new key, and
// the failures and successes of the earlier pairings are what counts.
@test
fn test_the_key_pair_is_replaced_before_a_pairing_once_the_count_is_over()
    let old = smp_keys.key_pair_from_private(initiator_private())
    let pres = pres_of(3, 0, smp.SMP_AUTHREQ_BONDING | smp.SMP_AUTHREQ_SC, 16, 0, 0)
    var worn = copy(connected(config_with(3), old))
    worn.failures = 3
    test.assert(needs_new_key_pair(worn))
    let started = handle(worn, StartPairing(2), 0)
    let resp = handle(started.state, Pdu(pres), 10)
    test.assert_eq(resp.state.failures, 0)
    test.assert_eq(resp.state.successes, 0)
    test.assert(not smp_keys.equal_ct(resp.state.key_pair.public_key.x, old.public_key.x))
    assert_bytes(smp.field_bytes(resp.pdus[0], 1, 32), resp.state.key_pair.public_key.x)
    // At the limit the key stays.
    var at_limit = copy(connected(config_with(3), old))
    at_limit.failures = 2
    at_limit.successes = 2
    let kept = handle(handle(at_limit, StartPairing(2), 0).state, Pdu(pres), 10)
    assert_bytes(kept.state.key_pair.public_key.x, old.public_key.x)
    // Failed pairings are counted: three Pairing Failed from the peer.
    var counted = connected(config_with(3), old)
    for i in 0..3
        counted = handle(handle(counted, StartPairing(2), 0).state, Pdu(smp.build_pairing_failed(smp.SMP_FAIL_UNSPECIFIED_REASON)), 1).state
    test.assert_eq(counted.failures, 3)

@test
fn test_sc_just_works_sends_na_after_the_responders_confirm()
    let resp = sc_open(config_with(smp.SMP_IO_CAP_NO_INPUT_NO_OUTPUT), 3,
                       smp.SMP_AUTHREQ_BONDING | smp.SMP_AUTHREQ_SC, 0, 0)
    test.assert_eq(resp.state.sc, true)
    test.assert(resp.state.phase == Phase.PublicKeyExchange)
    test.assert_eq(list.len(resp.pdus), 1)
    test.assert_eq(resp.pdus[0][0] as Int, smp.SMP_OP_PAIRING_PUBLIC_KEY)
    let kp = smp_keys.key_pair_from_private(initiator_private())
    assert_bytes(smp.field_bytes(resp.pdus[0], 1, 32), kp.public_key.x)
    // The responder's public key and its Cb: no Na before both are in.
    let peer = responder_key_pair()
    let nb = hex("a6e8e7cc25a75f6e216583f7ff3dc4cf")
    let pk = sc_public_key(resp, peer)
    test.assert_eq(list.len(pk.pdus), 0)
    test.assert(pk.state.phase == Phase.ScConfirm)
    test.assert(pk.state.dhkey_wanted)
    assert_bytes(dhkey_request(pk.state)!.x, peer.public_key.x)
    let cb = smp_keys.sc_confirm(peer.public_key.x, kp.public_key.x, nb, 0)
    let c = handle(pk.state, Pdu(smp.build_pairing_confirm(cb)), 30)
    test.assert_eq(list.len(c.pdus), 1)
    test.assert_eq(c.pdus[0][0] as Int, smp.SMP_OP_PAIRING_RANDOM)
    assert_bytes(value16(c, 0), c.state.local_rand)
    // The DHKey comes back before Nb: nothing goes out yet.
    let dh = handle(c.state, DhKeyComputed(smp_keys.dhkey(kp.private_key, peer.public_key)), 31)
    test.assert_eq(list.len(dh.pdus), 0)
    let n = handle(dh.state, Pdu(smp.build_pairing_random(nb)), 40)
    test.assert_eq(list.len(n.pdus), 1)
    test.assert_eq(n.pdus[0][0] as Int, smp.SMP_OP_PAIRING_DHKEY_CHECK)

@test
fn test_sc_just_works_reaches_encryption_with_the_ltk()
    let resp = sc_open(config_with(3), 3, smp.SMP_AUTHREQ_BONDING | smp.SMP_AUTHREQ_SC, 0, 0)
    let kp = smp_keys.key_pair_from_private(initiator_private())
    let peer = responder_key_pair()
    let nb = hex("a6e8e7cc25a75f6e216583f7ff3dc4cf")
    let a = smp_keys.address_56(1, own_address())
    let b = smp_keys.address_56(0, peer_address())
    let pk = sc_public_key(resp, peer)
    let cb = smp_keys.sc_confirm(peer.public_key.x, kp.public_key.x, nb, 0)
    let c = handle(pk.state, Pdu(smp.build_pairing_confirm(cb)), 30)
    let dh = handle(c.state, DhKeyComputed(smp_keys.dhkey(kp.private_key, peer.public_key)), 31)
    let n = handle(dh.state, Pdu(smp.build_pairing_random(nb)), 40)
    // Ea, checked here the way the responder checks the initiator's.
    let keys = smp_keys.sc_keys(smp_keys.dhkey(peer.private_key, kp.public_key), n.state.local_rand, nb, a, b)
    let ea = smp_keys.sc_check(keys.mac_key, n.state.local_rand, nb, smp_keys.zeros(16),
                               1 | smp.SMP_AUTHREQ_SC | smp.SMP_AUTHREQ_CT2, 0, 3, a, b)
    assert_bytes(value16(n, 0), ea)
    // Eb, with the responder's AuthReq and IO Capability of its response.
    let eb = smp_keys.sc_check(keys.mac_key, nb, n.state.local_rand, smp_keys.zeros(16),
                               1 | smp.SMP_AUTHREQ_SC, 0, 3, b, a)
    let done = handle(n.state, Pdu(smp.build_pairing_dhkey_check(eb)), 50)
    test.assert_eq(action_name(done), "encrypt")
    assert_bytes(action_ltk(done), keys.ltk)
    let enc = handle(done.state, EncryptionChanged(true), 60)
    test.assert_eq(action_name(enc), "complete")
    let result = action_result(enc)
    test.assert_eq(result.level, 2)
    test.assert(result.bond.secure_connections)
    test.assert_eq(result.bond.ediv, 0)
    assert_bytes(result.bond.ltk, keys.ltk)
    test.assert_eq(result.bond.key_size, 16)

@test
fn test_sc_wrong_eb_fails_with_dhkey_check_failed()
    let resp = sc_open(config_with(3), 3, smp.SMP_AUTHREQ_BONDING | smp.SMP_AUTHREQ_SC, 0, 0)
    let kp = smp_keys.key_pair_from_private(initiator_private())
    let peer = responder_key_pair()
    let nb = hex("a6e8e7cc25a75f6e216583f7ff3dc4cf")
    let pk = sc_public_key(resp, peer)
    let c = handle(pk.state, Pdu(smp.build_pairing_confirm(smp_keys.sc_confirm(peer.public_key.x, kp.public_key.x, nb, 0))), 30)
    let dh = handle(c.state, DhKeyComputed(smp_keys.dhkey(kp.private_key, peer.public_key)), 31)
    let n = handle(dh.state, Pdu(smp.build_pairing_random(nb)), 40)
    assert_failed_with(handle(n.state, Pdu(smp.build_pairing_dhkey_check(smp_keys.zeros(16))), 50), smp.SMP_FAIL_DHKEY_CHECK_FAILED)

// SM/CEN/KDU/BI-04-C: the responder's public key is not on the curve, and
// the responder's own half refuses the same key the same way
// (SM/PER/KDU/BI-04-C).  The debug key pair and a key with this device's
// own X coordinate are the other two refusals of Section 2.3.5.6.1.
@test
fn test_an_invalid_public_key_fails_with_dhkey_check_failed()
    let resp = sc_open(config_with(3), 3, smp.SMP_AUTHREQ_BONDING | smp.SMP_AUTHREQ_SC, 0, 0)
    let peer = responder_key_pair()
    var bad_y = peer.public_key.y[:]
    bad_y[0] = ((bad_y[0] as Int) ^ 1) as u8
    assert_failed_with(handle(resp.state, Pdu(smp.build_pairing_public_key(peer.public_key.x, bad_y)), 20), smp.SMP_FAIL_DHKEY_CHECK_FAILED)
    let debug = smp_keys.debug_public_key()
    assert_failed_with(handle(resp.state, Pdu(smp.build_pairing_public_key(debug.x, debug.y)), 20), smp.SMP_FAIL_INVALID_PARAMETERS)
    // Both coordinates off the curve, and one of them: a point is refused
    // whatever it is that fails (Section 2.3.5.6.1).
    let peer_x = peer.public_key.x[:]
    assert_failed_with(handle(resp.state, Pdu(smp.build_pairing_public_key(peer_x, smp_keys.zeros(32))), 20), smp.SMP_FAIL_DHKEY_CHECK_FAILED)
    assert_failed_with(handle(resp.state, Pdu(smp.build_pairing_public_key(smp_keys.zeros(32), peer.public_key.y)), 20), smp.SMP_FAIL_DHKEY_CHECK_FAILED)

// SM/CEN/OOB/BV-03-C and BV-09-C: only this device holds out of band
// data, so its Pairing Request says so and the responder answers with its
// own flag clear.  The model is Just Works with the zero Temporary Key
// (Section 2.3.5.5): the out of band value counts only when both sides
// have one.
@test
fn test_legacy_oob_data_on_one_side_only_pairs_as_just_works()
    let tk = hex("a0a1a2a3a4a5a6a7a8a9aaabacadaeaf")
    let s = handle(connected(config_legacy(3), no_key_pair()), SetLegacyOobTk(tk), 0).state
    let r = handle(s, StartPairing(2), 0)
    test.assert_eq(r.pdus[0][2] as Int, smp.SMP_OOB_PRESENT)
    let pres = pres_of(3, 0, smp.SMP_AUTHREQ_BONDING, 16, 0, 0)
    let resp = handle(r.state, Pdu(pres), 10)
    test.assert(resp.state.method == Method.JustWorks)
    test.assert_eq(resp.state.tk, smp_keys.zeros(16))

@test
fn test_sc_numeric_comparison_waits_for_the_user()
    // SM/CEN/SCJW/BV-01-C with DisplayYesNo on both sides.
    let resp = sc_open(config_with(smp.SMP_IO_CAP_DISPLAY_YES_NO), smp.SMP_IO_CAP_DISPLAY_YES_NO,
                       smp.SMP_AUTHREQ_BONDING | smp.SMP_AUTHREQ_MITM | smp.SMP_AUTHREQ_SC, 0, 0)
    let kp = smp_keys.key_pair_from_private(initiator_private())
    let peer = responder_key_pair()
    let nb = hex("a6e8e7cc25a75f6e216583f7ff3dc4cf")
    let pk = sc_public_key(resp, peer)
    let c = handle(pk.state, Pdu(smp.build_pairing_confirm(smp_keys.sc_confirm(peer.public_key.x, kp.public_key.x, nb, 0))), 30)
    let dh = handle(c.state, DhKeyComputed(smp_keys.dhkey(kp.private_key, peer.public_key)), 31)
    let n = handle(dh.state, Pdu(smp.build_pairing_random(nb)), 40)
    test.assert_eq(action_name(n), "numeric")
    test.assert_eq(action_int(n), smp_keys.numeric_value(kp.public_key.x, peer.public_key.x, n.state.local_rand, nb))
    // Ea waits for the user's answer.
    test.assert_eq(list.len(n.pdus), 0)
    let no = handle(n.state, NumericConfirmed(false), 41)
    assert_failed_with(no, smp.SMP_FAIL_NUMERIC_COMPARISON_FAILED)
    let yes = handle(n.state, NumericConfirmed(true), 41)
    test.assert_eq(yes.pdus[0][0] as Int, smp.SMP_OP_PAIRING_DHKEY_CHECK)

@test
fn test_sc_passkey_entry_runs_the_twenty_rounds()
    // SM/CEN/SCPK/BV-01-C: this device's user types the passkey.
    let resp = sc_open(config_with(smp.SMP_IO_CAP_KEYBOARD_ONLY), smp.SMP_IO_CAP_DISPLAY_ONLY,
                       smp.SMP_AUTHREQ_BONDING | smp.SMP_AUTHREQ_MITM | smp.SMP_AUTHREQ_SC, 0, 0)
    let kp = smp_keys.key_pair_from_private(initiator_private())
    let peer = responder_key_pair()
    let passkey = 131313
    let pk = sc_public_key(resp, peer)
    test.assert_eq(action_name(pk), "request")
    let typed = handle(pk.state, PasskeyEntered(passkey), 21)
    test.assert_eq(typed.pdus[0][0] as Int, smp.SMP_OP_PAIRING_CONFIRM)
    // One round: Cai, then Nai, with Cbi = f4(PKbx, PKax, Nbi, Zi).
    let z = smp_keys.passkey_z(passkey, 0)
    assert_bytes(value16(typed, 0), smp_keys.sc_confirm(kp.public_key.x, peer.public_key.x, typed.state.local_rand, z))
    let nb0 = hex("0033445566778899aabbccddeeff0011")
    let cbi = smp_keys.sc_confirm(peer.public_key.x, kp.public_key.x, nb0, z)
    let c = handle(typed.state, Pdu(smp.build_pairing_confirm(cbi)), 22)
    assert_bytes(value16(c, 0), typed.state.local_rand)
    let n = handle(c.state, Pdu(smp.build_pairing_random(nb0)), 23)
    test.assert_eq(n.state.round, 1)
    test.assert_eq(n.pdus[0][0] as Int, smp.SMP_OP_PAIRING_CONFIRM)
    // Passkey Entry displays and types; the Keypress flag is clear.
    test.assert_eq(list.len(handle(typed.state, SendKeypress(smp.SMP_KEYPRESS_DIGIT_ENTERED), 24).pdus), 0)
    // A wrong Cbi fails at once.
    let bad = handle(typed.state, Pdu(smp.build_pairing_confirm(smp_keys.zeros(16))), 22)
    assert_failed_with(handle(bad.state, Pdu(smp.build_pairing_random(nb0)), 23), smp.SMP_FAIL_CONFIRM_VALUE_FAILED)

@test
fn test_sc_out_of_band_checks_the_confirm_it_was_given()
    // SM/CEN/SCOB/BV-01-C: both devices hold out of band data.
    let kp = smp_keys.key_pair_from_private(initiator_private())
    let s0 = connected(config_with(3), kp)
    let local = handle(s0, CreateOobData, 0)
    test.assert_eq(action_name(local), "oob")
    let ra = local.state.local_oob_r
    let rb = hex("12a3343bb453bb5408da42d20c2d0fc8")
    let peer = responder_key_pair()
    // The responder's C is f4(PKbx, PKbx, rb, 0): its own key twice
    // (Section 2.3.5.6.4).
    let cb = smp_keys.sc_confirm(peer.public_key.x, peer.public_key.x, rb, 0)
    let s1 = handle(local.state, SetPeerOobData(rb, cb), 0).state
    let r = handle(s1, StartPairing(2), 0)
    test.assert_eq(r.pdus[0][2] as Int, smp.SMP_OOB_PRESENT)
    let pres = pres_of(3, 1, smp.SMP_AUTHREQ_BONDING | smp.SMP_AUTHREQ_SC, 16, 0, 0)
    let resp = handle(r.state, Pdu(pres), 10)
    test.assert(resp.state.method == Method.OutOfBand)
    let pk = sc_public_key(resp, peer)
    // Na goes out at once, with no confirm (Figure 2.5).
    test.assert_eq(pk.pdus[0][0] as Int, smp.SMP_OP_PAIRING_RANDOM)
    let na = pk.state.local_rand
    let nb = hex("a6e8e7cc25a75f6e216583f7ff3dc4cf")
    // The DHKey of the exchange is in before Nb arrives.
    let dh = handle(pk.state, DhKeyComputed(smp_keys.dhkey(kp.private_key, peer.public_key)), 25)
    let n = handle(dh.state, Pdu(smp.build_pairing_random(nb)), 30)
    test.assert_eq(n.pdus[0][0] as Int, smp.SMP_OP_PAIRING_DHKEY_CHECK)
    // The check values take ra and rb, each from the device that holds it.
    let a = smp_keys.address_56(1, own_address())
    let b = smp_keys.address_56(0, peer_address())
    let keys = smp_keys.sc_keys(smp_keys.dhkey(peer.private_key, kp.public_key), na, nb, a, b)
    let ea = smp_keys.sc_check(keys.mac_key, na, nb, rb, 1 | smp.SMP_AUTHREQ_SC | smp.SMP_AUTHREQ_CT2, 1, 3, a, b)
    assert_bytes(value16(n, 0), ea)
    // SM/CEN/SCOB/BI-01-C: the responder's C is not the one it sent, and
    // the pairing ends the moment its public key is in, with the Pairing
    // Failed the model asks for and no Na (Section 2.3.5.6.4).
    let bad = handle(handle(s1, SetPeerOobData(rb, smp_keys.zeros(16)), 0).state, StartPairing(2), 0)
    let bad_resp = handle(bad.state, Pdu(pres), 10)
    let bad_pk = sc_public_key(bad_resp, peer)
    assert_failed_with(bad_pk, smp.SMP_FAIL_CONFIRM_VALUE_FAILED)
    test.assert(bad_pk.state.phase == Phase.Idle)

// The r this device published out of band is the one this half pairs with
// when the session hands it one it did not make itself: the BTP commands
// that carry out of band data run before the connection whose role
// decides which half pairs (SM/CEN/SCOB/BV-04-C), so the half that pairs
// is given the published r and must use it, not a draw of its own
// (Section 2.3.5.6.4).
@test
fn test_an_out_of_band_r_made_by_the_other_half_is_the_one_the_pairing_uses()
    let kp = smp_keys.key_pair_from_private(initiator_private())
    let peer = responder_key_pair()
    let ra = hex("0f1e2d3c4b5a69788796a5b4c3d2e1f0")
    let rb = hex("12a3343bb453bb5408da42d20c2d0fc8")
    let cb = smp_keys.sc_confirm(peer.public_key.x, peer.public_key.x, rb, 0)
    let s = handle(connected(config_with(3), kp), SetLocalOobData(ra), 0).state
    let s1 = handle(s, SetPeerOobData(rb, cb), 0).state
    assert_bytes(s1.local_oob_r, ra)
    let r = handle(s1, StartPairing(2), 0)
    test.assert_eq(r.pdus[0][2] as Int, smp.SMP_OOB_PRESENT)
    let pres = pres_of(3, 1, smp.SMP_AUTHREQ_BONDING | smp.SMP_AUTHREQ_SC, 16, 0, 0)
    let resp = handle(r.state, Pdu(pres), 10)
    test.assert(resp.state.method == Method.OutOfBand)
    // Ea takes rb and Eb takes ra, and ra is the published r.
    assert_bytes(smp_core.r_initiator(resp.state), ra)
    let pk = sc_public_key(resp, peer)
    let na = pk.state.local_rand
    let nb = hex("a6e8e7cc25a75f6e216583f7ff3dc4cf")
    let dh = handle(pk.state, DhKeyComputed(smp_keys.dhkey(kp.private_key, peer.public_key)), 25)
    let n = handle(dh.state, Pdu(smp.build_pairing_random(nb)), 30)
    test.assert_eq(n.pdus[0][0] as Int, smp.SMP_OP_PAIRING_DHKEY_CHECK)
    let a = smp_keys.address_56(1, own_address())
    let b = smp_keys.address_56(0, peer_address())
    let keys = smp_keys.sc_keys(smp_keys.dhkey(peer.private_key, kp.public_key), na, nb, a, b)
    let ea = smp_keys.sc_check(keys.mac_key, na, nb, rb, 1 | smp.SMP_AUTHREQ_SC | smp.SMP_AUTHREQ_CT2, 1, 3, a, b)
    assert_bytes(value16(n, 0), ea)

// The r values of f6 follow [Vol 3] Part H, Section 2.3.5.6.4: a device
// sets the peer's r to what it received out of band when its own Out of
// Band Data Flag says it did, and sets its own r to zero when the remote
// device's flag says "not present".  For the initiator, ra (its own r) is
// guarded by the Pairing Response flag and rb (the peer's r) by the
// Pairing Request flag.
@test
fn test_the_out_of_band_r_values_follow_the_specifications_rule()
    let kp = smp_keys.key_pair_from_private(initiator_private())
    let peer = responder_key_pair()
    let ra = hex("0f1e2d3c4b5a69788796a5b4c3d2e1f0")
    let rb = hex("12a3343bb453bb5408da42d20c2d0fc8")
    let cb = smp_keys.sc_confirm(peer.public_key.x, peer.public_key.x, rb, 0)
    let s = handle(connected(config_with(3), kp), SetLocalOobData(ra), 0).state
    let held = handle(s, SetPeerOobData(rb, cb), 0).state
    // This device holds the responder's r (its flag is set) and the
    // responder's flag is clear: rb is the received r, and ra is zero.
    let only_initiator_received = with_oob_flags(held, 1, smp.SMP_OOB_NOT_PRESENT)
    assert_bytes(smp_core.r_initiator(only_initiator_received), smp_keys.zeros(16))
    assert_bytes(smp_core.r_responder(only_initiator_received), rb)
    // The responder's flag is set and this device holds nothing from the
    // peer: ra is this device's own r, and rb is zero.
    let bare = with_oob_flags(s, 0, smp.SMP_OOB_PRESENT)
    assert_bytes(smp_core.r_initiator(bare), ra)
    assert_bytes(smp_core.r_responder(bare), smp_keys.zeros(16))
    // Both flags set: both r values count.
    let both = with_oob_flags(held, 1, smp.SMP_OOB_PRESENT)
    assert_bytes(smp_core.r_initiator(both), ra)
    assert_bytes(smp_core.r_responder(both), rb)

// ── Key distribution ────────────────────────────────────────────────

@test
fn test_the_responders_keys_arrive_in_order_and_bond_the_pairing()
    // LE legacy, both sides distributing everything: the initiator sends
    // EncKey, IdKey and SignKey of its own and takes the responder's.
    let s = connected(config_legacy(3), no_key_pair())
    let r = handle(s, StartPairing(2), 0)
    let pres = pres_of(3, 0, smp.SMP_AUTHREQ_BONDING, 16, 7, 7)
    let resp = handle(r.state, Pdu(pres), 10)
    test.assert_eq(resp.state.init_dist, 7)
    test.assert_eq(resp.state.resp_dist, 7)
    let rand_r = hex("0102030405060708090a0b0c0d0e0f10")
    let peer = legacy_peer(r.pdus[0], pres, smp_keys.zeros(16), rand_r)
    let c = handle(resp.state, Pdu(smp.build_pairing_confirm(peer.confirm_r)), 20)
    let done = handle(c.state, Pdu(smp.build_pairing_random(rand_r)), 30)
    let enc = handle(done.state, EncryptionChanged(true), 40)
    // The initiator's own keys first, in the Section 3.6.1 order.
    test.assert_eq(list.len(enc.pdus), 5)
    test.assert_eq(enc.pdus[0][0] as Int, smp.SMP_OP_ENCRYPTION_INFORMATION)
    test.assert_eq(enc.pdus[1][0] as Int, smp.SMP_OP_CENTRAL_IDENTIFICATION)
    test.assert_eq(enc.pdus[2][0] as Int, smp.SMP_OP_IDENTITY_INFORMATION)
    test.assert_eq(enc.pdus[3][0] as Int, smp.SMP_OP_IDENTITY_ADDRESS_INFORMATION)
    test.assert_eq(enc.pdus[4][0] as Int, smp.SMP_OP_SIGNING_INFORMATION)
    test.assert_eq(action_name(enc), "none")
    // The responder's, in the same order; a key out of order fails.
    assert_failed_with(handle(enc.state, Pdu(smp.build_identity_information(smp_keys.zeros(16))), 41), smp.SMP_FAIL_UNSPECIFIED_REASON)
    let k1 = handle(enc.state, Pdu(smp.build_encryption_information(hex("000102030405060708090a0b0c0d0e0f"))), 42)
    let k2 = handle(k1.state, Pdu(smp.build_central_identification(0x4321, hex("0807060504030201"))), 43)
    let k3 = handle(k2.state, Pdu(smp.build_identity_information(hex("ec0234a357c8ad05341010a60a397d9b"))), 44)
    let k4 = handle(k3.state, Pdu(smp.build_identity_address_information(1, hex("c1c2c3c4c5d6"))), 45)
    let k5 = handle(k4.state, Pdu(smp.build_signing_information(hex("f0f1f2f3f4f5f6f7f8f9fafbfcfdfeff"))), 46)
    test.assert_eq(action_name(k5), "complete")
    let result = action_result(k5)
    test.assert(result.bonded)
    let bond = result.bond
    // The key the encryption procedure uses later is the responder's.
    assert_bytes(bond.ltk, hex("000102030405060708090a0b0c0d0e0f"))
    test.assert_eq(bond.ediv, 0x4321)
    assert_bytes(bond.rand, hex("0807060504030201"))
    // And the key this device distributed is kept for the other role.
    assert_bytes(bond.peer_ltk, value16(enc, 0))
    test.assert_eq(bond.peer_ediv, (enc.pdus[1][1] as Int) | ((enc.pdus[1][2] as Int) << 8))
    assert_bytes(bond.local_csrk, value16(enc, 4))
    assert_bytes(bond.peer_csrk, hex("f0f1f2f3f4f5f6f7f8f9fafbfcfdfeff"))
    test.assert_eq(bond.peer_address_type, 1)
    assert_bytes(bond.peer_address, hex("c1c2c3c4c5d6"))
    assert_bytes(bond.peer_irk, hex("ec0234a357c8ad05341010a60a397d9b"))

@test
fn test_no_keys_are_distributed_without_bonding()
    let s = connected(config_legacy(3), no_key_pair())
    let r = handle(s, StartPairing(2), 0)
    let pres = pres_of(3, 0, 0, 16, 7, 7)
    let resp = handle(r.state, Pdu(pres), 10)
    test.assert_eq(resp.state.init_dist, 0)
    test.assert_eq(resp.state.resp_dist, 0)
    let rand_r = hex("0102030405060708090a0b0c0d0e0f10")
    let peer = legacy_peer(r.pdus[0], pres, smp_keys.zeros(16), rand_r)
    let c = handle(resp.state, Pdu(smp.build_pairing_confirm(peer.confirm_r)), 20)
    let done = handle(c.state, Pdu(smp.build_pairing_random(rand_r)), 30)
    let enc = handle(done.state, EncryptionChanged(true), 40)
    test.assert_eq(list.len(enc.pdus), 0)
    // A completed pairing counts as a success (Section 2.3.6).
    test.assert_eq(enc.state.successes, 1)
    let result = action_result(enc)
    test.assert(not result.bonded)
    test.assert_eq(list.len(result.bond.ltk), 0)
    // The encryption procedure ran with the STK either way: the bond
    // keeps no key for a later connection, but the link is encrypted.
    assert_bytes(action_ltk(done), smp_keys.legacy_stk(smp_keys.zeros(16), rand_r, done.state.local_rand))

// The Pairing Response answers the offer in the Pairing Request: a
// Peripheral that sets a flag the Central left at zero gets nothing built
// for it (Section 3.6.1).  This device has no Identity Resolving Key and
// does not sign, so it offers EncKey only, and an IdKey or SignKey it never
// offered must not reach the key distribution.
@test
fn test_a_response_that_over_asks_the_key_distribution_is_masked_by_the_offer()
    let s = connected(config_unidentified(3), no_key_pair())
    let r = handle(s, StartPairing(2), 0)
    test.assert_eq(r.pdus[0][5] as Int, smp.SMP_KEY_DIST_ENC)
    let pres = pres_of(3, 0, smp.SMP_AUTHREQ_BONDING, 16, 7, 7)
    let resp = handle(r.state, Pdu(pres), 10)
    test.assert_eq(resp.state.init_dist, smp.SMP_KEY_DIST_ENC)
    test.assert_eq(resp.state.resp_dist, 7)
    let rand_r = hex("0102030405060708090a0b0c0d0e0f10")
    let peer = legacy_peer(r.pdus[0], pres, smp_keys.zeros(16), rand_r)
    let c = handle(resp.state, Pdu(smp.build_pairing_confirm(peer.confirm_r)), 20)
    let done = handle(c.state, Pdu(smp.build_pairing_random(rand_r)), 30)
    let enc = handle(done.state, EncryptionChanged(true), 40)
    test.assert_eq(list.len(enc.pdus), 2)
    test.assert_eq(enc.pdus[0][0] as Int, smp.SMP_OP_ENCRYPTION_INFORMATION)
    test.assert_eq(enc.pdus[1][0] as Int, smp.SMP_OP_CENTRAL_IDENTIFICATION)

@test
fn test_a_secure_connections_response_that_sets_enckey_is_masked_to_idkey_and_signkey()
    let resp = sc_open(config_with(3), 3, smp.SMP_AUTHREQ_BONDING | smp.SMP_AUTHREQ_SC, 7, 7)
    test.assert_eq(resp.state.init_dist, smp.SMP_KEY_DIST_ID | smp.SMP_KEY_DIST_SIGN)
    test.assert_eq(resp.state.resp_dist, smp.SMP_KEY_DIST_ID | smp.SMP_KEY_DIST_SIGN)

@test
fn test_sc_distributes_no_ltk_and_completes_on_the_responders_keys()
    // SM/CEN/KDU/BV-10-C and BV-11-C: IdKey and SignKey over LE Secure
    // Connections, no EncKey either way.
    let resp = sc_open(config_with(3), 3, smp.SMP_AUTHREQ_BONDING | smp.SMP_AUTHREQ_SC,
                       smp.SMP_KEY_DIST_ID | smp.SMP_KEY_DIST_SIGN,
                       smp.SMP_KEY_DIST_ID | smp.SMP_KEY_DIST_SIGN)
    test.assert_eq(resp.state.init_dist, smp.SMP_KEY_DIST_ID | smp.SMP_KEY_DIST_SIGN)
    test.assert_eq(resp.state.resp_dist, smp.SMP_KEY_DIST_ID | smp.SMP_KEY_DIST_SIGN)
    let kp = smp_keys.key_pair_from_private(initiator_private())
    let peer = responder_key_pair()
    let a = smp_keys.address_56(1, own_address())
    let b = smp_keys.address_56(0, peer_address())
    let nb = hex("a6e8e7cc25a75f6e216583f7ff3dc4cf")
    let pk = sc_public_key(resp, peer)
    let c = handle(pk.state, Pdu(smp.build_pairing_confirm(smp_keys.sc_confirm(peer.public_key.x, kp.public_key.x, nb, 0))), 30)
    let dh = handle(c.state, DhKeyComputed(smp_keys.dhkey(kp.private_key, peer.public_key)), 31)
    let n = handle(dh.state, Pdu(smp.build_pairing_random(nb)), 40)
    let keys = smp_keys.sc_keys(smp_keys.dhkey(peer.private_key, kp.public_key), n.state.local_rand, nb, a, b)
    let eb = smp_keys.sc_check(keys.mac_key, nb, n.state.local_rand, smp_keys.zeros(16),
                               1 | smp.SMP_AUTHREQ_SC, 0, 3, b, a)
    let done = handle(n.state, Pdu(smp.build_pairing_dhkey_check(eb)), 50)
    let enc = handle(done.state, EncryptionChanged(true), 60)
    test.assert_eq(list.len(enc.pdus), 3)
    test.assert_eq(enc.pdus[0][0] as Int, smp.SMP_OP_IDENTITY_INFORMATION)
    test.assert_eq(enc.pdus[2][0] as Int, smp.SMP_OP_SIGNING_INFORMATION)
    let k1 = handle(enc.state, Pdu(smp.build_identity_information(hex("ec0234a357c8ad05341010a60a397d9b"))), 61)
    let k2 = handle(k1.state, Pdu(smp.build_identity_address_information(1, hex("c1c2c3c4c5d6"))), 62)
    let k3 = handle(k2.state, Pdu(smp.build_signing_information(hex("f0f1f2f3f4f5f6f7f8f9fafbfcfdfeff"))), 63)
    test.assert_eq(action_name(k3), "complete")
    let bond = action_result(k3).bond
    test.assert(bond.secure_connections)
    test.assert_eq(bond.ediv, 0)
    assert_bytes(bond.ltk, keys.ltk)
    assert_bytes(bond.peer_irk, hex("ec0234a357c8ad05341010a60a397d9b"))

// ── The timer, the cancelled pairing and the stray commands ─────────

@test
fn test_timeout_silences_the_channel_until_the_next_connection()
    let s = connected(config_legacy(3), no_key_pair())
    let r = handle(s, StartPairing(2), 0)
    let late = handle(r.state, Tick, smp_core.SMP_TIMEOUT_MS + 1)
    test.assert_eq(action_name(late), "timeout")
    test.assert(not is_pairing(late.state))
    // Nothing is answered on this connection again.
    test.assert_eq(list.len(handle(late.state, Pdu(smp.build_pairing_response(3, 0, 1, 16, 0, 0)), smp_core.SMP_TIMEOUT_MS + 2).pdus), 0)
    test.assert_eq(action_name(handle(late.state, StartPairing(2), smp_core.SMP_TIMEOUT_MS + 3)), "none")
    // A new connection clears it.
    let again = handle(late.state, Connected(1, own_address(), 0, peer_address(), None), smp_core.SMP_TIMEOUT_MS + 4)
    test.assert_eq(action_name(handle(again.state, StartPairing(2), smp_core.SMP_TIMEOUT_MS + 4)), "none")
    test.assert_eq(list.len(handle(again.state, StartPairing(2), smp_core.SMP_TIMEOUT_MS + 4).pdus), 1)

@test
fn test_cancel_sends_pairing_failed()
    let s = connected(config_legacy(3), no_key_pair())
    let r = handle(s, StartPairing(2), 0)
    let cancelled = handle(r.state, Cancel, 10)
    assert_failed_with(cancelled, smp.SMP_FAIL_UNSPECIFIED_REASON)
    test.assert(not is_pairing(cancelled.state))
    test.assert_eq(list.len(handle(cancelled.state, Cancel, 10).pdus), 0)
    // Cancelling outside a pairing is a no-op.
    test.assert_eq(action_name(handle(connected(config_legacy(3), no_key_pair()), Cancel, 10)), "none")

@test
fn test_unexpected_and_malformed_commands()
    let s = connected(config_legacy(3), no_key_pair())
    // Outside a pairing: an unexpected command is refused, a short one
    // with Invalid Parameters.
    assert_failed_with(handle(s, Pdu(smp.build_pairing_random(hex("000102030405060708090a0b0c0d0e0f"))), 0), smp.SMP_FAIL_UNSPECIFIED_REASON)
    assert_failed_with(handle(s, Pdu([smp.SMP_OP_PAIRING_CONFIRM]), 0), smp.SMP_FAIL_INVALID_PARAMETERS)
    // A reserved Code is ignored.
    test.assert_eq(list.len(handle(s, Pdu([0x0F]), 0).pdus), 0)
    test.assert_eq(list.len(handle(s, Pdu([]), 0).pdus), 0)
    let r = handle(s, StartPairing(2), 0)
    // A short command inside a pairing fails it.
    assert_failed_with(handle(r.state, Pdu([smp.SMP_OP_PAIRING_RESPONSE]), 10), smp.SMP_FAIL_INVALID_PARAMETERS)
    // A Pairing Response with a reserved IO Capability or OOB flag.
    assert_failed_with(handle(r.state, Pdu(pres_of(9, 0, 0, 16, 0, 0)), 10), smp.SMP_FAIL_INVALID_PARAMETERS)
    let r2 = handle(s, StartPairing(2), 0)
    assert_failed_with(handle(r2.state, Pdu(pres_of(3, 2, 0, 16, 0, 0)), 10), smp.SMP_FAIL_INVALID_PARAMETERS)

@test
fn test_pairing_supported_off_refuses_everything()
    let d = config_legacy(3)
    let cfg = SmpConfig {
        io_capability: d.io_capability, bondable: d.bondable, secure_connections: d.secure_connections,
        sc_only: d.sc_only, required_level: d.required_level, keypress: d.keypress, request_mitm: d.request_mitm,
        max_key_size: d.max_key_size, min_key_size: d.min_key_size, identity_irk: d.identity_irk,
        identity_address_type: d.identity_address_type, identity_address: d.identity_address,
        distribute_csrk: d.distribute_csrk, accept_debug_key: d.accept_debug_key,
        pairing_supported: false, attempt_min_wait_ms: 0, attempt_max_wait_ms: 0 }
    let s = connected(cfg, no_key_pair())
    assert_failed_with(handle(s, Pdu(smp.build_security_request(smp.SMP_AUTHREQ_BONDING)), 0), smp.SMP_FAIL_PAIRING_NOT_SUPPORTED)

@test
fn test_a_disconnect_ends_the_pairing()
    let s = connected(config_legacy(3), no_key_pair())
    let r = handle(s, StartPairing(2), 0)
    let d = handle(r.state, Disconnected, 10)
    test.assert_eq(action_name(d), "failed")
    test.assert_eq(d.state.bond, None)
    test.assert(not is_pairing(d.state))

@test
fn test_reseed_and_the_local_oob_data()
    let s = connected(config_with(3), no_key_pair())
    let seeded = handle(s, Reseed(seed()), 0)
    test.assert_eq(list.len(seeded.pdus), 0)
    let made = handle(seeded.state, CreateOobData, 0)
    let r = made.state.local_oob_r
    let kp = s.key_pair
    assert_bytes(action_oob(made), list.concat(r, smp_keys.sc_confirm(kp.public_key.x, kp.public_key.x, r, 0)))

// ── The two halves against each other ───────────────────────────────

struct Exchange
    a: SmpInitState
    b: smp_core.PairingState
    steps: Int

fn peer_connected(owner: [u8], peer: [u8], key_pair: KeyPair) -> smp_core.PairingState
    peer_connected_as(smp.SMP_IO_CAP_NO_INPUT_NO_OUTPUT, owner, peer, key_pair)

fn peer_connected_as(io_cap: Int, owner: [u8], peer: [u8], key_pair: KeyPair) -> smp_core.PairingState
    let s = smp_responder.new_state(config_with(io_cap), key_pair, peer_seed())
    smp_responder.handle(s, smp_responder.Connected(0, owner, 1, peer, None), 0).state

// Hand every command `first` and every command each side answers to the
// other, until neither side has one left, counting the exchanges.  The
// DHKey each side asks for is computed here, as the session computes it.
fn run_both(a0: SmpInitState, first: [[u8]], b0: smp_core.PairingState, rounds: Int) -> Exchange
    var a = copy(a0)
    var b = smp_core.copy(b0)
    var to_b: [[u8]] = first[:]
    var to_a: [[u8]] = []
    var steps = 0
    for i in 0..rounds
        while list.len(to_b) > 0 or list.len(to_a) > 0
            if list.len(to_a) > 0
                let pdu = to_a[0]
                to_a = to_a[1:]
                let step = handle(a, Pdu(pdu), 10 + steps)
                a = step.state
                steps = steps + 1
                list.append(to_b, step.pdus[:])
                let wanted = dhkey_request(a)
                if wanted != None
                    a = handle(a, DhKeyComputed(smp_keys.dhkey(a.key_pair.private_key, wanted!)), 10 + steps).state
                // The user of the side that asked answers it: this side's
                // ConfirmNumericValue is accepted by its own user, and a passkey
                // it SHOWS is the one the responder's user must type.
                match step.action
                    Some(smp_initiator_action) =>
                        match smp_initiator_action
                            DisplayPasskey(passkey) =>
                                let answered = smp_responder.handle(b, smp_responder.PasskeyEntered(passkey), 10 + steps)
                                b = answered.state
                                list.append(to_a, answered.pdus[:])
                            ConfirmNumericValue(_) =>
                                let answered = handle(a, NumericConfirmed(true), 10 + steps)
                                a = answered.state
                                list.append(to_b, answered.pdus[:])
                            _ => ()
                    None => ()
            else
                let pdu = to_b[0]
                to_b = to_b[1:]
                let step = smp_responder.handle(b, smp_responder.Pdu(pdu), 10 + steps)
                b = step.state
                steps = steps + 1
                list.append(to_a, step.pdus[:])
                match smp_core.dhkey_request(b)
                    Some(peer) =>
                        b = smp_responder.handle(b, smp_responder.DhKeyComputed(smp_keys.dhkey(b.key_pair.private_key, peer)), 10 + steps).state
                    None => ()
                // As above the other way round: a passkey the responder shows
                // is the one this device's user types, and its numeric
                // comparison is accepted by its own user.
                match step.action
                    Some(responder_action) =>
                        match responder_action
                            smp_responder.DisplayPasskey(passkey) =>
                                let typed = handle(a, PasskeyEntered(passkey), 10 + steps)
                                a = typed.state
                                list.append(to_b, typed.pdus[:])
                            smp_responder.ConfirmNumericValue(_) =>
                                let accepted = smp_responder.handle(b, smp_responder.NumericConfirmed(true), 10 + steps)
                                b = accepted.state
                                list.append(to_a, accepted.pdus[:])
                            _ => ()
                    None => ()
            if list.len(to_a) == 0 and list.len(to_b) == 0
                return Exchange { a: a, b: b, steps: steps }
    Exchange { a: a, b: b, steps: steps }

@test
fn test_the_responder_completes_the_legacy_pairing_this_device_started()
    // LE legacy Just Works between the two halves of this package: the
    // responder answers the Pairing Request this device sends and both
    // end up with the same Short Term Key.
    let kp = smp_keys.key_pair_from_private(initiator_private())
    let a0 = connected(config_legacy(smp.SMP_IO_CAP_NO_INPUT_NO_OUTPUT), kp)
    let r = handle(a0, StartPairing(2), 0)
    let b0 = peer_connected(peer_address(), own_address(), responder_key_pair())
    let run = run_both(r.state, r.pdus, b0, 8)
    test.assert(run.a.phase == Phase.Encryption)
    test.assert(run.b.phase == Phase.Encryption)
    test.assert_eq(run.steps, 6)
    assert_bytes(run.a.session_key, run.b.session_key)

// SM/CEN/SCPK/BV-01-C end to end: twenty rounds of Cai/Cbi and Nai/Nbi
// between the two halves of this package, the DHKey checks over the
// TWENTIETH round's nonces, and one Long Term Key.  The round this pins is
// the one the rig caught: with the last Nai dropped, the f5 of stage 2 takes
// an empty nonce and the responder answers Pairing Failed (DHKey Check
// Failed), which no Just Works run can see.
@test
fn test_the_responder_completes_the_secure_connections_passkey_pairing()
    let kp = smp_keys.key_pair_from_private(initiator_private())
    let a0 = connected(config_with(smp.SMP_IO_CAP_KEYBOARD_ONLY), kp)
    let r = handle(a0, StartPairing(2), 0)
    let b0 = peer_connected_as(smp.SMP_IO_CAP_DISPLAY_ONLY, peer_address(), own_address(), responder_key_pair())
    let run = run_both(r.state, r.pdus, b0, 64)
    test.assert_eq(run.a.round, smp_core.PASSKEY_ROUNDS)
    test.assert_eq(run.b.round, smp_core.PASSKEY_ROUNDS)
    test.assert_eq(list.len(run.a.local_rand), 16)
    test.assert_eq(list.len(run.b.local_rand), 16)
    test.assert(run.a.phase == Phase.Encryption)
    test.assert(run.b.phase == Phase.Encryption)
    assert_bytes(run.a.session_key, run.b.session_key)
    test.assert_eq(list.len(run.a.session_key), 16)

// The same with this device's user typing the passkey: the responder
// displays it and asks for nothing.
@test
fn test_the_responder_completes_the_secure_connections_passkey_pairing_it_displays()
    let kp = smp_keys.key_pair_from_private(initiator_private())
    let a0 = connected(config_with(smp.SMP_IO_CAP_DISPLAY_ONLY), kp)
    let r = handle(a0, StartPairing(2), 0)
    let b0 = peer_connected_as(smp.SMP_IO_CAP_KEYBOARD_ONLY, peer_address(), own_address(), responder_key_pair())
    let run = run_both(r.state, r.pdus, b0, 64)
    test.assert_eq(run.a.round, smp_core.PASSKEY_ROUNDS)
    test.assert(run.a.phase == Phase.Encryption)
    test.assert(run.b.phase == Phase.Encryption)
    assert_bytes(run.a.session_key, run.b.session_key)

// And Numeric Comparison: both sides display the same value, both users
// accept it, and the DHKey checks are over the one pair of nonces.
@test
fn test_the_responder_completes_the_numeric_comparison_this_device_started()
    let kp = smp_keys.key_pair_from_private(initiator_private())
    let a0 = connected(config_with(smp.SMP_IO_CAP_DISPLAY_YES_NO), kp)
    let r = handle(a0, StartPairing(2), 0)
    let b0 = peer_connected_as(smp.SMP_IO_CAP_DISPLAY_YES_NO, peer_address(), own_address(), responder_key_pair())
    let run = run_both(r.state, r.pdus, b0, 16)
    test.assert(run.a.method == Method.NumericComparison)
    // The user's answer each side waits for, and the Ea of this device
    // reaching the responder, which is what names the DHKey check.
    test.assert(run.a.numeric_confirmed)
    test.assert(run.b.numeric_confirmed)
    test.assert(run.a.check_sent)
    test.assert_eq(list.len(run.b.peer_check), 16)
    test.assert(run.a.phase == Phase.Encryption)
    test.assert(run.b.phase == Phase.Encryption)
    assert_bytes(run.a.session_key, run.b.session_key)

@test
fn test_the_responder_completes_the_secure_connections_pairing_this_device_started()
    // The same over LE Secure Connections: two DHKey values, the Ea and
    // Eb of both sides, and one Long Term Key.
    let kp = smp_keys.key_pair_from_private(initiator_private())
    let a0 = connected(config_with(smp.SMP_IO_CAP_NO_INPUT_NO_OUTPUT), kp)
    let r = handle(a0, StartPairing(2), 0)
    let b0 = peer_connected(peer_address(), own_address(), responder_key_pair())
    let run = run_both(r.state, r.pdus, b0, 12)
    test.assert(run.a.phase == Phase.Encryption)
    test.assert(run.b.phase == Phase.Encryption)
    assert_bytes(run.a.session_key, run.b.session_key)
    test.assert_eq(list.len(run.a.session_key), 16)

// SM/CEN/SCOB/BI-04-C, the case's own sequence: the Lower Tester has sent
// the WRONG Out of band data, so the confirm value the responder's public
// key implies is not the one it published.  The initiating half must
// catch that at the moment that key is in -- Cb = f4(PKbx, PKbx, rb, 0)
// -- send Pairing Failed (Confirm Value Failed, 0x04) and no Na, and the
// responding half hears the peer's failure and ends the pairing too
// (Section 2.3.5.6.4; the case's step 3 and its "Fail Expected to receive
// pairing failed").
@test
fn test_the_wrong_out_of_band_confirm_ends_the_pairing_with_0x04()
    let kp = smp_keys.key_pair_from_private(initiator_private())
    let peer = responder_key_pair()
    let rb = hex("12a3343bb453bb5408da42d20c2d0fc8")
    let wrong_c = hex("00112233445566778899aabbccddeeff")
    let a0 = handle(connected(config_with(smp.SMP_IO_CAP_NO_INPUT_NO_OUTPUT), kp), SetPeerOobData(rb, wrong_c), 0).state
    let r = handle(a0, StartPairing(2), 0)
    test.assert_eq(r.pdus[0][2] as Int, smp.SMP_OOB_PRESENT)
    // The responder holds Out of band data of its own (its flag is what
    // makes both sides run the model), answers the request and sends its
    // public key; the initiator's Pairing Failed is the only answer to it.
    let ra = hex("0f1e2d3c4b5a69788796a5b4c3d2e1f0")
    let ca = hex("f0e1d2c3b4a5968778695a4b3c2d1e0f")
    let b0 = smp_responder.handle(peer_connected(peer_address(), own_address(), peer), smp_responder.SetPeerOobData(ra, ca), 0).state
    let run = run_both(r.state, r.pdus, b0, 4)
    test.assert(run.a.phase == Phase.Idle)
    test.assert(run.b.phase == Phase.Idle)
    test.assert_eq(run.b.failures, 1)
    // The same sequence one step at a time: the failure is the Pairing
    // Failed with Confirm Value Failed, and no Pairing Random follows it.
    let b1 = smp_responder.handle(b0, smp_responder.Pdu(r.pdus[0]), 5)
    let a1 = handle(r.state, Pdu(b1.pdus[0]), 10)
    let b2 = smp_responder.handle(b1.state, smp_responder.Pdu(a1.pdus[0]), 15)
    let failed = handle(a1.state, Pdu(b2.pdus[0]), 20)
    assert_failed_with(failed, smp.SMP_FAIL_CONFIRM_VALUE_FAILED)
    test.assert(failed.state.phase == Phase.Idle)
    let heard = smp_responder.handle(b2.state, smp_responder.Pdu(failed.pdus[0]), 25)
    test.assert_eq(heard.state.failures, 1)
    match heard.action
        Some(a) =>
            match a
                smp_responder.PairingFailed(reason, by_peer) =>
                    test.assert_eq(reason, smp.SMP_FAIL_CONFIRM_VALUE_FAILED)
                    test.assert_eq(by_peer, true)
                _ => test.assert_eq("PairingFailed", "another action")
        None => test.assert_eq("an action", "none")
