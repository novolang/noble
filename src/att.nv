// att.nv — Attribute Protocol PDU encode / decode.
//
// Per Bluetooth Core Vol 3 Part F §3.3 — every ATT PDU is:
//
//   opcode:u8           top bit = signed, next bit = command flag
//   parameters:[u8]     opcode-specific layout
//   [auth_sig:[u8;12]]  optional, only when signed bit set
//
// On LE, ATT PDUs ride L2CAP CID 0x0004 (`l2cap.CID_ATT`).
//
// The server implements:
//
//   0x02/0x03  EXCHANGE_MTU
//   0x04/0x05  FIND_INFORMATION
//   0x06/0x07  FIND_BY_TYPE_VALUE
//   0x08/0x09  READ_BY_TYPE
//   0x0A/0x0B  READ
//   0x0C/0x0D  READ_BLOB
//   0x10/0x11  READ_BY_GROUP_TYPE
//
// plus the universal 0x01 ERROR_RSP, and the write side (writes /
// notifications / indications, 0x12/0x13/0x1B-0x1E).  Signed-write
// and the auth signature trailer have no impl.
//
// Satisfies: REQ-BLE-ATT-PDU-001 (opcode encoding), -002 (error
// response shape), -003 (request decoding), -004 (response
// encoding for that subset).

use std.test
use std.bits


// ── Opcodes (Vol 3 Part F §3.4) ─────────────────────────────────────

// The opcode of the ATT Error Response PDU ([Vol 3] Part F, Section 3.4).
pub const ATT_OP_ERROR_RSP             = 0x01
// The opcode of the ATT Exchange MTU Request PDU ([Vol 3] Part F, Section 3.4).
pub const ATT_OP_EXCHANGE_MTU_REQ      = 0x02
// The opcode of the ATT Exchange MTU Response PDU ([Vol 3] Part F, Section 3.4).
pub const ATT_OP_EXCHANGE_MTU_RSP      = 0x03
const ATT_OP_FIND_INFORMATION_REQ  = 0x04
const ATT_OP_FIND_INFORMATION_RSP  = 0x05
// The opcode of the ATT Find By Type Value Request PDU ([Vol 3] Part F, Section 3.4).
pub const ATT_OP_FIND_BY_TYPE_VALUE_REQ = 0x06
const ATT_OP_FIND_BY_TYPE_VALUE_RSP = 0x07
const ATT_OP_READ_BY_TYPE_REQ      = 0x08
const ATT_OP_READ_BY_TYPE_RSP      = 0x09
// The opcode of the ATT Read Request PDU ([Vol 3] Part F, Section 3.4).
pub const ATT_OP_READ_REQ              = 0x0A
// The opcode of the ATT Read Response PDU ([Vol 3] Part F, Section 3.4).
pub const ATT_OP_READ_RSP              = 0x0B
// The opcode of the ATT Read Blob Request PDU ([Vol 3] Part F, Section 3.4).
pub const ATT_OP_READ_BLOB_REQ         = 0x0C
const ATT_OP_READ_BLOB_RSP         = 0x0D
const ATT_OP_READ_MULTIPLE_REQ     = 0x0E
const ATT_OP_READ_MULTIPLE_RSP     = 0x0F
const ATT_OP_READ_BY_GROUP_TYPE_REQ = 0x10
const ATT_OP_READ_BY_GROUP_TYPE_RSP = 0x11
const ATT_OP_READ_MULTIPLE_VARIABLE_REQ = 0x20
const ATT_OP_READ_MULTIPLE_VARIABLE_RSP = 0x21

// Write-side opcodes (Write / Notify / Indicate / Prepare-Execute).
pub const ATT_OP_WRITE_REQ             = 0x12
// The opcode of the ATT Write Response PDU ([Vol 3] Part F, Section 3.4).
pub const ATT_OP_WRITE_RSP             = 0x13
// The opcode of the ATT Prepare Write Request PDU ([Vol 3] Part F, Section 3.4).
pub const ATT_OP_PREPARE_WRITE_REQ     = 0x16
const ATT_OP_PREPARE_WRITE_RSP     = 0x17
// The opcode of the ATT Execute Write Request PDU ([Vol 3] Part F, Section 3.4).
pub const ATT_OP_EXECUTE_WRITE_REQ     = 0x18
// The opcode of the ATT Execute Write Response PDU ([Vol 3] Part F, Section 3.4).
pub const ATT_OP_EXECUTE_WRITE_RSP     = 0x19
// The opcode of the ATT Handle Value Notification PDU ([Vol 3] Part F, Section 3.4).
pub const ATT_OP_HANDLE_VALUE_NTF      = 0x1B
// The opcode of the ATT Handle Value Indication PDU ([Vol 3] Part F, Section 3.4).
pub const ATT_OP_HANDLE_VALUE_IND      = 0x1D
const ATT_OP_HANDLE_VALUE_CFM      = 0x1E
// Write Command — the method of WRITE_REQ (0x12) with the command flag
// (bit 6) set: 0x12 | 0x40 = 0x52.  Spec §3.4.5.3.
pub const ATT_OP_WRITE_CMD             = 0x52
// Signed Write Command — a write command with the authentication
// signature flag (bit 7) set as well: 0x12 | 0xC0 = 0xD2.  Carries a
// 12-byte signature trailer, which nothing here produces or verifies.
pub const ATT_OP_SIGNED_WRITE_CMD      = 0xD2

// Execute-Write flags (Vol 3 Part F §3.4.6.3).
const ATT_EXECUTE_WRITE_FLAG_CANCEL = 0x00
// The flags value of an Execute Write Request that writes the queued prepared values ([Vol 3] Part F, Section
// 3.4.6.3).
pub const ATT_EXECUTE_WRITE_FLAG_WRITE  = 0x01


// ── Error codes (Vol 3 Part F §3.4.1.1) ─────────────────────────────

// The ATT error code Invalid Handle ([Vol 3] Part F, Section 3.4.1.1).
pub const ATT_ERR_INVALID_HANDLE              = 0x01
// The ATT error code Read Not Permitted ([Vol 3] Part F, Section 3.4.1.1).
pub const ATT_ERR_READ_NOT_PERMITTED          = 0x02
// The ATT error code Write Not Permitted ([Vol 3] Part F, Section 3.4.1.1).
pub const ATT_ERR_WRITE_NOT_PERMITTED         = 0x03
const ATT_ERR_INVALID_PDU                 = 0x04
// The ATT error code Insufficient Authentication ([Vol 3] Part F, Section 3.4.1.1).
pub const ATT_ERR_INSUFFICIENT_AUTHENTICATION = 0x05
// The ATT error code Request Not Supported ([Vol 3] Part F, Section 3.4.1.1).
pub const ATT_ERR_REQUEST_NOT_SUPPORTED       = 0x06
// The ATT error code Invalid Offset ([Vol 3] Part F, Section 3.4.1.1).
pub const ATT_ERR_INVALID_OFFSET              = 0x07
// The ATT error code Insufficient Authorization ([Vol 3] Part F, Section 3.4.1.1).
pub const ATT_ERR_INSUFFICIENT_AUTHORIZATION  = 0x08
const ATT_ERR_PREPARE_QUEUE_FULL          = 0x09
// The ATT error code Attribute Not Found ([Vol 3] Part F, Section 3.4.1.1).
pub const ATT_ERR_ATTRIBUTE_NOT_FOUND         = 0x0A
// The ATT error code Attribute Not Long ([Vol 3] Part F, Section 3.4.1.1).
pub const ATT_ERR_ATTRIBUTE_NOT_LONG          = 0x0B
const ATT_ERR_INSUFFICIENT_ENC_KEY_SIZE   = 0x0C
// The ATT error code Invalid Attribute Value Length ([Vol 3] Part F, Section 3.4.1.1).
pub const ATT_ERR_INVALID_ATTRIBUTE_VALUE_LEN = 0x0D
// The ATT error code Unlikely Error ([Vol 3] Part F, Section 3.4.1.1).
pub const ATT_ERR_UNLIKELY_ERROR              = 0x0E
// The ATT error code Insufficient Encryption ([Vol 3] Part F, Section 3.4.1.1).
pub const ATT_ERR_INSUFFICIENT_ENCRYPTION     = 0x0F
const ATT_ERR_UNSUPPORTED_GROUP_TYPE      = 0x10
// The ATT error code Insufficient Resources ([Vol 3] Part F, Section 3.4.1.1).
pub const ATT_ERR_INSUFFICIENT_RESOURCES      = 0x11
const ATT_ERR_DATABASE_OUT_OF_SYNC        = 0x12
// The ATT error code Value Not Allowed ([Vol 3] Part F, Section 3.4.1.1).
pub const ATT_ERR_VALUE_NOT_ALLOWED           = 0x13

// ── Common Profile and Service Error Codes ([CSS] Part B, Section 1.2) ──

// The ATT application error code Write Request Rejected (Core Specification Supplement, Part B, Section 1.2).
pub const ATT_ERR_WRITE_REQUEST_REJECTED      = 0xFC
// The ATT application error code Client Characteristic Configuration Descriptor Improperly Configured (Core
// Specification Supplement, Part B, Section 1.2).
pub const ATT_ERR_CCC_IMPROPERLY_CONFIGURED   = 0xFD
// The ATT application error code Procedure Already in Progress (Core Specification Supplement, Part B, Section 1.2).
pub const ATT_ERR_PROCEDURE_ALREADY_IN_PROGRESS = 0xFE
// The ATT application error code Out of Range (Core Specification Supplement, Part B, Section 1.2).
pub const ATT_ERR_OUT_OF_RANGE                = 0xFF


// ── Opcode bit fields ───────────────────────────────────────────────
//
// Vol 3 Part F §3.3.1 — the top two bits of the opcode byte are
// flags:
//
//   bit 7  authentication signature flag (1 = signed; 12-byte trailer)
//   bit 6  command flag                  (1 = no response expected)
//
// The bottom 6 bits are the opcode method.
pub @satisfies("REQ-BLE-ATT-PDU-001")
@tier(embedded)
@no_alloc
fn opcode_method(op: Int) -> Int
    op & 0x3F

@satisfies("REQ-BLE-ATT-PDU-001")
@tier(embedded)
@no_alloc
fn opcode_is_command(op: Int) -> Bool
    (op & 0x40) != 0

@satisfies("REQ-BLE-ATT-PDU-001")
@tier(embedded)
@no_alloc
fn opcode_is_signed(op: Int) -> Bool
    (op & 0x80) != 0


// ── ATT_ERROR_RSP (5 bytes) ─────────────────────────────────────────
//
//   opcode               = 0x01
//   request_opcode       = the opcode that failed
//   handle_in_error:u16  = handle the error pertains to (LE)
//   error_code           = one of ATT_ERR_*
@satisfies("REQ-BLE-ATT-PDU-002")
@tier(embedded)
fn build_error_rsp(req_opcode: Int, handle: Int, err_code: Int) -> [u8]
    [
        ATT_OP_ERROR_RSP,
        req_opcode as u8,
        (handle & 0xFF) as u8,
        ((handle >>> 8) & 0xFF) as u8,
        err_code as u8
    ]


// ── ATT_EXCHANGE_MTU_REQ / _RSP (3 bytes) ───────────────────────────
//
//   opcode | client_rx_mtu:u16 LE
//
// Symmetric — REQ and RSP carry the same payload, just with
// distinct opcodes.
@satisfies("REQ-BLE-ATT-PDU-004")
@tier(embedded)
fn build_exchange_mtu_rsp(server_rx_mtu: Int) -> [u8]
    [
        ATT_OP_EXCHANGE_MTU_RSP,
        (server_rx_mtu & 0xFF) as u8,
        ((server_rx_mtu >>> 8) & 0xFF) as u8
    ]

@satisfies("REQ-BLE-ATT-PDU-003")
@tier(embedded)
@no_alloc
fn read_exchange_mtu_req_mtu(pdu: [u8]) -> Int
    if list.len(pdu) < 3
        -1
    else
        (pdu[1] as Int) | ((pdu[2] as Int) << 8)


// ── ATT_READ_REQ / _RSP ─────────────────────────────────────────────
//
//   REQ  (3 bytes): opcode | handle:u16 LE
//   RSP  (1 + N) :  opcode | attribute_value:[u8]
@satisfies("REQ-BLE-ATT-PDU-003")
@tier(embedded)
@no_alloc
fn read_read_req_handle(pdu: [u8]) -> Int
    if list.len(pdu) < 3
        -1
    else
        (pdu[1] as Int) | ((pdu[2] as Int) << 8)

@satisfies("REQ-BLE-ATT-PDU-004")
@tier(embedded)
fn build_read_rsp(value: [u8]) -> [u8]
    var header: [u8] = list.with_capacity(1 + list.len(value))
    list.append(header, [ATT_OP_READ_RSP])
    list.append(header, value)
    header


// ── ATT_READ_BLOB_REQ ───────────────────────────────────────────────
//
//   REQ (5 bytes): opcode | handle:u16 LE | offset:u16 LE
//   RSP (1 + N) :  opcode | part_attribute_value:[u8]
@satisfies("REQ-BLE-ATT-PDU-003")
@tier(embedded)
@no_alloc
fn read_read_blob_req_handle(pdu: [u8]) -> Int
    if list.len(pdu) < 5
        -1
    else
        (pdu[1] as Int) | ((pdu[2] as Int) << 8)

@satisfies("REQ-BLE-ATT-PDU-003")
@tier(embedded)
@no_alloc
fn read_read_blob_req_offset(pdu: [u8]) -> Int
    if list.len(pdu) < 5
        -1
    else
        (pdu[3] as Int) | ((pdu[4] as Int) << 8)

@satisfies("REQ-BLE-ATT-PDU-004")
@tier(embedded)
fn build_read_blob_rsp(part: [u8]) -> [u8]
    var header: [u8] = list.with_capacity(1 + list.len(part))
    list.append(header, [ATT_OP_READ_BLOB_RSP])
    list.append(header, part)
    header


// ── ATT_READ_BY_TYPE_REQ / _RSP ─────────────────────────────────────
//
//   REQ (5+N): opcode | start:u16 LE | end:u16 LE | type:[u8]
//              type is 2 or 16 bytes (16/128-bit UUID)
//
//   RSP (2+N): opcode | length | data_list:[u8]
//              length = per-attribute pair size (handle:u16 + value)
//              data_list = repeated handle/value pairs
@satisfies("REQ-BLE-ATT-PDU-003")
@tier(embedded)
@no_alloc
fn read_read_by_type_req_start(pdu: [u8]) -> Int
    if list.len(pdu) < 5
        -1
    else
        (pdu[1] as Int) | ((pdu[2] as Int) << 8)

@satisfies("REQ-BLE-ATT-PDU-003")
@tier(embedded)
@no_alloc
fn read_read_by_type_req_end(pdu: [u8]) -> Int
    if list.len(pdu) < 5
        -1
    else
        (pdu[3] as Int) | ((pdu[4] as Int) << 8)

// Returns the length-of-each-pair byte count for the type slot:
// 2 (16-bit UUID) or 16 (128-bit UUID).  Returns -1 if the
// trailing type is malformed.
@satisfies("REQ-BLE-ATT-PDU-003")
@tier(embedded)
@no_alloc
fn read_read_by_type_req_type_len(pdu: [u8]) -> Int
    let n = list.len(pdu)
    if n < 7                       // opcode + start + end + at least 2 byte UUID
        -1
    else if n == 7
        2
    else if n == 21                // 5 + 16 = 21
        16
    else
        -1

// Returns the 16-bit type UUID (when type_len == 2).
@satisfies("REQ-BLE-ATT-PDU-003")
@tier(embedded)
@no_alloc
fn read_read_by_type_req_type16(pdu: [u8]) -> Int
    if read_read_by_type_req_type_len(pdu) != 2
        -1
    else
        (pdu[5] as Int) | ((pdu[6] as Int) << 8)

@satisfies("REQ-BLE-ATT-PDU-004")
@tier(embedded)
fn build_read_by_type_rsp(pair_len: Int, data: [u8]) -> [u8]
    [ATT_OP_READ_BY_TYPE_RSP, pair_len as u8, ...data]


// ── ATT_READ_BY_GROUP_TYPE_REQ / _RSP ───────────────────────────────
//
//   Same on-the-wire shape as READ_BY_TYPE_REQ (start + end +
//   group type).  RSP triplets are (handle:u16, end_group:u16,
//   value:[u8]).  Used for primary-service discovery
//   (group type = 0x2800).
@satisfies("REQ-BLE-ATT-PDU-003")
@tier(embedded)
@no_alloc
fn read_read_by_group_type_req_start(pdu: [u8]) -> Int
    read_read_by_type_req_start(pdu)

@satisfies("REQ-BLE-ATT-PDU-003")
@tier(embedded)
@no_alloc
fn read_read_by_group_type_req_end(pdu: [u8]) -> Int
    read_read_by_type_req_end(pdu)

@satisfies("REQ-BLE-ATT-PDU-003")
@tier(embedded)
@no_alloc
fn read_read_by_group_type_req_type_len(pdu: [u8]) -> Int
    read_read_by_type_req_type_len(pdu)

@satisfies("REQ-BLE-ATT-PDU-003")
@tier(embedded)
@no_alloc
fn read_read_by_group_type_req_type16(pdu: [u8]) -> Int
    read_read_by_type_req_type16(pdu)

@satisfies("REQ-BLE-ATT-PDU-004")
@tier(embedded)
fn build_read_by_group_type_rsp(triplet_len: Int, data: [u8]) -> [u8]
    var header: [u8] = list.with_capacity(2 + list.len(data))
    list.append(header, [ATT_OP_READ_BY_GROUP_TYPE_RSP, triplet_len as u8])
    list.append(header, data)
    header


// ── ATT_FIND_INFORMATION_REQ / _RSP ─────────────────────────────────
//
//   REQ (5 bytes): opcode | start:u16 LE | end:u16 LE
//   RSP (2+N)   : opcode | format | data_list:[u8]
//                  format = 0x01 (16-bit UUIDs) or 0x02 (128-bit)
//                  data_list = repeated (handle:u16 + uuid)
const ATT_FIND_INFO_FORMAT_UUID16  = 0x01
const ATT_FIND_INFO_FORMAT_UUID128 = 0x02

@satisfies("REQ-BLE-ATT-PDU-003")
@tier(embedded)
@no_alloc
fn read_find_info_req_start(pdu: [u8]) -> Int
    if list.len(pdu) < 5
        -1
    else
        (pdu[1] as Int) | ((pdu[2] as Int) << 8)

@satisfies("REQ-BLE-ATT-PDU-003")
@tier(embedded)
@no_alloc
fn read_find_info_req_end(pdu: [u8]) -> Int
    if list.len(pdu) < 5
        -1
    else
        (pdu[3] as Int) | ((pdu[4] as Int) << 8)

@satisfies("REQ-BLE-ATT-PDU-004")
@tier(embedded)
fn build_find_info_rsp(format: Int, data: [u8]) -> [u8]
    var header: [u8] = list.with_capacity(2 + list.len(data))
    list.append(header, [ATT_OP_FIND_INFORMATION_RSP, format as u8])
    list.append(header, data)
    header


// ── ATT_FIND_BY_TYPE_VALUE_REQ / _RSP ───────────────────────────────
//
//   REQ (7+N): opcode | start:u16 LE | end:u16 LE | uuid16:u16 LE | value:[u8]
//
//   RSP (1+N): opcode | handles_information_list:[u8]
//              handles_information_list = repeated (found:u16 + group_end:u16)
@satisfies("REQ-BLE-ATT-PDU-003")
@tier(embedded)
@no_alloc
fn read_find_by_type_value_req_start(pdu: [u8]) -> Int
    if list.len(pdu) < 7
        -1
    else
        (pdu[1] as Int) | ((pdu[2] as Int) << 8)

@satisfies("REQ-BLE-ATT-PDU-003")
@tier(embedded)
@no_alloc
fn read_find_by_type_value_req_end(pdu: [u8]) -> Int
    if list.len(pdu) < 7
        -1
    else
        (pdu[3] as Int) | ((pdu[4] as Int) << 8)

@satisfies("REQ-BLE-ATT-PDU-003")
@tier(embedded)
@no_alloc
fn read_find_by_type_value_req_type16(pdu: [u8]) -> Int
    if list.len(pdu) < 7
        -1
    else
        (pdu[5] as Int) | ((pdu[6] as Int) << 8)

@satisfies("REQ-BLE-ATT-PDU-004")
@tier(embedded)
fn build_find_by_type_value_rsp(handles_information: [u8]) -> [u8]
    var header: [u8] = list.with_capacity(1 + list.len(handles_information))
    list.append(header, [ATT_OP_FIND_BY_TYPE_VALUE_RSP])
    list.append(header, handles_information)
    header


// ── ATT_WRITE_REQ / _RSP ────────────────────────────────────────────
//
//   REQ (3+N): opcode | handle:u16 LE | value:[u8]
//   RSP (1)  : opcode (no parameters)
//
// WRITE_CMD (0x52) shares the same on-wire payload as WRITE_REQ;
// the only difference is the opcode byte (command flag set), so
// the same handle/value extractors work for both.
@satisfies("REQ-BLE-ATT-PDU-003")
@tier(embedded)
@no_alloc
fn read_write_req_handle(pdu: [u8]) -> Int
    if list.len(pdu) < 3
        -1
    else
        (pdu[1] as Int) | ((pdu[2] as Int) << 8)

@satisfies("REQ-BLE-ATT-PDU-003")
@tier(embedded)
fn read_write_req_value(pdu: [u8]) -> [u8]
    let n = list.len(pdu)
    if n < 3
        []
    else
        var out : [u8] = list.with_capacity(n - 3)
        for i in 3..n
            let _ = list.try_push(out, pdu[i])
        out

@satisfies("REQ-BLE-ATT-PDU-004")
@tier(embedded)
fn build_write_rsp() -> [u8]
    [ATT_OP_WRITE_RSP]


// ── ATT_HANDLE_VALUE_NTF / _IND / _CFM ──────────────────────────────
//
// Both notify and indicate carry the same on-wire shape:
//
//   NTF/IND (3+N): opcode | handle:u16 LE | value:[u8]
//   CFM (1)     : 0x1E (no parameters; client → server)
//
// Notifications are fire-and-forget; indications expect the peer to
// answer with HANDLE_VALUE_CFM before the server can send the next.
@satisfies("REQ-BLE-ATT-PDU-004")
@tier(embedded)
fn build_handle_value_ntf(handle: Int, value: [u8]) -> [u8]
    [ATT_OP_HANDLE_VALUE_NTF, (handle & 0xFF) as u8, ((handle >>> 8) & 0xFF) as u8, ...value]

@satisfies("REQ-BLE-ATT-PDU-004")
@tier(embedded)
fn build_handle_value_ind(handle: Int, value: [u8]) -> [u8]
    [ATT_OP_HANDLE_VALUE_IND, (handle & 0xFF) as u8, ((handle >>> 8) & 0xFF) as u8, ...value]

@satisfies("REQ-BLE-ATT-PDU-004")
@tier(embedded)
fn build_handle_value_cfm() -> [u8]
    [ATT_OP_HANDLE_VALUE_CFM]


// ── ATT_PREPARE_WRITE_REQ / _RSP ────────────────────────────────────
//
//   REQ/RSP (5+N): opcode | handle:u16 LE | offset:u16 LE | part_value:[u8]
//
// The RSP echoes the REQ byte-for-byte (with opcode swapped); the
// server uses prepared writes to queue partial values that get
// committed atomically by EXECUTE_WRITE_REQ flag=0x01 (or thrown
// away by flag=0x00).
@satisfies("REQ-BLE-ATT-PDU-003")
@tier(embedded)
@no_alloc
fn read_prepare_write_req_handle(pdu: [u8]) -> Int
    if list.len(pdu) < 5
        -1
    else
        (pdu[1] as Int) | ((pdu[2] as Int) << 8)

@satisfies("REQ-BLE-ATT-PDU-003")
@tier(embedded)
@no_alloc
fn read_prepare_write_req_offset(pdu: [u8]) -> Int
    if list.len(pdu) < 5
        -1
    else
        (pdu[3] as Int) | ((pdu[4] as Int) << 8)

@satisfies("REQ-BLE-ATT-PDU-003")
@tier(embedded)
fn read_prepare_write_req_value(pdu: [u8]) -> [u8]
    let n = list.len(pdu)
    if n < 5
        []
    else
        var out : [u8] = list.with_capacity(n - 5)
        for i in 5..n
            let _ = list.try_push(out, pdu[i])
        out

@satisfies("REQ-BLE-ATT-PDU-004")
@tier(embedded)
fn build_prepare_write_rsp(handle: Int, offset: Int, value: [u8]) -> [u8]
    var header: [u8] = list.with_capacity(5 + list.len(value))
    list.append(header, [ATT_OP_PREPARE_WRITE_RSP, (handle & 0xFF) as u8, ((handle >>> 8) & 0xFF) as u8,
        (offset & 0xFF) as u8, ((offset >>> 8) & 0xFF) as u8])
    list.append(header, value)
    header


// ── ATT_EXECUTE_WRITE_REQ / _RSP ────────────────────────────────────
//
//   REQ (2): opcode | flags:u8        (0x00 cancel / 0x01 write)
//   RSP (1): opcode (no parameters)
@satisfies("REQ-BLE-ATT-PDU-003")
@tier(embedded)
@no_alloc
fn read_execute_write_req_flags(pdu: [u8]) -> Int
    if list.len(pdu) < 2
        -1
    else
        pdu[1] as Int

@satisfies("REQ-BLE-ATT-PDU-004")
@tier(embedded)
fn build_execute_write_rsp() -> [u8]
    [ATT_OP_EXECUTE_WRITE_RSP]


// ── PDU classification helpers ──────────────────────────────────────
//
// Returns true if `op` is one of the read-side requests the server
// handles.
// false means "unknown" — server should answer with ERROR_RSP /
// REQUEST_NOT_SUPPORTED.  Matches against opcode_method (bottom
// 6 bits) so a hypothetical request opcode with the command flag
// set still classifies correctly.  Method-byte literals named
// alongside in comments for spec cross-reference.
@tier(embedded)
@no_alloc
fn is_m5_request(op: Int) -> Bool
    match opcode_method(op)
        // EXCHANGE_MTU_REQ | FIND_INFO_REQ | FIND_BY_TYPE_VALUE_REQ
        // | READ_BY_TYPE_REQ | READ_REQ | READ_BLOB_REQ
        // | READ_BY_GROUP_TYPE_REQ
        0x02 | 0x04 | 0x06 | 0x08 | 0x0A | 0x0C | 0x10 => true
        _                                              => false


// Returns true if `op` is a write-side request (write / prepare /
// execute / handle-value-cfm).  Notifications + indications are
// server-emitted, not client-requests, and are excluded.
@tier(embedded)
@no_alloc
fn is_m6_request(op: Int) -> Bool
    match opcode_method(op)
        // WRITE_REQ | PREPARE_WRITE_REQ | EXECUTE_WRITE_REQ
        // | HANDLE_VALUE_CFM
        0x12 | 0x16 | 0x18 | 0x1E => true
        _                         => false


// Returns true if `op` is a write command (no response expected).
// Spec: WRITE_CMD (0x52) and SIGNED_WRITE_CMD (0xD2) carry
// the command flag set on the WRITE method.
@tier(embedded)
@no_alloc
fn is_write_command(op: Int) -> Bool
    match op
        0x52 | 0xD2 => true        // WRITE_CMD | SIGNED_WRITE_CMD
        _           => false


// ── Tests ───────────────────────────────────────────────────────────

@test
@satisfies("REQ-BLE-ATT-PDU-001")
fn test_opcode_field_extraction()
    // 0x52 = 0101 0010 — bit 6 (command) set, bit 7 (signed) clear,
    // method = 0x12: the write command.
    test.assert_eq(opcode_method(0x52), 0x12)
    test.assert_eq(opcode_is_command(0x52), true)
    test.assert_eq(opcode_is_signed(0x52), false)

    // 0xD2 = 1101 0010 — both top bits set: signed-write command.
    test.assert_eq(opcode_method(0xD2), 0x12)
    test.assert_eq(opcode_is_command(0xD2), true)
    test.assert_eq(opcode_is_signed(0xD2), true)

    // 0x0A = 0000 1010 — plain READ_REQ (request, not signed).
    test.assert_eq(opcode_method(0x0A), 0x0A)
    test.assert_eq(opcode_is_command(0x0A), false)
    test.assert_eq(opcode_is_signed(0x0A), false)

@test
@satisfies("REQ-BLE-ATT-PDU-002")
fn test_error_rsp_shape()
    // ERROR_RSP for READ_REQ on handle 0x000F with INVALID_HANDLE.
    let e = build_error_rsp(ATT_OP_READ_REQ, 0x000F, ATT_ERR_INVALID_HANDLE)
    test.assert_eq(list.len(e), 5)
    test.assert_eq(e[0] as Int, 0x01)               // opcode
    test.assert_eq(e[1] as Int, 0x0A)               // request opcode (READ)
    test.assert_eq(e[2] as Int, 0x0F)               // handle lo
    test.assert_eq(e[3] as Int, 0x00)               // handle hi
    test.assert_eq(e[4] as Int, 0x01)               // err code

@test
@satisfies("REQ-BLE-ATT-PDU-002")
fn test_error_rsp_request_not_supported()
    let e = build_error_rsp(ATT_OP_WRITE_REQ, 0x0000, ATT_ERR_REQUEST_NOT_SUPPORTED)
    test.assert_eq(e[1] as Int, ATT_OP_WRITE_REQ)
    test.assert_eq(e[4] as Int, ATT_ERR_REQUEST_NOT_SUPPORTED)

