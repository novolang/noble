// advertiser.nv — the Host side of bringing a Controller up
// and making it an Advertiser.
//
// The bring-up sequence, one HCI Command packet at a time:
//
//   Reset command                          [Vol 4] Part E, Section 7.3.2
//   Read Local Version Information command [Vol 4] Part E, Section 7.4.1
//   LE Set Random Address command          [Vol 4] Part E, Section 7.8.4
//   LE Set Advertising Parameters command  [Vol 4] Part E, Section 7.8.5
//   LE Set Advertising Data command        [Vol 4] Part E, Section 7.8.7
//   LE Set Scan Response Data command      [Vol 4] Part E, Section 7.8.8
//   LE Set Advertising Enable command      [Vol 4] Part E, Section 7.8.9
//
// After a reset the Host sends at most one outstanding HCI Command
// packet until a Command Complete event or Command Status event
// arrives ([Vol 4] Part E, Section 4.4); this Host waits for that
// answer before every command, not only the first.
//
// The advertising is General Discoverable mode ([Vol 3] Part C,
// Section 9.2.4) and Undirected Connectable mode ([Vol 3] Part C,
// Section 9.3.4): `ADV_IND` from a static address ([Vol 3] Part C,
// Section 10.8.1), with `Own_Address_Type` random.
//
// The commands are the legacy advertising commands.  [Vol 4] Part E,
// Section 3.1.1 says a Host should not issue them to a Controller that
// supports the LE Feature (Extended Advertising), and that once a
// legacy command has been issued since the last reset the Controller
// answers an extended one with Command Disallowed (0x0C).  This Host
// departs from that recommendation and stays with the legacy commands
// on every Controller; the Reset command first makes the choice hold
// for the whole session.
//
// The module reaches the Controller only through `HciLink` and prints
// nothing.  `run_command` returns what was sent and received, and the
// formatting functions turn it into text, so the program that owns the
// transport and the console decides where the lines go.
//
// Satisfies: REQ-BLE-HCI-003 (every command waits for its answer).

use bd_addr
use hci_commands
use hci_frame
use hci_init
use gap
use hci_codec
use hci_session

// How long a command waits for its Command Complete or Command Status.
pub const COMMAND_TIMEOUT_MS = 2000

// How many other packets a command passes over while it waits for its
// answer before it gives up.
const MAX_PASSED_OVER = 32

// ── Configuration ───────────────────────────────────────────────────

// Why `make_advertiser` refuses its arguments.
const ERR_ADDRESS_NOT_STATIC_RANDOM = "the address is not a static random address: the two most significant bits of its most significant octet must both be 1"

const ERR_INTERVAL_OUT_OF_RANGE = "the advertising interval is outside 20 to 10240 ms"

const ERR_NAME_TOO_LONG = "the name is longer than the 26 bytes that fit beside the Flags record"

// What the advertiser sends.  `address` is in on-air order, least
// significant octet first; `adv_data` and `scan_rsp` are the 32-byte
// parameter blocks of their commands.
struct Advertiser
    name: [u8]
    address: [u8]
    interval_ms: Int
    interval_units: Int
    adv_data: [u8]
    scan_rsp: [u8]

// The advertiser for a name, a random static address in on-air
// order, and an interval in milliseconds, or what is wrong with them.
pub @tier(embedded)
fn make_advertiser(name: [u8], address: [u8], interval_ms: Int) -> Result<Advertiser, Str>
    if not is_static_random(address)
        return Err(ERR_ADDRESS_NOT_STATIC_RANDOM)
    match hci_commands.adv_interval_units(interval_ms)
        None        => Err(ERR_INTERVAL_OUT_OF_RANGE)
        Some(units) =>
            let flags = gap.ad_flags_for(GeneralDiscoverable, true)
            let adv = hci_commands.build_le_adv_data_block(gap.build_flags_and_name_ad(flags, name))
            let rsp = hci_commands.build_le_adv_data_block(gap.build_local_name_record(name))
            match (adv, rsp)
                (Some(a), Some(r)) =>
                    Ok(Advertiser { name: name,
                        address: address,
                        interval_ms: interval_ms,
                        interval_units: units,
                        adv_data: a,
                        scan_rsp: r })
                _                  => Err(ERR_NAME_TOO_LONG)

// True when `address` is six octets and a static random address.
pub @tier(embedded)
@no_alloc
fn is_static_random(address: [u8]) -> Bool
    if list.len(address) != 6
        false
    else
        match bd_addr.classify_random(address)
            StaticRandom => true
            _            => false

// ── Address text ────────────────────────────────────────────────────

// The value of one ASCII hex digit, or -1.
@tier(embedded)
@no_alloc
fn hex_digit(c: Int) -> Int
    if c >= '0' and c <= '9'
        c - '0'
    else if c >= 'A' and c <= 'F'
        c - 'A' + 10
    else if c >= 'a' and c <= 'f'
        c - 'a' + 10
    else
        -1

// A BD_ADDR written as ASCII text most significant octet first,
// "C0:4E:4F:56:4F:01", as the six octets the HCI commands carry, least
// significant octet first.  `None` unless the text is six
// colon-separated pairs of hex digits.
pub @tier(embedded)
fn parse_address(text: [u8]) -> ?[u8]
    if list.len(text) != 17
        return None
    var msb_first: [u8] = []
    for k in 0..6
        let hi = hex_digit(text[3 * k] as Int)
        let lo = hex_digit(text[3 * k + 1] as Int)
        if hi < 0 or lo < 0
            return None
        if k < 5 and (text[3 * k + 2] as Int) != ':'
            return None
        list.push(msb_first, (hi * 16 + lo) as u8)
    var addr: [u8] = []
    for i in 0..6
        list.push(addr, msb_first[5 - i])
    Some(addr)

// ── Commands ────────────────────────────────────────────────────────

@tier(embedded)
fn cmd(opcode: Int, params: [u8]) -> HciCmdMsg
    HciCmdMsg { opcode: opcode, params: params }

// The bring-up sequence above, in order, as HCI Command packets'
// opcodes and parameters.
pub @satisfies("REQ-BLE-HCI-003")
@tier(embedded)
fn bringup_commands(adv: Advertiser) -> [HciCmdMsg]
    [
        // [Vol 4] Part E, Section 7.3.2 — Reset command
        cmd(hci_commands.opcode_hci_reset(), []),
        // [Vol 4] Part E, Section 7.4.1 — Read Local Version Information command
        cmd(hci_commands.opcode_read_local_version_information(), []),
        // [Vol 4] Part E, Section 7.8.4 — LE Set Random Address command
        cmd(hci_commands.opcode_le_set_random_address(),
        hci_commands.build_le_set_random_address(adv.address)),
        // [Vol 4] Part E, Section 7.8.5 — LE Set Advertising Parameters command
        cmd(hci_commands.opcode_le_set_advertising_parameters(),
        hci_init.build_le_set_advertising_parameters(adv.interval_units, adv.interval_units)),
        // [Vol 4] Part E, Section 7.8.7 — LE Set Advertising Data command
        cmd(hci_commands.opcode_le_set_advertising_data(), adv.adv_data),
        // [Vol 4] Part E, Section 7.8.8 — LE Set Scan Response Data command
        cmd(hci_commands.opcode_le_set_scan_response_data(), adv.scan_rsp),
        // [Vol 4] Part E, Section 7.8.9 — LE Set Advertising Enable command, Advertising_Enable 1
        cmd(hci_commands.opcode_le_set_advertising_enable(),
        hci_commands.build_le_set_advertising_enable(true))]

// [Vol 4] Part E, Section 7.8.9 — LE Set Advertising Enable command,
// Advertising_Enable 0.
pub @tier(embedded)
fn stop_command() -> HciCmdMsg
    cmd(hci_commands.opcode_le_set_advertising_enable(),
        hci_commands.build_le_set_advertising_enable(false))

// What became of one command.  `sent` is the HCI Command packet with
// its HCI packet indicator.  `answer` is the HCI Event packet that
// answered it, with its indicator, empty when none did; `passed_over` holds the packets
// that arrived before the answer, in order.  `status` is the answer's
// Status parameter ([Vol 4] Part E, Section 4.5: the first return
// parameter, always present), STATUS_NOT_SENT when the link refused the command and
// STATUS_NO_ANSWER when no answer came.
pub struct CommandOutcome
    sent: [u8]
    answer: [u8]
    passed_over: [[u8]]
    status: Int

// The status of a `CommandOutcome` whose command the link refused to send.
pub const STATUS_NOT_SENT = -2

// The status of a `CommandOutcome` that no event answered before the timeout.
pub const STATUS_NO_ANSWER = -1

// Send `c` and wait for the Command Complete event or Command Status
// event that answers it ([Vol 4] Part E, Section 4.4), giving up after `timeout_ms` without a packet or
// MAX_PASSED_OVER packets that are not the answer.
pub @satisfies("REQ-BLE-HCI-003")
@tier(embedded)
fn run_command<L: HciLink[e]>(var link: L, c: HciCmdMsg,
                              timeout_ms: Int) -> CommandOutcome [e, mutate]
    let wire = hci_codec.build_h4_command(c.opcode, c.params)
    var passed: [[u8]] = []
    if not link.send_packet(wire)
        return CommandOutcome { sent: wire, answer: [], passed_over: passed, status: STATUS_NOT_SENT }
    let issue = hci_session.session_issue(hci_session.SESSION_IDLE, 0, wire, c.opcode)
    for _ in 0..MAX_PASSED_OVER + 1
        match link.recv_packet(timeout_ms)
            None      =>
                break
            Some(pkt) =>
                let fed = hci_session.session_feed_event(issue.state, issue.pending, pkt)
                if fed.outcome == hci_session.SESSION_OUTCOME_MATCH
                    let status = hci_codec.answered_status(pkt[1:])
                    return CommandOutcome { sent: wire,
                        answer: pkt[:],
                        passed_over: passed,
                        status: status }
                list.push(passed, pkt[:])
    CommandOutcome { sent: wire, answer: [], passed_over: passed, status: STATUS_NO_ANSWER }

// ── Formatting ──────────────────────────────────────────────────────

// Bytes as space-separated hex pairs, as autopts/controller/README.md
// shows an HCI exchange.
pub @tier(embedded)
fn hex_bytes(pkt: [u8]) -> Str
    var out = ""
    for i in 0..list.len(pkt)
        if i > 0
            out = out + " "
        out = out + bd_addr.hex_byte(pkt[i] as Int)
    out

// The low octet of `v` as `0x` and two hexadecimal digits.
pub @tier(embedded)
fn hex8(v: Int) -> Str
    "0x" + bd_addr.hex_byte(v & 0xFF)

@tier(embedded)
fn hex16(v: Int) -> Str
    "0x" + bd_addr.hex_byte((v >>> 8) & 0xFF) + bd_addr.hex_byte(v & 0xFF)

// The address most significant octet first, the notation scanners
// print.
pub @tier(embedded)
fn format_address(addr: [u8]) -> Str
    var out = ""
    for i in 0..6
        if i > 0
            out = out + ":"
        out = out + bd_addr.hex_byte(addr[5 - i] as Int)
    out

// The name of the HCI command `opcode` as the Core Specification writes it, or `opcode` and the opcode in hexadecimal
// when the command is not one the Host sends.
pub @tier(embedded)
fn command_name(opcode: Int) -> Str
    match opcode
        n if n == hci_commands.opcode_hci_reset()                                             => "HCI_Reset"
        n if n == hci_commands.opcode_hci_set_event_mask()                                    => "HCI_Set_Event_Mask"
        n if n == hci_commands.opcode_read_local_version_information()                        => "HCI_Read_Local_Version_Information"
        n if n == hci_commands.opcode_read_bd_addr()                                          => "HCI_Read_BD_ADDR"
        n if n == hci_commands.opcode_le_set_random_address()                                 => "HCI_LE_Set_Random_Address"
        n if n == hci_commands.opcode_le_set_advertising_parameters()                         => "HCI_LE_Set_Advertising_Parameters"
        n if n == hci_commands.opcode_le_set_advertising_data()                               => "HCI_LE_Set_Advertising_Data"
        n if n == hci_commands.opcode_le_set_scan_response_data()                             => "HCI_LE_Set_Scan_Response_Data"
        n if n == hci_commands.opcode_le_set_advertising_enable()                             => "HCI_LE_Set_Advertising_Enable"
        n if n == hci_commands.opcode_le_set_scan_parameters()                                => "HCI_LE_Set_Scan_Parameters"
        n if n == hci_commands.opcode_le_set_scan_enable()                                    => "HCI_LE_Set_Scan_Enable"
        n if n == hci_commands.opcode_le_encrypt()                                            => "HCI_LE_Encrypt"
        n if n == hci_commands.opcode_le_rand()                                               => "HCI_LE_Rand"
        n if n == hci_commands.opcode_hci_disconnect()                                        => "HCI_Disconnect"
        n if n == hci_commands.opcode_le_set_event_mask()                                     => "HCI_LE_Set_Event_Mask"
        n if n == hci_commands.opcode_le_read_buffer_size()                                   => "HCI_LE_Read_Buffer_Size"
        n if n == hci_commands.opcode_le_connection_update()                                  => "HCI_LE_Connection_Update"
        n if n == hci_commands.opcode_le_remote_connection_parameter_request_reply()          => "HCI_LE_Remote_Connection_Parameter_Request_Reply"
        n if n == hci_commands.opcode_le_remote_connection_parameter_request_negative_reply() => "HCI_LE_Remote_Connection_Parameter_Request_Negative_Reply"
        n if n == hci_commands.opcode_le_long_term_key_request_reply()                        => "HCI_LE_Long_Term_Key_Request_Reply"
        n if n == hci_commands.opcode_le_long_term_key_request_negative_reply()               => "HCI_LE_Long_Term_Key_Request_Negative_Reply"
        n                                                                                     => "opcode " + hex16(n)

// Subevents of the LE Meta event ([Vol 4] Part E, Section 7.7.65) that
// can reach an Advertiser or a Peripheral, named as the Section 7.7.65.x headings name
// them.
@tier(embedded)
fn le_subevent_name(sub: Int) -> Str
    match sub
        0x1  => "LE Connection Complete"
        0x2  => "LE Advertising Report"
        0x3  => "LE Connection Update Complete"
        0x4  => "LE Read Remote Features Page 0 Complete"
        0x5  => "LE Long Term Key Request"
        0x6  => "LE Remote Connection Parameter Request"
        0x7  => "LE Data Length Change"
        0xa  => "LE Enhanced Connection Complete"
        0xc  => "LE PHY Update Complete"
        0xd  => "LE Extended Advertising Report"
        0xe  => "LE Periodic Advertising Sync Established"
        0xf  => "LE Periodic Advertising Report"
        0x10 => "LE Periodic Advertising Sync Lost"
        0x12 => "LE Advertising Set Terminated"
        0x18 => "LE Periodic Advertising Sync Transfer Received"
        0x13 => "LE Scan Request Received"
        0x14 => "LE Channel Selection Algorithm"
        n    => "LE subevent " + hex8(n)

// One line naming an event, from an HCI Event packet without its HCI
// packet indicator.
@tier(embedded)
fn describe_event(evt: [u8]) -> Str
    match hci_codec.event_code(evt)
        n if n == hci_frame.EVT_COMMAND_COMPLETE            =>
            let op = hci_codec.command_complete_opcode(evt)
            "Command Complete, " + command_name(op) + ", status " + hex8(hci_codec.command_complete_status(evt))
        n if n == hci_frame.EVT_COMMAND_STATUS              =>
            let op = hci_codec.command_status_opcode(evt)
            "Command Status, " + command_name(op) + ", status " + hex8(hci_codec.command_status_status(evt))
        n if n == hci_frame.EVT_LE_META_EVENT               =>
            let sub = hci_codec.le_meta_subevent(evt)
            "LE Meta, subevent " + hex8(sub) + " (" + le_subevent_name(sub) + ")"
        n if n == hci_frame.EVT_DISCONNECTION_COMPLETE      => "Disconnection Complete"
        n if n == hci_frame.EVT_ENCRYPTION_CHANGE           => "Encryption Change"
        n if n == hci_frame.EVT_HARDWARE_ERROR              => "Hardware Error"
        n if n == hci_frame.EVT_NUMBER_OF_COMPLETED_PACKETS => "Number Of Completed Packets"
        n                                                   => "event " + hex8(n)

// One line naming a received HCI packet, HCI packet indicator first.
pub @tier(embedded)
fn describe_packet(pkt: [u8]) -> Str
    if list.len(pkt) < 2
        "short packet"
    else if (pkt[0] as Int) == hci_frame.H4_PKT_EVENT
        describe_event(pkt[1:])
    else if (pkt[0] as Int) == hci_frame.H4_PKT_ACL and list.len(pkt) >= 5
        let handle = hci_frame.acl_handle(pkt[1] as Int | (pkt[2] as Int << 8))
        "HCI ACL Data, handle " + hex16(handle) + ", " + string_of_int(list.len(pkt) - 5) + " bytes"
    else
        "packet type " + hex8(pkt[0] as Int)

// The return parameters of the Read Local Version Information command
// ([Vol 4] Part E, Section 7.4.1), from the Command Complete event that
// answers it, HCI packet indicator first.
pub @tier(embedded)
fn describe_local_version(pkt: [u8]) -> Str
    if list.len(pkt) < 15
        "short Read Local Version Information reply"
    else
        let revision = pkt[8] as Int | (pkt[9] as Int << 8)
        let manufacturer = pkt[11] as Int | (pkt[12] as Int << 8)
        let subversion = pkt[13] as Int | (pkt[14] as Int << 8)
        "HCI version " + hex8(pkt[7] as Int) + ", revision " + hex16(revision) + ", LMP/LL version " + hex8(pkt[10] as Int) + ", manufacturer " + hex16(manufacturer) + ", subversion " + hex16(subversion)
