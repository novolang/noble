    test.assert_eq(list.len(trace.statuses), 1)
    test.assert(gatt_client.needs_security(trace.statuses[0]))
    test.assert_eq(gatt_client.result_handle(var t, link_a(), 0), decl + 1)
    test.assert(not gatt_client.is_busy(var t, link_a(), 0))

