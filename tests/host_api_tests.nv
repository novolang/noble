    run(var h, var l, var p, var b, 1)
    // At the limit (one link of one) the answer Readvertise is read as non-connectable.
    test.assert_eq(h.api.advertise, noble.ADVERTISE_NON_CONNECTABLE)
    list.push(l.inbox, disconnection_complete(0x41, 0x13))
    run(var h, var l, var p, var b, 1)
    test.assert_eq(h.api.advertise, noble.ADVERTISE_CONNECTABLE)

