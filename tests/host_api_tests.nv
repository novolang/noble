// ── ATT traffic of a Peripheral ─────────────────────────────────────

// An HCI ACL Data packet from the Controller carrying the ATT PDU `att` on the fixed channel 4.
fn att_packet(handle: Int, att: [u8]) -> [u8]
    let l2cap_length = list.len(att)
    let total = l2cap_length + 4
    var pkt: [u8] = [0x02, (handle & 0xFF) as u8, (((handle >> 8) & 0x0F) | 0x20) as u8, (total & 0xFF) as u8, ((total >> 8) & 0xFF) as u8]
    list.append(pkt, le16(l2cap_length))
    list.append(pkt, le16(4))
    list.append(pkt, att)
    pkt

@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_the_host_answers_the_att_requests_of_a_client_through_the_link()
    var h = new_host(2)
    var l = script_link()
    var p = test_policy()
    var b = new_store()
    started(var h, var l, var p, var b)
    list.push(l.inbox, connection_complete(0, 0x41, 1, peer_octets(0x31)))
    run(var h, var l, var p, var b, 1)
    test.assert_eq(next_kind(var h), EV_CONNECTED)
    // A Read Request of the Device Name, handle 3: the Host answers it with an ACL packet.
    list.push(l.inbox, att_packet(0x41, [0x0A, 0x03, 0x00]))
    run(var h, var l, var p, var b, 2)
    test.assert_eq(list.len(l.acl), 1)
    test.assert_eq(l.acl[0][0] as Int, 2)
    test.assert_eq(l.acl[0][9] as Int, 0x0B)
    // A Write Request of the same handle (the Device Name is writable) is answered too.  The GATT server
    // reports a write as a change only for the attributes it tracks (`take_changed`), and the Device Name
    // is not one of them, so no `Written` is queued.
    list.push(l.inbox, att_packet(0x41, [0x12, 0x03, 0x00, 0x58, 0x59]))
    run(var h, var l, var p, var b, 2)
    test.assert_eq(list.len(l.acl), 2)
    test.assert_eq(l.acl[1][9] as Int, 0x13)
    test.assert_eq(next_kind(var h), -1)

// ═══════════════════════════════════════════════════════════════════
// Layer B: the Adapter, advertising and scanning, the GATT client and server, the services
// ═══════════════════════════════════════════════════════════════════

fn new_ble() -> Adapter<ScriptLink, TestPolicy, RamBonds>
    var l = script_link()
    l.credit = true
    noble.adapter(l, test_policy(), new_store())

fn kind_of(e: Event) -> Int
    match e
        Ready => 0
        Advert(_) => 1
        Connected(_, _, _, _) => 2
        Disconnected(_, _) => 3
        ParamsUpdated(_, _) => 4
        SecurityChanged(_, _, _) => 5
        PasskeyRequested(_) => 6
        NumericRequested(_, _) => 7
        Notification(_, _, _, _) => 8
        Written(_, _) => 9
        AttrRead(_, _, _) => 10
        AttrWrite(_, _, _, _) => 11
        Subscribed(_, _, _) => 12
        CocOpened(_, _, _) => 13
        CocData(_, _, _) => 14
        CocClosed(_, _, _) => 15
        DatabaseChanged(_) => 16
        Dropped(_) => 17

const EV_NOTIFICATION = 8
const EV_WRITTEN = 9
const EV_ATTR_READ = 10
const EV_ATTR_WRITE = 11
const EV_SUBSCRIBED = 12

// The kind of the next event of the Adapter within `ms`, -1 for none.
fn wait_kind(var ble: Adapter<ScriptLink, TestPolicy, RamBonds>, ms: Int) -> Int
    match ble.wait_event(ms)
        Some(e) => kind_of(e)
        None => -1

fn value_of_byte(b: Int) -> noble.Value
    var v: noble.Value = Vec.new()
    let _ = v.push(b as u8)
    v

// An LE Advertising Report event of `peer` with the advertising data `ad`.
fn report_ad(peer: [u8], rssi: Int, ad: [u8]) -> [u8]
    var params: [u8] = [1, 0, 1]
    list.append(params, peer)
    list.push(params, list.len(ad) as u8)
    list.append(params, ad)
    list.push(params, rssi as u8)
    le_meta(0x02, params)

// An Adapter that has started and has a link as the Peripheral; the name of the link.
fn peripheral_up(var ble: Adapter<ScriptLink, TestPolicy, RamBonds>) -> ConnId
    test.assert(ble.start().is_ok())
    test.assert_eq(wait_kind(var ble, 0), 0)
    list.push(ble.io.inbox, connection_complete(0, 0x41, 1, peer_octets(0x31)))
    match ble.wait_event(100)
        Some(e) =>
            match e
                Connected(c, _, _, _) => return c
                _ => test.fail("the Peripheral is told of the link")
        None => test.fail("the Peripheral is told of the link")
    noble.no_conn()

// Give the Adapter the ATT request `att` as the Central's, and let the Host answer.
fn central_sends(var ble: Adapter<ScriptLink, TestPolicy, RamBonds>, att: [u8])
    list.push(ble.io.inbox, att_packet(0x41, att))
    ble.step()
    ble.step()

// The ATT PDU of the ACL packet `n` the Host wrote.
fn acl_att(l: ScriptLink, n: Int) -> [u8]
    l.acl[n][9:]

// ── The Adapter ─────────────────────────────────────────────────────

@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_start_waits_for_the_controller_and_a_silent_controller_ends_the_call_with_a_timeout()
    var ble = new_ble()
    test.assert(ble.start().is_ok())
    test.assert_eq(wait_kind(var ble, 0), 0)
    test.assert_eq(wait_kind(var ble, 200), -1)
    test.assert(ble.io.now >= 200)
    var quiet = new_ble()
    quiet.io.mute = true
    let st = quiet.start()
    test.assert(st.is(noble.LAYER_LOCAL, noble.E_TIMEOUT))
    test.assert(quiet.io.now >= 5000)
    // The call was given up: the Host takes the next.
    test.assert(host_api.begin(var quiet.host, Request.Start).is_ok())

// ── GAP: advertising ────────────────────────────────────────────────

@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_adv_start_sends_the_legacy_commands_a_link_is_an_event_and_the_policy_readvertises_after_it()
    var ble = new_ble()
    test.assert(ble.start().is_ok())
    test.assert_eq(wait_kind(var ble, 0), 0)
    var data: noble.AdData = Vec.new()
    test.assert(noble.ad_flags(var data, 0x06))
    test.assert(noble.ad_uuid16(var data, 0x180D))
    var name: noble.Name = String.new()
    let _ = name.push_str("hr")
    test.assert(noble.ad_name(var data, name))
    let rsp: noble.AdData = Vec.new()
    let first = list.len(ble.io.commands)
    test.assert(ble.adv_start(0, noble.adv_legacy(), data, rsp).is_ok())
    test.assert_eq(list.len(ble.io.commands), first + 5)
    test.assert_eq(ble.io.commands[first], hci_commands.opcode_le_set_advertising_enable())
    test.assert_eq(ble.io.commands[first + 1], hci_commands.opcode_le_set_advertising_parameters())
    test.assert_eq(ble.io.commands[first + 2], hci_commands.opcode_le_set_advertising_data())
    test.assert_eq(ble.io.commands[first + 3], hci_commands.opcode_le_set_scan_response_data())
    test.assert_eq(ble.io.commands[first + 4], hci_commands.opcode_le_set_advertising_enable())
    // The data block: its length (3 + 4 + 4), then the Flags record.
    test.assert_eq(ble.io.cmdlog[first + 2][4] as Int, 11)
    test.assert_eq(ble.io.cmdlog[first + 2][6] as Int, 0x01)
    test.assert_eq(ble.io.cmdlog[first + 2][7] as Int, 0x06)
    test.assert(ble.host.api.adv_on)
    // A link a Central made ends the advertising; the policy asks for it again after the link.
    ble.policy.on_disc = -1
    list.push(ble.io.inbox, connection_complete(0, 0x41, 1, peer_octets(0x31)))
    test.assert_eq(wait_kind(var ble, 100), EV_CONNECTED)
    test.assert(not ble.host.api.adv_on)
    test.assert_eq(ble.link_count(), 1)
    let enables = times_sent(ble.io, hci_commands.opcode_le_set_advertising_enable())
    list.push(ble.io.inbox, disconnection_complete(0x41, 0x13))
    test.assert_eq(wait_kind(var ble, 100), EV_DISCONNECTED)
    test.assert_eq(wait_kind(var ble, 300), -1)
    test.assert_eq(times_sent(ble.io, hci_commands.opcode_le_set_advertising_enable()), enables + 2)
    test.assert(ble.host.api.adv_on)
    // Stopping turns it off once; stopping again sends nothing.
    test.assert(ble.adv_stop(0).is_ok())
    test.assert(not ble.host.api.adv_on)
    let sent = list.len(ble.io.commands)
    test.assert(ble.adv_stop(0).is_ok())
    test.assert_eq(list.len(ble.io.commands), sent)

@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_extended_and_periodic_advertising_send_the_extended_commands_and_refuse_what_the_specification_refuses()
    var ble = new_ble()
    test.assert(ble.start().is_ok())
    let data: noble.AdData = Vec.new()
    let rsp: noble.AdData = Vec.new()
    let ext = noble.AdvParams { extended: true, connectable: false, scannable: true, interval_min_ms: 100, interval_max_ms: 100, duration_ms: 0 }
    let first = list.len(ble.io.commands)
    test.assert(ble.adv_start(2, ext, data, rsp).is_ok())
    test.assert_eq(ble.io.commands[first], hci_commands.opcode_le_set_extended_advertising_parameters())
    test.assert_eq(ble.io.commands[first + 1], hci_commands.opcode_le_set_extended_advertising_data())
    test.assert_eq(ble.io.commands[first + 2], hci_commands.opcode_le_set_extended_advertising_enable())
    test.assert_eq(list.len(ble.io.commands), first + 3)
    // The set runs, so a new start disables it first.
    let second = list.len(ble.io.commands)
    test.assert(ble.adv_start(2, ext, data, rsp).is_ok())
    test.assert_eq(ble.io.commands[second], hci_commands.opcode_le_set_extended_advertising_enable())
    test.assert(ble.adv_stop(2).is_ok())
    test.assert(not ble.host.api.adv_on)
    // A train rides on a set that does not connect or scan.
    let third = list.len(ble.io.commands)
    var d: noble.AdData = Vec.new()
    test.assert(noble.ad_flags(var d, 0x06))
    test.assert(ble.periodic_start(1, 100, d).is_ok())
    test.assert_eq(ble.io.commands[third], hci_commands.opcode_le_set_extended_advertising_parameters())
    test.assert_eq(ble.io.commands[third + 1], hci_commands.opcode_le_set_periodic_advertising_parameters())
    test.assert_eq(ble.io.commands[third + 2], hci_commands.opcode_le_set_periodic_advertising_data())
    test.assert_eq(ble.io.commands[third + 3], hci_commands.opcode_le_set_extended_advertising_enable())
    test.assert_eq(ble.io.commands[third + 4], hci_commands.opcode_le_set_periodic_advertising_enable())
    test.assert(ble.host.api.adv_periodic)
    test.assert(ble.adv_stop(1).is_ok())
    test.assert_eq(ble.io.commands[list.len(ble.io.commands) - 2], hci_commands.opcode_le_set_periodic_advertising_enable())
    // Legacy data is 31 octets at most, set 0 only; an interval outside the range is refused.
    var big: noble.AdData = Vec.new()
    for _ in 0..31
        let _ = big.push(1)
    test.assert(ble.adv_start(0, noble.adv_legacy(), big, rsp).is_ok())
    test.assert(ble.adv_start(1, noble.adv_legacy(), data, rsp).is(noble.LAYER_LOCAL, noble.E_BAD_ARGUMENT))
    let slow = noble.AdvParams { extended: false, connectable: true, scannable: true, interval_min_ms: 5, interval_max_ms: 5, duration_ms: 0 }
    test.assert(ble.adv_start(0, slow, data, rsp).is(noble.LAYER_LOCAL, noble.E_BAD_ARGUMENT))
    test.assert(ble.periodic_start(0, 1, data).is(noble.LAYER_LOCAL, noble.E_BAD_ARGUMENT))
    test.assert(ble.adv_stop(3).is(noble.LAYER_LOCAL, noble.E_NOT_FOUND))

@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_a_connectable_advertising_at_the_limit_of_links_answers_no_room_and_a_nonconnectable_one_goes_on()
    var ble = new_ble()
    let _ = peripheral_up(var ble)
    host_api.host_set_max_links(var ble.host, 1)
    let data: noble.AdData = Vec.new()
    let rsp: noble.AdData = Vec.new()
    test.assert(ble.adv_start(0, noble.adv_legacy(), data, rsp).is(noble.LAYER_LOCAL, noble.E_NO_ROOM))
    let beacon = noble.AdvParams { extended: false, connectable: false, scannable: false, interval_min_ms: 100, interval_max_ms: 150, duration_ms: 0 }
    let before = list.len(ble.io.commands)
    test.assert(ble.adv_start(0, beacon, data, rsp).is_ok())
    // ADV_NONCONN_IND, byte 4 of the parameters.
    test.assert_eq(ble.io.cmdlog[before + 1][8] as Int, hci_commands.ADV_TYPE_ADV_NONCONN_IND)

