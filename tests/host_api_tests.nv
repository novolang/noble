@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_the_queue_gives_the_oldest_event_first_and_none_when_empty()
    var q = noble.api_new(2)
    test.assert(noble.queue_take(var q) == None)
    test.assert(noble.queue_event(var q, Event.Ready))
    test.assert(noble.queue_event(var q, Event.DatabaseChanged(noble.no_conn())))
    match noble.queue_take(var q)
        Some(e) =>
            match e
                Ready => ()
                _ => test.fail("the first event is Ready")
        None => test.fail("an event is queued")
    match noble.queue_take(var q)
        Some(e) =>
            match e
                DatabaseChanged(_) => ()
                _ => test.fail("the second event is DatabaseChanged")
        None => test.fail("an event is queued")

// ── Two Hosts with a link between them ──────────────────────────────

// A Central (`a`) and a Peripheral (`b`) joined by a Controller that carries the ACL data of the
// one to the other and plays the encryption procedure between them.  `seen_a` and `seen_b` count the
// commands of each Host the link has looked at.
struct Pair
    var a: Host
    var b: Host
    var la: ScriptLink
    var lb: ScriptLink
    var pa: TestPolicy
    var pb: TestPolicy
    var sa: RamBonds
    var sb: RamBonds
    var ca: ConnId
    var cb: ConnId
    var seen_a: Int
    var seen_b: Int
    var now: Int

fn result_ok(r: ?Status) -> Bool
    match r
        Some(st) => st.is_ok()
        None => false

// The address of the Peripheral, which the Central connects to.
fn b_octets() -> [u8]
    [0xB1, 0xA2, 0xA3, 0xA4, 0xA5, 0xA6]

// ACL data written by one Host goes to the other with the handle of the receiver and the flags of
// a packet that the Controller delivers; the sender gets its buffers back.
fn carry(var from: ScriptLink, var to: ScriptLink, to_handle: Int, from_handle: Int)
    let out = from.acl
    from.acl = []
    for pkt in out
        let flags = ((pkt[2] as Int) >> 4) & 3
        let pb = if flags == 0 then 2 else flags
        var q = pkt[:]
        q[1] = (to_handle & 0xFF) as u8
        q[2] = (((to_handle >> 8) & 0x0F) | (pb << 4)) as u8
        list.push(to.inbox, q)
        list.push(from.inbox, event_packet(0x13, [1, (from_handle & 0xFF) as u8, (from_handle >> 8) as u8, 1, 0]))

fn handle_of_command(c: [u8]) -> Int
    (c[4] as Int) | ((c[5] as Int) << 8)

// The encryption procedure between the two Controllers: LE Start Encryption of the Central makes
// the Peripheral's Controller ask for the key; the Peripheral's reply switches the encryption on at
// both ends.
fn encryption(var x: Pair)
    for i in x.seen_a..list.len(x.la.cmdlog)
        let c = x.la.cmdlog[i]
        let opcode = (c[1] as Int) | ((c[2] as Int) << 8)
        if opcode == hci_commands.opcode_le_start_encryption()
            // handle (2), Rand (8), EDIV (2), LTK (16)
            var params: [u8] = []
            list.append(params, le16(0x41))
            list.append(params, c[6:14])
            list.append(params, c[14:16])
            list.push(x.lb.inbox, le_meta(0x05, params))
    x.seen_a = list.len(x.la.cmdlog)
    for i in x.seen_b..list.len(x.lb.cmdlog)
        let c = x.lb.cmdlog[i]
        let opcode = (c[1] as Int) | ((c[2] as Int) << 8)
        if opcode == hci_commands.opcode_le_long_term_key_request_reply()
            list.push(x.la.inbox, event_packet(0x08, [0, 0x40, 0, 1]))
            list.push(x.lb.inbox, event_packet(0x08, [0, 0x41, 0, 1]))
    x.seen_b = list.len(x.lb.cmdlog)

// Run both Hosts `n` turns, carrying what they write.
fn pump(var x: Pair, n: Int)
    for _ in 0..n
        x.now = x.now + 10
        x.la.now = x.now
        x.lb.now = x.now
        host_api.poll(var x.a, var x.la, var x.pa, var x.sa, x.now)
        host_api.poll(var x.b, var x.lb, var x.pb, var x.sb, x.now)
        carry(var x.la, var x.lb, 0x41, 0x40)
        carry(var x.lb, var x.la, 0x40, 0x41)
        encryption(var x)

// The call `req` of the Central, run until it ends.
fn call_a(var x: Pair, req: Request) -> Status
    let st = host_api.begin(var x.a, req)
    if not st.is_ok()
        return st
    for _ in 0..200
        pump(var x, 1)
        match host_api.result(var x.a)
            Some(done) => return done
            None => ()
    noble.failed(noble.LAYER_LOCAL, noble.E_TIMEOUT)

// Two started Hosts with a link: the Central `a` connected to the address `b_octets`, and the
// Peripheral `b` told of the link.  Both Connected events are taken.
fn pair_up() -> Pair
    var x = Pair {
        a: new_host(2), b: new_host(2), la: script_link(), lb: script_link(), pa: test_policy(), pb: test_policy(),
        sa: new_store(), sb: new_store(), ca: noble.no_conn(), cb: noble.no_conn(), seen_a: 0, seen_b: 0, now: 0 }
    x.la.seed = 1
    x.lb.seed = 40
    x.la.addr = 0xA1
    x.lb.addr = 0xB1
    let sa = host_api.begin(var x.a, Request.Start)
    let sb = host_api.begin(var x.b, Request.Start)
    test.assert(sa.is_ok() and sb.is_ok())
    pump(var x, 12)
    test.assert(x.a.api.ready and x.b.api.ready)
    test.assert(result_ok(host_api.result(var x.a)))
    test.assert(result_ok(host_api.result(var x.b)))
    test.assert_eq(next_kind(var x.a), 0)
    test.assert_eq(next_kind(var x.b), 0)
    // The Peripheral's Controller reports the link of the Central.
    list.push(x.lb.inbox, connection_complete_kind(0, 0x41, 1, 0, [0xA1, 0xA2, 0xA3, 0xA4, 0xA5, 0xA6]))
    let up = call_a(var x, Request.Connect(Addr { kind: 0, octets: [0xB1, 0xA2, 0xA3, 0xA4, 0xA5, 0xA6] }, noble.conn_params_default()))
    test.assert(up.is_ok())
    x.ca = host_api.op_conn(x.a)
    test.assert_eq(next_kind(var x.a), EV_CONNECTED)
    pump(var x, 2)
    match host_api.next_event(var x.b)
        Some(e) =>
            match e
                Connected(c, _, _, _) => x.cb = c
                _ => test.fail("the Peripheral is told of the link")
        None => test.fail("the Peripheral is told of the link")
    x

fn level_of_conn(h: Host, conn: ConnId) -> Int
    match host_api.conn_info(h, conn)
        Some(info) => level_number(info.level)
        None => -1

fn bonded_conn(h: Host, conn: ConnId) -> Bool
    match host_api.conn_info(h, conn)
        Some(info) => info.bonded
        None => false

@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_two_hosts_join_and_both_see_the_link_in_their_own_role()
    var x = pair_up()
    test.assert_eq(host_api.link_count(x.a), 1)
    test.assert_eq(host_api.link_count(x.b), 1)
    match host_api.conn_info(x.a, x.ca)
        Some(info) => test.assert(role_is_central(info.role))
        None => test.fail("the Central has the link")
    match host_api.conn_info(x.b, x.cb)
        Some(info) => test.assert(not role_is_central(info.role))
        None => test.fail("the Peripheral has the link")

// ── Pairing ─────────────────────────────────────────────────────────

@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_secure_pairs_with_just_works_after_the_policies_accept_and_stores_a_bond_on_both_sides()
    var x = pair_up()
    let st = call_a(var x, Request.Secure(x.ca, Security.Encrypted))
    test.assert(st.is_ok())
    // The Central asked its policy before it started, the Peripheral when the Pairing Request came.
    test.assert_eq(x.pa.pairing_asked, 1)
    test.assert_eq(x.pa.pairing_level, 2)
    test.assert(x.pa.pairing_bonding)
    test.assert_eq(x.pb.pairing_asked, 1)
    pump(var x, 10)
    test.assert_eq(level_of_conn(x.a, x.ca), 2)
    test.assert_eq(level_of_conn(x.b, x.cb), 2)
    test.assert(bonded_conn(x.a, x.ca))
    test.assert(bonded_conn(x.b, x.cb))
    test.assert_eq(x.pa.done, 1)
    test.assert(x.pa.done_ok and x.pa.done_bonded)
    test.assert_eq(x.pb.done, 1)
    test.assert(x.pb.done_ok and x.pb.done_bonded)
    test.assert_eq(x.sa.count(), 1)
    test.assert_eq(x.sb.count(), 1)
    // Both sides hear SecurityChanged once.
    test.assert_eq(next_kind(var x.a), EV_SECURITY)
    test.assert_eq(next_kind(var x.b), EV_SECURITY)
    // A call for a level the link has answers at once.
    test.assert(call_a(var x, Request.Secure(x.ca, Security.Encrypted)).is_ok())
    test.assert_eq(x.pa.pairing_asked, 1)

@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_a_pairing_the_peripherals_policy_refuses_fails_the_call_with_the_smp_reason()
    var x = pair_up()
    x.pb.allow_pairing = false
    let st = call_a(var x, Request.Secure(x.ca, Security.Encrypted))
    test.assert(st.is(noble.LAYER_SMP, noble.SMP_PAIRING_NOT_SUPPORTED))
    test.assert_eq(st.name(), "pairing not supported")
    test.assert_eq(x.pb.pairing_asked, 1)
    pump(var x, 4)
    test.assert_eq(x.pb.done, 1)
    test.assert(not x.pb.done_ok)
    test.assert_eq(level_of_conn(x.a, x.ca), 1)
    test.assert_eq(x.sa.count(), 0)

@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_a_pairing_the_centrals_own_policy_refuses_sends_nothing_and_answers_security_low()
    var x = pair_up()
    x.pa.allow_pairing = false
    let before = list.len(x.la.acl) + list.len(x.lb.inbox)
    let st = call_a(var x, Request.Secure(x.ca, Security.Authenticated))
    test.assert(st.is(noble.LAYER_LOCAL, noble.E_SECURITY_LOW))
    test.assert_eq(x.pa.pairing_asked, 1)
    test.assert_eq(x.pa.pairing_level, 3)
    test.assert_eq(x.pb.pairing_asked, 0)

@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_a_passkey_the_policy_answers_pending_is_asked_through_an_event_and_given_with_passkey_reply()
    var x = pair_up()
    // The Central shows the passkey, the Peripheral types it: Passkey Entry.
    x.pa.io = IoCap.DisplayOnly
    x.pb.io = IoCap.KeyboardOnly
    x.pb.passkey = noble.PENDING
    let st = host_api.begin(var x.a, Request.Secure(x.ca, Security.Authenticated))
    test.assert(st.is_ok())
    for _ in 0..200
        if x.b.api.ask[0] == 0
            pump(var x, 1)
    test.assert_eq(next_kind(var x.b), EV_PASSKEY)
    pump(var x, 6)
    // The Central's policy was handed the six digits to show.
    test.assert(x.pa.shown >= 0 and x.pa.shown <= 999999)
    test.assert(result_none(host_api.result(var x.a)))
    // A wrong call is refused and the right one is taken at the next poll.
    test.assert(host_api.passkey_reply(var x.b, x.cb, 1000000).is(noble.LAYER_LOCAL, noble.E_BAD_ARGUMENT))
    test.assert(host_api.passkey_reply(var x.b, x.cb, x.pa.shown).is_ok())
    var done = noble.failed(noble.LAYER_LOCAL, noble.E_TIMEOUT)
    for _ in 0..200
        pump(var x, 1)
        match host_api.result(var x.a)
            Some(r) =>
                done = r
                break
            None => ()
    test.assert(done.is_ok())
    pump(var x, 10)
    test.assert(level_of_conn(x.a, x.ca) >= 3)
    test.assert(level_of_conn(x.b, x.cb) >= 3)
    test.assert(x.pb.done_ok)
    // A second reply has nothing to answer.
    test.assert(host_api.passkey_reply(var x.b, x.cb, 5).is(noble.LAYER_LOCAL, noble.E_BAD_ARGUMENT))

@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_a_wrong_passkey_fails_the_pairing_with_passkey_entry_failed()
    var x = pair_up()
    x.pa.io = IoCap.DisplayOnly
    x.pb.io = IoCap.KeyboardOnly
    x.pb.passkey = noble.PENDING
    let st = host_api.begin(var x.a, Request.Secure(x.ca, Security.Authenticated))
    test.assert(st.is_ok())
    for _ in 0..200
        if x.b.api.ask[0] == 0
            pump(var x, 1)
    test.assert_eq(next_kind(var x.b), EV_PASSKEY)
    pump(var x, 6)
    test.assert(x.pa.shown >= 0)
    test.assert(host_api.passkey_reply(var x.b, x.cb, (x.pa.shown + 1) % 1000000).is_ok())
    var done = noble.failed(noble.LAYER_LOCAL, noble.E_TIMEOUT)
    for _ in 0..200
        pump(var x, 1)
        match host_api.result(var x.a)
            Some(r) =>
                done = r
                break
            None => ()
    test.assert(done.layer == noble.LAYER_SMP)
    test.assert_eq(level_of_conn(x.a, x.ca), 1)
    test.assert_eq(x.sa.count(), 0)

fn result_none(r: ?Status) -> Bool
    match r
        Some(_) => false
        None => true

