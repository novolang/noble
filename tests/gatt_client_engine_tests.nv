@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_reliable_write_the_peer_echoes_wrongly_is_cancelled()
    var t = table()
    var s = server()
    let handle = open_value(var s, 0xAA10)
    var trace = new_log()
    let _ = gatt_client.begin_reliable_write(var t, link_a(), 0, handle, payload(ramp(40)), 40)
    var echo = exchange(var t, link_a(), 0, var s, 0, var trace)
    var wrong = echo[0][:]
    wrong[7] = 0xEE
    deliver(var t, link_a(), 0, wrong, var trace)
    let cancel = exchange(var t, link_a(), 0, var s, 0, var trace)
    test.assert_eq(trace.sent[1], [0x18, 0x00])
    deliver(var t, link_a(), 0, cancel[0], var trace)
    test.assert_eq(trace.statuses, [gatt_client.STATUS_MISMATCH])
    test.assert_eq(served(var s, handle), [])

