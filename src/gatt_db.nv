// ── Tests: HRS + Battery + CCCD presence ───────────────────────────

@test
fn test_hrs_service_and_chars_present()
    let db = build()
    let svc = att_server.db_index_for_handle(db, HANDLE_HRS_SVC)
    test.assert_eq(svc >= 0, true)
    test.assert_eq(att_server.db_type16_at(db, svc), UUID_PRIMARY_SERVICE)
    test.assert_eq(att_server.db_end_group_at(db, svc), HANDLE_HRS_END_GROUP)
    let svc_val = att_server.db_value_at(db, svc)
    test.assert_eq(svc_val[0] as Int, 0x0D)   // 0x180D lo
    test.assert_eq(svc_val[1] as Int, 0x18)

    let hrm_idx = att_server.db_index_for_handle(db, HANDLE_HRM_VALUE)
    test.assert_eq(att_server.db_type16_at(db, hrm_idx), UUID_HEART_RATE_MEASUREMENT)

    let bsl_idx = att_server.db_index_for_handle(db, HANDLE_BSL_VALUE)
    test.assert_eq(att_server.db_type16_at(db, bsl_idx), UUID_BODY_SENSOR_LOCATION)

@test
fn test_hrm_cccd_present_and_writable()
    let db = build()
    let idx = att_server.db_index_for_handle(db, HANDLE_HRM_CCCD)
    test.assert_eq(idx >= 0, true)
    test.assert_eq(att_server.db_type16_at(db, idx), UUID_CCCD)
    let v = att_server.db_value_at(db, idx)
    test.assert_eq(list.len(v), 2)
    test.assert_eq(v[0] as Int, 0x00)   // off at boot
    test.assert_eq(v[1] as Int, 0x00)
    // CCCDs are writable by spec — att_server's perm check
    // recognises UUID 0x2902.
    test.assert_eq(att_server.db_writable_at(db, HANDLE_HRM_CCCD), true)

@test
fn test_battery_service_and_cccd()
    let db = build()
    let svc = att_server.db_index_for_handle(db, HANDLE_BATTERY_SVC)
    test.assert_eq(svc >= 0, true)
    let svc_val = att_server.db_value_at(db, svc)
    test.assert_eq(svc_val[0] as Int, 0x0F)   // 0x180F lo
    test.assert_eq(svc_val[1] as Int, 0x18)

    let level_idx = att_server.db_index_for_handle(db, HANDLE_BATTERY_LEVEL_VALUE)
    let v = att_server.db_value_at(db, level_idx)
    test.assert_eq(list.len(v), 1)
    test.assert_eq(v[0] as Int, 100)   // 100% at boot

    // Decl should advertise Read + Notify.
    let decl_idx = att_server.db_index_for_handle(db, HANDLE_BATTERY_LEVEL_DECL)
    let dv = att_server.db_value_at(db, decl_idx)
    test.assert_eq(dv[0] as Int, CHAR_PROP_READ + CHAR_PROP_NOTIFY)

    // CCCD present.
    let cccd_idx = att_server.db_index_for_handle(db, HANDLE_BATTERY_LEVEL_CCCD)
    test.assert_eq(att_server.db_type16_at(db, cccd_idx), UUID_CCCD)

@test
fn test_writes_to_cccd_succeed()
    // CCCD writes are how a peer subscribes to notify/indicate.
    // Smoke-test the att_server write path against the HRM CCCD.
    var db = build()
    let queue: [u8] = []
    let req: [u8] = [
        att.ATT_OP_WRITE_REQ,
        (HANDLE_HRM_CCCD & 0xFF) as u8,
        ((HANDLE_HRM_CCCD >>> 8) & 0xFF) as u8,
        0x01, 0x00]   // CCCD = NOTIFY
    let r = att_server.handle_write_req(var db, queue, req)
    test.assert_eq(r.rsp[0] as Int, att.ATT_OP_WRITE_RSP)
    test.assert_eq(r.applied, true)

    // Read back — value should be 0x0001.
    let read: [u8] = [
        att.ATT_OP_READ_REQ,
        (HANDLE_HRM_CCCD & 0xFF) as u8,
        ((HANDLE_HRM_CCCD >>> 8) & 0xFF) as u8]
    let rsp = att_server.handle_request(r.new_blob, att_server.ATT_DEFAULT_MTU, read)
    test.assert_eq(rsp[0] as Int, att.ATT_OP_READ_RSP)
    test.assert_eq(rsp[1] as Int, 0x01)
    test.assert_eq(rsp[2] as Int, 0x00)

@test
fn test_the_table_is_the_size_it_is_built_to()
    test.assert_eq(list.len(build()), GATT_DB_BLOB_BYTES)
    let gap = build_gap_server(device_name_bytes(), appearance_bytes(), ppcp_value(0x0018, 0x0028, 0, 0x01F4), false)
    test.assert_eq(list.len(gap), GAP_SERVER_FIXED_BYTES + 7 + 2 + 8)
