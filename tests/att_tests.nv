@satisfies("REQ-BLE-ATT-PDU-003")
fn test_read_req_handle_extraction()
    // READ_REQ for handle 0x0042.
    let req: [u8] = [ATT_OP_READ_REQ, 0x42, 0x00]
    test.assert_eq(read_read_req_handle(req), 0x0042)

@test
@satisfies("REQ-BLE-ATT-PDU-004")
fn test_read_rsp_carries_value_bytes()
    let value: [u8] = [0x4E, 0x6F, 0x76, 0x6F]   // "Novo"
    let rsp = build_read_rsp(value)
    test.assert_eq(list.len(rsp), 1 + 4)
    test.assert_eq(rsp[0] as Int, ATT_OP_READ_RSP)
    test.assert_eq(rsp[1] as Int, 0x4E)
    test.assert_eq(rsp[4] as Int, 0x6F)

