// tests/hci_init_tests.nv — the unit tests of src/hci_init.nv.
//
//   novo test tests/hci_init_tests.nv

use std.test
use hci_commands
use hci_init.{ build_le_set_adv_params_default, build_le_set_advertising_parameters, build_le_set_advertising_parameters_for, build_le_set_advertising_parameters_to }

// ── Tests ────────────────────────────────────────────────────────────

@test
fn test_build_le_set_adv_params_default_layout()
    let p = build_le_set_adv_params_default()
    test.assert_eq(list.len(p), 15)
    // Interval_Min LE = 0x00A0 → bytes [0xA0, 0x00].
    test.assert_eq(p[0] as Int, 0xA0)
    test.assert_eq(p[1] as Int, 0x00)
    // Interval_Max LE = 0x00A0 → bytes [0xA0, 0x00].
    test.assert_eq(p[2] as Int, 0xA0)
    test.assert_eq(p[3] as Int, 0x00)
    // Adv_Type = ADV_IND = 0x00.
    test.assert_eq(p[4] as Int, 0x00)
    // Own_Addr_Type = RANDOM = 0x01.
    test.assert_eq(p[5] as Int, 0x01)
    // Peer_Addr_Type = PUBLIC = 0x00.
    test.assert_eq(p[6] as Int, 0x00)
    // Channel map at byte 13 (after 6 zero peer-address bytes).
    test.assert_eq(p[13] as Int, 0x07)
    // Filter policy at byte 14 — NONE = 0x00.
    test.assert_eq(p[14] as Int, 0x00)

@test
fn test_build_le_set_adv_params_interval()
    // 1 s is 1600 units, 0x0640.
    let p = build_le_set_advertising_parameters(0x0640, 0x0640)
    test.assert_eq(list.len(p), 15)
    test.assert_eq(p[0] as Int, 0x40)
    test.assert_eq(p[1] as Int, 0x06)
    test.assert_eq(p[2] as Int, 0x40)
    test.assert_eq(p[3] as Int, 0x06)
    test.assert_eq(p[4] as Int, 0x00)
    test.assert_eq(p[5] as Int, 0x01)
    test.assert_eq(p[13] as Int, 0x07)

@test
fn test_build_le_set_adv_params_for_type_and_address()
    // ADV_NONCONN_IND from the public address, 100 ms.
    let p = build_le_set_advertising_parameters_for(0xA0, 0xA0, hci_commands.ADV_TYPE_ADV_NONCONN_IND, hci_commands.OWN_ADDR_TYPE_PUBLIC)
    test.assert_eq(list.len(p), 15)
    test.assert_eq(p[0] as Int, 0xA0)
    test.assert_eq(p[4] as Int, 0x03)
    test.assert_eq(p[5] as Int, 0x00)
    test.assert_eq(p[13] as Int, 0x07)
    test.assert_eq(p[14] as Int, 0x00)

@test
fn test_build_le_set_adv_params_to_a_peer()
    // Low duty cycle directed advertising from the random address to
    // the public address 66:55:44:33:22:11.
    let peer: [u8] = [0x11, 0x22, 0x33, 0x44, 0x55, 0x66]
    let p = build_le_set_advertising_parameters_to(0xA0,
        0xA0,
        hci_commands.ADV_TYPE_ADV_DIRECT_IND_LDC,
        hci_commands.OWN_ADDR_TYPE_RANDOM,
        0x00,
        peer)
    test.assert_eq(list.len(p), 15)
    test.assert_eq(p[4] as Int, 0x04)
    test.assert_eq(p[5] as Int, 0x01)
    test.assert_eq(p[6] as Int, 0x00)
    test.assert_eq(p[7] as Int, 0x11)
    test.assert_eq(p[12] as Int, 0x66)
    test.assert_eq(p[13] as Int, 0x07)
    test.assert_eq(p[14] as Int, 0x00)
