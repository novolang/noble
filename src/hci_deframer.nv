// hci_deframer.nv — stateful H4 byte-stream deframer.
//
// A UART driver delivers bytes one (or a handful) at a time;
// the HCI layer wants complete packets.  This module bridges
// the two.  Callers maintain a `var buf: [u8]` themselves and
// invoke the functions here to push bytes + take complete
// packets when ready.
//
// The original design used a `struct H4Deframer { mut buf }`
// with methods, but cross-module struct-type references hit
// pilot finding #8 (OCaml codegen emits bare type names) and
// method dispatch on function-returned receivers hits #13.
// The stateless-API approach sidesteps both: the buffer lives
// in the caller's scope as a plain `[u8]` and every function
// takes + returns it.
//
// Typical use from a consumer module:
//
//     var buf : [u8] = []
//     let result = hci_deframer.push_bytes(buf, incoming)
//     buf = result.0
//     match result.1
//       Some(pkt) => // complete packet
//       None      => // not yet
//
// On a `reject` status (unknown type byte — see
// `h4_bytes_reject` in hci_h4), the deframer drops the
// offending byte and tries again.
//
// Avoids finding #14 (list.take/drop args swapped) by never
// calling those stdlib helpers — uses index-based while-loops.
//
// Satisfies: REQ-BLE-H4-007 (framing-error recovery — drain
// on reject), REQ-BLE-H4-009 (no H4 fragmentation — every
// complete packet pulled from the stream is a single HCI
// packet).

use hci_h4

// ── Byte-range helpers (avoid stdlib list.take / list.drop) ──────────

@tier(embedded)
fn take_first(buf: [u8], n: Int) -> [u8]
    var out: [u8] = []
    for i in 0..n
        if i >= list.len(buf)
            break
        out = list.append(out, [buf[i]])
    out

@tier(embedded)
fn drop_first_n(buf: [u8], n: Int) -> [u8]
    var out: [u8] = []
    for i in n..list.len(buf)
        out = list.append(out, [buf[i]])
    out

@tier(embedded)
fn drop_first(buf: [u8]) -> [u8]
    drop_first_n(buf, 1)

// ── Result struct ────────────────────────────────────────────────────
//
// Named-fields return type.  Tuples via `(x, y)` parse but
// neither `.0` field access nor `let (a, b) = ...` destructure
// work (finding #18) — only `match` extracts components, which
// is awkward for a pure-data return.  Struct-with-fields is
// clean cross-module: construction stays inside this module
// (finding #8 stays clear), `.field` access works at the call
// site.

struct DeframerResult
    new_buf: [u8]
    packet: ?[u8]

// ── Core operations ──────────────────────────────────────────────────
//
// Each returns a `DeframerResult`.  Consumers reassign
// `buf = result.new_buf` to advance state and dispatch on
// `result.packet` for any complete packet that came out.

@satisfies("REQ-BLE-H4-009")
@tier(embedded)
fn push_byte(var buf: [u8], b: Int) -> DeframerResult
    try_take(list.append(buf, [b as u8]))

@satisfies("REQ-BLE-H4-009")
@tier(embedded)
fn push_bytes(var buf: [u8], bytes: [u8]) -> DeframerResult
    try_take(list.append(buf, bytes))

@satisfies("REQ-BLE-H4-007")
@satisfies("REQ-BLE-H4-008")
@satisfies("REQ-BLE-H4-009")
@tier(embedded)
fn try_take(buf: [u8]) -> DeframerResult
    let plen = hci_h4.h4_packet_length(buf)
    match plen
        n if n == hci_h4.H4_BYTES_NEED_MORE =>
            DeframerResult { new_buf: buf, packet: None }
        n if n == hci_h4.H4_BYTES_REJECT    =>
            // Drop the offending byte.  Real framing sync drains
            // until the next plausible type byte; single-byte
            // drop is equivalent in a driven loop.
            DeframerResult { new_buf: drop_first(buf), packet: None }
        n                                   =>
            let have = list.len(buf)
            if have < n
                DeframerResult { new_buf: buf, packet: None }
            else
                let pkt = take_first(buf, n)
                DeframerResult { new_buf: drop_first_n(buf, n), packet: Some(pkt) }

// Take the next complete HCI packet, HCI packet indicator first, off
// the front of `buf`.  Unlike `try_take`, which stops after dropping
// one byte that is not an HCI packet indicator ([Vol 4] Part A,
// Section 2), this goes on until a packet completes or none can, so
// `packet` is `None` only when `buf` holds no complete packet.
// `new_buf` is what remains either way.
pub @satisfies("REQ-BLE-H4-007")
@satisfies("REQ-BLE-H4-009")
@tier(embedded)
fn next_packet(buf: [u8]) -> DeframerResult
    var r = try_take(buf)
    var had = list.len(buf)
    // A pass that yields no packet drops one byte or stops, so the
    // buffer's length bounds the passes.
    for _ in 0..list.len(buf)
        if has_packet(r) or list.len(r.new_buf) == had
            break
        had = list.len(r.new_buf)
        r = try_take(r.new_buf)
    r

@tier(embedded)
@no_alloc
fn has_packet(r: DeframerResult) -> Bool
    match r.packet
        Some(_) => true
        None    => false
