@test
fn test_is_m5_request_classification()
    test.assert_eq(is_m5_request(ATT_OP_READ_REQ), true)
    test.assert_eq(is_m5_request(ATT_OP_READ_BY_GROUP_TYPE_REQ), true)
    test.assert_eq(is_m5_request(ATT_OP_FIND_BY_TYPE_VALUE_REQ), true)
    test.assert_eq(is_m5_request(ATT_OP_WRITE_REQ), false)        // write side
    test.assert_eq(is_m5_request(ATT_OP_HANDLE_VALUE_NTF), false) // write side


// ── Write-side tests: write / prepare / execute / notify / indicate

@test
@satisfies("REQ-BLE-ATT-PDU-003")
fn test_write_req_handle_and_value_extraction()
    // WRITE_REQ for handle 0x002A with payload [0xAA 0xBB 0xCC].
    let req : [u8] = [
        ATT_OP_WRITE_REQ,
        0x2A, 0x00,
        0xAA, 0xBB, 0xCC
    ]
    test.assert_eq(read_write_req_handle(req), 0x002A)
    let v = read_write_req_value(req)
    test.assert_eq(list.len(v), 3)
    test.assert_eq(v[0] as Int, 0xAA)
    test.assert_eq(v[2] as Int, 0xCC)

@test
@satisfies("REQ-BLE-ATT-PDU-004")
fn test_write_rsp_is_one_byte_opcode()
    let rsp = build_write_rsp()
    test.assert_eq(list.len(rsp), 1)
    test.assert_eq(rsp[0] as Int, ATT_OP_WRITE_RSP)

@test
fn test_write_cmd_uses_same_extractors()
    // WRITE_CMD (0x52) for handle 0x0010 with payload [0x42].
    let cmd : [u8] = [
        ATT_OP_WRITE_CMD,
        0x10, 0x00,
        0x42
    ]
    test.assert_eq(read_write_req_handle(cmd), 0x0010)
    let v = read_write_req_value(cmd)
    test.assert_eq(list.len(v), 1)
    test.assert_eq(v[0] as Int, 0x42)
    test.assert_eq(opcode_is_command(ATT_OP_WRITE_CMD), true)
    test.assert_eq(is_write_command(ATT_OP_WRITE_CMD), true)
    test.assert_eq(is_write_command(ATT_OP_WRITE_REQ), false)

