// iso_flow.nv -- the Host's flow control for HCI ISO Data packets.
//
// The Controller has a fixed number of buffers for HCI ISO Data packets and
// says how many in the answer to LE Read Buffer Size [v2]: Total_Num_ISO_
// Data_Packets of ISO_Data_Packet_Length octets each, shared by every CIS and
// BIS ([Vol 4] Part E, Section 7.8.2).  The Host sends a packet only while it
// holds a credit for a free buffer, and gets the credit back when the
// Controller's Number Of Completed Packets event names the handle
// ([Vol 4] Part E, Section 7.7.19).  The ACL buffers are a separate pool: a
// Controller that has no dedicated ISO buffer reports an
// ISO_Data_Packet_Length of 0 and carries no HCI ISO Data packets at all.
//
// `IsoCredits` is that pool.  It keeps, for each stream handle it has been
// told of, the number of packets in flight, so that a stream that ends gives
// its buffers back: the Controller does not name a handle in a Number Of
// Completed Packets event after the connection or the BIG ended (Section
// 7.7.19), so the packets it still held are never reported.  It also keeps
// the Packet_Sequence_Number of the next SDU of each stream.
//
// One SDU is cut into one HCI ISO Data packet or, when it is longer than
// ISO_Data_Packet_Length, into a first fragment, intermediate fragments and
// a last fragment (`isoal.isoal_fragments`).  Each packet takes a credit, and
// `iso_packets_for_sdu` says how many an SDU needs, so a sender takes the
// credits of a whole SDU or none, and never leaves a Controller with half an
// SDU.
//
// Satisfies: REQ-BLE-ISO-005.

use hci_codec
use noble_config
// The sequence numbers are 16 bits.
const SEQUENCE_MODULUS = 0x10000

// The pool, the packets in flight of each stream and the next sequence
// number of each.  The capacity of the stream tables is a literal and is
// `noble_config.MAX_CIS + noble_config.MAX_BIS`.
@value
struct IsoCredits
    packet_length: u16
    total: u8
    free: u8
    used: Vec[Bool; 4]
    handles: Vec[u16; 4]
    in_flight: Vec[u8; 4]
    sequence: Vec[u16; 4]

@tier(embedded)
fn iso_credits_new() -> IsoCredits
    var c = IsoCredits {
        packet_length: 0, total: 0, free: 0, used: Vec.new(), handles: Vec.new(),
        in_flight: Vec.new(), sequence: Vec.new() }
    for _ in 0..noble_config.MAX_CIS + noble_config.MAX_BIS
        let _a = c.used.push(false)
        let _b = c.handles.push(0)
        let _c = c.in_flight.push(0)
        let _d = c.sequence.push(0)
    c

// Take the ISO half of the LE Read Buffer Size [v2] answer.  Both values
// are non-zero on a Controller that carries HCI ISO Data packets ([Vol 4]
// Part E, Section 7.8.2); an answer with either at 0 leaves the pool
// unconfigured and answers false, and no ISO packet is sent.  A configured
// pool starts with every buffer free.
pub @satisfies("REQ-BLE-ISO-005")
@tier(embedded)
@no_alloc
fn iso_credits_configure(var c: IsoCredits, sizes: hci_codec.LeBufferSizeV2) -> Bool
    if sizes.iso_data_packet_length <= 0 or sizes.iso_data_packet_length > hci_codec.ISO_DATA_TOTAL_LENGTH_MAX or sizes.total_iso_data_packets <= 0 or sizes.total_iso_data_packets > 0xFF
        c.packet_length = 0
        c.total = 0
        c.free = 0
        return false
    c.packet_length = sizes.iso_data_packet_length as u16
    c.total = sizes.total_iso_data_packets as u8
    c.free = sizes.total_iso_data_packets as u8
    for i in 0..c.used.len()
        c.in_flight[i] = 0
    true

// Whether the pool knows the Controller's ISO buffers.
pub @tier(embedded)
@no_alloc
fn iso_credits_ready(var c: IsoCredits) -> Bool
    c.packet_length != 0

// ISO_Data_Packet_Length, 0 while the pool is not configured.
pub @tier(embedded)
@no_alloc
fn iso_packet_length(var c: IsoCredits) -> Int
    c.packet_length as Int

// The slot of the credit pool that holds the stream `handle`, or -1 when it holds none.
pub @tier(embedded)
@no_alloc
fn iso_stream_slot(var c: IsoCredits, handle: Int) -> Int
    for i in 0..c.used.len()
        if c.used[i] and (c.handles[i] as Int) == handle
            return i
    -1

// Tell the pool of a stream that exists, with no packet in flight and
// sequence number 0 for its next SDU.  False for a handle outside 0x0000 to
// 0x0EFF, one the pool holds, and a full table.
@satisfies("REQ-BLE-ISO-005")
@tier(embedded)
@no_alloc
fn iso_credits_open(var c: IsoCredits, handle: Int) -> Bool
    if handle < 0 or handle > 0x0EFF or iso_stream_slot(var c, handle) >= 0
        return false
    for i in 0..c.used.len()
        if not c.used[i]
            c.used[i] = true
            c.handles[i] = handle as u16
            c.in_flight[i] = 0
            c.sequence[i] = 0
            return true
    false

// A stream ended.  The packets it had in flight are flushed with it and
// their buffers are free again.  The answer is the number of buffers given
// back; a handle the pool does not hold gives back none.
@satisfies("REQ-BLE-ISO-005")
@tier(embedded)
@no_alloc
fn iso_credits_close(var c: IsoCredits, handle: Int) -> Int
    let i = iso_stream_slot(var c, handle)
    if i < 0
        return 0
    let n = c.in_flight[i] as Int
    c.free = (c.free as Int + n) as u8
    c.used[i] = false
    c.handles[i] = 0
    c.in_flight[i] = 0
    c.sequence[i] = 0
    n

// The number of HCI ISO Data packets an SDU of `sdu_octets` octets takes
// when the packets hold at most `packet_length` octets of data, SDU header
// included: one when the SDU and its 4-octet header (8 with a Time_Stamp)
// fit, otherwise a first fragment that holds what fits beside the header and
// as many more fragments as the rest takes.  0 when `packet_length` leaves
// no room for an octet beside the header, and for an SDU above 4095 octets
// (the same refusals as `isoal.isoal_fragments`).
pub @satisfies("REQ-BLE-ISO-005")
@tier(embedded)
@no_alloc
fn iso_packets_for_sdu(sdu_octets: Int, packet_length: Int, has_time_stamp: Bool) -> Int
    let head = hci_codec.ISO_SDU_HEADER_LEN + (if has_time_stamp then hci_codec.ISO_TIME_STAMP_LEN else 0)
    if sdu_octets < 0 or sdu_octets > hci_codec.ISO_SDU_LENGTH_MAX or packet_length <= head or packet_length > hci_codec.ISO_DATA_TOTAL_LENGTH_MAX
        return 0
    if head + sdu_octets <= packet_length
        return 1
    let rest = sdu_octets - (packet_length - head)
    1 + (rest + packet_length - 1) / packet_length

// Take `packets` credits for the stream `handle`: all of them or none.
// False while the pool is not configured, for a stream the pool does not
// hold, for fewer than one packet, and when fewer buffers are free.
@satisfies("REQ-BLE-ISO-005")
@tier(embedded)
@no_alloc
fn iso_credits_take(var c: IsoCredits, handle: Int, packets: Int) -> Bool
    let i = iso_stream_slot(var c, handle)
    if i < 0 or packets < 1 or not iso_credits_ready(var c) or packets > (c.free as Int)
        return false
    if c.in_flight[i] as Int + packets > 0xFF
        return false
    c.in_flight[i] = (c.in_flight[i] as Int + packets) as u8
    c.free = (c.free as Int - packets) as u8
    true

// The Number Of Completed Packets event named `handle` with `count`
// packets.  The credits go back to the pool, but no more than the stream had
// in flight: a Controller that reports more than was sent is not trusted
// with credits it never took.  The answer is the number returned; a handle
// the pool does not hold returns none.
pub @satisfies("REQ-BLE-ISO-005")
@tier(embedded)
@no_alloc
fn iso_credits_completed(var c: IsoCredits, handle: Int, count: Int) -> Int
    let i = iso_stream_slot(var c, handle)
    if i < 0 or count < 1
        return 0
    let held = c.in_flight[i] as Int
    let back = if count < held
        count
    else
        held
    c.in_flight[i] = (held - back) as u8
    c.free = (c.free as Int + back) as u8
    back

// The pairs of a Number Of Completed Packets event.  The answer is the
// number of credits returned to the pool.  Handles that are not ISO streams
// of the pool (ACL connections share the event) return none.
@satisfies("REQ-BLE-ISO-005")
@tier(embedded)
@no_alloc
fn iso_credits_on_completed(var c: IsoCredits, pairs: [hci_codec.CompletedPackets]) -> Int
    var n = 0
    for p in pairs
        n = n + iso_credits_completed(var c, p.connection_handle, p.count)
    n

// Whether the stream `handle` may send a packet now: the pool is
// configured, knows the stream and has a free buffer.
@tier(embedded)
@no_alloc
fn iso_may_send(var c: IsoCredits, handle: Int) -> Bool
    iso_stream_slot(var c, handle) >= 0 and iso_credits_ready(var c) and (c.free as Int) > 0

// The Packet_Sequence_Number of the next SDU of the stream `handle`, which
// is then advanced by one, modulo 2^16 ([Vol 6] Part G, Section 2).  -1 for
// a stream the pool does not hold.
pub @satisfies("REQ-BLE-ISO-005")
@tier(embedded)
@no_alloc
fn iso_next_sequence(var c: IsoCredits, handle: Int) -> Int
    let i = iso_stream_slot(var c, handle)
    if i < 0
        return -1
    let s = c.sequence[i] as Int
    c.sequence[i] = ((s + 1) % SEQUENCE_MODULUS) as u16
    s

// Packets in flight for the stream `handle`, -1 for a stream the pool does
// not hold.
pub @tier(embedded)
@no_alloc
fn iso_in_flight(var c: IsoCredits, handle: Int) -> Int
    let i = iso_stream_slot(var c, handle)
    if i < 0
        -1
    else
        c.in_flight[i] as Int

// ── Fixtures that the suites of other modules share ─────────────────────

@tier(app)
fn sizes(iso_length: Int, iso_total: Int) -> hci_codec.LeBufferSizeV2
    hci_codec.LeBufferSizeV2 {
        acl_data_packet_length: 251, total_acl_data_packets: 3,
        iso_data_packet_length: iso_length, total_iso_data_packets: iso_total }
