// noble.nv -- the Host API, Layer A: the values an application holds and the decisions it makes.
//
// Layer A is the request-and-poll core of the Host: `begin` takes a request and answers at once
// whether it was accepted, `poll` runs the Host once, `result` reads the outcome of the call in
// flight and `next_event` the next event the application did not ask about.  Nothing in it waits,
// reads a clock or sleeps; the time is an argument and the wire is the `HciLink` the caller passes.
// This module holds the values of that surface (`Status`, `ConnId`, `Event`, `Request`, ...), the
// policy trait `HostPolicy` and the bond store `BondStore`; `host_api.nv` holds the engine.
// Layer B, at the end of this module, is the `Adapter` that waits over those four calls, the GAP and GATT
// methods that start requests, the trait `Service` with `plug` and `pump`, and the payload builders.
// planning/NOBLE-HOST-API-SKETCH.md sections 3.3 and 3.4 are the design.

use gatt_client
use gatt_server
use hci_deframer
use hci_transport
use host
use host.{ Host, host_blank, host_config }
use host_api
use limits
use profile_builder
use smp
use noble_config

// ── Status: the error value ─────────────────────────────────────────
// A failure keeps the number its layer gave it.  `layer` says which
// specification the number belongs to; `code` is that layer's value, so
// an ATT error "insufficient authentication" is
// `Status { layer: LAYER_ATT, code: ATT_INSUFFICIENT_AUTHENTICATION }` and
// an HCI "connection failed to be established" is
// `Status { layer: LAYER_HCI, code: HCI_CONNECTION_FAILED_TO_ESTABLISH }`.
pub const LAYER_LOCAL = 0
pub const LAYER_HCI = 1
pub const LAYER_ATT = 2
pub const LAYER_SMP = 3
pub const LAYER_L2CAP = 4

// Local codes: failures the Host itself reports.
pub const E_NOT_READY = 1
pub const E_BUSY = 2
pub const E_NO_ROOM = 3
pub const E_STALE = 4
pub const E_TIMEOUT = 5
pub const E_SECURITY_LOW = 6
pub const E_NOT_SUBSCRIBED = 7
pub const E_CANCELLED = 8
pub const E_BAD_ARGUMENT = 9
pub const E_NOT_FOUND = 10
pub const E_LINK_LOST = 11
pub const E_REFUSED = 12

// The numbers of the other layers, by the name their specification gives
// them (Core 6.3: ATT Part F 3.4.1.1, HCI Vol 1 Part F, SMP Part H 3.5.5).
// No example or comment on this page uses the bare number.
pub const ATT_INVALID_HANDLE = 1
pub const ATT_READ_NOT_PERMITTED = 2
pub const ATT_WRITE_NOT_PERMITTED = 3
pub const ATT_INVALID_PDU = 4
pub const ATT_INSUFFICIENT_AUTHENTICATION = 5
pub const ATT_REQUEST_NOT_SUPPORTED = 6
pub const ATT_INVALID_OFFSET = 7
pub const ATT_INSUFFICIENT_AUTHORIZATION = 8
pub const ATT_PREPARE_QUEUE_FULL = 9
pub const ATT_ATTRIBUTE_NOT_FOUND = 10
pub const ATT_ATTRIBUTE_NOT_LONG = 11
pub const ATT_INSUFFICIENT_ENCRYPTION_KEY_SIZE = 12
pub const ATT_INVALID_ATTRIBUTE_VALUE_LENGTH = 13
pub const ATT_UNLIKELY_ERROR = 14
pub const ATT_INSUFFICIENT_ENCRYPTION = 15
pub const ATT_UNSUPPORTED_GROUP_TYPE = 16
pub const ATT_INSUFFICIENT_RESOURCES = 17
pub const ATT_DATABASE_OUT_OF_SYNC = 18
pub const ATT_VALUE_NOT_ALLOWED = 19

pub const HCI_UNKNOWN_COMMAND = 0x1
pub const HCI_UNKNOWN_CONNECTION = 0x2
pub const HCI_AUTHENTICATION_FAILURE = 0x5
pub const HCI_PIN_OR_KEY_MISSING = 0x6
pub const HCI_CONNECTION_TIMEOUT = 0x8
pub const HCI_CONNECTION_LIMIT_EXCEEDED = 0x9
pub const HCI_COMMAND_DISALLOWED = 0xc
pub const HCI_UNSUPPORTED_PARAMETER = 0x11
pub const HCI_INVALID_PARAMETERS = 0x12
pub const HCI_REMOTE_USER_TERMINATED = 0x13
pub const HCI_REMOTE_LOW_RESOURCES = 0x14
pub const HCI_REMOTE_POWER_OFF = 0x15
pub const HCI_CONNECTION_TERMINATED_BY_LOCAL_HOST = 0x16
pub const HCI_UNSUPPORTED_REMOTE_FEATURE = 0x1a
pub const HCI_MIC_FAILURE = 0x3d
pub const HCI_UNACCEPTABLE_CONNECTION_PARAMETERS = 0x3b
pub const HCI_CONNECTION_FAILED_TO_ESTABLISH = 0x3e

pub const SMP_PASSKEY_ENTRY_FAILED = 1
pub const SMP_OOB_NOT_AVAILABLE = 2
pub const SMP_AUTHENTICATION_REQUIREMENTS = 3
pub const SMP_CONFIRM_VALUE_FAILED = 4
pub const SMP_PAIRING_NOT_SUPPORTED = 5
pub const SMP_ENCRYPTION_KEY_SIZE = 6
pub const SMP_COMMAND_NOT_SUPPORTED = 7
pub const SMP_UNSPECIFIED_REASON = 8
pub const SMP_REPEATED_ATTEMPTS = 9
pub const SMP_INVALID_PARAMETERS = 10
pub const SMP_DHKEY_CHECK_FAILED = 11
pub const SMP_NUMERIC_COMPARISON_FAILED = 12
pub const SMP_BR_EDR_PAIRING_IN_PROGRESS = 13
pub const SMP_CROSS_TRANSPORT_KEY_NOT_ALLOWED = 14

pub @value
struct Status
    layer: u8
    code: u16

impl Status
    @tier(embedded)
    fn is_ok(self) -> Bool
        (self.layer as Int) == LAYER_LOCAL and (self.code as Int) == 0

    @tier(embedded)
    fn is(self, layer: Int, code: Int) -> Bool
        (self.layer as Int) == layer and (self.code as Int) == code

    // The name of the failure, for a log line: "insufficient authentication"
    // for `Status { layer: LAYER_ATT, code: ATT_INSUFFICIENT_AUTHENTICATION }`.
    @tier(embedded)
    fn name(self) -> Str
        if self.layer == LAYER_LOCAL
            return local_name(self.code as Int)
        if self.layer == LAYER_ATT
            return att_name(self.code as Int)
        if self.layer == LAYER_HCI
            return hci_name(self.code as Int)
        if self.layer == LAYER_SMP
            return smp_name(self.code as Int)
        "unknown"

pub @tier(embedded)
fn ok() -> Status
    Status { layer: 0, code: 0 }

pub @tier(embedded)
fn failed(layer: Int, code: Int) -> Status
    Status { layer: layer as u8, code: code as u16 }

// A name for a log line.  Only the codes this page names have one; any other
// code answers "unknown", and the log line adds the number.
pub @tier(embedded)
fn att_name(code: Int) -> Str
    if code == ATT_INVALID_HANDLE
        return "invalid handle"
    if code == ATT_READ_NOT_PERMITTED
        return "read not permitted"
    if code == ATT_WRITE_NOT_PERMITTED
        return "write not permitted"
    if code == ATT_INVALID_PDU
        return "invalid pdu"
    if code == ATT_INSUFFICIENT_AUTHENTICATION
        return "insufficient authentication"
    if code == ATT_REQUEST_NOT_SUPPORTED
        return "request not supported"
    if code == ATT_INVALID_OFFSET
        return "invalid offset"
    if code == ATT_INSUFFICIENT_AUTHORIZATION
        return "insufficient authorization"
    if code == ATT_PREPARE_QUEUE_FULL
        return "prepare queue full"
    if code == ATT_ATTRIBUTE_NOT_FOUND
        return "attribute not found"
    if code == ATT_ATTRIBUTE_NOT_LONG
        return "attribute not long"
    if code == ATT_INSUFFICIENT_ENCRYPTION_KEY_SIZE
        return "insufficient encryption key size"
    if code == ATT_INVALID_ATTRIBUTE_VALUE_LENGTH
        return "invalid attribute value length"
    if code == ATT_UNLIKELY_ERROR
        return "unlikely error"
    if code == ATT_INSUFFICIENT_ENCRYPTION
        return "insufficient encryption"
    if code == ATT_UNSUPPORTED_GROUP_TYPE
        return "unsupported group type"
    if code == ATT_INSUFFICIENT_RESOURCES
        return "insufficient resources"
    if code == ATT_DATABASE_OUT_OF_SYNC
        return "database out of sync"
    if code == ATT_VALUE_NOT_ALLOWED
        return "value not allowed"
    "unknown"

pub @tier(embedded)
fn hci_name(code: Int) -> Str
    if code == HCI_UNKNOWN_COMMAND
        return "unknown hci command"
    if code == HCI_UNKNOWN_CONNECTION
        return "unknown connection identifier"
    if code == HCI_CONNECTION_LIMIT_EXCEEDED
        return "connection limit exceeded"
    if code == HCI_COMMAND_DISALLOWED
        return "command disallowed"
    if code == HCI_UNSUPPORTED_PARAMETER
        return "unsupported feature or parameter value"
    if code == HCI_INVALID_PARAMETERS
        return "invalid hci command parameters"
    if code == HCI_AUTHENTICATION_FAILURE
        return "authentication failure"
    if code == HCI_PIN_OR_KEY_MISSING
        return "pin or key missing"
    if code == HCI_CONNECTION_TIMEOUT
        return "connection timeout"
    if code == HCI_REMOTE_USER_TERMINATED
        return "remote user terminated"
    if code == HCI_REMOTE_LOW_RESOURCES
        return "remote low resources"
    if code == HCI_REMOTE_POWER_OFF
        return "remote power off"
    if code == HCI_CONNECTION_TERMINATED_BY_LOCAL_HOST
        return "connection terminated by local host"
    if code == HCI_UNSUPPORTED_REMOTE_FEATURE
        return "unsupported remote feature"
    if code == HCI_MIC_FAILURE
        return "mic failure"
    if code == HCI_UNACCEPTABLE_CONNECTION_PARAMETERS
        return "unacceptable connection parameters"
    if code == HCI_CONNECTION_FAILED_TO_ESTABLISH
        return "connection failed to establish"
    "unknown"

pub @tier(embedded)
fn local_name(code: Int) -> Str
    if code == 0
        return "ok"
    if code == E_NOT_READY
        return "not ready"
    if code == E_BUSY
        return "busy"
    if code == E_NO_ROOM
        return "no room"
    if code == E_STALE
        return "stale name"
    if code == E_TIMEOUT
        return "timeout"
    if code == E_SECURITY_LOW
        return "security too low"
    if code == E_NOT_SUBSCRIBED
        return "not subscribed"
    if code == E_CANCELLED
        return "cancelled"
    if code == E_BAD_ARGUMENT
        return "bad argument"
    if code == E_NOT_FOUND
        return "not found"
    if code == E_LINK_LOST
        return "link lost"
    if code == E_REFUSED
        return "refused"
    "unknown"

pub @tier(embedded)
fn smp_name(code: Int) -> Str
    if code == SMP_PASSKEY_ENTRY_FAILED
        return "passkey entry failed"
    if code == SMP_OOB_NOT_AVAILABLE
        return "oob not available"
    if code == SMP_AUTHENTICATION_REQUIREMENTS
        return "authentication requirements"
    if code == SMP_CONFIRM_VALUE_FAILED
        return "confirm value failed"
    if code == SMP_PAIRING_NOT_SUPPORTED
        return "pairing not supported"
    if code == SMP_ENCRYPTION_KEY_SIZE
        return "encryption key size"
    if code == SMP_COMMAND_NOT_SUPPORTED
        return "command not supported"
    if code == SMP_UNSPECIFIED_REASON
        return "unspecified reason"
    if code == SMP_REPEATED_ATTEMPTS
        return "repeated attempts"
    if code == SMP_INVALID_PARAMETERS
        return "invalid parameters"
    if code == SMP_DHKEY_CHECK_FAILED
        return "dhkey check failed"
    if code == SMP_NUMERIC_COMPARISON_FAILED
        return "numeric comparison failed"
    if code == SMP_BR_EDR_PAIRING_IN_PROGRESS
        return "br edr pairing in progress"
    if code == SMP_CROSS_TRANSPORT_KEY_NOT_ALLOWED
        return "cross transport key not allowed"
    "unknown"

// ── Names ───────────────────────────────────────────────────────────
// A device address as it is on the air: `kind` 0 public, 1 random;
// `octets` least significant first.
pub @value
struct Addr
    kind: u8
    octets: [u8; 6]

// A connection, named by its slot and the slot's generation.  The Host
// owns the connection; the application holds only the name.  A name kept
// after the connection ended is refused with E_STALE, not answered for
// the next occupant of the slot.
pub @value
struct ConnId
    slot: u8
    generation: u8

pub @value
struct Uuid
    wide: Bool
    lo: Int
    hi: Int

pub @tier(embedded)
fn uuid16(v: Int) -> Uuid
    Uuid { wide: false, lo: v & 0xFFFF, hi: 0 }

// A characteristic as discovery found it: its value handle, its
// properties and the handle of its Client Characteristic Configuration
// descriptor (0 for none).
pub @value
struct Attr
    handle: u16
    props: u8
    cccd: u16

// The security a call needs, named by the LE security mode 1 level.
pub @value
enum Security
    Open
    Encrypted
    Authenticated
    SecureConnections

// What a GATT server demands of a client for one direction of one
// attribute: the four levels above, plus Denied and Authorized.
pub @value
enum Access
    Denied
    Open
    Authorized
    Encrypted
    Authenticated
    SecureConnections

// The `Access` of the GATT server's own `gatt_server.Access`, the form in which the service modules of the package
// noble-services keep the access a client needs.
pub @tier(embedded)
fn access_from_gatt(a: gatt_server.Access) -> Access
    if a == gatt_server.Access.Open
        return Access.Open
    if a == gatt_server.Access.Authorized
        return Access.Authorized
    if a == gatt_server.Access.Encrypted
        return Access.Encrypted
    if a == gatt_server.Access.Authenticated
        return Access.Authenticated
    if a == gatt_server.Access.SecureConnections
        return Access.SecureConnections
    Access.Denied

pub @value
struct Permissions
    read: Access
    write: Access

pub @value
enum Role
    Central
    Peripheral

pub @value
enum IoCap
    DisplayOnly
    DisplayYesNo
    KeyboardOnly
    NoInputNoOutput
    KeyboardDisplay

// Connection parameters in the units of the specification: intervals
// in 1.25 ms, the supervision timeout in 10 ms.
pub @value
struct ConnParams
    interval_min: u16
    interval_max: u16
    latency: u16
    timeout: u16

pub @tier(embedded)
fn conn_params_default() -> ConnParams
    ConnParams { interval_min: 24, interval_max: 40, latency: 0, timeout: 400 }

pub alias Value = Vec[u8; noble_config.ATT_VALUE_BYTES]

// ── Policy hooks: the decisions the specification leaves to the product ──
// Every method has a default, so a product writes the ones it cares about.
// `e` is what the product's code costs (a hook that draws on a display
// declares `[hw]`), and the functions that call a hook carry that effect.
pub const PENDING = -1
pub const REFUSE = -2
// The answer of `on_read` and `on_write` that leaves the decision to the
// Host, which then answers the client ATT_READ_NOT_PERMITTED or
// ATT_WRITE_NOT_PERMITTED.  A service module answers it for an attribute it
// does not serve, so the product's policy can decide instead.
pub const NOT_HANDLED = -3

// What the Host does at a decision point of the policy: after the Controller started (`on_start`), and after a link was made or
// ended.  Advertise starts the advertising set `set` with the parameters and the data it carries, the arguments of `adv_start`; it
// is read at `on_start` only, and any other point reads it as Stay.  Readvertise repeats the last `adv_start` (Peripheral);
// Reconnect repeats the last `connect` or `connect_listed` (Central) after `after_ms`, so a product sets the backoff and a peer
// that is switched off is not asked at once and for ever; Stay does nothing.
// Advertise holds two `AdData` (`max_adv_data` octets each, 31 by default) and the parameters, so a value of `Action` takes about
// 100 bytes on the stack where it took 16 without it (the size rule: a `Vec[u8; 31]` is 40 bytes, `AdvParams` 16).
pub @value
enum Action
    Stay
    Readvertise
    AdvertiseNonConnectable
    Reconnect(after_ms: Int)
    Advertise(set: u8, params: AdvParams, data: AdData, scan_rsp: AdData)

// The decisions of the product, one method each, every one with a default, so a product writes the ones it takes.  The trait is
// open to more hooks: a hook added later has a default too, and a policy that does not write it is not changed.
pub trait HostPolicy[e]
    // The IO capability this device offers in a pairing.
    fn io_capability(self, conn: ConnId) -> IoCap [e]
        IoCap.NoInputNoOutput

    // Whether to start or accept a pairing that wants `level`.
    fn accept_pairing(var self, conn: ConnId, peer: Addr, level: Security, bonding: Bool) -> Bool [e]
        true

    // Show a passkey the user types on the other device.
    fn show_passkey(var self, conn: ConnId, passkey: Int) [e]
        let _ = passkey

    // Ask the user for the passkey the other device shows.  Answer the six
    // digits (0 to 999999), PENDING to answer later with `passkey_reply`,
    // or REFUSE to end the pairing.  A hook that waits for the user holds
    // the Host's turn while it waits: no other link is served and no event
    // is queued until it returns.  That form is for a program with one link
    // and nothing else to serve (example 4).  Every other program answers
    // PENDING, takes `Event.PasskeyRequested` in its loop, asks the user
    // there, and calls `passkey_reply`.
    fn ask_passkey(var self, conn: ConnId) -> Int [e]
        PENDING

    // Show a six-digit value and ask whether it matches the other device's.
    // Answer 1 for yes, 0 for no, or PENDING to answer with `numeric_reply`
    // after `Event.NumericRequested`; the same rule on waiting applies.
    fn confirm_numeric(var self, conn: ConnId, value: Int) -> Int [e]
        PENDING

    // Whether to accept the connection parameters the peer asks for.
    fn accept_params(var self, conn: ConnId, p: ConnParams) -> Bool [e]
        true

    // The connection flow.  The role says which side this device is, so one
    // trait serves both.  Every default keeps the behaviour of a Host with
    // no hook.
    //
    // Whether to keep a link with `peer`.  As a Peripheral it is called once
    // for a link a peer made, after the Controller reports it and before the
    // application sees `Event.Connected`; false makes the Host disconnect with
    // reason `HCI_REMOTE_USER_TERMINATED` and queue no `Connected`.  As a
    // Central it is called before `connect` sends the command; false answers
    // `E_REFUSED` and nothing is sent.
    fn accept_connect(var self, peer: Addr, role: Role) -> Bool [e]
        true

    // Whether a scan report reaches the application.  False drops it before
    // it takes a place in the event queue.  The `ScanFilter` still applies
    // first; this is for what a filter cannot say (an address list, the
    // manufacturer data).
    fn on_advert(var self, r: AdvReport) -> Bool [e]
        true

    // A link ended.  The answer is what the Host does next: nothing, advertise
    // again, or connect again after a delay.  `Readvertise` is valid for a
    // Peripheral and `Reconnect` for a Central; the other answer is read as
    // `Stay`.  `attempts` is how many times the Host has reconnected to this
    // peer since the last link that was made, so the hook can back off and
    // give up: `Reconnect(1000 * attempts)` up to a count, then `Stay`.
    fn on_disconnected(var self, conn: ConnId, reason: Status, role: Role, attempts: Int) -> Action [e]
        let _ = attempts
        Action.Stay

    // A link was made.  `links` is how many are live now, against
    // `HostConfig.max_links`.  The answer says what the Host does with the
    // advertising the connection ended: nothing, advertise again (connectable
    // while there is room), or advertise non-connectable so the device stays
    // visible at the limit.  The Host never advertises connectable at the
    // limit: an answer that asks for it at the limit is read as
    // `AdvertiseNonConnectable`.
    fn on_connected(var self, conn: ConnId, role: Role, links: Int) -> Action [e]
        Action.Stay

    // Decide a write to a characteristic whose permission is Authorized:
    // 0 accepts, any other value is the ATT error code the client receives.
    fn authorize_write(var self, conn: ConnId, attr: Int, var value: Value) -> Int [e]
        0

    // The attributes bound with `bind_function` have no value in the Host:
    // a read asks the policy to fill `out`, and a write asks it to act on
    // `value`.  Both answer 0, the ATT error code the client receives
    // (`ATT_*`, or an application code from 0x80, which a Control Point
    // uses for "op code not supported"), or NOT_HANDLED.  `svc` is the index
    // `add_service` answered for the service that owns `attr`, so a product
    // with several services dispatches on it (one line per service) and no
    // service is offered an attribute it does not own.  The hooks run inside
    // the Host's turn and must not wait.
    fn on_read(var self, conn: ConnId, attr: u16, svc: Int, var out: Value) -> Int [e]
        NOT_HANDLED

    fn on_write(var self, conn: ConnId, attr: u16, svc: Int, var value: Value) -> Int [e]
        NOT_HANDLED

    // A pairing ended; `bonded` says the keys were stored.
    fn pairing_done(var self, conn: ConnId, st: Status, level: Security, bonded: Bool) [e]
        let _ = st

    // What the device does once the Controller is up: `serve` asks it once, after `start` answered, and applies the answer.
    // `Action.Advertise(...)` starts advertising; every other answer is read as `Action.Stay`.
    fn on_start(var self) -> Action [e]
        Action.Stay

    // Whether `serve` turns the pump again.  `serve` reads it once before each turn; the default is true, so a product that never
    // stops does not write it.
    fn keep_serving(self) -> Bool [e]
        true

// ── Bond storage: the security database the product keeps ───────────
pub @value
struct Bond
    peer: Addr
    irk: [u8; 16]
    has_irk: Bool
    ltk: [u8; 16]
    ediv: u16
    rand: [u8; 8]
    key_size: u8
    level: Security

// What the GATT server keeps for a bonded client (Core Vol 3 Part G 7.2
// and 2.5.2.1: persistent across connections for a trusted client): the
// Client Characteristic Configuration values, the Client Supported
// Features value and the database generation the client last saw.
pub @value
struct ServerState
    peer: Addr
    csf: u8
    generation: u16
    ccc: Vec[u16; noble_config.MAX_CCCD]

// The Database Hash of a peer's GATT database (Vol 3 Part G 7.3).
pub alias DbHash = [u8; 16]

// A peer's discovered database as the Host serialised it.  The store keeps
// the octets and does not interpret them.
pub alias CacheImage = Vec[u8; cache_image_bytes()]

pub trait BondStore[g]
    fn find(self, peer: Addr) -> ?Bond [g]
    fn save(var self, bond: Bond) -> Status [g]
    fn forget(var self, peer: Addr) [g]
    fn count(self) -> Int [g]
    fn at(self, index: Int) -> ?Bond [g]

    // GATT state kept with the bond.  Every default stores nothing, so a
    // store that only holds bonds is complete, and a product that wants
    // robust caching across a reset writes these four over flash.
    fn load_server(self, peer: Addr) -> ?ServerState [g]
        None

    fn save_server(var self, st: ServerState) [g]
        let _ = st

    // The discovered database of `peer` whose Database Hash was `hash`.
    // False when none is stored for that hash.
    fn load_cache(self, peer: Addr, hash: DbHash, var img: CacheImage) -> Bool [g]
        false

    fn save_cache(var self, peer: Addr, hash: DbHash, img: CacheImage) [g]
        let _ = peer

// Bonds in RAM, `MAX_BONDS` of them.  A product that keeps bonds across
// a reset writes its own store over flash.
pub @value
struct RamBonds
    rows: Vec[Bond; noble_config.MAX_BONDS]

pub @tier(embedded)
fn same_addr(a: Addr, b: Addr) -> Bool
    if a.kind != b.kind
        return false
    for i in 0..6
        if a.octets[i] != b.octets[i]
            return false
    true

impl BondStore[] for RamBonds
    @tier(embedded)
    fn find(self, peer: Addr) -> ?Bond
        for i in 0..self.rows.len()
            if same_addr(self.rows[i].peer, peer)
                return Some(self.rows[i])
        None

    // A bond for a peer that has one replaces it; a full table answers
    // E_NO_ROOM and keeps what it has, and the Host reports the pairing as not
    // bonded.
    @tier(embedded)
    fn save(var self, bond: Bond) -> Status
        for i in 0..self.rows.len()
            if same_addr(self.rows[i].peer, bond.peer)
                self.rows[i] = bond
                return ok()
        match self.rows.push(bond)
            Ok(_) => ok()
            Err(_) => failed(LAYER_LOCAL, E_NO_ROOM)

    // Remove the bond of `peer` by moving the last bond into its place.
    @tier(embedded)
    fn forget(var self, peer: Addr)
        for i in 0..self.rows.len()
            if same_addr(self.rows[i].peer, peer)
                let last = self.rows.len() - 1
                self.rows[i] = self.rows[last]
                let _ = self.rows.pop()
                return

    @tier(embedded)
    fn count(self) -> Int
        self.rows.len()

    @tier(embedded)
    fn at(self, index: Int) -> ?Bond
        self.rows.get(index)

// The policy of a device with no product code.
pub @value
struct DefaultPolicy
    placeholder: Int

impl HostPolicy[] for DefaultPolicy

// ── Data the Host reports ───────────────────────────────────────────
pub alias AdData = Vec[u8; noble_config.MAX_ADV_DATA]

pub @value
struct AdvReport
    addr: Addr
    rssi: i8
    flags: u8
    data: AdData

pub @value
struct ConnInfo
    role: Role
    peer: Addr
    params: ConnParams
    mtu: u16
    level: Security
    bonded: Bool

// What happened that the application did not ask about.  The Host queues
// at most `EVENT_QUEUE` of them.  An `Advert` or a `Notification` that does
// not fit is dropped and counted in `Dropped`; the events of a connection's
// state (`Connected`, `Disconnected`, `ParamsUpdated`, `SecurityChanged`,
// and the two pairing requests) are never dropped, because one slot of the
// queue is reserved for each connection.  An answer to a call is never an
// event: it is the call's result.  `PasskeyRequested` and `NumericRequested`
// are queued when the policy's hook answered PENDING; the application asks
// the user and calls `passkey_reply` or `numeric_reply`.
pub @value
enum Event
    Ready
    Advert(report: AdvReport)
    Connected(conn: ConnId, role: Role, peer: Addr, params: ConnParams)
    Disconnected(conn: ConnId, reason: Status)
    ParamsUpdated(conn: ConnId, params: ConnParams)
    SecurityChanged(conn: ConnId, level: Security, bonded: Bool)
    PasskeyRequested(conn: ConnId)
    NumericRequested(conn: ConnId, value: Int)
    Notification(conn: ConnId, attr: u16, indication: Bool, value: Value)
    Written(conn: ConnId, attr: u16)
    // A read or write of an attribute bound with `bind_event` (section
    // 3.17): the client waits for `Out.Respond` from the service that owns
    // `svc`.  Counted with the state events: it keeps a slot of the queue from the adverts and
    // notifications.  When the queue has no slot at all, the Host answers the client
    // ATT_INSUFFICIENT_RESOURCES and queues nothing.
    AttrRead(conn: ConnId, attr: u16, svc: Int)
    AttrWrite(conn: ConnId, attr: u16, svc: Int, value: Value)
    Subscribed(conn: ConnId, attr: u16, mode: u8)
    CocOpened(conn: ConnId, chan: u8, psm: u16)
    CocData(conn: ConnId, chan: u8, sdu: Value)
    CocClosed(conn: ConnId, chan: u8, reason: Status)
    DatabaseChanged(conn: ConnId)
    Dropped(count: u16)

// ── The requests: Layer A's one entry for starting a call ───────────
pub @value
struct AdvParams
    extended: Bool
    connectable: Bool
    scannable: Bool
    interval_min_ms: u16
    interval_max_ms: u16
    duration_ms: u32

pub @value
struct ScanParams
    active: Bool
    extended: Bool
    interval_ms: u16
    window_ms: u16
    duration_ms: u32

pub @value
struct ScanFilter
    uuid16: u16
    name_prefix: String[16]
    rssi_min: i8
    duplicates: Bool

pub @value
enum Request
    Start
    AdvStart(set: u8, p: AdvParams, data: AdData, scan_rsp: AdData)
    PeriodicStart(set: u8, interval_ms: u16, data: AdData)
    AdvStop(set: u8)
    ScanStart(p: ScanParams, f: ScanFilter)
    ScanStop
    SyncCreate(adv: Addr, sid: u8, skip: u16, timeout: u16)
    SyncStop
    AcceptListFromBonds
    Connect(peer: Addr, p: ConnParams)
    ConnectListed(p: ConnParams)
    ConnectCancel
    Disconnect(conn: ConnId, reason: u8)
    UpdateParams(conn: ConnId, p: ConnParams)
    ExchangeMtu(conn: ConnId)
    Discover(conn: ConnId, svc: Uuid)
    Read(conn: ConnId, attr: Attr, need: Security)
    Write(conn: ConnId, attr: Attr, need: Security, data: Value, response: Bool)
    Subscribe(conn: ConnId, attr: Attr, mode: u8, need: Security)
    Indicate(conn: ConnId, attr: Attr, data: Value)
    Secure(conn: ConnId, need: Security)
    CocOpen(conn: ConnId, psm: u16, mtu: u16, need: Security)
    CocClose(conn: ConnId, chan: u8)

// ── The call in flight ──────────────────────────────────────────────
// HCI allows one command at a time and the GATT client one ATT transaction per
// bearer, so the Host takes one call at a time and answers a second with
// E_BUSY.  `Op` is the record of that call: `begin` sets `busy`, the engine
// sets `done` and `status` when the call ends, and `result` reads them and
// clears the record.  `conn` and `chan` are what a call that makes a link or a
// channel answers.
pub struct Op
    var busy: Bool
    var done: Bool
    var status: Status
    var conn: ConnId
    var chan: u8
    var value: Value

pub @tier(embedded)
fn no_conn() -> ConnId
    ConnId { slot: 255, generation: 0 }

pub @tier(embedded)
fn blank_report() -> AdvReport
    AdvReport { addr: Addr { kind: 0, octets: [0, 0, 0, 0, 0, 0] }, rssi: 0, flags: 0, data: Vec.new() }

// The octets of `u` as they are on the air: two for a 16-bit UUID, sixteen for a 128-bit one, least significant first.
pub @tier(embedded)
fn uuid_octets(u: Uuid) -> [u8]
    var out: [u8] = []
    if not u.wide
        list.push(out, (u.lo & 255) as u8)
        list.push(out, ((u.lo >>> 8) & 255) as u8)
        return out
    for i in 0..8
        list.push(out, ((u.lo >>> (8 * i)) & 255) as u8)
    for i in 0..8
        list.push(out, ((u.hi >>> (8 * i)) & 255) as u8)
    out

// The UUID as the GATT client engine names it (`gatt_client.Uuid` has the same three fields).
pub @tier(embedded)
fn to_client_uuid(u: Uuid) -> gatt_client.Uuid
    gatt_client.Uuid { wide: u.wide, lo: u.lo, hi: u.hi }

pub @tier(embedded)
fn from_client_uuid(u: gatt_client.Uuid) -> Uuid
    Uuid { wide: u.wide, lo: u.lo, hi: u.hi }

// The record of no call.  `Op` is a plain struct, made once with the `Host`.
fn idle_op() -> Op
    Op { busy: false, done: false, status: ok(), conn: no_conn(), chan: 0, value: Vec.new() }

// The larger of `n` and 1: a table whose key is 0 keeps one record.
@tier(embedded)
const fn max1(n: Int) -> Int
    if n > 1
        n
    else
        1

// The octets of a serialised discovery cache: 32 for each record the client
// engine keeps for a link.
@tier(embedded)
const fn cache_image_bytes() -> Int
    max1(noble_config.CLIENT_CACHE_RECORDS) * 32

// ── The state of Layer A ────────────────────────────────────────────
// Everything the request engine (host_api.nv) keeps beside the tables of `Host`
// (host.nv), as one value of fixed size: the event queue, the connection table,
// the call in flight and the registers of the request that serves it.  It holds
// no list, so a `Host` that never calls `begin` pays for the queue and the
// table only, and a profile with `event_queue = 0` pays for one slot.
//
// `held` counts the connection-state events in the queue, and `dropped` the
// events lost since the application last read `Event.Dropped`.  The queue
// keeps `reserve` slots for the events of a connection's state: an `Advert` or a
// `Notification` is admitted only while at least that many slots, less the
// state events already queued, stay free.

// One connection of the Host as the application sees it.  The slot is the one
// of the Host's link registry (`le_link.LeLinks`); `id` carries the slot and its
// generation, `info` what `conn_info` answers.
pub @value
struct Conn
    live: Bool
    id: ConnId
    info: ConnInfo

// The kinds of request the engine serves, held in `Api.kind`.
const R_NONE = 0
const R_START = 1
const R_CONNECT = 2
const R_CANCEL = 3
const R_DISCONNECT = 4
const R_UPDATE = 5
const R_SECURE = 6
const R_COC_OPEN = 7
const R_COC_CLOSE = 8
const R_ADV_START = 9
const R_PERIODIC_START = 10
const R_ADV_STOP = 11
const R_SCAN_START = 12
const R_SCAN_STOP = 13
const R_SYNC_CREATE = 14
const R_SYNC_STOP = 15
const R_ACCEPT_LIST = 16
const R_MTU = 17
const R_DISCOVER = 18
const R_READ = 19
const R_WRITE = 20
const R_SUBSCRIBE = 21
const R_INDICATE = 22

// The value of an answer that was not given.
const NO_ANSWER = -1000

// The answers of `HostPolicy.on_connected` and `on_disconnected` that concern
// advertising, held in `Api.advertise` for the advertising code of Layer B.
const ADVERTISE_NONE = 0
const ADVERTISE_CONNECTABLE = 1
const ADVERTISE_NON_CONNECTABLE = 2

pub struct Api
    var ready: Bool
    var events: Deque[Event; max1(noble_config.EVENT_QUEUE)]
    var held: Int
    var dropped: Int
    var conns: Vec[Conn; limits.LINK_SLOTS]
    var op: Op
    var max_links: Int
    // The request being served: its kind, its step, and its arguments.
    var kind: Int
    var step: Int
    var r_conn: ConnId
    var r_params: ConnParams
    var r_need: Security
    var r_peer: Addr
    var r_psm: Int
    var r_mtu: Int
    var r_chan: Int
    var r_reason: Int
    // The last `connect`, for `Action.Reconnect`: the peer, the parameters, whether
    // it was `connect_listed`, how many reconnections have been made since the
    // last link, and the time the next one is due (-1 for none).
    var last_peer: Addr
    var last_params: ConnParams
    var last_listed: Bool
    var last_valid: Bool
    var attempts: Int
    var due_ms: Int
    var reconnecting: Bool
    var advertise: Int
    // The one PSM `coc_listen` accepts, with the MTU and the security it asked.
    var coc_psm: Int
    var coc_need: Security
    // The settings the pairing reads (HostConfig of the sketch).
    var bondable: Bool
    var sc_only: Bool
    var min_key_size: Int
    // Bytes of the random seed the Controller gave (LE Rand), 16 of them.
    var seed: Vec[u8; 16]
    var own_kind: Int
    // What each connection waits for from the application: 0 nothing, 1 a passkey,
    // 2 a numeric comparison; and the answer given, -1000 for none.
    var ask: Vec[Int; limits.LINK_SLOTS]
    var ans: Vec[Int; limits.LINK_SLOTS]
    // Layer B.  The advertising set the last `AdvStart` or `PeriodicStart` started, with its arguments, for `Action.Readvertise`
    // and for `AdvStop`: whether it is on, whether it used the extended commands, whether a periodic train rides on it.
    var adv_valid: Bool
    var adv_on: Bool
    var adv_ext: Bool
    var adv_periodic: Bool
    var adv_set: Int
    var adv_p: AdvParams
    var adv_data: AdData
    var adv_rsp: AdData
    var adv_interval: Int
    // The advertising the Host restarts by itself (`ADVERTISE_*`, the same as `advertise` but kept until the restart runs).
    var adv_again: Int
    // A call the Host started for itself (the restart above): it holds `op.busy` but no application waits for it.
    var internal: Bool
    // Scanning: the filter the Host applies to each report, and whether the Controller scans.
    var scan_f: ScanFilter
    var scan_p: ScanParams
    var scan_on: Bool
    // Periodic advertising synchronisation: the Sync_Handle the Controller gave, -1 for none, and the arguments of the call.
    var sync_handle: Int
    var r_sid: Int
    var r_skip: Int
    var r_timeout: Int
    // The registers of a GATT request: the attribute, the data to write or the service to find, the mode of a subscription,
    // whether a write expects a response, and the step of a discovery.
    var r_attr: Attr
    var r_data: Value
    var r_svc: Uuid
    var r_mode: Int
    var r_response: Bool
    var r_cursor: Int
    var r_phase: Int
    // The GATT server: the services added, so the index of the next one.
    var svc_count: Int
    // The request a bound attribute is held for, for each connection: 0 none, 1 Read Request, 2 Write Request, 3 Write
    // Command, 4 Read Blob Request; the handle, the offset of a Read Blob, and the time it was queued.
    var pend: Vec[Int; limits.LINK_SLOTS]
    var pend_attr: Vec[Int; limits.LINK_SLOTS]
    var pend_off: Vec[Int; limits.LINK_SLOTS]
    var pend_ms: Vec[Int; limits.LINK_SLOTS]

pub @tier(embedded)
fn blank_addr() -> Addr
    Addr { kind: 0, octets: [0, 0, 0, 0, 0, 0] }

@tier(embedded)
fn blank_info() -> ConnInfo
    ConnInfo { role: Role.Peripheral, peer: blank_addr(), params: conn_params_default(), mtu: 23, level: Security.Open, bonded: false }

// The Layer A state of a Host that serves `max_links` connections, made once with the `Host`.
pub fn api_new(max_links: Int) -> Api
    var conns: Vec[Conn; limits.LINK_SLOTS] = Vec.new()
    var ask: Vec[Int; limits.LINK_SLOTS] = Vec.new()
    var ans: Vec[Int; limits.LINK_SLOTS] = Vec.new()
    var pend: Vec[Int; limits.LINK_SLOTS] = Vec.new()
    var pend_attr: Vec[Int; limits.LINK_SLOTS] = Vec.new()
    var pend_off: Vec[Int; limits.LINK_SLOTS] = Vec.new()
    var pend_ms: Vec[Int; limits.LINK_SLOTS] = Vec.new()
    for _ in 0..limits.LINK_SLOTS
        let _ = conns.push(Conn { live: false, id: no_conn(), info: blank_info() })
        let _ = ask.push(0)
        let _ = ans.push(NO_ANSWER)
        let _ = pend.push(0)
        let _ = pend_attr.push(0)
        let _ = pend_off.push(0)
        let _ = pend_ms.push(0)
    Api {
        ready: false, events: Deque.new(), held: 0, dropped: 0, conns: conns, op: idle_op(), max_links: max_links,
        kind: 0, step: 0, r_conn: no_conn(), r_params: conn_params_default(), r_need: Security.Open, r_peer: blank_addr(),
        r_psm: 0, r_mtu: 0, r_chan: 0, r_reason: 0,
        last_peer: blank_addr(), last_params: conn_params_default(), last_listed: false, last_valid: false,
        attempts: 0, due_ms: -1, reconnecting: false, advertise: 0, coc_psm: 0, coc_need: Security.Open,
        bondable: true, sc_only: false, min_key_size: 7, seed: Vec.new(), own_kind: 0, ask: ask, ans: ans,
        adv_valid: false, adv_on: false, adv_ext: false, adv_periodic: false, adv_set: 0, adv_p: adv_legacy(),
        adv_data: Vec.new(), adv_rsp: Vec.new(), adv_interval: 0, adv_again: 0, internal: false,
        scan_f: scan_all(), scan_p: scan_passive(), scan_on: false, sync_handle: -1, r_sid: 0, r_skip: 0, r_timeout: 0,
        r_attr: Attr { handle: 0, props: 0, cccd: 0 }, r_data: Vec.new(), r_svc: uuid16(0), r_mode: 0, r_response: true,
        r_cursor: 0, r_phase: 0, svc_count: 0, pend: pend, pend_attr: pend_attr, pend_off: pend_off, pend_ms: pend_ms }

// Whether `ev` reports the state of a connection or a pairing: such an event is
// never dropped, because one slot per connection is kept for it.
@tier(embedded)
fn is_state_event(ev: Event) -> Bool
    match ev
        Connected(_, _, _, _) => true
        Disconnected(_, _) => true
        ParamsUpdated(_, _) => true
        SecurityChanged(_, _, _) => true
        PasskeyRequested(_) => true
        NumericRequested(_, _) => true
        AttrRead(_, _, _) => true
        AttrWrite(_, _, _, _) => true
        _ => false

// Whether `ev` arrives with no flow control the Host can apply, so that a full
// queue drops it and counts the loss.
@tier(embedded)
fn is_droppable_event(ev: Event) -> Bool
    match ev
        Advert(_) => true
        Notification(_, _, _, _) => true
        _ => false

// The slots the queue keeps free for the state events of the connections: the
// ceiling `max_links` less the state events already queued, and always one slot
// less than the queue so that a droppable event can be admitted at all.
@tier(embedded)
fn reserve_free(a: Api) -> Int
    var cap = noble_config.EVENT_QUEUE - 1
    if cap < 0
        cap = 0
    var reserve = a.max_links
    if reserve > cap
        reserve = cap
    let free = reserve - a.held
    if free < 0
        0
    else
        free

// Put `ev` in the queue.  False, with the loss counted in `dropped`, when the
// queue has no room for it: a droppable event is admitted while the reserve stays
// free, any other event while the queue has a slot.
pub @tier(embedded)
fn queue_event(var a: Api, ev: Event) -> Bool
    let n = a.events.len()
    var room = n < noble_config.EVENT_QUEUE
    if room and is_droppable_event(ev) and n + reserve_free(a) >= noble_config.EVENT_QUEUE
        room = false
    if not room
        a.dropped = a.dropped + 1
        return false
    a.events.push_back(ev)
    if is_state_event(ev)
        a.held = a.held + 1
    true

// The oldest event; once the queue is empty, the count of the events that were
// dropped since the last time, as `Event.Dropped`.
pub @tier(embedded)
fn queue_take(var a: Api) -> ?Event
    match a.events.pop_front()
        Some(ev) =>
            if is_state_event(ev)
                a.held = a.held - 1
            Some(ev)
        None =>
            if a.dropped > 0
                let n = a.dropped
                a.dropped = 0
                Some(Event.Dropped((if n > 65535 then 65535 else n) as u16))
            else
                None

// ── Adapters from the five error forms of the existing code ─────────
// A module that still answers in its own form is read as a `Status` with these, so the
// application sees one error value (planning/NOBLE-HOST-API-SKETCH.md, section 3.11).

// The result of a GATT client request (`gatt_client.result_status`): 0 is success, 1 to 255 is the
// Error Code of the peer's Error Response, and the codes from 0x100 are the engine's own.
pub @tier(embedded)
fn from_client_status(code: Int) -> Status
    if code == gatt_client.STATUS_OK
        return ok()
    if code > 0 and code < 256
        return failed(LAYER_ATT, code)
    if code == gatt_client.STATUS_TIMEOUT
        return failed(LAYER_LOCAL, E_TIMEOUT)
    if code == gatt_client.STATUS_CACHE_FULL or code == gatt_client.STATUS_TRUNCATED
        return failed(LAYER_LOCAL, E_NO_ROOM)
    failed(LAYER_ATT, ATT_INVALID_PDU)

// The reason the GATT client did not queue a request (`gatt_client.ERR_*`).
pub @tier(embedded)
fn from_client_error(code: Int) -> Status
    if code == gatt_client.ERR_NO_LINK
        return failed(LAYER_LOCAL, E_STALE)
    if code == gatt_client.ERR_QUEUE_FULL or code == gatt_client.ERR_REPEAT
        return failed(LAYER_LOCAL, E_BUSY)
    if code == gatt_client.ERR_NO_ROOM
        return failed(LAYER_LOCAL, E_NO_ROOM)
    if code == gatt_client.ERR_DEAD
        return failed(LAYER_LOCAL, E_LINK_LOST)
    if code == gatt_client.ERR_NO_BEARER
        return failed(LAYER_LOCAL, E_NOT_READY)
    failed(LAYER_LOCAL, E_BAD_ARGUMENT)

// The text `advertiser.make_advertiser` answers when it refuses its arguments.
pub @tier(embedded)
fn from_advertiser_error(text: Str) -> Status
    let _ = text
    failed(LAYER_LOCAL, E_BAD_ARGUMENT)

// A Pairing Failed reason of the Security Manager (`smp.Reason`).
pub @tier(embedded)
fn from_smp_reason(reason: smp.Reason) -> Status
    failed(LAYER_SMP, smp.reason_code(reason))

// Why a profile could not be added to the server (`profile_builder.ProfileError`).
pub @tier(embedded)
fn from_profile_error(e: profile_builder.ProfileError) -> Status
    match e
        NoRoom => failed(LAYER_LOCAL, E_NO_ROOM)
        InvalidValue => failed(LAYER_LOCAL, E_BAD_ARGUMENT)
        NotPermitted => failed(LAYER_LOCAL, E_REFUSED)

// ═══════════════════════════════════════════════════════════════════
// Layer B: the Adapter, GAP, GATT and the services
// ═══════════════════════════════════════════════════════════════════
//
// An `Adapter` holds a Host, the transport, the product's policy and its bond store, so a program does not thread four values
// through every call.  Its methods start a call with `begin`, run the Host until the call ends or the timeout passes, and answer
// the `Status`.  A method that can wait carries `[async]`: the task parks in the transport's `park` (by default
// `core.rt.yield_now`) between two turns of the Host.  Nothing in this layer reads a clock but through the transport's `now_ms`.
// planning/NOBLE-HOST-API-SKETCH.md sections 3.5, 3.6, 3.10 and 3.13 are the design.

// The longest a turn of the Adapter parks, in milliseconds: the timers of the Host (the ATT transaction timeout, the supervision
// of a pairing, a reconnection that is due) advance at the turns, so a transport that returns from `park` only when a packet
// arrives still turns the Host at least this often.
const PARK_SLICE_MS = 50

// What `connect` and `connect_listed` answer: the outcome, and the name of the link they made.
pub @value
struct ConnResult
    status: Status
    conn: ConnId

// What `coc_open` answers: the outcome, and the channel it opened.
pub @value
struct CocResult
    status: Status
    chan: u8

// What `add_char` answers: the outcome, and the attribute as discovery would give it (the value handle, the properties, the handle
// of the Client Characteristic Configuration descriptor, 0 for none).
pub @value
struct AttrResult
    status: Status
    attr: Attr

// What `add_service` answers: the outcome, and the index of the new service, which the Host passes to `HostPolicy.on_read` and
// `on_write` as `svc` and to `Event.AttrRead` and `AttrWrite` for every attribute of the service.
pub @value
struct ServiceResult
    status: Status
    svc: Int

pub alias Name = String[noble_config.MAX_NAME]

pub struct Adapter<T: HciLink[e], P: HostPolicy[f], B: BondStore[g]>
    var io: T
    var policy: P
    var bonds: B
    var host: Host
    // The product's services (`plug`), and the first and last attribute handle each one added to the database: `pump` finds the
    // owner of an attribute event by its handle.  At most `noble_config.MAX_SERVICES` entries (the key `max_services`).
    var services: [dyn Service]
    var owner_first: Vec[u16; noble_config.MAX_SERVICES]
    var owner_last: Vec[u16; noble_config.MAX_SERVICES]

// The Adapter of a transport, a policy and a bond store, with a Host that serves `MAX_CONNECTIONS` links and the Device Name
// "noble".
pub @tier(embedded)
fn adapter<T: HciLink[e], P: HostPolicy[f], B: BondStore[g]>(io: T, policy: P, bonds: B) -> Adapter<T, P, B>
    Adapter { io: io, policy: policy, bonds: bonds, host: host_blank(host_config(noble_config.MAX_CONNECTIONS, ['n', 'o', 'b', 'l', 'e'])),
        services: [], owner_first: Vec.new(), owner_last: Vec.new() }

impl Adapter
    // One turn of the Host at the current clock.
    @tier(embedded)
    fn step(var self) [e, f, g, time, mutate]
        let now = self.io.now_ms()
        host_api.poll(var self.host, var self.io, var self.policy, var self.bonds, now)

    // The transport's clock, in milliseconds.
    @tier(embedded)
    fn now_ms(var self) -> Int [e, time]
        self.io.now_ms()

    // Start `req` and run the Host until it ends.
    @tier(embedded)
    fn run(var self, req: Request, timeout_ms: Int) -> Status [e, f, g, async, time, mutate]
        let started = host_api.begin(var self.host, req)
        if not started.is_ok()
            return started
        let t0 = self.io.now_ms()
        while true
            self.step()
            match host_api.result(var self.host)
                Some(done) => return done
                None => ()
            let waited = self.io.now_ms() - t0
            if waited >= timeout_ms
                host_api.abandon(var self.host)
                return failed(LAYER_LOCAL, E_TIMEOUT)
            self.io.park(park_for(timeout_ms - waited))
        ok()

    // Bring the Controller up: reset, the event masks, the buffer sizes, the random seed and the address.  `Event.Ready` is queued
    // when it has.
    @tier(embedded)
    fn start(var self) -> Status [e, f, g, async, time, mutate]
        self.run(Request.Start, 5000)

    // The next event, waiting up to `timeout_ms` for one.
    @tier(embedded)
    fn wait_event(var self, timeout_ms: Int) -> ?Event [e, f, g, async, time, mutate]
        let t0 = self.io.now_ms()
        while true
            self.step()
            match host_api.next_event(var self.host)
                Some(ev) => return Some(ev)
                None => ()
            let waited = self.io.now_ms() - t0
            if waited >= timeout_ms
                return None
            self.io.park(park_for(timeout_ms - waited))
        None

@tier(embedded)
fn park_for(remaining_ms: Int) -> Int
    if remaining_ms > PARK_SLICE_MS
        PARK_SLICE_MS
    else if remaining_ms < 1
        1
    else
        remaining_ms

// ── GAP: advertising data ───────────────────────────────────────────

@tier(embedded)
fn ad_put(var d: AdData, b: Int) -> Bool
    match d.push(b as u8)
        Ok(_) => true
        Err(_) => false

// The Flags record.
pub @tier(embedded)
fn ad_flags(var d: AdData, flags: Int) -> Bool
    ad_put(var d, 2) and ad_put(var d, 0x01) and ad_put(var d, flags)

// The Complete List of 16-bit Service Class UUIDs with one entry.
pub @tier(embedded)
fn ad_uuid16(var d: AdData, uuid: Int) -> Bool
    ad_put(var d, 3) and ad_put(var d, 0x03) and ad_put(var d, uuid & 255) and ad_put(var d, uuid >> 8)

// The Complete Local Name record.
pub @tier(embedded)
fn ad_name(var d: AdData, name: Name) -> Bool
    if not ad_put(var d, name.len() + 1) or not ad_put(var d, 0x09)
        return false
    for b in name
        if not ad_put(var d, b as Int)
            return false
    true

// Legacy advertising, connectable and scannable, every 100 ms to 150 ms, with no limit of time.
pub @tier(embedded)
fn adv_legacy() -> AdvParams
    AdvParams { extended: false, connectable: true, scannable: true, interval_min_ms: 100, interval_max_ms: 150, duration_ms: 0 }

// ── GAP: scanning ───────────────────────────────────────────────────

// Report every device.
pub @tier(embedded)
fn scan_all() -> ScanFilter
    ScanFilter { uuid16: 0, name_prefix: String.new(), rssi_min: -127, duplicates: false }

// Report the devices that advertise the 16-bit service `uuid`.
pub @tier(embedded)
fn scan_service(uuid: Int) -> ScanFilter
    ScanFilter { uuid16: uuid as u16, name_prefix: String.new(), rssi_min: -127, duplicates: false }

// Passive scanning, 50 ms in every 100 ms, with no limit of time.
pub @tier(embedded)
fn scan_passive() -> ScanParams
    ScanParams { active: false, extended: false, interval_ms: 100, window_ms: 50, duration_ms: 0 }

impl Adapter
    // Start advertising set `set` (0 for the legacy set).  Legacy and extended advertising are one call: `p.extended` picks the
    // commands, and the Host never mixes the two.  A connection ends the advertising of a set; the policy decides whether it starts
    // again (`Action.Readvertise`).
    @tier(embedded)
    fn adv_start(var self, set: Int, p: AdvParams, data: AdData, scan_rsp: AdData) -> Status [e, f, g, async, time, mutate]
        self.run(Request.AdvStart(set as u8, p, data, scan_rsp), 2000)

    // Put a periodic advertising train on set `set`, with `data` as its data.
    @tier(embedded)
    fn periodic_start(var self, set: Int, interval_ms: Int, data: AdData) -> Status [e, f, g, async, time, mutate]
        self.run(Request.PeriodicStart(set as u8, interval_ms as u16, data), 2000)

    @tier(embedded)
    fn adv_stop(var self, set: Int) -> Status [e, f, g, async, time, mutate]
        self.run(Request.AdvStop(set as u8), 2000)

    // Reports arrive as `Event.Advert`.  The Host applies `f` to each report, then asks `HostPolicy.on_advert`.
    @tier(embedded)
    fn scan_start(var self, p: ScanParams, f: ScanFilter) -> Status [e, f, g, async, time, mutate]
        self.run(Request.ScanStart(p, f), 2000)

    @tier(embedded)
    fn scan_stop(var self) -> Status [e, f, g, async, time, mutate]
        self.run(Request.ScanStop, 2000)

    // Synchronise to a periodic advertising train.  The call ends when the Controller has the train.
    @tier(embedded)
    fn sync_create(var self, adv: Addr, sid: Int, skip: Int, timeout: Int) -> Status [e, f, g, async, time, mutate]
        self.run(Request.SyncCreate(adv, sid as u8, skip as u16, timeout as u16), 30000)

    @tier(embedded)
    fn sync_stop(var self) -> Status [e, f, g, async, time, mutate]
        self.run(Request.SyncStop, 2000)

    // Scan until one report matches `want`, then stop.  A convenience over `scan_start` and `wait_event`.
    @tier(embedded)
    fn find(var self, want: ScanFilter, timeout_ms: Int, var out: AdvReport) -> Status [e, f, g, async, time, mutate]
        let s = self.scan_start(scan_passive(), want)
        if not s.is_ok()
            return s
        let t0 = self.io.now_ms()
        while true
            match self.wait_event(100)
                Some(Event.Advert(r)) =>
                    out = r
                    return self.scan_stop()
                Some(_) => ()
                None => ()
            if self.io.now_ms() - t0 >= timeout_ms
                let _ = self.scan_stop()
                return failed(LAYER_LOCAL, E_TIMEOUT)
        ok()

// ── GAP: connections, in either role ────────────────────────────────

impl Adapter
    // Connect to `peer` as the Central.  The same `ConnId` names the link for the whole connection, whichever role set it up.
    @tier(embedded)
    fn connect(var self, peer: Addr, p: ConnParams, timeout_ms: Int) -> ConnResult [e, f, g, async, time, mutate]
        let s = self.run(Request.Connect(peer, p), timeout_ms)
        ConnResult { status: s, conn: host_api.op_conn(self.host) }

    // Connect to whichever bonded device is in range (the accept list).
    @tier(embedded)
    fn connect_listed(var self, p: ConnParams, timeout_ms: Int) -> ConnResult [e, f, g, async, time, mutate]
        let s = self.run(Request.ConnectListed(p), timeout_ms)
        ConnResult { status: s, conn: host_api.op_conn(self.host) }

    // Write the bonds into the Controller's accept list and resolving list.
    @tier(embedded)
    fn accept_list_from_bonds(var self) -> Status [e, f, g, async, time, mutate]
        self.run(Request.AcceptListFromBonds, 5000)

    @tier(embedded)
    fn connect_cancel(var self) -> Status [e, f, g, async, time, mutate]
        self.run(Request.ConnectCancel, 2000)

    @tier(embedded)
    fn disconnect(var self, conn: ConnId, reason: Int) -> Status [e, f, g, async, time, mutate]
        self.run(Request.Disconnect(conn, reason as u8), 5000)

    @tier(embedded)
    fn update_params(var self, conn: ConnId, p: ConnParams) -> Status [e, f, g, async, time, mutate]
        self.run(Request.UpdateParams(conn, p), 5000)

    // What the Host knows of a connection; None for a name that is stale.
    @tier(embedded)
    fn conn_info(self, conn: ConnId) -> ?ConnInfo
        host_api.conn_info(self.host, conn)

    // How many connections are live, in either role.
    @tier(embedded)
    fn link_count(self) -> Int
        host_api.link_count(self.host)

// ── GATT client ─────────────────────────────────────────────────────

// The values of a subscription: notifications or indications.
pub const NOTIFY = 1
pub const INDICATE = 2

impl Adapter
    @tier(embedded)
    fn exchange_mtu(var self, conn: ConnId) -> Status [e, f, g, async, time, mutate]
        self.run(Request.ExchangeMtu(conn), 30000)

    // Discover the service `svc` with its characteristics and the descriptors of those that notify or indicate, into the Host's
    // cache for `conn` (`CLIENT_CACHE_RECORDS` records for a link).
    @tier(embedded)
    fn discover(var self, conn: ConnId, svc: Uuid) -> Status [e, f, g, async, time, mutate]
        self.run(Request.Discover(conn, svc), 30000)

    // Look a characteristic up in the cache; no radio traffic.
    @tier(embedded)
    fn find_char(self, conn: ConnId, svc: Uuid, chr: Uuid) -> ?Attr
        host_api.find_char(self.host, conn, svc, chr)

    // Read a value.  `need` is the least security the link must have before the request is sent: below it the call fails with
    // E_SECURITY_LOW and nothing leaves the device.  `Open` accepts any link.
    @tier(embedded)
    fn read(var self, conn: ConnId, a: Attr, need: Security, var out: Value) -> Status [e, f, g, async, time, mutate]
        let s = self.run(Request.Read(conn, a, need), 30000)
        out.clear()
        let src = self.host.api.op.value
        for i in 0..src.len()
            let _ = out.push(src[i])
        s

    @tier(embedded)
    fn write(var self, conn: ConnId, a: Attr, need: Security, var data: Value) -> Status [e, f, g, async, time, mutate]
        self.run(Request.Write(conn, a, need, data, true), 30000)

    @tier(embedded)
    fn write_no_response(var self, conn: ConnId, a: Attr, need: Security, var data: Value) -> Status [e, f, g, async, time, mutate]
        self.run(Request.Write(conn, a, need, data, false), 30000)

    // Write the characteristic's configuration descriptor.  Values arrive as `Event.Notification`.
    @tier(embedded)
    fn subscribe(var self, conn: ConnId, a: Attr, mode: Int, need: Security) -> Status [e, f, g, async, time, mutate]
        self.run(Request.Subscribe(conn, a, mode as u8, need), 30000)

    @tier(embedded)
    fn unsubscribe(var self, conn: ConnId, a: Attr, need: Security) -> Status [e, f, g, async, time, mutate]
        self.run(Request.Subscribe(conn, a, 0, need), 30000)

// ── GATT server ─────────────────────────────────────────────────────

pub const PROP_READ = 0x02
pub const PROP_WRITE_NO_RESPONSE = 0x04
pub const PROP_WRITE = 0x08
pub const PROP_NOTIFY = 0x10
pub const PROP_INDICATE = 0x20

pub @tier(embedded)
fn open_perms() -> Permissions
    Permissions { read: Access.Open, write: Access.Open }

impl Adapter
    // The same calls as on the Host, for a program that holds an Adapter.
    @tier(embedded)
    fn add_service(var self, uuid: Uuid) -> ServiceResult [e, f, g, mutate]
        self.host.add_service(uuid)

    @tier(embedded)
    fn add_char(var self, uuid: Uuid, props: Int, perm: Permissions, cccd: Access, max_len: Int) -> AttrResult [e, f, g, mutate]
        self.host.add_char(uuid, props, perm, cccd, max_len)

    @tier(embedded)
    fn bind_function(var self, a: Attr) -> Status [e, f, g, mutate]
        self.host.bind_function(a)

    @tier(embedded)
    fn bind_event(var self, a: Attr) -> Status [e, f, g, mutate]
        self.host.bind_event(a)

    // Answer the ATT request that `Event.AttrRead` or `AttrWrite` reported: `code` 0 with `v` as the value of a read, or the ATT
    // error code.  E_BUSY when no request is pending on `conn` for `attr`.
    @tier(embedded)
    fn respond(var self, conn: ConnId, attr: u16, code: Int, var v: Value) -> Status [e, f, g, mutate]
        host_api.respond(var self.host, conn, attr, code, v)

    // Set the value a read returns.
    @tier(embedded)
    fn set_value(var self, a: Attr, var v: Value) -> Status [e, f, g, mutate]
        self.host.set_value(a, v)

    // Send `v` as a notification to the client on `conn` if it subscribed; E_NOT_SUBSCRIBED if it did not, E_SECURITY_LOW if the
    // link is below `need`.
    @tier(embedded)
    fn notify(var self, conn: ConnId, a: Attr, need: Security, var v: Value) -> Status [e, f, g, mutate]
        host_api.notify(var self.host, conn, a, need, v)

    // Send `v` to every connected client that subscribed to `a` and whose link is at `need` or above: the usual case for a sensor.
    // Answers how many were sent; a client below `need` is skipped and counted in neither.
    @tier(embedded)
    fn notify_all(var self, a: Attr, need: Security, var v: Value) -> Int [e, f, g, mutate]
        var n = 0
        for i in 0..self.host.api.conns.len()
            let k = self.host.api.conns[i]
            if k.live
                if host_api.notify(var self.host, k.id, a, need, v).is_ok()
                    n = n + 1
        n

    // Send `v` as an indication and wait for the client's confirmation.
    @tier(embedded)
    fn indicate(var self, conn: ConnId, a: Attr, var v: Value) -> Status [e, f, g, async, time, mutate]
        self.run(Request.Indicate(conn, a, v), 30000)

// ── Pairing, bonding and credit based channels ──────────────────────

impl Adapter
    // Raise the link to `need`.  With a bond that is strong enough the Host encrypts the link and no pairing runs.  Otherwise it
    // asks `policy.accept_pairing` and pairs, calling the hooks for the passkey or the numeric comparison.  It fails with
    // E_SECURITY_LOW when the peer or the policy cannot reach `need`, and with the SMP reason when the pairing fails.  Nothing in
    // the Host raises security on its own.
    @tier(embedded)
    fn secure(var self, conn: ConnId, need: Security) -> Status [e, f, g, async, time, mutate]
        self.run(Request.Secure(conn, need), 60000)

    // The answers to `Event.PasskeyRequested` and `Event.NumericRequested`.
    @tier(embedded)
    fn passkey_reply(var self, conn: ConnId, passkey: Int) -> Status [e, f, g, mutate]
        host_api.passkey_reply(var self.host, conn, passkey)

    @tier(embedded)
    fn numeric_reply(var self, conn: ConnId, accepted: Bool) -> Status [e, f, g, mutate]
        host_api.numeric_reply(var self.host, conn, accepted)

    // Delete the bond and drop the keys of the peer.
    @tier(embedded)
    fn unbond(var self, peer: Addr) [e, f, g, mutate]
        host_api.unbond(var self.host, var self.bonds, peer)

    // Accept channels on `psm`, if the link has at least `need`.
    @tier(embedded)
    fn coc_listen(var self, psm: Int, mtu: Int, need: Security) -> Status [e, f, g, mutate]
        host_api.coc_listen(var self.host, psm, mtu, need)

    @tier(embedded)
    fn coc_open(var self, conn: ConnId, psm: Int, mtu: Int, need: Security) -> CocResult [e, f, g, async, time, mutate]
        let s = self.run(Request.CocOpen(conn, psm as u16, mtu as u16, need), 30000)
        CocResult { status: s, chan: host_api.op_chan(self.host) as u8 }

    // Queue one SDU; E_NO_ROOM while the peer's credits are used up.
    @tier(embedded)
    fn coc_send(var self, conn: ConnId, chan: Int, var sdu: Value) -> Status [e, f, g, mutate]
        host_api.coc_send(var self.host, conn, chan, sdu)

    @tier(embedded)
    fn coc_close(var self, conn: ConnId, chan: Int) -> Status [e, f, g, async, time, mutate]
        self.run(Request.CocClose(conn, chan as u8), 5000)

// ── Services ────────────────────────────────────────────────────────

// What a service asks the pump to do: the pump applies it to the Adapter, so a service never holds the Adapter.
pub @value
enum Out
    Notify(conn: ConnId, attr: Attr, value: Value)
    NotifyAll(attr: Attr, value: Value)
    // The answer to `Event.AttrRead` or `AttrWrite`.
    Respond(conn: ConnId, attr: u16, code: Int, value: Value)

pub alias Outbox = Vec[Out; noble_config.OUTBOX]

// Every service module implements this trait and exports a value that does.  `attach` adds the service to the Host's database and
// keeps the handles and the service index in the value; `on_event` offers the service each event the Host queued, and answers
// true when it took the event; `tick` runs once a turn of the pump; `on_read` and `on_write` serve the attributes bound with
// `bind_function`, which the product's policy gives to the service whose index the Host passed, and answer NOT_HANDLED for an
// attribute the service leaves to the product.
pub trait Service[e]
    // Answers the `Status` of adding the service's attributes to the Host's database; `ble.plug` stops at the first that fails.
    fn attach(var self, var h: Host) -> Status [e, mutate]

    fn on_event(var self, ev: Event, var out: Outbox) -> Bool [e, mutate]
        false

    fn tick(var self, now_ms: Int, var out: Outbox) [e, mutate]
        let _ = now_ms

    fn on_read(var self, conn: ConnId, attr: u16, var out: Value) -> Int [e, mutate]
        NOT_HANDLED

    fn on_write(var self, conn: ConnId, attr: u16, var value: Value) -> Int [e, mutate]
        NOT_HANDLED

// The handle of an attribute event, None for every other event.
@tier(embedded)
fn attr_of(ev: Event) -> ?u16
    match ev
        Event.AttrRead(conn, attr, svc) => Some(attr)
        Event.AttrWrite(conn, attr, svc, value) => Some(attr)
        Event.Written(conn, attr) => Some(attr)
        Event.Subscribed(conn, attr, mode) => Some(attr)
        _ => None

// Whether every service sees the event (the state of a link), or only the first that takes it.
@tier(embedded)
fn reaches_all(ev: Event) -> Bool
    match ev
        Event.Ready => true
        Event.Connected(conn, role, peer, params) => true
        Event.Disconnected(conn, reason) => true
        Event.ParamsUpdated(conn, params) => true
        Event.SecurityChanged(conn, level, bonded) => true
        Event.DatabaseChanged(conn) => true
        _ => false

// The index in the list of the service whose attributes hold `attr`, -1 when none does (an attribute the product added outside
// its services).
@tier(embedded)
fn owner_of(first: Vec[u16; noble_config.MAX_SERVICES], last: Vec[u16; noble_config.MAX_SERVICES], attr: u16) -> Int
    for i in 0..first.len()
        if attr >= first[i] and attr <= last[i]
            return i
    -1

impl Adapter
    // Install the product's services: `attach` each one in order, and keep the range of attribute handles it added, so that `pump`
    // can give an attribute event to its owner and to no other service.  The list is the product's, made once at start-up (a
    // `system` block in a program at the embedded tier); the Adapter keeps it.  A product writes `ble.plug(var services)`.  The row
    // names `hw` since a service may use it: a call through `dyn` is charged with the row of every implementation (SPEC 3.7).
    @tier(embedded)
    fn plug(var self, var services: [dyn Service]) -> Status [e, f, g, hw, mutate]
        if services.len() > noble_config.MAX_SERVICES
            return failed(LAYER_LOCAL, E_NO_ROOM)
        self.services = services
        for i in 0..self.services.len()
            let first = gatt_server.last_handle(self.host.link.db) + 1
            var svc = self.services[i]
            var h = self.host
            let s = svc.attach(var h)
            if not s.is_ok()
                return s
            let _ = self.owner_first.push(first as u16)
            let _ = self.owner_last.push(gatt_server.last_handle(self.host.link.db) as u16)
        ok()

    // Install one service module held by the product itself (program 7): its attribute events are not routed, the product's
    // policy serves them with `bind_function`.
    @tier(embedded)
    fn plug_module<S: Service[h]>(var self, var s: S) -> Status [h, mutate]
        s.attach(var self.host)

    // One turn of a program whose services are behind the pump: wait up to `wait_ms` for an event; give an attribute event to the
    // service that owns the handle (the access check ran before the event existed, `gatt_server.access_error`), and refuse it at
    // once when no service owns or takes it, so a client never waits for the ATT timeout; give a link event to every service in
    // order, and any other event to the services until one takes it; run every `tick`; apply what they queued.  The row names
    // what a service may do (`hw` among it), since a call through `dyn` is charged with the row of every implementation.  A
    // product writes `ble.pump(100)`.
    @tier(embedded)
    fn pump(var self, wait_ms: Int) [e, f, g, hw, async, time, mutate]
        var out: Outbox = Vec.new()
        match self.wait_event(wait_ms)
            Some(ev) =>
                match attr_of(ev)
                    Some(attr) =>
                        let i = owner_of(self.owner_first, self.owner_last, attr)
                        if i < 0
                            refuse(ev, var out)
                        else if not self.services[i].on_event(ev, var out)
                            refuse(ev, var out)
                    None =>
                        let all = reaches_all(ev)
                        for i in 0..self.services.len()
                            if self.services[i].on_event(ev, var out) and not all
                                break
            None => ()
        let now = self.now_ms()
        for i in 0..self.services.len()
            self.services[i].tick(now, var out)
        for i in 0..out.len()
            match out[i]
                Out.Notify(conn, a, v) =>
                    var w: Value = v
                    let _ = self.notify(conn, a, Security.Open, var w)
                Out.NotifyAll(a, v) =>
                    var w: Value = v
                    let _ = self.notify_all(a, Security.Open, var w)
                Out.Respond(conn, attr, code, v) =>
                    var w: Value = v
                    let _ = self.respond(conn, attr, code, var w)

    // Run the Host: `start` the Controller, ask `policy.on_start` and apply its answer (`Action.Advertise` starts advertising), then
    // turn `pump(wait_ms)` for as long as `policy.keep_serving()` answers true, which is read once before each turn.  Answers the
    // `Status` that ended it: the failure of the start or of the advertising it asked for, or `ok()` when the policy stopped it.
    // For a product with no work of its own between turns; a product that has some calls `start` itself and writes the loop
    // around `pump`.  A product writes `ble.serve(100)`.
    @tier(embedded)
    fn serve(var self, wait_ms: Int) -> Status [e, f, g, hw, async, time, mutate]
        let started = self.start()
        if not started.is_ok()
            return started
        // The policy is copied out and stored back: `on_start` takes `var self`, and a policy that is a `@value` struct is read out
        // of the Adapter as a copy (SPEC 14.7).
        var pol = self.policy
        let first = pol.on_start()
        self.policy = pol
        match first
            Action.Advertise(set, params, data, scan_rsp) =>
                let advertising = self.adv_start(set as Int, params, data, scan_rsp)
                if not advertising.is_ok()
                    return advertising
            _ => ()
        while self.policy.keep_serving()
            self.pump(wait_ms)
        ok()

// The refusal of an attribute request that no service took.
@tier(embedded)
fn refuse(ev: Event, var out: Outbox)
    let empty: Value = Vec.new()
    match ev
        Event.AttrRead(conn, attr, svc) =>
            let _ = out.push(Out.Respond(conn, attr, ATT_READ_NOT_PERMITTED, empty))
        Event.AttrWrite(conn, attr, svc, value) =>
            let _ = out.push(Out.Respond(conn, attr, ATT_WRITE_NOT_PERMITTED, empty))
        _ => ()

// ── A transport: H4 over a UART ─────────────────────────────────────

// The HCI UART Transport Layer on the board's UART, to a Controller on the other side of it: each HCI packet follows its packet
// indicator ([Vol 4] Part A, Section 2).  The bytes that have not yet made a packet are kept in `rx`.
pub struct UartHci
    var rx: [u8]

pub @tier(embedded)
fn uart_hci() -> UartHci
    UartHci { rx: [] }

// How many octets one `recv_packet` takes from the UART before it cuts a packet.
const UART_READ_MAX = 255

impl HciLink[hw, mutate] for UartHci
    @tier(embedded)
    fn send_packet(var self, pkt: [u8]) -> Bool [hw]
        for i in 0..list.len(pkt)
            hal.uart.write_byte(pkt[i] as Int)
        true

    @tier(embedded)
    fn recv_packet(var self, timeout_ms: Int) -> ?[u8] [hw, mutate]
        let _ = timeout_ms
        for _ in 0..UART_READ_MAX
            let b = hal.uart.try_read_byte()
            if b < 0
                break
            list.push(self.rx, b as u8)
        let r = hci_deframer.next_packet(self.rx)
        self.rx = r.new_buf[:]
        match r.packet
            Some(pkt) => Some(pkt[:])
            None => None

// workaround(a-generic-struct-made-by-a-plain-function-never-used-calls-a-generic-of-another-module-that-has-no-specialisation): the
// sketch's `uart_adapter()`, the Adapter over `UartHci` with the default policy and RAM bonds, is a plain function that builds an
// `Adapter<UartHci, DefaultPolicy, RamBonds>`.  In a package no program calls it from, the build stops with "use of undefined value
// '@novo_user_host_api.poll'", because the `step` of that instantiation calls the generic `host_api.poll` and no specialisation of it
// is emitted.  A program writes `adapter(uart_hci(), DefaultPolicy { placeholder: 0 }, RamBonds { rows: Vec.new() })`, as the
// programs of orbit/noble-examples/device do.

// The Host, as the sketch spells it: a program or a service module that takes the Host names it `noble.Host`.
pub alias Host = host.Host
