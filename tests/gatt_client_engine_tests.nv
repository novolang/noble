@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_long_value_is_read_with_blobs_until_a_short_part()
    var t = table()
    var s = server()
    var trace = new_log()
    let _ = gatt_client.begin_read_long(var t, link_a(), 0, 0x0020)
    pump(var t, link_a(), var s, var trace)
    test.assert_eq(trace.statuses, [0])
    test.assert_eq(trace.values[0], ramp(100))
    // One Read Request of 22 octets, then four Read Blob Requests (22, 22,
    // 22 and the last 12).
    test.assert_eq(list.len(trace.sent), 5)
    test.assert_eq(trace.sent[0], [0x0A, 0x20, 0x00])
    test.assert_eq(trace.sent[1], [0x0C, 0x20, 0x00, 22, 0x00])
    test.assert_eq(trace.sent[4], [0x0C, 0x20, 0x00, 88, 0x00])

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
