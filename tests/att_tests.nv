@test
@satisfies("REQ-BLE-ATT-PDU-003")
fn test_find_by_type_value_req_extraction()
    // FBTV start=1 end=0xFFFF uuid=0x2800 value=[0x0A,0x18] (Device Info)
    let req: [u8] = [
