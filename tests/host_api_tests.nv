@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_readvertise_after_a_peripheral_link_ended_is_left_for_the_advertising_code_and_never_connectable_at_the_limit()
    var h = new_host(1)
    var l = script_link()
    var p = test_policy()
    var b = new_store()
    started(var h, var l, var p, var b)
