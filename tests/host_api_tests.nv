@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_a_parameter_request_of_the_peer_is_accepted_or_refused_by_the_policy()
    var h = new_host(2)
    var l = script_link()
    var p = test_policy()
    var b = new_store()
    started(var h, var l, var p, var b)
    list.push(l.inbox, connection_complete(0, 0x41, 1, peer_octets(1)))
    run(var h, var l, var p, var b, 1)
    list.push(l.inbox, remote_request(0x41, 24, 40, 0, 400))
    run(var h, var l, var p, var b, 2)
    test.assert_eq(p.params_asked, 1)
    test.assert_eq(times_sent(l, hci_commands.opcode_le_remote_connection_parameter_request_reply()), 1)
    p.allow_params = false
    list.push(l.inbox, remote_request(0x41, 24, 40, 0, 400))
    run(var h, var l, var p, var b, 2)
    test.assert_eq(p.params_asked, 2)
    test.assert_eq(times_sent(l, hci_commands.opcode_le_remote_connection_parameter_request_negative_reply()), 1)
    // Parameters the specification does not allow are refused without asking the policy.
    p.allow_params = true
    list.push(l.inbox, remote_request(0x41, 40, 24, 0, 400))
    run(var h, var l, var p, var b, 2)
    test.assert_eq(p.params_asked, 2)
    test.assert_eq(times_sent(l, hci_commands.opcode_le_remote_connection_parameter_request_negative_reply()), 2)

@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_update_params_changes_the_connection_and_queues_params_updated()
    var h = new_host(2)
    var l = script_link()
    var p = test_policy()
    var b = new_store()
    started(var h, var l, var p, var b)
    let up = call(var h, var l, var p, var b, Request.Connect(peer_addr(0x55), noble.conn_params_default()))
    test.assert(up.is_ok())
    let conn = host_api.op_conn(h)
    test.assert_eq(next_kind(var h), EV_CONNECTED)
    let want = ConnParams { interval_min: 12, interval_max: 12, latency: 2, timeout: 300 }
    let st = call(var h, var l, var p, var b, Request.UpdateParams(conn, want))
    test.assert(st.is_ok())
    match host_api.conn_info(h, conn)
        Some(info) =>
            test.assert_eq(info.params.interval_min as Int, 12)
            test.assert_eq(info.params.latency as Int, 2)
            test.assert_eq(info.params.timeout as Int, 300)
        None => test.fail("the link has a name")
    match host_api.next_event(var h)
        Some(e) =>
            match e
                ParamsUpdated(c, q) => test.assert_eq(q.timeout as Int, 300)
                _ => test.fail("ParamsUpdated is queued")
        None => test.fail("an event is queued")
    // Parameters the specification refuses are not accepted.
    let bad = ConnParams { interval_min: 4, interval_max: 2, latency: 0, timeout: 400 }
    test.assert(host_api.begin(var h, Request.UpdateParams(conn, bad)).is(noble.LAYER_LOCAL, noble.E_BAD_ARGUMENT))

