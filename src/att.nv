@test
@satisfies("REQ-BLE-ATT-PDU-003")
fn test_prepare_write_req_extraction()
    // PREPARE_WRITE_REQ handle=0x0030 offset=4 value=[0xDE 0xAD]
    let req : [u8] = [
        ATT_OP_PREPARE_WRITE_REQ,
        0x30, 0x00,
        0x04, 0x00,
        0xDE, 0xAD
    ]
    test.assert_eq(read_prepare_write_req_handle(req), 0x0030)
    test.assert_eq(read_prepare_write_req_offset(req), 4)
    let v = read_prepare_write_req_value(req)
    test.assert_eq(list.len(v), 2)
    test.assert_eq(v[0] as Int, 0xDE)
    test.assert_eq(v[1] as Int, 0xAD)

@test
@satisfies("REQ-BLE-ATT-PDU-004")
fn test_prepare_write_rsp_echoes_handle_offset_value()
    let value : [u8] = [0xBE, 0xEF]
    let rsp = build_prepare_write_rsp(0x0030, 4, value)
    test.assert_eq(list.len(rsp), 1 + 2 + 2 + 2)
    test.assert_eq(rsp[0] as Int, ATT_OP_PREPARE_WRITE_RSP)
    test.assert_eq(rsp[1] as Int, 0x30)             // handle lo
    test.assert_eq(rsp[2] as Int, 0x00)             // handle hi
    test.assert_eq(rsp[3] as Int, 0x04)             // offset lo
    test.assert_eq(rsp[4] as Int, 0x00)             // offset hi
    test.assert_eq(rsp[5] as Int, 0xBE)
    test.assert_eq(rsp[6] as Int, 0xEF)

