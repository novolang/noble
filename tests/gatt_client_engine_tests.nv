@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_part_the_peer_refuses_after_one_was_accepted_is_cancelled()
    var t = table()
    var s = server()
    let handle = open_value(var s, 0xAA10)
    var trace = new_log()
    let _ = gatt_client.begin_write_long(var t, link_a(), 0, handle, payload(ramp(60)), 60)
    // The first part goes through; the second is refused.
    var first = exchange(var t, link_a(), 0, var s, 0, var trace)
    deliver(var t, link_a(), 0, first[0], var trace)
    let second = exchange(var t, link_a(), 0, var s, 0, var trace)
    test.assert_eq(list.len(second), 1)
    deliver(var t,
        link_a(),
        0,
        [0x01, 0x16, (handle & 0xFF) as u8, (handle >>> 8) as u8, att.ATT_ERR_PREPARE_QUEUE_FULL],
        var trace)
    // The queue the peer holds is cancelled, and the request ends with the
    // refusal once the cancel is answered.
    test.assert_eq(list.len(trace.statuses), 0)
    let cancel = exchange(var t, link_a(), 0, var s, 0, var trace)
    test.assert_eq(trace.sent[2], [0x18, 0x00])
    deliver(var t, link_a(), 0, cancel[0], var trace)
    test.assert_eq(trace.statuses, [att.ATT_ERR_PREPARE_QUEUE_FULL])
    test.assert_eq(list.len(s.link.prepare_queue), 0)
    test.assert_eq(served(var s, handle), [])

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_first_part_the_peer_refuses_needs_no_cancel()
    var t = table()
    var s = server()
    var trace = new_log()
    let _ = gatt_client.begin_write_long(var t, link_a(), 0, 0x0020, payload(ramp(30)), 30)
    pump(var t, link_a(), var s, var trace)
    test.assert_eq(list.len(trace.sent), 1)
    test.assert_eq(trace.statuses, [att.ATT_ERR_WRITE_NOT_PERMITTED])

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
