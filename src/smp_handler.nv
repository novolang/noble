// smp_handler.nv — SMP L2CAP handler glue.
//
// Composes smp_fsm (state machine + reply-builder) and smp (PDU
// shapes) into the dispatcher main.nv (or the L2CAP-channel
// router) calls when an L2CAP B-frame on CID 0x0006 lands.  Pure
// software — no timing-sensitive code, no hardware dependency.
//
// Architecture:
//
//   main.nv                                     ← receives L2CAP frame
//     │  classify_cid(b_frame_cid(frame)) == 3  ← from l2cap.nv
//     ▼
//   smp_handler.smp_inbound_event_for_opcode(op) ← here
//     │  parses opcode, picks the right SmpPairingEvent
//     ▼
//   smp_fsm.smppairing_step(state, event)       ← FSM transition
//     │  produces SmpPairingState (the new state)
//     ▼
//   smp_fsm.smp_reply_for_state(new_state)      ← in smp_fsm.nv
//     │  builds the reply PDU bytes (or [] if no reply)
//     ▼
//   l2cap.build_b_frame(CID_SMP, reply)         ← back through l2cap
//     │
//     ▼
//   conn_event_dispatch.stage_tx(b_frame)       ← out on the wire
//
// `smp_reply_for_state` lives in smp_fsm.nv (not here) because
// Novo's OCaml backend rejects cross-module pattern matches on
// state-machine variants.  This module owns just the opcode →
// event mapping (function-call composition, no patterns) plus
// the integration tests that walk the full handler.
//
// Satisfies REQ-BLE-SMP-011 (SMP PDU dispatch).

use smp
use smp_fsm

// ── Opcode → SmpPairingEvent mapping ────────────────────────────────
//
// Returns the FSM event that should fire when the dispatcher
// observes the given inbound SMP opcode.  Returns
// `smp_event_host_abort()` for unknown opcodes (we don't model
// "received unsupported PDU" as its own event; treat-as-abort is
// the closest approximation for the FSM's purposes — a real
// dispatcher would also emit a Pairing_Failed("CMD_NOT_SUPPORTED")
// to the peer; that's the caller's job, not the FSM's).

// The event of the pairing state machine that a received SMP command with `opcode` stands for.
pub @tier(embedded)
fn smp_inbound_event_for_opcode(opcode: Int) -> SmpPairingEvent
    match smp.command_of(opcode)
        Some(PairingRequest) => smp_fsm.smp_event_rx_pairing_request()
        Some(PairingConfirm) => smp_fsm.smp_event_rx_pairing_confirm()
        Some(PairingRandom)  => smp_fsm.smp_event_rx_pairing_random()
        Some(PairingFailed)  => smp_fsm.smp_event_rx_pairing_failed()
        _                    => smp_fsm.smp_event_host_abort()
