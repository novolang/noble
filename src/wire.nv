// wire.nv — the integer encodings the measurement and
// control point values of the profile services share.
//
// Every multi-octet field of a GATT characteristic is little-endian, least
// significant octet first ([Vol 3] Part F, Section 3.2.1).  A signed field
// is two's complement.

// Append the low `octets` octets of `v`, least significant first.  A
// negative `v` appends its two's complement.
pub fn put(var out: [u8], v: Int, octets: Int)
    for k in 0..octets
        list.push(out, ((v >>> (8 * k)) & 0xFF) as u8)

// `v` limited to `lo..hi`.
pub fn clamp(v: Int, lo: Int, hi: Int) -> Int
    if v < lo
        lo
    else
        if v > hi
            hi
        else
            v

// The `octets`-octet unsigned integer at `i`, or 0 where `b` is too short.
pub fn get(b: [u8], i: Int, octets: Int) -> Int
    if i + octets > list.len(b)
        return 0
    var v = 0
    for k in 0..octets
        v = v | (b[i + k] as Int << (8 * k))
    v

// The `octets`-octet two's complement integer at `i`.
pub fn get_signed(b: [u8], i: Int, octets: Int) -> Int
    let v = get(b, i, octets)
    let top = 1 << (8 * octets - 1)
    if v >= top
        v - (top << 1)
    else
        v

// The octets of `v`, each element taken modulo 256.
pub fn octets(v: [Int]) -> [u8]
    var out: [u8] = []
    for x in v
        list.push(out, x as u8)
    out

// The octets of the string `s`, for a characteristic that holds text.
pub fn text(s: Str) -> [u8]
    var out: [u8] = []
    for i in 0..str.len(s)
        list.push(out, str.byte_at(s, i) as u8)
    out

// The Date Time of [GSS] 3.70, seven octets on the wire: the year as two
// octets, then the month, the day, the hours, the minutes and the seconds as
// one octet each.  A year, month or day of 0 is "not known".
pub @value
struct DateTime
    year: u16
    month: u8
    day: u8
    hours: u8
    minutes: u8
    seconds: u8

// The Date Time of the six parts.  A part wider than its field keeps its low
// octets, as `put` writes them.
pub @tier(embedded)
@no_alloc
fn date_time(year: Int, month: Int, day: Int, hours: Int, minutes: Int, seconds: Int) -> DateTime
    DateTime { year: year as u16,
        month: month as u8,
        day: day as u8,
        hours: hours as u8,
        minutes: minutes as u8,
        seconds: seconds as u8 }

// The Date Time with every part 0.
pub @tier(embedded)
@no_alloc
fn date_time_unknown() -> DateTime
    DateTime { year: 0, month: 0, day: 0, hours: 0, minutes: 0, seconds: 0 }

// Append the seven octets of `t`.
pub @tier(app)
fn put_date_time(var out: [u8], t: DateTime)
    put(var out, t.year as Int, 2)
    put(var out, t.month as Int, 1)
    put(var out, t.day as Int, 1)
    put(var out, t.hours as Int, 1)
    put(var out, t.minutes as Int, 1)
    put(var out, t.seconds as Int, 1)

// The Date Time at `i`, with 0 in every part where `b` is too short.
pub @tier(embedded)
@no_alloc
fn get_date_time(b: [u8], i: Int) -> DateTime
    date_time(get(b, i, 2),
        get(b, i + 2, 1),
        get(b, i + 3, 1),
        get(b, i + 4, 1),
        get(b, i + 5, 1),
        get(b, i + 6, 1))

// Whether `t` is a Date Time of [GSS] 3.70: a year of 1582 to 9999 or 0 for
// unknown, a month of 1 to 12 or 0, a day of 1 to 31 or 0, and the time of
// day, hours 0 to 23, minutes 0 to 59, seconds 0 to 59.
pub @tier(embedded)
@no_alloc
fn date_time_valid(t: DateTime) -> Bool
    if t.year != 0 and (t.year < 1582 or t.year > 9999)
        return false
    t.month <= 12 and t.day <= 31 and t.hours <= 23 and t.minutes <= 59 and t.seconds <= 59

// Whether `t` is a Date Time with a known year, month and day.
pub @tier(embedded)
@no_alloc
fn date_time_known(t: DateTime) -> Bool
    t.year != 0 and t.month != 0 and t.day != 0 and date_time_valid(t)

// ── IEEE 11073-20601 FLOAT and SFLOAT ───────────────────────────────
//
// The health services carry a decimal number as a signed mantissa and a
// signed power of ten: value = mantissa * 10^exponent.  The 32-bit FLOAT
// ([GSS] medfloat32) has a 24-bit mantissa in bits 0-23 and an 8-bit exponent
// in bits 24-31; the 16-bit SFLOAT (medfloat16) has a 12-bit mantissa in bits
// 0-11 and a 4-bit exponent in bits 12-15.  Both are two's complement.  The
// five mantissas next to the most negative and the most positive one are
// reserved for the special values of [GSS] Table 2.1, so a number has a
// mantissa of -(2^23 - 3) to 2^23 - 3 (FLOAT) or -2045 to 2045 (SFLOAT).
//
// A raw value is the unsigned Int of its octets, as `put` writes it and `get`
// reads it: `put(out, float(364, -1), 4)` appends the temperature 36.4.

// The raw 32-bit FLOAT that stands for NaN ([GSS] Table 2.1).
pub const FLOAT_NAN = 0x007FFFFF
// The raw 32-bit FLOAT that stands for +INFINITY ([GSS] Table 2.1).
pub const FLOAT_POSITIVE_INFINITY = 0x007FFFFE
// The raw 32-bit FLOAT that stands for NRes (not at this resolution) ([GSS] Table 2.1).
pub const FLOAT_NRES = 0x00800000
// The raw 32-bit FLOAT that stands for the reserved value ([GSS] Table 2.1).
pub const FLOAT_RESERVED = 0x00800001
// The raw 32-bit FLOAT that stands for -INFINITY ([GSS] Table 2.1).
pub const FLOAT_NEGATIVE_INFINITY = 0x00800002

// The raw 16-bit SFLOAT that stands for NaN ([GSS] Table 2.1).
pub const SFLOAT_NAN = 0x07FF
// The raw 16-bit SFLOAT that stands for +INFINITY ([GSS] Table 2.1).
pub const SFLOAT_POSITIVE_INFINITY = 0x07FE
// The raw 16-bit SFLOAT that stands for NRes (not at this resolution) ([GSS] Table 2.1).
pub const SFLOAT_NRES = 0x0800
// The raw 16-bit SFLOAT that stands for the reserved value ([GSS] Table 2.1).
pub const SFLOAT_RESERVED = 0x0801
// The raw 16-bit SFLOAT that stands for -INFINITY ([GSS] Table 2.1).
pub const SFLOAT_NEGATIVE_INFINITY = 0x0802

// The largest mantissa of a FLOAT that is a number.
pub const FLOAT_MANTISSA_MAX = 8388605
const FLOAT_EXPONENT_MIN = -128
const FLOAT_EXPONENT_MAX = 127
const SFLOAT_MANTISSA_MAX = 2045
const SFLOAT_EXPONENT_MIN = -8
const SFLOAT_EXPONENT_MAX = 7

// What a raw FLOAT or SFLOAT holds, as `float_kind` and `sfloat_kind` answer.
pub const KIND_NUMBER = 0
// The raw FLOAT or SFLOAT is NaN.
pub const KIND_NAN = 1
// The raw FLOAT or SFLOAT is +INFINITY.
pub const KIND_POSITIVE_INFINITY = 2
// The raw FLOAT or SFLOAT is -INFINITY.
pub const KIND_NEGATIVE_INFINITY = 3
// The raw FLOAT or SFLOAT is NRes (not at this resolution).
pub const KIND_NRES = 4
// The raw FLOAT or SFLOAT is the reserved value.
pub const KIND_RESERVED = 5

// 10^n for n of 0 to 18, the powers an Int holds.
@tier(embedded)
@no_alloc
fn pow10(n: Int) -> Int
    var p = 1
    for _ in 0..n
        p = p * 10
    p

@tier(embedded)
@no_alloc
fn magnitude(v: Int) -> Int
    if v < 0
        -v
    else
        v

// `m` divided by 10^k and rounded to the nearest integer, halves away from
// zero; 0 for a k above 18, where nothing of `m` is left.
@tier(embedded)
@no_alloc
fn drop_digits(m: Int, k: Int) -> Int
    if k > 18
        return 0
    let d = pow10(k)
    let q = (magnitude(m) + d / 2) / d
    if m < 0
        -q
    else
        q

// The number of digits `mantissa * 10^exponent` loses to fit a mantissa of at
// most `limit` and an exponent of at least `exponent_min`.  Each is rounded
// once, from the original mantissa, so 2044.49 becomes 2044, not 2045.
@tier(embedded)
@no_alloc
fn digits_lost(mantissa: Int, exponent: Int, limit: Int, exponent_min: Int) -> Int
    let first = if exponent < exponent_min
        exponent_min - exponent
    else
        0
    for step in 0..19
        let k = first + step
        if k > 18 or magnitude(drop_digits(mantissa, k)) <= limit
            return k
    19

// `value` in the `bits` low bits, two's complement.
@tier(embedded)
@no_alloc
fn field(value: Int, bits: Int) -> Int
    value & ((1 << bits) - 1)

// The low `bits` bits of `raw` read as a two's complement number.
@tier(embedded)
@no_alloc
fn signed_field(raw: Int, bits: Int) -> Int
    let v = field(raw, bits)
    if v >= (1 << (bits - 1))
        v - (1 << bits)
    else
        v

// The FLOAT of `mantissa * 10^exponent`.  A mantissa that is too large for 24
// bits loses its low digits (rounded once, halves away from zero) and the
// exponent grows by as many; an exponent below -128 does the same; an
// exponent above 127 multiplies the mantissa by ten as often as that fits.
// A number that does not fit then is the positive or the negative infinity,
// and one that rounds to zero, or zero itself, is 0.
pub @tier(embedded)
@no_alloc
fn float(mantissa: Int, exponent: Int) -> Int
    if mantissa == 0
        return 0
    let k = digits_lost(mantissa, exponent, FLOAT_MANTISSA_MAX, FLOAT_EXPONENT_MIN)
    let m = drop_digits(mantissa, k)
    if m == 0
        return 0
    let e = exponent + k
    if e > FLOAT_EXPONENT_MAX
        let j = e - FLOAT_EXPONENT_MAX
        if j > 18 or magnitude(m) > FLOAT_MANTISSA_MAX / pow10(j)
            return if m < 0 then FLOAT_NEGATIVE_INFINITY else FLOAT_POSITIVE_INFINITY
        return (field(FLOAT_EXPONENT_MAX, 8) << 24) | field(m * pow10(j), 24)
    (field(e, 8) << 24) | field(m, 24)

// The SFLOAT of `mantissa * 10^exponent`, brought into range as `float` does,
// with a 12-bit mantissa and an exponent of -8 to 7.
pub @tier(embedded)
@no_alloc
fn sfloat(mantissa: Int, exponent: Int) -> Int
    if mantissa == 0
        return 0
    let k = digits_lost(mantissa, exponent, SFLOAT_MANTISSA_MAX, SFLOAT_EXPONENT_MIN)
    let m = drop_digits(mantissa, k)
    if m == 0
        return 0
    let e = exponent + k
    if e > SFLOAT_EXPONENT_MAX
        let j = e - SFLOAT_EXPONENT_MAX
        if j > 18 or magnitude(m) > SFLOAT_MANTISSA_MAX / pow10(j)
            return if m < 0 then SFLOAT_NEGATIVE_INFINITY else SFLOAT_POSITIVE_INFINITY
        return (field(SFLOAT_EXPONENT_MAX, 4) << 12) | field(m * pow10(j), 12)
    (field(e, 4) << 12) | field(m, 12)

// What the 32-bit `raw` holds: a number or one of the five special values.
// The special values are told by the mantissa; the exponent is not looked at.
pub @tier(embedded)
@no_alloc
fn float_kind(raw: Int) -> Int
    let m = field(raw, 24)
    if m == FLOAT_NAN
        return KIND_NAN
    if m == FLOAT_POSITIVE_INFINITY
        return KIND_POSITIVE_INFINITY
    if m == FLOAT_NEGATIVE_INFINITY
        return KIND_NEGATIVE_INFINITY
    if m == FLOAT_NRES
        return KIND_NRES
    if m == FLOAT_RESERVED
        return KIND_RESERVED
    KIND_NUMBER

// What the 16-bit `raw` holds.
pub @tier(embedded)
@no_alloc
fn sfloat_kind(raw: Int) -> Int
    let m = field(raw, 12)
    if m == SFLOAT_NAN
        return KIND_NAN
    if m == SFLOAT_POSITIVE_INFINITY
        return KIND_POSITIVE_INFINITY
    if m == SFLOAT_NEGATIVE_INFINITY
        return KIND_NEGATIVE_INFINITY
    if m == SFLOAT_NRES
        return KIND_NRES
    if m == SFLOAT_RESERVED
        return KIND_RESERVED
    KIND_NUMBER

// The signed mantissa and the signed exponent of a FLOAT or an SFLOAT.
pub @tier(embedded)
@no_alloc
fn float_mantissa(raw: Int) -> Int
    signed_field(raw, 24)

@tier(embedded)
@no_alloc
fn float_exponent(raw: Int) -> Int
    signed_field(raw >>> 24, 8)

// The signed 12-bit mantissa of the raw SFLOAT `raw`.
pub @tier(embedded)
@no_alloc
fn sfloat_mantissa(raw: Int) -> Int
    signed_field(raw, 12)

// The signed 4-bit exponent of the raw SFLOAT `raw`.
pub @tier(embedded)
@no_alloc
fn sfloat_exponent(raw: Int) -> Int
    signed_field(raw >>> 12, 4)

// `mantissa * 10^exponent` times 10^decimals as an integer, rounded once, halves
// away from zero: 36.4 with one decimal is 364, with none 36.  A result beyond
// 10^15 is limited to it, and one below 10^-18 is 0.
@tier(embedded)
@no_alloc
fn scaled(mantissa: Int, exponent: Int, decimals: Int) -> Int
    let shift = exponent + decimals
    if shift < 0
        return drop_digits(mantissa, -shift)
    if mantissa == 0
        return 0
    if shift > 15
        return if mantissa < 0 then -1000000000000000 else 1000000000000000
    clamp(mantissa * pow10(shift), -1000000000000000, 1000000000000000)

// The number the FLOAT `raw` holds times 10^decimals; 0 for a special value,
// which `float_kind` tells apart.
pub @tier(embedded)
@no_alloc
fn float_scaled(raw: Int, decimals: Int) -> Int
    if float_kind(raw) != KIND_NUMBER
        return 0
    scaled(float_mantissa(raw), float_exponent(raw), decimals)

// The same for an SFLOAT.
pub @tier(embedded)
@no_alloc
fn sfloat_scaled(raw: Int, decimals: Int) -> Int
    if sfloat_kind(raw) != KIND_NUMBER
        return 0
    scaled(sfloat_mantissa(raw), sfloat_exponent(raw), decimals)
