@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_notification_arrives_while_a_request_is_outstanding()
    var t = table()
    var s = server()
    subscribe(var t, link_a(), var s, gatt_client.CCCD_NOTIFY)
    var trace = new_log()
    let read = gatt_client.begin_read(var t, link_a(), 0, 0x001A)
    let answers = exchange(var t, link_a(), 0, var s, 0, var trace)
    for pdu in gatt_server.send_value(var s.db, var s.link, 0x001C, 0)
        deliver(var t, link_a(), 0, pdu, var trace)
    deliver(var t, link_a(), 0, answers[0], var trace)
    test.assert_eq(trace.events, [gatt_client.EV_NOTIFICATION, gatt_client.EV_DONE])
    test.assert_eq(trace.tickets, [read])

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_pdu_for_the_server_role_is_not_the_clients()
