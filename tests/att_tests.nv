@test
fn test_is_m6_request_classification()
    test.assert_eq(is_m6_request(ATT_OP_WRITE_REQ), true)
    test.assert_eq(is_m6_request(ATT_OP_PREPARE_WRITE_REQ), true)
    test.assert_eq(is_m6_request(ATT_OP_EXECUTE_WRITE_REQ), true)
    test.assert_eq(is_m6_request(ATT_OP_HANDLE_VALUE_CFM), true)
    test.assert_eq(is_m6_request(ATT_OP_READ_REQ), false)   // read side
    test.assert_eq(is_m6_request(ATT_OP_HANDLE_VALUE_NTF), false)   // server-emitted

@test
fn test_a_request_too_short_for_its_fields_reads_as_minus_one_or_empty()
    test.assert_eq(att.read_read_by_type_req_start([0x08, 0x01]), -1)
    test.assert_eq(att.read_read_by_type_req_end([0x08, 0x01]), -1)
    // A type of 3 octets is neither a 16-bit nor a 128-bit UUID.
    test.assert_eq(att.read_read_by_type_req_type16([0x08, 0x01, 0x00, 0xFF, 0xFF, 0xAA, 0xBB, 0xCC]), -1)
    test.assert_eq(att.read_read_by_type_req_type16([0x08, 0x01, 0x00, 0xFF, 0xFF, 0x00, 0x28]), 0x2800)
    test.assert_eq(att.read_write_req_handle([0x12, 0x03]), -1)
    test.assert_eq(att.read_write_req_handle([0x12, 0x03, 0x00]), 3)
    test.assert_eq(list.len(att.read_write_req_value([0x12, 0x03])), 0)
    test.assert_eq(list.len(att.read_write_req_value([0x12, 0x03, 0x00, 0x44, 0x55])), 2)
    test.assert_eq(att.read_prepare_write_req_handle([0x16, 0x03, 0x00, 0x00]), -1)
    test.assert_eq(att.read_prepare_write_req_offset([0x16, 0x03, 0x00, 0x00]), -1)
    test.assert_eq(list.len(att.read_prepare_write_req_value([0x16, 0x03, 0x00, 0x00])), 0)
    test.assert_eq(att.read_prepare_write_req_handle([0x16, 0x03, 0x00, 0x05, 0x00, 0x77]), 3)
    test.assert_eq(att.read_prepare_write_req_offset([0x16, 0x03, 0x00, 0x05, 0x00, 0x77]), 5)
    test.assert_eq(att.read_execute_write_req_flags([0x18]), -1)
    test.assert_eq(att.read_execute_write_req_flags([0x18, 0x01]), 1)
    test.assert_eq(att.read_exchange_mtu_req_mtu([0x02, 0x17]), -1)
    test.assert_eq(att.read_exchange_mtu_req_mtu([0x02, 0x17, 0x00]), 23)

@test
fn test_the_opcode_flags_and_the_confirmation_pdu()
    test.assert(att.opcode_is_command(0x52))
    test.assert(not att.opcode_is_command(0x12))
    test.assert(att.opcode_is_signed(0xD2))
    test.assert(not att.opcode_is_signed(0x52))
    test.assert_eq(att.build_handle_value_cfm()[0] as Int, att.ATT_OP_HANDLE_VALUE_CFM)
    test.assert_eq(list.len(att.build_handle_value_cfm()), 1)
