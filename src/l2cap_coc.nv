// l2cap_coc.nv — the connection-oriented L2CAP channels of one
// LE-U logical link: LE Credit Based Flow Control mode ([Vol 3] Part A,
// Section 10.1) and Enhanced Credit Based Flow Control mode (Section
// 10.2).
//
// A channel is created by an exchange of signaling packets on the LE
// signaling channel, CID 0x0005: L2CAP_LE_CREDIT_BASED_CONNECTION_REQ
// (code 0x14) and _RSP (code 0x15) for one channel (Sections 4.22 and
// 4.23), or L2CAP_CREDIT_BASED_CONNECTION_REQ (0x17) and _RSP (0x18) for
// up to five channels (Sections 4.25 and 4.26).  Each endpoint names its
// own Source CID for the channel, and the two CIDs are its two endpoints:
// a K-frame is sent to the peer's CID.  The CIDs come from the
// dynamically allocated range of an LE-U logical link, 0x0040 to 0x007F
// (Table 2.3), and no two channels of the link share one.
//
// At creation each side gives the other a count of credits: the number of
// K-frames it may send on the channel before the next grant.  A K-frame
// spends one credit (Section 10.1); the receiver gives credits back with
// L2CAP_FLOW_CONTROL_CREDIT_IND (code 0x16, Section 4.24) and a credit
// count above 65535 ends the channel.  The SDU a K-frame carries is
// bounded by the receiver's MTU and its PDU by the receiver's MPS
// (Section 3.4.3): the first K-frame of an SDU holds the SDU Length field
// and then as much of the SDU as MPS - 2 octets, every further K-frame as
// much as MPS octets.
//
// A channel ends with L2CAP_DISCONNECTION_REQ and _RSP (codes 0x06 and
// 0x07, Sections 4.6 and 4.7): the side that asks names the peer's CID as
// the Destination CID and its own as the Source CID.  A Destination CID
// the receiver does not know is answered with L2CAP_COMMAND_REJECT_RSP,
// Invalid CID in request (Section 4.1); one that is known but whose Source
// CID does not match the channel is discarded silently (Section 4.6).
//
// The module is the channel table of one logical link and nothing else: it
// performs no I/O, holds no clock and knows nothing of HCI.  It answers
// what it receives with the packets and K-frames to send, each with the
// CID it goes to, and reports what happened to the upper layer as
// `CocEvent` values.  The caller writes the packets, so one implementation
// serves the PC program and a device image alike.
//
// Chosen where the specification leaves a choice: a signaling request this
// Host sends is not retransmitted, so no RTX timer runs (Section 6.2.1);
// a case that needed the retransmission would show it as a response that
// never comes.  The signaling Identifier of what this module sends comes
// from its own counter, and the one of the connection parameter update
// request from `le_link.nv`; responses are matched by their code as
// well as their Identifier (Section 4).
//
// Satisfies: REQ-BLE-L2CAP-008 (connection request), -009 (connection
// response), -010 (flow control credit), -011 and -012 (disconnection),
// -013 (MPS), -014 (SDU segmentation), -015 (SDU reassembly), -023 (one
// K-frame per credit), -026 (K-frame boundary errors).

use l2cap

// ── Result values ───────────────────────────────────────────────────
//
// The Result field of L2CAP_LE_CREDIT_BASED_CONNECTION_RSP ([Vol 3]
// Part A, Table 4.16).  The enhanced response of Table 4.17 uses the same
// values with the meanings its own table gives them: 0x0004, 0x0009 and
// 0x000A speak of some connections refused rather than all.

const RESULT_SUCCESS = 0x0000
// The connection result LE_PSM not supported.
pub const RESULT_SPSM_NOT_SUPPORTED = 0x0002
const RESULT_NO_RESOURCES = 0x0004
const RESULT_INSUFFICIENT_AUTHENTICATION = 0x0005
const RESULT_INSUFFICIENT_AUTHORIZATION = 0x0006
const RESULT_KEY_SIZE_TOO_SHORT = 0x0007
const RESULT_INSUFFICIENT_ENCRYPTION = 0x0008
const RESULT_INVALID_SOURCE_CID = 0x0009
const RESULT_SOURCE_CID_ALLOCATED = 0x000A
const RESULT_UNACCEPTABLE_PARAMETERS = 0x000B

// The Result field of L2CAP_CREDIT_BASED_RECONFIGURE_RSP (Table 4.18).
const RECONFIGURE_SUCCESS = 0x0000
const RECONFIGURE_MTU_REDUCED = 0x0001
const RECONFIGURE_MPS_REDUCED = 0x0002
const RECONFIGURE_INVALID_CID = 0x0003
const RECONFIGURE_UNACCEPTABLE = 0x0004

// The Response of the first Listen command for a PSM, when the PSM is
// listened on and the connection accepted (auto-pts doc/btp_l2cap.txt,
// Listen): the service's own value, not an L2CAP Result.  This Host bases
// the answer to a connection request on the PSM on it, which the BTP
// document allows, so `listen_result` maps the other values; 0x00 accepts.
pub const LISTEN_SUCCESS = 0x00

// ── CIDs and sizes ──────────────────────────────────────────────────

// The null CID ([Vol 3] Part A, Section 2.1) and the dynamically
// allocated CIDs of an LE-U logical link (Table 2.3).
const CID_NONE = 0x0000
const CID_FIRST_DYNAMIC = 0x0040
const CID_LAST_DYNAMIC = 0x007F

// The smallest MTU and MPS an LE Credit Based channel may be created with,
// and the smallest of an Enhanced Credit Based one ([Vol 3] Part A,
// Sections 4.22 and 4.25).
const MIN_MTU = 23
const MIN_MPS = 23
const MIN_MTU_ENHANCED = 64
const MIN_MPS_ENHANCED = 64

// The largest credit count either side may hold ([Vol 3] Part A,
// Section 10.1).
const MAX_CREDITS = 65535

// The most Source CIDs an L2CAP_CREDIT_BASED_CONNECTION_REQ may carry
// (Section 4.25) and the most channels this Host keeps on one link.
pub const MAX_SCIDS = 5
const MAX_CHANNELS = 5

// The credits a channel is created with, in the Request and in the
// Response alike.  The value is this Host's choice within 0 to 65535 for
// LE Credit Based mode and 1 to 65535 for Enhanced Credit Based mode
// (Sections 4.22 and 4.25).
const INITIAL_CREDITS = 10

// The largest number of K-frames one flush sends.  The loop behind it ends
// when the credits or the queued SDUs run out; the bound keeps a single
// call bounded and a later call continues where this one stopped.
const MAX_FLUSH_FRAMES = 128

// ── The channel table ───────────────────────────────────────────────

// One channel.  `id` is its number towards the upper layer, the smallest
// one not in use; `local_cid` and `remote_cid` are its two endpoints on
// this logical link, this Host's own and the peer's.  `mtu` and `mps` are
// what this Host may receive, `peer_mtu` and `peer_mps` what the peer may
// receive; `credits` counts the K-frames the peer may still send and
// `peer_credits` the K-frames this Host may still send.  `owed` counts the
// credits that received K-frames spent and that were not given back yet,
// which `hold_credits` keeps until the upper layer asks for them.  `rx`
// holds the SDU being reassembled and `rx_want` its announced length, -1
// when no SDU is open; `tx` holds the SDUs the upper layer asked to send
// and `tx_at` how many octets of the first one have gone out.  While the
// channel is `connecting`, `request_id` is the Identifier of the request
// that opened it, which the response must carry ([Vol 3] Part A, Section 4).
pub struct CocChannel
    id: Int
    local_cid: Int
    var remote_cid: Int
    psm: Int
    var mtu: Int
    var mps: Int
    var peer_mtu: Int
    var peer_mps: Int
    var credits: Int
    var peer_credits: Int
    var owed: Int
    hold_credits: Bool
    enhanced: Bool
    var connecting: Bool
    request_id: Int
    var disconnecting: Bool
    var rx: [u8]
    var rx_want: Int
    var tx: [[u8]]
    var tx_at: Int

// A PSM the upper layer listens on, as the last Listen command named it.
struct CocListener
    psm: Int
    transport: Int
    mtu: Int
    response: Int

// What the channel table reports to the upper layer: a channel is up, a
// channel is gone with the Result of the exchange that ended it, an SDU
// arrived, or the peer renegotiated the MTU and MPS it receives.
enum CocEvent
    Connected(id: Int, psm: Int)
    Disconnected(id: Int, psm: Int, result: Int)
    DataReceived(id: Int, sdu: [u8])
    Reconfigured(id: Int, mtu: Int, mps: Int)

// One packet to send: `payload` on `cid` — a signaling packet on the LE
// signaling channel, or a K-frame on one of the channel's CIDs.
pub struct CocOut
    cid: Int
    payload: [u8]

// The channel table of one logical link, its listeners, what it has to
// report to the upper layer, and the counter behind the Identifiers of the
// signaling packets it sends (Section 4: a command of one channel table
// uses a different Identifier for each successive request, never 0x00).
pub struct CocState
    var channels: [CocChannel]
    var listeners: [CocListener]
    var events: [CocEvent]
    var identifier: Int
    var reconfiguring: [Int]
    var reconfigure_mtu: Int
    var reconfigure_mps: Int

// The credit based channel state of a link: no channel, no listener and no event.
pub fn new_state() -> CocState
    CocState { channels: [],
        listeners: [],
        events: [],
        identifier: 0,
        reconfiguring: [],
        reconfigure_mtu: 0,
        reconfigure_mps: 0 }

// Take what happened since the last call, in order.
fn take_events(var state: CocState) -> [CocEvent]
    let events = state.events[:]
    state.events = []
    events

// The next signaling Identifier, never 0x00 ([Vol 3] Part A, Section 4).
fn next_identifier(var state: CocState) -> Int
    let next = if state.identifier >= 0xFF
        1
    else
        state.identifier + 1
    state.identifier = next
    next

// The index of the channel with this number towards the upper layer, or
// -1.  A write into a channel goes through a `var` name holding the
// element of this index, which is what reaches the table.
pub fn index_of(state: CocState, id: Int) -> Int
    for i in 0..list.len(state.channels)
        if state.channels[i].id == id
            return i
    -1

// The index of the channel whose own endpoint is `cid`, or -1.
fn index_of_cid(state: CocState, cid: Int) -> Int
    for i in 0..list.len(state.channels)
        if state.channels[i].local_cid == cid
            return i
    -1

// The index of the channel whose peer endpoint is `cid`, or -1: the
// channel a signaling packet of the peer names, since the CID such a
// packet carries is the peer's own endpoint of it ([Vol 3] Part A,
// Section 4.24).
fn index_of_remote_cid(state: CocState, cid: Int) -> Int
    for i in 0..list.len(state.channels)
        if state.channels[i].remote_cid == cid
            return i
    -1

// The channel with the local CID `id`, or None when the link has none.
pub fn channel_of(state: CocState, id: Int) -> ?CocChannel
    let i = index_of(state, id)
    if i < 0
        None
    else
        Some(state.channels[i])

// The channels of `psm` that are up, in the order the table created them:
// the ones an upper layer that serves a listened PSM has to serve now.
// An ATT bearer of the Enhanced ATT PSM is one such channel ([Vol 3]
// Part G, Section 5.3), and the connection and disconnection reports of
// the others stay in `events` for the upper layer that reads them there.
pub fn channels_of_psm(state: CocState, psm: Int) -> [CocChannel]
    var out: [CocChannel] = []
    for c in state.channels
        if c.psm == psm and not c.connecting and not c.disconnecting
            list.push(out, c)
    out

// The number towards the upper layer of the channel whose own endpoint is
// `cid`, or -1: what an upper layer that met a channel by the CID of a
// B-frame needs to name it.
fn id_of_local_cid(state: CocState, cid: Int) -> Int
    let i = index_of_cid(state, cid)
    if i < 0
        -1
    else
        state.channels[i].id

// Take the SDU the table reported for the channel `id`, or None when no
// SDU did: what an upper layer that serves the channel's data takes for
// itself.  Every other event, a connection or disconnection report among
// them, stays for `take_events`.
pub fn take_data(var state: CocState, id: Int) -> ?[u8]
    var rest: [CocEvent] = []
    var found: ?[u8] = None
    var taken = false
    for e in state.events
        match e
            CocEvent.DataReceived(channel, sdu) =>
                if channel == id and not taken
                    found = Some(sdu)
                    taken = true
                else
                    list.push(rest, e)
            _                                   => list.push(rest, e)
    state.events = rest
    found

fn has_remote_cid(state: CocState, cid: Int) -> Bool
    for c in state.channels
        if c.remote_cid == cid
            return true
    false

fn has_id(state: CocState, id: Int) -> Bool
    for c in state.channels
        if c.id == id
            return true
    false

// A CID from the dynamically allocated range that no channel of this link
// uses ([Vol 3] Part A, Table 2.3 and Section 4.22).
fn free_local_cid(state: CocState) -> Int
    var cid = CID_FIRST_DYNAMIC
    for _ in 0..CID_LAST_DYNAMIC - CID_FIRST_DYNAMIC + 1
        var used = false
        for c in state.channels
            if c.local_cid == cid
                used = true
        if not used
            return cid
        cid = cid + 1
    CID_NONE

// The smallest channel number the upper layer does not hold.
fn free_id(state: CocState) -> Int
    var id = 0
    for _ in 0..MAX_CHANNELS
        if not has_id(state, id)
            return id
        id = id + 1
    -1

// How many channels the table holds.
fn count(state: CocState) -> Int
    list.len(state.channels)

// The numbers of the channels whose request is still out, in the order
// they were created: what the upper layer gets back from `connect`.
fn connecting_ids(state: CocState) -> [Int]
    var ids: [Int] = []
    for c in state.channels
        if c.connecting
            list.push(ids, c.id)
    ids

// True when the channel `id` is open.
pub fn is_connected(state: CocState, id: Int) -> Bool
    match channel_of(state, id)
        None    => false
        Some(c) => not c.connecting and not c.disconnecting

// Drop the channel at `i` from the table and report it gone with `result`.
fn remove(var state: CocState, i: Int, result: Int)
    let c = state.channels[i]
    var rest: [CocChannel] = []
    for j in 0..list.len(state.channels)
        if j != i
            list.push(rest, state.channels[j])
    state.channels = rest
    let _ = list.push(state.events, CocEvent.Disconnected(c.id, c.psm, result))

// Every channel of the link is gone: the connection ended ([Vol 3] Part A,
// Section 6; REQ-BLE-L2CAP-024).
fn drop_all(var state: CocState)
    for c in state.channels
        if not c.connecting
            list.push(state.events, CocEvent.Disconnected(c.id, c.psm, RESULT_SUCCESS))
    state.channels = []

// ── Listeners ───────────────────────────────────────────────────────

// Listen on `psm` from now on, with the MTU and the response the last
// Listen command named.
pub fn listen(var state: CocState, psm: Int, transport: Int, mtu: Int, response: Int)
    var rest: [CocListener] = []
    for i in 0..list.len(state.listeners)
        if state.listeners[i].psm != psm
            list.push(rest, state.listeners[i])
    list.push(rest, CocListener { psm: psm, transport: transport, mtu: mtu, response: response })
    state.listeners = rest

fn listener_for(state: CocState, psm: Int) -> ?CocListener
    for l in state.listeners
        if l.psm == psm
            return Some(l)
    None

// The Result a request on a listened PSM is answered with: the response
// the Listen command set, as an L2CAP Result ([Vol 3] Part A, Table 4.16).
fn listen_result(response: Int) -> Int
    if response == LISTEN_SUCCESS
        RESULT_SUCCESS
    else if response == 0x01
        RESULT_INSUFFICIENT_AUTHENTICATION
    else if response == 0x02
        RESULT_INSUFFICIENT_AUTHORIZATION
    else if response == 0x03
        RESULT_KEY_SIZE_TOO_SHORT
    else
        RESULT_INSUFFICIENT_ENCRYPTION

// ── Packets ─────────────────────────────────────────────────────────

fn le16(v: Int) -> [u8]
    [(v & 0xFF) as u8, ((v >>> 8) & 0xFF) as u8]

fn read_le16(b: [u8], at: Int) -> Int
    b[at] as Int | (b[at + 1] as Int << 8)

// One signaling packet: Code, Identifier, Data Length and Data.
fn signal(code: Int, identifier: Int, body: [u8]) -> CocOut
    var data: [u8] = [code as u8, identifier as u8]
    list.append(data, le16(list.len(body)))
    list.append(data, body)
    CocOut { cid: l2cap.CID_LE_SIGNALING, payload: data }

// The Data of a signaling packet ([Vol 3] Part A, Section 4): empty when
// the buffer is not correctly formed, which the caller answers with
// L2CAP_COMMAND_REJECT_RSP, Command not understood.
fn signaling_data(payload: [u8]) -> [u8]
    let n = list.len(payload)
    if n < l2cap.SIGNALING_HEADER_LEN
        return []
    if read_le16(payload, 2) != n - l2cap.SIGNALING_HEADER_LEN
        return []
    payload[l2cap.SIGNALING_HEADER_LEN:n]

// L2CAP_LE_CREDIT_BASED_CONNECTION_RSP ([Vol 3] Part A, Section 4.23).
// The Destination CID, MTU, MPS and Initial Credits are ignored by the
// receiver when the Result refuses the connection, and are sent as zero
// then.
fn build_connection_rsp(identifier: Int, local_cid: Int, mtu: Int, mps: Int, credits: Int,
                        result: Int) -> CocOut
    var body: [u8] = []
    if result == RESULT_SUCCESS
        list.append(body, le16(local_cid))
        list.append(body, le16(mtu))
        list.append(body, le16(mps))
        list.append(body, le16(credits))
    else
        list.append(body, le16(CID_NONE))
        list.append(body, le16(0))
        list.append(body, le16(0))
        list.append(body, le16(0))
    list.append(body, le16(result))
    signal(l2cap.CODE_LE_CREDIT_BASED_CONNECTION_RSP, identifier, body)

// L2CAP_FLOW_CONTROL_CREDIT_IND ([Vol 3] Part A, Section 4.24): the CID
// "represents the source channel endpoint of the device sending the
// L2CAP_FLOW_CONTROL_CREDIT_IND packet", so it is this Host's own endpoint
// of the channel -- the CID the peer addresses its K-frames to.  The
// credit value is between 1 and 65535.  One command serves both modes:
// "A device shall send an L2CAP_FLOW_CONTROL_CREDIT_IND packet when it is
// capable of receiving additional K-frames ... in LE Credit Based Flow
// Control mode and Enhanced Credit Based Flow Control mode", and the
// signaling codes of Section 4 hold no other credit command (0x19 is
// L2CAP_CREDIT_BASED_RECONFIGURE_REQ, Section 4.27), so a channel of the
// GATT feature's Enhanced ATT bearer, which is an Enhanced Credit Based
// one, carries this same code.
fn build_credit_ind(identifier: Int, local_cid: Int, credits: Int) -> CocOut
    var body = le16(local_cid)
    list.append(body, le16(credits))
    signal(l2cap.CODE_FLOW_CONTROL_CREDIT_IND, identifier, body)

// L2CAP_DISCONNECTION_REQ and _RSP ([Vol 3] Part A, Sections 4.6 and 4.7):
// the Destination CID is the peer's endpoint of the channel, the Source
// CID this Host's.
fn build_disconnection(code: Int, identifier: Int, destination_cid: Int, source_cid: Int) -> CocOut
    var body = le16(destination_cid)
    list.append(body, le16(source_cid))
    signal(code, identifier, body)

// ── Creating a channel from this side ───────────────────────────────

fn new_channel(id: Int, local_cid: Int, remote_cid: Int, psm: Int, mtu: Int, mps: Int,
               peer_mtu: Int, peer_mps: Int, peer_credits: Int, hold_credits: Bool, enhanced: Bool,
               connecting: Bool, request_id: Int) -> CocChannel
    CocChannel {
        id: id,
        local_cid: local_cid,
        remote_cid: remote_cid,
        psm: psm,
        mtu: mtu,
        mps: mps,
        peer_mtu: peer_mtu,
        peer_mps: peer_mps,
        credits: INITIAL_CREDITS,
        peer_credits: peer_credits,
        owed: 0,
        hold_credits: hold_credits,
        enhanced: enhanced,
        connecting: connecting,
        request_id: request_id,
        disconnecting: false,
        rx: [],
        rx_want: -1,
        tx: [],
        tx_at: 0 }

// Send L2CAP_LE_CREDIT_BASED_CONNECTION_REQ or L2CAP_CREDIT_BASED_
// CONNECTION_REQ for `num` channels on `psm` ([Vol 3] Part A, Sections
// 4.22 and 4.25), or None when the table has no room for them.  The
// channels stay `connecting` until the peer's response arrives; the upper
// layer already has their numbers.
fn connect(var state: CocState, psm: Int, mtu: Int, num: Int, ecfc: Bool,
           hold_credit: Bool) -> ?[CocOut]
    let want = if num < 1
        1
    else
        if num > MAX_SCIDS
            MAX_SCIDS
        else
            num
    let many = ecfc or want > 1
    let mtu_wanted = if many and mtu < MIN_MTU_ENHANCED
        MIN_MTU_ENHANCED
    else
        mtu
    let mps_wanted = if many and mtu_wanted < MIN_MPS_ENHANCED
        MIN_MPS_ENHANCED
    else
        mtu_wanted
    if count(state) + want > MAX_CHANNELS
        return None
    var cids: [Int] = []
    let identifier = next_identifier(var state)
    for _ in 0..want
        let cid = free_local_cid(state)
        let id = free_id(state)
        if cid == CID_NONE or id < 0
            return None
        list.push(state.channels, new_channel(id,
            cid,
            CID_NONE,
            psm,
            mtu_wanted,
            mps_wanted,
            0,
            0,
            0,
            hold_credit,
            many,
            true,
            identifier))
        list.push(cids, cid)
    var body: [u8] = []
    if many
        list.append(body, le16(psm))
        list.append(body, le16(mtu_wanted))
        list.append(body, le16(mps_wanted))
        list.append(body, le16(INITIAL_CREDITS))
        for cid in cids
            list.append(body, le16(cid))
    else
        list.append(body, le16(psm))
        list.append(body, le16(cids[0]))
        list.append(body, le16(mtu_wanted))
        list.append(body, le16(mps_wanted))
        list.append(body, le16(INITIAL_CREDITS))
    let code = if many
        l2cap.CODE_CREDIT_BASED_CONNECTION_REQ
    else
        l2cap.CODE_LE_CREDIT_BASED_CONNECTION_REQ
    Some([signal(code, identifier, body)])

// Create a channel that answers a request from the peer: its endpoint is a
// free CID of this link and its number the smallest the upper layer does
// not hold.  The answer is its index in the table, or -1 when the table is
// full.
fn accept_channel(var state: CocState, remote_cid: Int, psm: Int, mtu: Int, mps: Int, peer_mtu: Int,
                  peer_mps: Int, peer_credits: Int, hold_credits: Bool, enhanced: Bool) -> Int
    let cid = free_local_cid(state)
    let id = free_id(state)
    if cid == CID_NONE or id < 0
        return -1
    list.push(state.channels, new_channel(id,
        cid,
        remote_cid,
        psm,
        mtu,
        mps,
        peer_mtu,
        peer_mps,
        peer_credits,
        hold_credits,
        enhanced,
        false,
        0))
    list.len(state.channels) - 1

// ── Requests from the peer ──────────────────────────────────────────

// The Result a request on `psm` for `remote_cid` is answered with, before
// any channel is created ([Vol 3] Part A, Table 4.16 and Section 4.22).
fn connection_result(state: CocState, psm: Int, remote_cid: Int, mtu: Int, mps: Int, enhanced: Bool,
                     peer_credits: Int) -> Int
    let min_mtu = if enhanced
        MIN_MTU_ENHANCED
    else
        MIN_MTU
    let min_mps = if enhanced
        MIN_MPS_ENHANCED
    else
        MIN_MPS
    match listener_for(state, psm)
        None    => RESULT_SPSM_NOT_SUPPORTED
        Some(l) =>
            let asked = listen_result(l.response)
            if asked != RESULT_SUCCESS
                asked
            else if remote_cid < CID_FIRST_DYNAMIC or remote_cid > CID_LAST_DYNAMIC
                RESULT_INVALID_SOURCE_CID
            else if has_remote_cid(state, remote_cid)
                RESULT_SOURCE_CID_ALLOCATED
            else if mtu < min_mtu or mps < min_mps
                RESULT_UNACCEPTABLE_PARAMETERS
            else if peer_credits > MAX_CREDITS
                RESULT_UNACCEPTABLE_PARAMETERS
            else
                RESULT_SUCCESS

// The MTU this Host offers on a channel of a listened PSM: the listener's,
// at least the smallest the mode allows ([Vol 3] Part A, Sections 4.22 and
// 4.25).
fn offered_mtu(state: CocState, psm: Int, enhanced: Bool) -> Int
    let floor = if enhanced
        MIN_MTU_ENHANCED
    else
        MIN_MTU
    match listener_for(state, psm)
        None    => floor
        Some(l) => if l.mtu < floor
            floor
        else
            l.mtu

// L2CAP_LE_CREDIT_BASED_CONNECTION_REQ: SPSM, Source CID, MTU, MPS and
// Initial Credits ([Vol 3] Part A, Section 4.22).
fn le_connection_request(var state: CocState, identifier: Int, data: [u8]) -> [CocOut]
    if list.len(data) != 10
        return [signal(l2cap.CODE_COMMAND_REJECT_RSP, identifier, le16(l2cap.REJECT_COMMAND_NOT_UNDERSTOOD))]
    let psm = read_le16(data, 0)
    let remote_cid = read_le16(data, 2)
    let mtu = read_le16(data, 4)
    let mps = read_le16(data, 6)
    let credits = read_le16(data, 8)
    let result = connection_result(state, psm, remote_cid, mtu, mps, false, 0)
    if result != RESULT_SUCCESS
        return [build_connection_rsp(identifier, CID_NONE, 0, 0, 0, result)]
    let size = offered_mtu(state, psm, false)
    let i = accept_channel(var state, remote_cid, psm, size, size, mtu, mps, credits, false, false)
    if i < 0
        return [build_connection_rsp(identifier, CID_NONE, 0, 0, 0, RESULT_NO_RESOURCES)]
    let c = state.channels[i]
    list.push(state.events, CocEvent.Connected(c.id, psm))
    [build_connection_rsp(identifier, c.local_cid, c.mtu, c.mps, INITIAL_CREDITS, RESULT_SUCCESS)]

// L2CAP_CREDIT_BASED_CONNECTION_REQ: SPSM, MTU, MPS, Initial Credits and
// the Source CIDs ([Vol 3] Part A, Section 4.25).  A Source CID the Host
// cannot take is answered with a Destination CID of 0x0000, and the Result
// names whether all or only some of the connections were refused.
fn enhanced_connection_request(var state: CocState, identifier: Int, data: [u8]) -> [CocOut]
    let n = list.len(data)
    if n < 10 or (n - 8) % 2 != 0 or (n - 8) / 2 > MAX_SCIDS
        return [signal(l2cap.CODE_COMMAND_REJECT_RSP, identifier, le16(l2cap.REJECT_COMMAND_NOT_UNDERSTOOD))]
    let psm = read_le16(data, 0)
    let mtu = read_le16(data, 2)
    let mps = read_le16(data, 4)
    let credits = read_le16(data, 6)
    let want = (n - 8) / 2
    let size = offered_mtu(state, psm, true)
    var destination: [Int] = []
    var refused = 0
    var created = 0
    var partial = RESULT_NO_RESOURCES
    for i in 0..want
        let remote_cid = read_le16(data, 8 + 2 * i)
        let result = connection_result(state, psm, remote_cid, mtu, mps, true, credits)
        if result != RESULT_SUCCESS
            list.push(destination, CID_NONE)
            refused = refused + 1
            if result == RESULT_SOURCE_CID_ALLOCATED or result == RESULT_INVALID_SOURCE_CID
                partial = result
            continue
        let i = accept_channel(var state, remote_cid, psm, size, size, mtu, mps, credits, false, true)
        if i < 0
            list.push(destination, CID_NONE)
            refused = refused + 1
            partial = RESULT_NO_RESOURCES
        else
            let c = state.channels[i]
            list.push(state.events, CocEvent.Connected(c.id, psm))
            list.push(destination, c.local_cid)
            created = created + 1
    let result = if created == 0
        connection_result(state, psm, read_le16(data, 8), mtu, mps, true, credits)
    else if refused > 0
        partial
    else
        RESULT_SUCCESS
    // The Result, MTU, MPS and Initial Credits of an "all refused" answer
    // are those of the first Source CID, so the answer says which refusal
    // the Host means ([Vol 3] Part A, Table 4.17).
    let answer_mtu = if created > 0
        size
    else
        0
    let answer_credits = if created > 0
        INITIAL_CREDITS
    else
        0
    [enhanced_connection_rsp(identifier, answer_mtu, answer_mtu, answer_credits, result, destination)]

// L2CAP_CREDIT_BASED_CONNECTION_RSP ([Vol 3] Part A, Section 4.26): MTU,
// MPS, Initial Credits, Result and one Destination CID per Source CID of
// the request, in the order of the request.
fn enhanced_connection_rsp(identifier: Int, mtu: Int, mps: Int, credits: Int, result: Int,
                           destination: [Int]) -> CocOut
    var body = le16(mtu)
    list.append(body, le16(mps))
    list.append(body, le16(credits))
    list.append(body, le16(result))
    for cid in destination
        list.append(body, le16(cid))
    signal(l2cap.CODE_CREDIT_BASED_CONNECTION_RSP, identifier, body)

// ── Responses from the peer ─────────────────────────────────────────

// L2CAP_LE_CREDIT_BASED_CONNECTION_RSP: the peer answered a request of
// this Host's ([Vol 3] Part A, Section 4.23).
fn le_connection_response(var state: CocState, identifier: Int, data: [u8]) -> [CocOut]
    if list.len(data) != 10
        return []
    let remote_cid = read_le16(data, 0)
    let peer_mtu = read_le16(data, 2)
    let peer_mps = read_le16(data, 4)
    let peer_credits = read_le16(data, 6)
    let result = read_le16(data, 8)
    let i = pending_index(state, identifier, false)
    if i < 0
        return []
    var c = state.channels[i]
    if result == RESULT_SUCCESS and peer_mps < MIN_MPS
        // A channel is established on receipt of a successful result, and
        // no implementation supports an MPS below 23 octets ([Vol 3] Part A,
        // Section 4.23): the channel is dropped and the peer is asked to
        // end it, so the segmenter never sees the value.
        c.remote_cid = remote_cid
        return end_channel(var state, i, RESULT_UNACCEPTABLE_PARAMETERS)
    if result == RESULT_SUCCESS
        c.remote_cid = remote_cid
        c.peer_mtu = peer_mtu
        c.peer_mps = peer_mps
        c.peer_credits = peer_credits
        c.connecting = false
        list.push(state.events, CocEvent.Connected(c.id, c.psm))
    else
        remove(var state, i, result)
    []

// The index of the first channel whose request, an Enhanced one or an LE
// one as `enhanced` says, is still out under `identifier`: the channel a
// response with that Identifier answers, or -1 when no such request is
// out.
fn pending_index(state: CocState, identifier: Int, enhanced: Bool) -> Int
    for i in 0..list.len(state.channels)
        let c = state.channels[i]
        if c.connecting and c.request_id == identifier and c.enhanced == enhanced
            return i
    -1

// L2CAP_CREDIT_BASED_CONNECTION_RSP: one Destination CID per Source CID of
// the request, in order; a Destination CID of 0x0000 is a channel that was
// not created ([Vol 3] Part A, Section 4.26).
fn enhanced_connection_response(var state: CocState, identifier: Int, data: [u8]) -> [CocOut]
    if list.len(data) < 8
        return []
    let peer_mtu = read_le16(data, 0)
    let peer_mps = read_le16(data, 2)
    let peer_credits = read_le16(data, 4)
    let result = read_le16(data, 6)
    let n = (list.len(data) - 8) / 2
    // The channels of the request are the connecting ones, in the order
    // their Source CIDs were sent, and the Destination CIDs answer them in
    // the same order ([Vol 3] Part A, Section 4.26).
    var pending: [Int] = []
    for i in 0..list.len(state.channels)
        let c = state.channels[i]
        if c.connecting and c.request_id == identifier and c.enhanced
            list.push(pending, i)
    // A Destination CID of 0x0000 leaves that channel uncreated; the
    // refusal reason is the Result of the response for the whole request.
    var refused: [Int] = []
    var unacceptable: [Int] = []
    var out: [CocOut] = []
    // A response that lists fewer Destination CIDs than the request had
    // Source CIDs leaves the missing ones uncreated as well.
    for i in 0..list.len(pending)
        let remote_cid = if i < n
            read_le16(data, 8 + 2 * i)
        else
            CID_NONE
        if remote_cid != CID_NONE and accepts_partly(result) and peer_mps < MIN_MPS_ENHANCED
            // The peer holds the channel open with an MPS below the 64
            // octets an Enhanced Credit Based channel supports ([Vol 3]
            // Part A, Section 4.26): it is dropped here and the peer
            // is asked to end it.
            let local_cid = state.channels[pending[i]].local_cid
            list.push(out,
                build_disconnection(l2cap.CODE_DISCONNECTION_REQ, next_identifier(var state), remote_cid, local_cid))
            list.push(unacceptable, local_cid)
        else if remote_cid != CID_NONE and accepts_partly(result)
            var c = state.channels[pending[i]]
            c.remote_cid = remote_cid
            c.peer_mtu = peer_mtu
            c.peer_mps = peer_mps
            c.peer_credits = peer_credits
            c.connecting = false
            list.push(state.events, CocEvent.Connected(c.id, c.psm))
        else
            list.push(refused, state.channels[pending[i]].local_cid)
    drop_local_cids(var state, refused, (if result == RESULT_SUCCESS then RESULT_NO_RESOURCES else result))
    drop_local_cids(var state, unacceptable, RESULT_UNACCEPTABLE_PARAMETERS)
    out

// Whether a Result of L2CAP_CREDIT_BASED_CONNECTION_RSP leaves the
// channels with a Destination CID established: the "all successful" and
// "some refused" values of Table 4.17 do, the "all refused" ones do not.
fn accepts_partly(result: Int) -> Bool
    if result == RESULT_SUCCESS
        true
    else if result == RESULT_NO_RESOURCES
        true
    else if result == RESULT_INVALID_SOURCE_CID
        true
    else
        result == RESULT_SOURCE_CID_ALLOCATED

fn holds(cids: [Int], cid: Int) -> Bool
    for c in cids
        if c == cid
            return true
    false

// Drop the channels whose own endpoints are in `cids`, and report each gone
// with `result`.
fn drop_local_cids(var state: CocState, cids: [Int], result: Int)
    var kept: [CocChannel] = []
    for i in 0..list.len(state.channels)
        let c = state.channels[i]
        if holds(cids, c.local_cid)
            list.push(state.events, CocEvent.Disconnected(c.id, c.psm, result))
        else
            list.push(kept, c)
    state.channels = kept

// L2CAP_FLOW_CONTROL_CREDIT_IND: the peer grants this Host credits
// ([Vol 3] Part A, Section 4.24).  The CID the peer sends is its own
// endpoint of the channel -- "a received L2CAP_FLOW_CONTROL_CREDIT_IND
// packet with a given CID (0x0042) would provide credits for the
// receiving device's destination CID (0x0042)" -- so the channel is the
// one whose peer endpoint is that CID, which is the CID this Host sends
// its K-frames to.  The credits come due on what the channel held back
// ([Vol 3] Part A, Section 10.1): the queued SDUs go out now, in order,
// as far as the new allowance reaches.  A credit count above 65535 ends
// the channel and a credit of zero is ignored (Section 10.1).
fn flow_control_credit(var state: CocState, data: [u8]) -> [CocOut]
    if list.len(data) != 4
        return []
    let cid = read_le16(data, 0)
    let credits = read_le16(data, 2)
    let i = index_of_remote_cid(state, cid)
    if i < 0
        return []
    var c = state.channels[i]
    if c.connecting or credits == 0
        return []
    if c.peer_credits + credits > MAX_CREDITS
        return end_channel(var state, i, RESULT_SUCCESS)
    c.peer_credits = c.peer_credits + credits
    flush(var state, i)

// L2CAP_CREDIT_BASED_RECONFIGURE_REQ: the peer states the MTU and MPS it
// can receive on its own channels ([Vol 3] Part A, Section 4.27).  Its
// Destination CIDs "represent the channel endpoints on the device sending
// the ... packet", so each is the peer's endpoint of a channel of this
// Host's -- what this module holds as the channel's `remote_cid`.
fn reconfigure_request(var state: CocState, identifier: Int, data: [u8]) -> [CocOut]
    let n = list.len(data)
    if n < 6 or (n - 4) % 2 != 0 or (n - 4) / 2 > MAX_SCIDS
        return [signal(l2cap.CODE_COMMAND_REJECT_RSP, identifier, le16(l2cap.REJECT_COMMAND_NOT_UNDERSTOOD))]
    let mtu = read_le16(data, 0)
    let mps = read_le16(data, 2)
    let want = (n - 4) / 2
    if mtu < MIN_MTU or mps < MIN_MPS_ENHANCED
        // Other unacceptable parameters: no channel may receive an SDU
        // smaller than the smallest MTU, or a PDU smaller than the smallest
        // MPS of an Enhanced Credit Based channel ([Vol 3] Part A,
        // Table 4.18).
        return [signal(l2cap.CODE_CREDIT_BASED_RECONFIGURE_RSP, identifier, le16(RECONFIGURE_UNACCEPTABLE))]
    var result = RECONFIGURE_SUCCESS
    var channels: [Int] = []
    for i in 0..want
        let cid = read_le16(data, 4 + 2 * i)
        let j = index_of_remote_cid(state, cid)
        if j < 0
            if result == RECONFIGURE_SUCCESS
                result = RECONFIGURE_INVALID_CID
        else
            list.push(channels, j)
            if mtu < state.channels[j].peer_mtu and result == RECONFIGURE_SUCCESS
                result = RECONFIGURE_MTU_REDUCED
            else if mps < state.channels[j].peer_mps and want > 1 and result == RECONFIGURE_SUCCESS
                result = RECONFIGURE_MPS_REDUCED
    if result == RECONFIGURE_SUCCESS
        for i in channels
            var c = state.channels[i]
            c.peer_mtu = mtu
            c.peer_mps = mps
            list.push(state.events, CocEvent.Reconfigured(c.id, mtu, mps))
    [signal(l2cap.CODE_CREDIT_BASED_RECONFIGURE_RSP, identifier, le16(result))]

// ── Signaling ───────────────────────────────────────────────────────

// Whether a signaling code concerns the channel table: the connection
// requests and responses of both modes, the credit indication, the two
// disconnections and the reconfiguration of the enhanced mode ([Vol 3]
// Part A, Table 4.2).
fn is_coc_code(code: Int) -> Bool
    if code == l2cap.CODE_LE_CREDIT_BASED_CONNECTION_REQ
        true
    else if code == l2cap.CODE_LE_CREDIT_BASED_CONNECTION_RSP
        true
    else if code == l2cap.CODE_FLOW_CONTROL_CREDIT_IND
        true
    else if code == l2cap.CODE_CREDIT_BASED_CONNECTION_REQ
        true
    else if code == l2cap.CODE_CREDIT_BASED_CONNECTION_RSP
        true
    else if code == l2cap.CODE_CREDIT_BASED_RECONFIGURE_REQ
        true
    else if code == l2cap.CODE_CREDIT_BASED_RECONFIGURE_RSP
        true
    else if code == l2cap.CODE_DISCONNECTION_REQ
        true
    else
        code == l2cap.CODE_DISCONNECTION_RSP

// Take one signaling packet of the LE signaling channel that concerns the
// channel table, and answer it.  `code` and `identifier` are the packet's
// own; `data` its Data, which `signaling_data` reads.
pub fn receive_signaling(var state: CocState, code: Int, identifier: Int, data: [u8]) -> [CocOut]
    if code == l2cap.CODE_LE_CREDIT_BASED_CONNECTION_REQ
        le_connection_request(var state, identifier, data)
    else if code == l2cap.CODE_LE_CREDIT_BASED_CONNECTION_RSP
        le_connection_response(var state, identifier, data)
    else if code == l2cap.CODE_FLOW_CONTROL_CREDIT_IND
        flow_control_credit(var state, data)
    else if code == l2cap.CODE_CREDIT_BASED_CONNECTION_REQ
        enhanced_connection_request(var state, identifier, data)
    else if code == l2cap.CODE_CREDIT_BASED_CONNECTION_RSP
        enhanced_connection_response(var state, identifier, data)
    else if code == l2cap.CODE_CREDIT_BASED_RECONFIGURE_REQ
        reconfigure_request(var state, identifier, data)
    else if code == l2cap.CODE_CREDIT_BASED_RECONFIGURE_RSP
        reconfigure_response(var state, data)
    else if code == l2cap.CODE_DISCONNECTION_REQ
        disconnection_request(var state, identifier, data)
    else if code == l2cap.CODE_DISCONNECTION_RSP
        disconnection_response(var state, data)
    else
        []

// L2CAP_DISCONNECTION_REQ: the peer ends a channel ([Vol 3] Part A,
// Section 4.6).
fn disconnection_request(var state: CocState, identifier: Int, data: [u8]) -> [CocOut]
    if list.len(data) != 4
        return [signal(l2cap.CODE_COMMAND_REJECT_RSP, identifier, le16(l2cap.REJECT_COMMAND_NOT_UNDERSTOOD))]
    let destination_cid = read_le16(data, 0)
    let source_cid = read_le16(data, 2)
    let i = index_of_cid(state, destination_cid)
    if i < 0
        // The reason data of Invalid CID in request is the two CIDs of the
        // request, as the sender of the reject saw them ([Vol 3] Part A,
        // Section 4.1).
        return [CocOut { cid: l2cap.CID_LE_SIGNALING,
            payload: l2cap.build_command_reject_invalid_cid(identifier, destination_cid, source_cid) }]
    if state.channels[i].remote_cid != source_cid
        // The CIDs do not name one channel; the request is discarded
        // silently ([Vol 3] Part A, Section 4.6).
        return []
    remove(var state, i, RESULT_SUCCESS)
    [build_disconnection(l2cap.CODE_DISCONNECTION_RSP, identifier, source_cid, destination_cid)]

// L2CAP_DISCONNECTION_RSP: a channel this Host asked to end is gone
// ([Vol 3] Part A, Section 4.7).
fn disconnection_response(var state: CocState, data: [u8]) -> [CocOut]
    if list.len(data) != 4
        return []
    let source_cid = read_le16(data, 2)
    for i in 0..list.len(state.channels)
        if state.channels[i].disconnecting and state.channels[i].local_cid == source_cid
            remove(var state, i, RESULT_SUCCESS)
            return []
    []

// ── K-frames ────────────────────────────────────────────────────────

// Take one K-frame on `cid`, the destination CID of its B-frame ([Vol 3]
// Part A, Section 3.4).  A channel whose credit count is zero, an SDU
// Length above the MTU, a PDU above the MPS, and segments that run past
// the announced SDU length each end the channel (Section 3.4.3), and so
// does a credit count above 65535 (Section 10.1).
pub fn receive_k_frame(var state: CocState, cid: Int, payload: [u8]) -> [CocOut]
    let i = index_of_cid(state, cid)
    if i < 0
        return []
    var c = state.channels[i]
    if c.connecting or c.disconnecting
        return []
    if c.credits <= 0
        return end_channel(var state, i, RESULT_SUCCESS)
    // The frame that opens an SDU also carries its 2-octet SDU Length
    // field, and that field does not count against the MPS: with an MTU
    // equal to the MPS, an SDU of exactly the MPS octets is otherwise
    // impossible to send, which is the shape PTS's L2CAP/LE/CFC/BV-32-C
    // fixes (it sends 122 octets of frame for an SDU of 120 with the MPS
    // announced as 120).  A continuation frame carries data only and is
    // bounded by the MPS itself ([Vol 3] Part A, Section 3.4.2).
    let limit = if c.rx_want < 0
        c.mps + 2
    else
        c.mps
    if list.len(payload) > limit
        return end_channel(var state, i, RESULT_SUCCESS)
    c.credits = c.credits - 1
    c.owed = c.owed + 1
    var out = assemble(var state, i, payload)
    // The frame can have ended the channel, in which case no credit is
    // owed for it.
    if index_of_cid(state, cid) < 0
        return out
    if not c.hold_credits and c.owed > 0
        list.push(out, build_credit_ind(next_identifier(var state), c.local_cid, c.owed))
        c.credits = c.credits + c.owed
        c.owed = 0
    out

// Add one K-frame's octets to the SDU being reassembled and report the SDU
// when it is whole.  The first K-frame of an SDU holds its length.
fn assemble(var state: CocState, i: Int, payload: [u8]) -> [CocOut]
    var c = state.channels[i]
    if c.rx_want < 0
        if list.len(payload) < 2
            return end_channel(var state, i, RESULT_SUCCESS)
        let want = read_le16(payload, 0)
        if want > c.mtu
            return end_channel(var state, i, RESULT_SUCCESS)
        c.rx = []
        c.rx_want = want
        list.append(c.rx, payload[2:list.len(payload)])
    else
        list.append(c.rx, payload)
    if list.len(c.rx) > c.rx_want
        return end_channel(var state, i, RESULT_SUCCESS)
    if list.len(c.rx) == c.rx_want
        let sdu = c.rx[:]
        c.rx = []
        c.rx_want = -1
        list.push(state.events, CocEvent.DataReceived(c.id, sdu))
    []

// ── Sending ─────────────────────────────────────────────────────────

// Send as many K-frames of the queued SDUs as the peer's credits allow,
// each spending one credit and carrying at most the peer's MPS octets
// ([Vol 3] Part A, Section 3.4.3).
fn flush(var state: CocState, index: Int) -> [CocOut]
    var c = state.channels[index]
    var out: [CocOut] = []
    for _ in 0..MAX_FLUSH_FRAMES
        if c.peer_credits <= 0 or list.len(c.tx) == 0
            return out
        let sdu = c.tx[0]
        let n = list.len(sdu)
        var payload: [u8] = []
        if c.tx_at == 0
            list.push(payload, (n & 0xFF) as u8)
            list.push(payload, ((n >>> 8) & 0xFF) as u8)
            let room = c.peer_mps - 2
            let end = if n < room
                n
            else
                room
            list.append(payload, sdu[0:end])
            c.tx_at = end
        else
            let start = c.tx_at
            let end = if start + c.peer_mps < n
                start + c.peer_mps
            else
                n
            list.append(payload, sdu[start:end])
            c.tx_at = end
        list.push(out, CocOut { cid: c.remote_cid, payload: payload })
        c.peer_credits = c.peer_credits - 1
        if c.tx_at >= n
            var rest: [[u8]] = []
            for k in 0..list.len(c.tx)
                if k > 0
                    list.push(rest, c.tx[k])
            c.tx = rest
            c.tx_at = 0
    out

// Send the SDU `sdu` on the channel `id`: its K-frames go now as far as the
// peer's credits reach and wait otherwise.  None when there is no such
// channel, the channel is not up, or the SDU is longer than the peer's MTU
// ([Vol 3] Part A, Section 3.4.2).
pub fn send_sdu(var state: CocState, id: Int, sdu: [u8]) -> ?[CocOut]
    let i = index_of(state, id)
    if i < 0
        return None
    var c = state.channels[i]
    if c.connecting or c.disconnecting or list.len(sdu) > c.peer_mtu
        return None
    list.push(c.tx, sdu[:])
    Some(flush(var state, i))

// Give the peer the credits that received K-frames spent, at least one
// ([Vol 3] Part A, Section 4.24).  None when there is no such channel.
fn return_credits(var state: CocState, id: Int) -> ?[CocOut]
    let i = index_of(state, id)
    if i < 0
        return None
    var c = state.channels[i]
    if c.connecting or c.disconnecting
        return None
    let credits = if c.owed > 0
        c.owed
    else
        1
    c.owed = 0
    c.credits = c.credits + credits
    Some([build_credit_ind(next_identifier(var state), c.local_cid, credits)])

// Ask the peer to end the channel: L2CAP_DISCONNECTION_REQ names the
// peer's CID as the Destination CID ([Vol 3] Part A, Section 4.6).  The
// channel is dropped when the response arrives.
pub fn disconnect(var state: CocState, id: Int) -> ?[CocOut]
    let i = index_of(state, id)
    if i < 0
        return None
    var c = state.channels[i]
    if c.connecting or c.disconnecting
        return None
    c.disconnecting = true
    Some([build_disconnection(l2cap.CODE_DISCONNECTION_REQ, next_identifier(var state), c.remote_cid, c.local_cid)])

// Ask the peer to accept the MTU and MPS `mtu` and `mps` this Host can
// receive on the channels `ids`, which must be up:
// L2CAP_CREDIT_BASED_RECONFIGURE_REQ names this Host's own endpoints as
// the Destination CIDs ([Vol 3] Part A, Section 4.27).  None when a
// number is not a channel of the table or no channel is named.
fn reconfigure(var state: CocState, ids: [Int], mtu: Int, mps: Int) -> ?[CocOut]
    if list.len(ids) == 0 or list.len(ids) > MAX_SCIDS
        return None
    var local: [Int] = []
    for id in ids
        let i = index_of(state, id)
        if i < 0
            return None
        let c = state.channels[i]
        if c.connecting or c.disconnecting
            return None
        list.push(local, c.local_cid)
    var body = le16(mtu)
    list.append(body, le16(mps))
    for cid in local
        list.append(body, le16(cid))
    state.reconfiguring = local
    state.reconfigure_mtu = mtu
    state.reconfigure_mps = mps
    Some([signal(l2cap.CODE_CREDIT_BASED_RECONFIGURE_REQ, next_identifier(var state), body)])

// L2CAP_CREDIT_BASED_RECONFIGURE_RSP: the peer answered a request of this
// Host's ([Vol 3] Part A, Section 4.28).  The channels take the new MTU
// and MPS on a successful result, which is what they may receive.
fn reconfigure_response(var state: CocState, data: [u8]) -> [CocOut]
    if list.len(data) != 2
        return []
    let result = read_le16(data, 0)
    if result != RECONFIGURE_SUCCESS
        state.reconfiguring = []
        return []
    for cid in state.reconfiguring
        let i = index_of_cid(state, cid)
        if i >= 0
            var c = state.channels[i]
            c.mtu = state.reconfigure_mtu
            c.mps = state.reconfigure_mps
            list.push(state.events, CocEvent.Reconfigured(c.id, c.peer_mtu, c.peer_mps))
    state.reconfiguring = []
    []

// End a channel because of the frame that arrived on it, or because a
// credit count passed 65535 ([Vol 3] Part A, Section 10.1): the channel is
// dropped at once and the peer is asked to end it.
fn end_channel(var state: CocState, i: Int, result: Int) -> [CocOut]
    let c = state.channels[i]
    let request = build_disconnection(l2cap.CODE_DISCONNECTION_REQ, next_identifier(var state), c.remote_cid, c.local_cid)
    remove(var state, i, result)
    [request]
