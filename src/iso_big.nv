    test.assert(t.state[big_row(var t, 1)] == BigState.Broadcasting)
    var r = big_table_new()
    synchronized(r, 1, 0x20, [1], [0x0100])
    test.assert(big_terminate_complete(var r, done).kind == iso_event.IsoEventKind.Unrelated)

