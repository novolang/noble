@test
@satisfies("REQ-BLE-ATT-PDU-003")
fn test_read_by_type_req_uuid16_path()
    // READ_BY_TYPE_REQ start=0x0001 end=0xFFFF type=0x2803 (Characteristic).
    let req: [u8] = [
        ATT_OP_READ_BY_TYPE_REQ,
        0x01, 0x00,
        0xFF, 0xFF,
        0x03, 0x28]
    test.assert_eq(read_read_by_type_req_start(req), 0x0001)
    test.assert_eq(read_read_by_type_req_end(req), 0xFFFF)
    test.assert_eq(read_read_by_type_req_type_len(req), 2)
    test.assert_eq(read_read_by_type_req_type16(req), 0x2803)

@test
@satisfies("REQ-BLE-ATT-PDU-004")
fn test_read_by_type_rsp_shape()
    // One pair: handle 0x0010 + 5-byte value → pair_len = 7.
    let pair: [u8] = [
        0x10, 0x00,
        0x02, 0x11, 0x00, 0x29, 0x2A]
    let rsp = build_read_by_type_rsp(7, pair)
    test.assert_eq(list.len(rsp), 2 + 7)
    test.assert_eq(rsp[0] as Int, ATT_OP_READ_BY_TYPE_RSP)
    test.assert_eq(rsp[1] as Int, 7)

@test
@satisfies("REQ-BLE-ATT-PDU-003")
fn test_read_by_group_type_aliases_read_by_type()
