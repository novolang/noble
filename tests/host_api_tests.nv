@test
fn test_status_keeps_the_number_of_its_layer_and_names_the_codes_it_knows()
    test.assert(noble.ok().is_ok())
    test.assert(not noble.failed(noble.LAYER_LOCAL, noble.E_BUSY).is_ok())
    let a = noble.failed(noble.LAYER_ATT, noble.ATT_INSUFFICIENT_AUTHENTICATION)
    test.assert(a.is(noble.LAYER_ATT, noble.ATT_INSUFFICIENT_AUTHENTICATION))
    test.assert(not a.is(noble.LAYER_HCI, noble.ATT_INSUFFICIENT_AUTHENTICATION))
    test.assert_eq(a.name(), "insufficient authentication")
    test.assert_eq(noble.failed(noble.LAYER_HCI, noble.HCI_CONNECTION_TIMEOUT).name(), "connection timeout")
    test.assert_eq(noble.failed(noble.LAYER_SMP, noble.SMP_PASSKEY_ENTRY_FAILED).name(), "passkey entry failed")
    test.assert_eq(noble.failed(noble.LAYER_ATT, 200).name(), "unknown")
    test.assert_eq(noble.failed(noble.LAYER_L2CAP, 2).name(), "unknown")

@test
fn test_every_named_code_has_a_name()
    for code in 1..20
        test.assert(noble.att_name(code) != "unknown")
    for code in [5, 6, 8, 19, 20, 21, 22, 26, 61, 59, 62]
        test.assert(noble.hci_name(code) != "unknown")
    for code in 1..15
        test.assert(noble.smp_name(code) != "unknown")
    test.assert_eq(noble.att_name(0), "unknown")
    test.assert_eq(noble.hci_name(0), "unknown")
    test.assert_eq(noble.smp_name(0), "unknown")

@test
fn test_the_adapters_read_the_five_error_forms_as_one_status()
    test.assert(noble.from_client_status(0).is_ok())
    test.assert(noble.from_client_status(0x05).is(noble.LAYER_ATT, noble.ATT_INSUFFICIENT_AUTHENTICATION))
    test.assert(noble.from_client_status(0x100).is(noble.LAYER_LOCAL, noble.E_TIMEOUT))
    test.assert(noble.from_client_status(0x102).is(noble.LAYER_LOCAL, noble.E_NO_ROOM))
    test.assert(noble.from_client_status(0x101).is(noble.LAYER_ATT, noble.ATT_INVALID_PDU))
    test.assert(noble.from_client_error(-1).is(noble.LAYER_LOCAL, noble.E_STALE))
    test.assert(noble.from_client_error(-2).is(noble.LAYER_LOCAL, noble.E_BUSY))
    test.assert(noble.from_client_error(-3).is(noble.LAYER_LOCAL, noble.E_NO_ROOM))
    test.assert(noble.from_client_error(-4).is(noble.LAYER_LOCAL, noble.E_BAD_ARGUMENT))
    test.assert(noble.from_client_error(-5).is(noble.LAYER_LOCAL, noble.E_LINK_LOST))
    test.assert(noble.from_client_error(-6).is(noble.LAYER_LOCAL, noble.E_NOT_READY))
    test.assert(noble.from_client_error(-7).is(noble.LAYER_LOCAL, noble.E_BUSY))
    test.assert(noble.from_advertiser_error("the advertising interval is outside 20 to 10240 ms").is(noble.LAYER_LOCAL, noble.E_BAD_ARGUMENT))
    test.assert(noble.from_smp_reason(smp.Reason.PairingNotSupported).is(noble.LAYER_SMP, noble.SMP_PAIRING_NOT_SUPPORTED))
    test.assert(noble.from_smp_reason(smp.Reason.ConfirmValueFailed).is(noble.LAYER_SMP, noble.SMP_CONFIRM_VALUE_FAILED))
    test.assert(noble.from_profile_error(profile_builder.ProfileError.NoRoom).is(noble.LAYER_LOCAL, noble.E_NO_ROOM))
    test.assert(noble.from_profile_error(profile_builder.ProfileError.InvalidValue).is(noble.LAYER_LOCAL, noble.E_BAD_ARGUMENT))
    test.assert(noble.from_profile_error(profile_builder.ProfileError.NotPermitted).is(noble.LAYER_LOCAL, noble.E_REFUSED))

@test
fn test_default_policy_answers_what_a_host_with_no_hook_does()
    var p = DefaultPolicy { placeholder: 0 }
    let c = noble.no_conn()
    let a = peer_addr(1)
    test.assert(p.accept_pairing(c, a, Security.Encrypted, true))
    test.assert_eq(p.ask_passkey(c), noble.PENDING)
    test.assert_eq(p.confirm_numeric(c, 123456), noble.PENDING)
    test.assert(p.accept_params(c, noble.conn_params_default()))
    test.assert(p.accept_connect(a, Role.Central))
    test.assert(p.on_advert(noble.blank_report()))
    var v: noble.Value = Vec.new()
    test.assert_eq(p.on_read(c, 3, 0, var v), noble.NOT_HANDLED)
    test.assert_eq(p.on_write(c, 3, 0, var v), noble.NOT_HANDLED)
    test.assert_eq(p.authorize_write(c, 3, var v), 0)
    match p.on_disconnected(c, noble.ok(), Role.Peripheral, 0)
        Action.Stay => ()
        _ => test.fail("a default policy stays")
    match p.on_connected(c, Role.Peripheral, 1)
        Action.Stay => ()
        _ => test.fail("a default policy stays")
    match p.io_capability(c)
        IoCap.NoInputNoOutput => ()
        _ => test.fail("a default policy offers no input and no output")
    let q = noble.conn_params_default()
    test.assert_eq(q.interval_min as Int, 24)
    test.assert_eq(q.timeout as Int, 400)

@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_a_host_on_the_default_policy_connects_and_keeps_to_one_link()
    var h = new_host(1)
    var l = script_link()
    var p = DefaultPolicy { placeholder: 0 }
    var b = new_store()
    started(var h, var l, var p, var b)
