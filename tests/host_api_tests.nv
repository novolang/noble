@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_the_name_of_an_ended_link_stays_stale_when_a_new_link_takes_its_slot()
    var h = new_host(2)
    var l = script_link()
    var p = test_policy()
    var b = new_store()
    started(var h, var l, var p, var b)
    let first = call(var h, var l, var p, var b, Request.Connect(peer_addr(0x55), noble.conn_params_default()))
    test.assert(first.is_ok())
    let old = host_api.op_conn(h)
    test.assert(call(var h, var l, var p, var b, Request.Disconnect(old, 0x13)).is_ok())
    l.handle = 0x42
    let second = call(var h, var l, var p, var b, Request.Connect(peer_addr(0x56), noble.conn_params_default()))
    test.assert(second.is_ok())
    let fresh = host_api.op_conn(h)
    // The same slot, the next generation.
    test.assert_eq(fresh.slot as Int, old.slot as Int)
    test.assert(fresh.generation != old.generation)
    test.assert(host_api.conn_info(h, old) == None)
    test.assert(host_api.conn_info(h, fresh) != None)
    test.assert(host_api.begin(var h, Request.Disconnect(old, 0x13)).is(noble.LAYER_LOCAL, noble.E_STALE))

