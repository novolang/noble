@tier(app)
fn create_test(var t: BigTable, iso_interval: Int, nse: Int, max_pdu: Int, bn: Int, irc: Int, pto: Int) -> Int
    big_create_test(var t, 1, 1, 1, 10000, iso_interval, nse, 100, max_pdu, 0x02, 0, 0, bn, irc, pto, false, zero_code())

@test
@satisfies("REQ-BLE-ISO-004")
