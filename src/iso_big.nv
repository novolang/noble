@test
@satisfies("REQ-BLE-ISO-004")
fn test_terminate_big_runs_broadcasting_terminating_free()
    var t = big_table_new()
    broadcasting(var t, 1, 1, [0x0100, 0x0101])
    let at = big_row(var t, 1)
    test.assert_eq(bis_data_path_setup(var t, 0x0100, PATH_INPUT, 0x06, 0), 0)
    test.assert(bis_data_path_setup_complete(var t, 0, 0x0100).kind == iso_event.IsoEventKind.DataPathSet)
    test.assert_eq(big_terminate(var t, 1, iso_event.STATUS_CONNECTION_TERMINATED_BY_LOCAL_HOST), 0)
    test.assert(t.state[at] == BigState.Terminating)
    test.assert(t.pending == BigPending.TerminateBig)
    test.assert(big_terminate_status(var t, 0).kind == iso_event.IsoEventKind.CommandDone)
    test.assert(t.state[at] == BigState.Terminating)
    let e = big_terminate_complete(var t, hci_codec.TerminateBigComplete { big_handle: 1, reason: 0x16 })
    test.assert(e.kind == iso_event.IsoEventKind.BigTerminated)
    test.assert_eq(e.status, 0x16)
    test.assert_eq(big_row(var t, 1), -1)
    // The streams and their paths are gone.
    test.assert_eq(bis_row(var t, 0x0100), -1)
    test.assert_eq(bis_free_rows(var t), noble_config.MAX_BIS)
    test.assert_eq(t.bis_paths[0] as Int, 0)

@test
@satisfies("REQ-BLE-ISO-004")
fn test_terminate_big_refusals_and_failure()
    var t = big_table_new()
    test.assert_eq(big_terminate(var t, 1, 0x16), iso_event.STATUS_UNKNOWN_ADVERTISING_IDENTIFIER)
    broadcasting(var t, 1, 1, [0x0100])
    test.assert_eq(big_terminate(var t, 1, 0x100), iso_event.STATUS_INVALID_COMMAND_PARAMETERS)
    test.assert_eq(big_terminate(var t, 1, 0x16), 0)
    // One command at a time, and not twice.
    test.assert_eq(big_terminate(var t, 1, 0x16), iso_event.STATUS_COMMAND_DISALLOWED)
    // A failed command puts the BIG back.
    let f = big_terminate_status(var t, iso_event.STATUS_COMMAND_DISALLOWED)
    test.assert(f.kind == iso_event.IsoEventKind.CommandFailed)
    test.assert(t.state[big_row(var t, 1)] == BigState.Broadcasting)
    test.assert(big_terminate_status(var t, 0).kind == iso_event.IsoEventKind.Unrelated)
    test.assert_eq(big_terminate(var t, 1, 0x16), 0)
    test.assert(big_terminate_status(var t, 0).kind == iso_event.IsoEventKind.CommandDone)
    // Terminating already.
    test.assert_eq(big_terminate(var t, 1, 0x16), iso_event.STATUS_COMMAND_DISALLOWED)
    // A group this Host follows is not the Broadcaster's to terminate.
    var r = big_table_new()
    synchronized(r, 1, 0x20, [1], [0x0100])
    test.assert_eq(big_terminate(var r, 1, 0x16), iso_event.STATUS_COMMAND_DISALLOWED)

@test
@satisfies("REQ-BLE-ISO-004")
fn test_terminate_big_while_creating_cancels_the_creation()
    var t = big_table_new()
    test.assert_eq(create(var t, 1, 1, 2), 0)
    test.assert(big_create_status(var t, 0).kind == iso_event.IsoEventKind.CommandDone)
    test.assert_eq(big_terminate(var t, 1, 0x16), 0)
    let at = big_row(var t, 1)
    test.assert(t.state[at] == BigState.Cancelling)
    // A failed command puts the creation back.
    test.assert(big_terminate_status(var t, iso_event.STATUS_COMMAND_DISALLOWED).kind == iso_event.IsoEventKind.CommandFailed)
    test.assert(t.state[at] == BigState.Building)
    test.assert_eq(big_terminate(var t, 1, 0x16), 0)
    test.assert(big_terminate_status(var t, 0).kind == iso_event.IsoEventKind.CommandDone)
    // 0x44: Operation Cancelled by Host.
    let e = big_create_complete(var t, create_complete_event(1, iso_event.STATUS_OPERATION_CANCELLED_BY_HOST, []))
    test.assert(e.kind == iso_event.IsoEventKind.BigCreateFailed)
    test.assert_eq(e.status, 0x44)
    test.assert_eq(big_row(var t, 1), -1)
    test.assert_eq(bis_free_rows(var t), noble_config.MAX_BIS)

@test
@satisfies("REQ-BLE-ISO-004")
fn test_a_big_created_before_the_cancellation_is_then_terminated()
    var t = big_table_new()
    test.assert_eq(create(var t, 1, 1, 1), 0)
    test.assert(big_create_status(var t, 0).kind == iso_event.IsoEventKind.CommandDone)
    test.assert_eq(big_terminate(var t, 1, 0x16), 0)
    test.assert(big_terminate_status(var t, 0).kind == iso_event.IsoEventKind.CommandDone)
    // The Controller finished creating the BIG before it saw the command.
    let e = big_create_complete(var t, create_complete_event(1, 0, [0x0100]))
    test.assert(e.kind == iso_event.IsoEventKind.BigCreated)
    test.assert(t.state[e.slot] == BigState.Terminating)
    let g = big_terminate_complete(var t, hci_codec.TerminateBigComplete { big_handle: 1, reason: 0x16 })
    test.assert(g.kind == iso_event.IsoEventKind.BigTerminated)
    test.assert_eq(big_row(var t, 1), -1)

@test
@satisfies("REQ-BLE-ISO-004")
fn test_terminate_big_complete_for_nothing_the_table_terminates_is_ignored()
    var t = big_table_new()
    let done = hci_codec.TerminateBigComplete { big_handle: 1, reason: 0x16 }
    test.assert(big_terminate_complete(var t, done).kind == iso_event.IsoEventKind.Unrelated)
    broadcasting(var t, 1, 1, [0x0100])
