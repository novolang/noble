    test.assert_eq(list.len(trace.sent), 2)
    test.assert_eq(served(var s, handle), [1, 2, 3])

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_an_execute_the_peer_refuses_ends_with_the_handle_it_names()
    var t = table()
    var s = server()
    let decl = gatt_server.add_characteristic(var s.db, 0x0A, gatt_server.PERM_READ | gatt_server.PERM_WRITE, gatt_server.le16(0xAA11))
