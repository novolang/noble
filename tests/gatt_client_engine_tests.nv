@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_write_longer_than_the_mtu_allows_is_not_queued()
    var t = table()
    test.assert_eq(gatt_client.begin_write(var t, link_a(), 0, 0x001A, payload(fill(21, 1)), 21),
        gatt_client.ERR_ARGUMENT)
    test.assert_eq(gatt_client.begin_write_command(var t, link_a(), 0, 0x001A, payload(fill(21, 1)), 21),
        gatt_client.ERR_ARGUMENT)
    test.assert(gatt_client.begin_write(var t, link_a(), 0, 0x001A, payload(fill(20, 1)), 20) > 0)
    test.assert_eq(gatt_client.begin_write(var t, link_a(), 0, 0x001A, payload([]), -1), gatt_client.ERR_ARGUMENT)
    test.assert_eq(gatt_client.begin_write(var t, link_a(), 0, 0, payload([1]), 1), gatt_client.ERR_ARGUMENT)

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_write_command_has_no_response_and_ends_when_it_is_sent()
    var t = table()
    var s = server()
    var trace = new_log()
    let _ = gatt_client.begin_write_command(var t, link_a(), 0, 0x0022, payload([5]), 1)
    test.assert_eq(gatt_client.is_busy(var t, link_a(), 0), true)
    pump(var t, link_a(), var s, var trace)
    test.assert_eq(trace.kinds, [gatt_client.TX_COMMAND])
    test.assert_eq(trace.sent[0], [0x52, 0x22, 0x00, 5])
    test.assert_eq(list.len(trace.events), 0)
    test.assert_eq(gatt_client.is_busy(var t, link_a(), 0), false)
    test.assert_eq(served(var s, 0x0022), [5])

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_request_queued_behind_a_command_runs_after_it()
    var t = table()
    var s = server()
    var trace = new_log()
    let _ = gatt_client.begin_write_command(var t, link_a(), 0, 0x0022, payload([5]), 1)
    let read = gatt_client.begin_read(var t, link_a(), 0, 0x0022)
    pump(var t, link_a(), var s, var trace)
    test.assert_eq(trace.kinds, [gatt_client.TX_COMMAND, gatt_client.TX_REQUEST])
    test.assert_eq(trace.tickets, [read])
    test.assert_eq(trace.statuses, [att.ATT_ERR_READ_NOT_PERMITTED])

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_long_value_is_written_in_parts_and_executed()
    var t = table()
    var s = server()
    let handle = open_value(var s, 0xAA10)
    var trace = new_log()
    let _ = gatt_client.begin_write_long(var t, link_a(), 0, handle, payload(ramp(100)), 100)
    pump(var t, link_a(), var s, var trace)
    test.assert_eq(trace.statuses, [0])
    // Parts of ATT_MTU - 5 = 18 octets: five of 18 and one of 10, then Execute.
    test.assert_eq(list.len(trace.sent), 7)
    test.assert_eq(trace.sent[0][0:5], [0x16, handle & 0xFF, handle >>> 8, 0, 0])
    test.assert_eq(list.len(trace.sent[0]), 23)
    test.assert_eq(trace.sent[5][3:5], [90, 0])
    test.assert_eq(list.len(trace.sent[5]), 15)
    test.assert_eq(trace.sent[6], [0x18, 0x01])
    test.assert_eq(served(var s, handle), ramp(100))

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
