@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_a_stored_characteristic_answers_a_read_and_a_write_is_an_event_and_the_database_has_room_for_what_the_key_says()
    var ble = new_ble()
    test.assert(ble.add_service(noble.uuid16(0x180F)).svc == 0)
    let level = ble.add_char(noble.uuid16(0x2A19), noble.PROP_READ | noble.PROP_WRITE, noble.open_perms(), noble.Access.Open, 4)
    test.assert(level.status.is_ok())
    var t1 = value_of_byte(87)
    test.assert(ble.set_value(level.attr, var t1).is_ok())
    // A characteristic before a service, and an attribute that is no characteristic.
    var fresh = new_ble()
    let orphan = fresh.add_char(noble.uuid16(0x2A19), noble.PROP_READ, noble.open_perms(), noble.Access.Open, 1)
    test.assert(orphan.status.is(noble.LAYER_LOCAL, noble.E_BAD_ARGUMENT))
    test.assert(fresh.bind_event(level.attr).is(noble.LAYER_LOCAL, noble.E_BAD_ARGUMENT))
    var t2 = value_of_byte(1)
    test.assert(ble.set_value(noble.Attr { handle: 900, props: 0, cccd: 0 }, var t2).is(noble.LAYER_LOCAL, noble.E_NOT_FOUND))
    test.assert(ble.bind_function(noble.Attr { handle: 900, props: 0, cccd: 0 }).is(noble.LAYER_LOCAL, noble.E_NOT_FOUND))
    let conn = peripheral_up(var ble)
    central_sends(var ble, [0x0A, (level.attr.handle & 255) as u8, (level.attr.handle >> 8) as u8])
    test.assert_eq(list.len(ble.io.acl), 1)
    test.assert_eq(acl_att(ble.io, 0)[0] as Int, 0x0B)
    test.assert_eq(acl_att(ble.io, 0)[1] as Int, 87)
    // A write is stored and the application hears of it; the longest write is what `add_char` said.
    central_sends(var ble, [0x12, (level.attr.handle & 255) as u8, (level.attr.handle >> 8) as u8, 5, 6])
    test.assert_eq(acl_att(ble.io, 1)[0] as Int, 0x13)
    test.assert_eq(wait_kind(var ble, 10), EV_WRITTEN)
    central_sends(var ble, [0x12, (level.attr.handle & 255) as u8, (level.attr.handle >> 8) as u8, 1, 2, 3, 4, 5])
    test.assert_eq(acl_att(ble.io, 2)[0] as Int, 0x01)
    test.assert_eq(acl_att(ble.io, 2)[4] as Int, noble.ATT_INVALID_ATTRIBUTE_VALUE_LENGTH)
    test.assert(conn.slot < 255)

@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_a_function_valued_characteristic_asks_the_policy_with_the_index_of_its_service()
    var ble = new_ble()
    test.assert(ble.add_service(noble.uuid16(0x180F)).svc == 0)
    test.assert(ble.add_service(noble.uuid16(0xFFF0)).svc == 1)
    let cp = ble.add_char(noble.uuid16(0xFFF1), noble.PROP_READ | noble.PROP_WRITE, noble.open_perms(), noble.Access.Open, 4)
    test.assert(ble.bind_function(cp.attr).is_ok())
    let h0 = (cp.attr.handle & 255) as u8
    let h1 = (cp.attr.handle >> 8) as u8
    let _ = peripheral_up(var ble)
    ble.policy.read_byte = 42
    central_sends(var ble, [0x0A, h0, h1])
    test.assert_eq(acl_att(ble.io, 0)[0] as Int, 0x0B)
    test.assert_eq(acl_att(ble.io, 0)[1] as Int, 42)
    test.assert_eq(ble.policy.read_svc, 1)
    // A read at an offset takes the part after it; an offset past the end is refused.
    central_sends(var ble, [0x0C, h0, h1, 0, 0])
    test.assert_eq(acl_att(ble.io, 1)[0] as Int, 0x0D)
    central_sends(var ble, [0x0C, h0, h1, 9, 0])
    test.assert_eq(acl_att(ble.io, 2)[0] as Int, 0x01)
    test.assert_eq(acl_att(ble.io, 2)[4] as Int, noble.ATT_INVALID_OFFSET)
    // A policy that leaves the read alone answers Read Not Permitted; one that gives a code sends it.
    ble.policy.read_code = noble.NOT_HANDLED
    central_sends(var ble, [0x0A, h0, h1])
    test.assert_eq(acl_att(ble.io, 3)[4] as Int, noble.ATT_READ_NOT_PERMITTED)
    ble.policy.read_code = 0x80
    central_sends(var ble, [0x0A, h0, h1])
    test.assert_eq(acl_att(ble.io, 4)[4] as Int, 0x80)
    // A write reaches the policy, which accepts or refuses it; a command is not answered.
    central_sends(var ble, [0x12, h0, h1, 0x7F])
    test.assert_eq(acl_att(ble.io, 5)[0] as Int, 0x13)
    test.assert_eq(ble.policy.wrote, 0x7F)
    test.assert_eq(ble.policy.write_svc, 1)
    ble.policy.write_code = noble.ATT_VALUE_NOT_ALLOWED
    central_sends(var ble, [0x12, h0, h1, 0x01])
    test.assert_eq(acl_att(ble.io, 6)[4] as Int, noble.ATT_VALUE_NOT_ALLOWED)
    ble.policy.write_code = 0
    central_sends(var ble, [0x52, h0, h1, 0x33])
    test.assert_eq(list.len(ble.io.acl), 7)
    test.assert_eq(ble.policy.wrote, 0x33)
    test.assert_eq(ble.policy.writes, 3)
    // A value longer than the characteristic accepts is refused before the policy is asked.
    var long: [u8] = [0x12, h0, h1]
    for _ in 0..80
        list.push(long, 1)
    central_sends(var ble, long)
    test.assert_eq(acl_att(ble.io, 7)[0] as Int, 0x01)

@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_an_event_bound_characteristic_queues_the_request_and_respond_answers_it()
    var ble = new_ble()
    test.assert(ble.add_service(noble.uuid16(0x180F)).svc == 0)
    test.assert(ble.add_service(noble.uuid16(0xFFF0)).svc == 1)
    let c = ble.add_char(noble.uuid16(0xFFF1), noble.PROP_READ | noble.PROP_WRITE, noble.open_perms(), noble.Access.Open, 4)
    test.assert(ble.bind_event(c.attr).is_ok())
    let h0 = (c.attr.handle & 255) as u8
    let h1 = (c.attr.handle >> 8) as u8
    let conn = peripheral_up(var ble)
    // No request pending: nothing to answer.
    var t3 = value_of_byte(1)
    test.assert(ble.respond(conn, c.attr.handle, 0, var t3).is(noble.LAYER_LOCAL, noble.E_BUSY))
    list.push(ble.io.inbox, att_packet(0x41, [0x0A, h0, h1]))
    match ble.wait_event(50)
        Some(e) =>
            match e
                AttrRead(k, attr, svc) =>
                    test.assert_eq(k.slot as Int, conn.slot as Int)
                    test.assert_eq(attr as Int, c.attr.handle as Int)
                    test.assert_eq(svc, 1)
                _ => test.fail("a read of an event-bound attribute is queued")
        None => test.fail("a read of an event-bound attribute is queued")
    // The client waits: nothing was answered, and the policy was not asked.
    test.assert_eq(list.len(ble.io.acl), 0)
    test.assert_eq(ble.policy.reads, 0)
    var t4 = value_of_byte(77)
    test.assert(ble.respond(conn, c.attr.handle, 0, var t4).is_ok())
    ble.step()
    test.assert_eq(acl_att(ble.io, 0)[0] as Int, 0x0B)
    test.assert_eq(acl_att(ble.io, 0)[1] as Int, 77)
    var t5 = value_of_byte(1)
    test.assert(ble.respond(conn, c.attr.handle, 0, var t5).is(noble.LAYER_LOCAL, noble.E_BUSY))
    // A write carries its value, and the answer can be an error.
    list.push(ble.io.inbox, att_packet(0x41, [0x12, h0, h1, 5, 6]))
    match ble.wait_event(50)
        Some(e) =>
            match e
                AttrWrite(_, attr, svc, value) =>
                    test.assert_eq(value.len(), 2)
                    test.assert_eq(value[1] as Int, 6)
                _ => test.fail("a write of an event-bound attribute is queued")
        None => test.fail("a write of an event-bound attribute is queued")
    var nothing: noble.Value = Vec.new()
    test.assert(ble.respond(conn, c.attr.handle, noble.ATT_VALUE_NOT_ALLOWED, var nothing).is_ok())
    ble.step()
    test.assert_eq(acl_att(ble.io, 1)[0] as Int, 0x01)
    test.assert_eq(acl_att(ble.io, 1)[4] as Int, noble.ATT_VALUE_NOT_ALLOWED)
    // A second request while one waits is refused at once; a command is queued and needs no answer.
    list.push(ble.io.inbox, att_packet(0x41, [0x0A, h0, h1]))
    ble.step()
    list.push(ble.io.inbox, att_packet(0x41, [0x0A, h0, h1]))
    ble.step()
    test.assert_eq(acl_att(ble.io, 2)[0] as Int, 0x01)
    test.assert_eq(acl_att(ble.io, 2)[4] as Int, noble.ATT_UNLIKELY_ERROR)
    test.assert_eq(wait_kind(var ble, 10), EV_ATTR_READ)
    list.push(ble.io.inbox, att_packet(0x41, [0x52, h0, h1, 9]))
    ble.step()
    test.assert_eq(wait_kind(var ble, 10), EV_ATTR_WRITE)
    // The client gave up: the held request ends with the ATT timeout.
    var t6 = value_of_byte(1)
    test.assert(ble.respond(conn, c.attr.handle, 0, var t6).is_ok())
    list.push(ble.io.inbox, att_packet(0x41, [0x0A, h0, h1]))
    test.assert_eq(wait_kind(var ble, 50), EV_ATTR_READ)
    test.assert_eq(wait_kind(var ble, 31000), -1)
    var t7 = value_of_byte(1)
    test.assert(ble.respond(conn, c.attr.handle, 0, var t7).is(noble.LAYER_LOCAL, noble.E_BUSY))

@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_a_client_that_subscribes_is_an_event_and_notify_reaches_it_only_then_and_at_the_security_asked()
    var ble = new_ble()
    test.assert(ble.add_service(noble.uuid16(0x180D)).svc == 0)
    let hrm = ble.add_char(noble.uuid16(0x2A37), noble.PROP_NOTIFY, noble.Permissions { read: noble.Access.Denied, write: noble.Access.Denied }, noble.Access.Open, 2)
    let ind = ble.add_char(noble.uuid16(0x2A38), noble.PROP_INDICATE, noble.Permissions { read: noble.Access.Denied, write: noble.Access.Denied }, noble.Access.Open, 2)
    test.assert(hrm.attr.cccd != 0 and ind.attr.cccd != 0)
    let conn = peripheral_up(var ble)
    var t8 = value_of_byte(60)
    test.assert(ble.notify(conn, hrm.attr, noble.Security.Open, var t8).is(noble.LAYER_LOCAL, noble.E_NOT_SUBSCRIBED))
    var t9 = value_of_byte(60)
    test.assert_eq(ble.notify_all(hrm.attr, noble.Security.Open, var t9), 0)
    // The Client Characteristic Configuration descriptor is written: Subscribed, with the handle of the value.
    central_sends(var ble, [0x12, (hrm.attr.cccd & 255) as u8, (hrm.attr.cccd >> 8) as u8, 1, 0])
    test.assert_eq(acl_att(ble.io, 0)[0] as Int, 0x13)
    match ble.wait_event(10)
        Some(e) =>
            match e
                Subscribed(k, attr, mode) =>
                    test.assert_eq(k.slot as Int, conn.slot as Int)
                    test.assert_eq(attr as Int, hrm.attr.handle as Int)
                    test.assert_eq(mode as Int, 1)
                _ => test.fail("Subscribed is queued")
        None => test.fail("Subscribed is queued")
    var t10 = value_of_byte(60)
    test.assert(ble.notify(conn, hrm.attr, noble.Security.Encrypted, var t10).is(noble.LAYER_LOCAL, noble.E_SECURITY_LOW))
    var t11 = value_of_byte(61)
    test.assert(ble.notify(conn, hrm.attr, noble.Security.Open, var t11).is_ok())
    ble.step()
    test.assert_eq(acl_att(ble.io, 1)[0] as Int, 0x1B)
    test.assert_eq(acl_att(ble.io, 1)[3] as Int, 61)
    var t12 = value_of_byte(62)
    test.assert_eq(ble.notify_all(hrm.attr, noble.Security.Open, var t12), 1)
    ble.step()
    test.assert_eq(acl_att(ble.io, 2)[3] as Int, 62)
    // Writing zero is a Subscribed with mode 0, and notify is refused again.
    central_sends(var ble, [0x12, (hrm.attr.cccd & 255) as u8, (hrm.attr.cccd >> 8) as u8, 0, 0])
    match ble.wait_event(10)
        Some(e) =>
            match e
                Subscribed(_, _, mode) => test.assert_eq(mode as Int, 0)
                _ => test.fail("Subscribed is queued when the client unsubscribes")
        None => test.fail("Subscribed is queued when the client unsubscribes")
    var t13 = value_of_byte(63)
    test.assert(ble.notify(conn, hrm.attr, noble.Security.Open, var t13).is(noble.LAYER_LOCAL, noble.E_NOT_SUBSCRIBED))
    // A characteristic that indicates: the call ends with the client's confirmation.
    var t14 = value_of_byte(7)
    test.assert(ble.indicate(conn, ind.attr, var t14).is(noble.LAYER_LOCAL, noble.E_NOT_SUBSCRIBED))
    central_sends(var ble, [0x12, (ind.attr.cccd & 255) as u8, (ind.attr.cccd >> 8) as u8, 2, 0])
    test.assert_eq(wait_kind(var ble, 10), EV_SUBSCRIBED)
    ble.io.confirm = true
    var t15 = value_of_byte(7)
    test.assert(ble.indicate(conn, ind.attr, var t15).is_ok())
    var sent_indication = false
    for k in 0..list.len(ble.io.acl)
        if (acl_att(ble.io, k)[0] as Int) == 0x1D
            sent_indication = true
    test.assert(sent_indication)
    // A client that never confirms ends the call with a timeout.
    ble.io.confirm = false
    var t16 = value_of_byte(8)
    test.assert(ble.indicate(conn, ind.attr, var t16).is(noble.LAYER_LOCAL, noble.E_TIMEOUT))
    // A name that is stale is refused.
    test.assert(ble.disconnect(conn, noble.HCI_REMOTE_USER_TERMINATED).is_ok())
    var t17 = value_of_byte(1)
    test.assert(ble.notify(conn, hrm.attr, noble.Security.Open, var t17).is(noble.LAYER_LOCAL, noble.E_STALE))

// ── Services behind the pump ────────────────────────────────────────

// A service that keeps a switch: a write of 0 or 1 is taken, anything else is refused.
struct Switch
    var svc: Int
    var attr: noble.Attr
    var seen: Int
    var ticks: Int
    var events: Int

impl noble.Service[] for Switch
    fn attach(var self, var h: Host) -> Status
        let s = h.add_service(noble.uuid16(0xFFF0))
        if not s.status.is_ok()
            return s.status
        self.svc = s.svc
        let c = h.add_char(noble.uuid16(0xFFF1), noble.PROP_WRITE, noble.Permissions { read: noble.Access.Denied, write: noble.Access.Open }, noble.Access.Denied, 1)
        if not c.status.is_ok()
            return c.status
        self.attr = c.attr
        h.bind_event(c.attr)

    fn on_event(var self, ev: Event, var out: noble.Outbox) -> Bool
        self.events = self.events + 1
        match ev
            AttrWrite(conn, attr, svc, value) =>
                if svc != self.svc
                    return false
                let empty: noble.Value = Vec.new()
                if value.len() != 1 or value[0] > 1
                    let _ = out.push(noble.Out.Respond(conn, attr, noble.ATT_VALUE_NOT_ALLOWED, empty))
                    return true
                self.seen = value[0] as Int
                let _ = out.push(noble.Out.Respond(conn, attr, 0, empty))
                true
            _ => false

    fn tick(var self, now_ms: Int, var out: noble.Outbox)
        self.ticks = self.ticks + 1

@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_plug_attaches_a_service_and_the_pump_gives_it_the_events_and_answers_for_it()
    var ble = new_ble()
    var sw = Switch { svc: -1, attr: noble.Attr { handle: 0, props: 0, cccd: 0 }, seen: -1, ticks: 0, events: 0 }
    test.assert(ble.plug(var sw).is_ok())
    test.assert_eq(sw.svc, 0)
    // A characteristic of the product's own, in a service of its own, that no service module takes.
    test.assert_eq(ble.add_service(noble.uuid16(0xFFF3)).svc, 1)
    let own = ble.add_char(noble.uuid16(0xFFF2), noble.PROP_READ | noble.PROP_WRITE, noble.open_perms(), noble.Access.Open, 1)
    test.assert(own.status.is_ok())
    test.assert(ble.bind_event(own.attr).is_ok())
    let _ = peripheral_up(var ble)
    let sw0 = (sw.attr.handle & 255) as u8
    let sw1 = (sw.attr.handle >> 8) as u8
    list.push(ble.io.inbox, att_packet(0x41, [0x12, sw0, sw1, 1]))
    noble.pump(var ble, var sw, 50)
    test.assert_eq(sw.seen, 1)
    test.assert(sw.ticks >= 1)
    ble.step()
    test.assert_eq(acl_att(ble.io, 0)[0] as Int, 0x13)
    list.push(ble.io.inbox, att_packet(0x41, [0x12, sw0, sw1, 7]))
    noble.pump(var ble, var sw, 50)
    ble.step()
    test.assert_eq(sw.seen, 1)
    test.assert_eq(acl_att(ble.io, 1)[4] as Int, noble.ATT_VALUE_NOT_ALLOWED)
    // A request for an attribute no service owns is refused at once, whatever the service sees of it.
    let own0 = (own.attr.handle & 255) as u8
    let own1 = (own.attr.handle >> 8) as u8
    list.push(ble.io.inbox, att_packet(0x41, [0x12, own0, own1, 1]))
    noble.pump(var ble, var sw, 50)
    ble.step()
    test.assert_eq(acl_att(ble.io, 2)[4] as Int, noble.ATT_WRITE_NOT_PERMITTED)
    list.push(ble.io.inbox, att_packet(0x41, [0x0A, own0, own1]))
    noble.pump(var ble, var sw, 50)
    ble.step()
    test.assert_eq(acl_att(ble.io, 3)[4] as Int, noble.ATT_READ_NOT_PERMITTED)

// ── The GATT client over a server of the link ───────────────────────

// The database of the server the link plays: a Battery Service with a level (read, notify, a configuration descriptor), a control
// point (write) and a secret (nothing can be read).  The handles of the three values.
fn fake_battery(var l: ScriptLink) -> [Int]
    var out: [Int] = []
    match profile_builder.start_service(var l.srv.db, [0x0F, 0x18])
        Ok(_) => ()
        Err(_) => test.fail("the service is added")
    match profile_builder.add_value(var l.srv.db, 0x12, profile_builder.read_only(gatt_server.Access.Open), [0x19, 0x2A], [87])
        Ok(h) => list.push(out, h)
        Err(_) => test.fail("the level is added")
    match profile_builder.add_cccd(var l.srv.db, gatt_server.open_permissions())
        Ok(h) => list.push(out, h)
        Err(_) => test.fail("the descriptor is added")
    match profile_builder.add_value(var l.srv.db, 0x08, profile_builder.write_only(gatt_server.Access.Open), [0x1A, 0x2A], [0])
        Ok(h) => list.push(out, h)
        Err(_) => test.fail("the control point is added")
    match profile_builder.add_value(var l.srv.db, 0x02, profile_builder.write_only(gatt_server.Access.Open), [0x1B, 0x2A], [1])
        Ok(h) => list.push(out, h)
        Err(_) => test.fail("the secret is added")
    out

// Push the notification of the server's value `handle` to the Host.
fn server_notifies(var l: ScriptLink, handle: Int)
    for pdu in gatt_server.send_value(var l.srv.db, var l.srv.link, handle, l.now)
        list.push(l.inbox, att_packet(l.handle, pdu))

@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_the_adapter_discovers_reads_writes_and_subscribes_over_a_link_and_a_notification_is_an_event()
    var ble = new_ble()
    ble.io.serve = true
    let handles = fake_battery(var ble.io)
    test.assert(ble.start().is_ok())
    test.assert_eq(wait_kind(var ble, 0), 0)
    let up = ble.connect(peer_addr(0x55), noble.conn_params_default(), 5000)
    test.assert(up.status.is_ok())
    test.assert_eq(wait_kind(var ble, 0), EV_CONNECTED)
    test.assert(ble.exchange_mtu(up.conn).is_ok())
    match ble.conn_info(up.conn)
        Some(info) => test.assert((info.mtu as Int) > 23)
        None => test.fail("the link has a name")
    let battery = noble.uuid16(0x180F)
    test.assert(ble.discover(up.conn, noble.uuid16(0x1234)).is(noble.LAYER_LOCAL, noble.E_NOT_FOUND))
    test.assert(ble.discover(up.conn, battery).is_ok())
    match ble.find_char(up.conn, battery, noble.uuid16(0x2A19))
        None => test.fail("the level is in the cache")
        Some(level) =>
            test.assert_eq(level.handle as Int, handles[0])
            test.assert(level.cccd != 0)
            test.assert_eq((level.props as Int) & noble.PROP_NOTIFY, noble.PROP_NOTIFY)
            var v: noble.Value = Vec.new()
            test.assert(ble.read(up.conn, level, noble.Security.Open, var v).is_ok())
            test.assert_eq(v.len(), 1)
            test.assert_eq(v[0] as Int, 87)
            // A link below the security asked sends nothing.
            let sent = list.len(ble.io.acl)
            test.assert(ble.read(up.conn, level, noble.Security.Authenticated, var v).is(noble.LAYER_LOCAL, noble.E_SECURITY_LOW))
            test.assert_eq(list.len(ble.io.acl), sent)
            test.assert(ble.subscribe(up.conn, level, noble.NOTIFY, noble.Security.Open).is_ok())
            test.assert_eq(gatt_server.configuration(ble.io.srv.link, level.cccd as Int), 1)
            server_notifies(var ble.io, handles[0])
            match ble.wait_event(100)
                Some(e) =>
                    match e
                        Notification(k, attr, indication, value) =>
                            test.assert_eq(k.slot as Int, up.conn.slot as Int)
                            test.assert_eq(attr as Int, handles[0])
                            test.assert(not indication)
                            test.assert_eq(value[0] as Int, 87)
                        _ => test.fail("a notification is an event")
                None => test.fail("a notification is an event")
            // Three notifications at once: two fit, and the rest are counted.
            server_notifies(var ble.io, handles[0])
            server_notifies(var ble.io, handles[0])
            server_notifies(var ble.io, handles[0])
            test.assert_eq(wait_kind(var ble, 50), EV_NOTIFICATION)
            test.assert_eq(wait_kind(var ble, 50), EV_NOTIFICATION)
            match ble.wait_event(50)
                Some(e) =>
                    match e
                        Dropped(k) => test.assert_eq(k as Int, 1)
                        _ => test.fail("the notifications that did not fit are counted")
                None => test.fail("the notifications that did not fit are counted")
            test.assert(ble.unsubscribe(up.conn, level, noble.Security.Open).is_ok())
            test.assert_eq(gatt_server.configuration(ble.io.srv.link, level.cccd as Int), 0)
    match ble.find_char(up.conn, battery, noble.uuid16(0x2A1A))
        None => test.fail("the control point is in the cache")
        Some(control) =>
            var t18 = value_of_byte(9)
            test.assert(ble.write(up.conn, control, noble.Security.Open, var t18).is_ok())
            test.assert_eq(ble.io.srv.db.attributes[gatt_server.index_of(ble.io.srv.db, control.handle as Int)].value[0] as Int, 9)
            var t19 = value_of_byte(10)
            test.assert(ble.write_no_response(up.conn, control, noble.Security.Open, var t19).is_ok())
            test.assert_eq(ble.io.srv.db.attributes[gatt_server.index_of(ble.io.srv.db, control.handle as Int)].value[0] as Int, 10)
            // The control point cannot be read: the refusal keeps the number of ATT.
            var v: noble.Value = Vec.new()
            test.assert(ble.read(up.conn, control, noble.Security.Open, var v).is(noble.LAYER_ATT, noble.ATT_READ_NOT_PERMITTED))
            test.assert(ble.subscribe(up.conn, control, noble.NOTIFY, noble.Security.Open).is(noble.LAYER_LOCAL, noble.E_BAD_ARGUMENT))
    test.assert(ble.find_char(up.conn, battery, noble.uuid16(0x2A99)) == None)
    test.assert(ble.find_char(up.conn, noble.uuid16(0x1800), noble.uuid16(0x2A19)) == None)

// ── Two Hosts: the GATT client and server end to end ────────────────

@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_two_hosts_discover_read_write_subscribe_and_notify_through_the_requests_of_layer_a()
    var x = pair_up()
    let battery = noble.uuid16(0x180F)
    test.assert(x.b.add_service(battery).svc == 0)
    let level = x.b.add_char(noble.uuid16(0x2A19), noble.PROP_READ | noble.PROP_WRITE | noble.PROP_NOTIFY, noble.open_perms(), noble.Access.Open, 4)
    let computed = x.b.add_char(noble.uuid16(0x2A1A), noble.PROP_READ, noble.Permissions { read: noble.Access.Open, write: noble.Access.Denied }, noble.Access.Open, 1)
    test.assert(level.status.is_ok() and computed.status.is_ok())
    test.assert(x.b.set_value(level.attr, value_of_byte(87)).is_ok())
    test.assert(x.b.bind_function(computed.attr).is_ok())
    x.pb.read_byte = 0x2B
    // Discovery fills the cache of the Central; the cache is not radio traffic.
    test.assert(call_a(var x, Request.Discover(x.ca, battery)).is_ok())
    match host_api.find_char(x.a, x.ca, battery, noble.uuid16(0x2A19))
        None => test.fail("the level is in the cache")
        Some(found) =>
            test.assert_eq(found.handle as Int, level.attr.handle as Int)
            test.assert_eq(found.cccd as Int, level.attr.cccd as Int)
            test.assert(call_a(var x, Request.Read(x.ca, found, Security.Open)).is_ok())
            test.assert_eq(x.a.api.op.value[0] as Int, 87)
            // A write with a response is stored and reaches the application of the server as Written.
            test.assert(call_a(var x, Request.Write(x.ca, found, Security.Open, value_of_byte(66), true)).is_ok())
            test.assert_eq(next_kind(var x.b), EV_WRITTEN)
            test.assert(call_a(var x, Request.Read(x.ca, found, Security.Open)).is_ok())
            test.assert_eq(x.a.api.op.value[0] as Int, 66)
            // A subscription is an event of the server, and a notification one of the client.
            test.assert(call_a(var x, Request.Subscribe(x.ca, found, 1, Security.Encrypted)).is(noble.LAYER_LOCAL, noble.E_SECURITY_LOW))
            test.assert(call_a(var x, Request.Subscribe(x.ca, found, 1, Security.Open)).is_ok())
            test.assert_eq(next_kind(var x.b), EV_SUBSCRIBED)
            test.assert(host_api.notify(var x.b, x.cb, level.attr, Security.Open, value_of_byte(70)).is_ok())
            pump(var x, 4)
            match host_api.next_event(var x.a)
                Some(e) =>
                    match e
                        Notification(k, attr, indication, value) =>
                            test.assert_eq(attr as Int, level.attr.handle as Int)
                            test.assert_eq(value[0] as Int, 70)
                        _ => test.fail("a notification is an event")
                None => test.fail("a notification is an event")
            // The queue of four holds two notifications beside the slots kept for the state events; the others are counted.
            for k in 0..4
                test.assert(host_api.notify(var x.b, x.cb, level.attr, Security.Open, value_of_byte(80 + k)).is_ok())
            pump(var x, 6)
            test.assert_eq(next_kind(var x.a), EV_NOTIFICATION)
            test.assert_eq(next_kind(var x.a), EV_NOTIFICATION)
            test.assert_eq(next_kind(var x.a), EV_DROPPED)
            test.assert_eq(next_kind(var x.a), -1)
            // And a Central unsubscribes with mode 0.
            test.assert(call_a(var x, Request.Subscribe(x.ca, found, 0, Security.Open)).is_ok())
            test.assert(host_api.notify(var x.b, x.cb, level.attr, Security.Open, value_of_byte(71)).is(noble.LAYER_LOCAL, noble.E_NOT_SUBSCRIBED))
    match host_api.find_char(x.a, x.ca, battery, noble.uuid16(0x2A1A))
        None => test.fail("the computed value is in the cache")
        Some(found) =>
            test.assert(call_a(var x, Request.Read(x.ca, found, Security.Open)).is_ok())
            test.assert_eq(x.a.api.op.value[0] as Int, 0x2B)
            test.assert_eq(x.pb.read_svc, 0)
            // A write to a value that does not accept one keeps the code of ATT.
            test.assert(call_a(var x, Request.Write(x.ca, found, Security.Open, value_of_byte(1), true)).is(noble.LAYER_ATT, noble.ATT_WRITE_NOT_PERMITTED))
    test.assert(call_a(var x, Request.ExchangeMtu(x.ca)).is_ok())
    // The server indicates, and the Central confirms it.
    match host_api.find_char(x.a, x.ca, battery, noble.uuid16(0x2A19))
        None => test.fail("the level is in the cache")
        Some(found) =>
            test.assert(call_a(var x, Request.Subscribe(x.ca, found, 2, Security.Open)).is_ok())
            test.assert_eq(next_kind(var x.b), EV_SUBSCRIBED)
            let begun = host_api.begin(var x.b, Request.Indicate(x.cb, level.attr, value_of_byte(5)))
            test.assert(begun.is_ok())
            var done = false
            for _ in 0..40
                pump(var x, 1)
                match host_api.result(var x.b)
                    Some(st) =>
                        test.assert(st.is_ok())
                        done = true
                        break
                    None => ()
            test.assert(done)
            match host_api.next_event(var x.a)
                Some(e) =>
                    match e
                        Notification(_, _, indication, value) =>
                            test.assert(indication)
                            test.assert_eq(value[0] as Int, 5)
                        _ => test.fail("an indication is an event")
                None => test.fail("an indication is an event")
