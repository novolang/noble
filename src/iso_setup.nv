// iso_setup.nv -- what the Host does at start to use isochronous
// channels.
//
// A Controller that carries isochronous channels reports it in its LE
// feature set ([Vol 6] Part B, Section 4.6): bit 28 Connected Isochronous
// Stream - Central, bit 29 Connected Isochronous Stream - Peripheral, bit 30
// Isochronous Broadcaster and bit 31 Synchronized Receiver.  Four things
// follow from what it reports, and none of them is done for a Controller that
// reports none of the four bits:
//
//   1. LE Read Buffer Size [v2] gives the size and the number of the
//      Controller's HCI ISO Data packet buffers ([Vol 4] Part E, Section
//      7.8.2); `iso_flow.iso_credits_configure` takes the answer.
//   2. LE Set Event Mask enables the isochronous events, the ones of the
//      roles the Controller reports ([Vol 4] Part E, Section 7.8.1).  The
//      Controller sends none of them while its bit is clear.
//   3. LE Set Host Feature sets bit 32, Connected Isochronous Stream (Host
//      Support), in the Controller's feature set ([Vol 4] Part E, Section
//      7.8.115, and [Vol 6] Part B, Section 4.6.33.1).  A Controller sets
//      that bit only if it supports one of the two CIS roles, so the command
//      is sent for those and not for a Controller that is only a
//      Broadcaster or a Receiver.  It is Command Disallowed while the
//      Controller has a connection to another device, so it goes before any
//      connection exists.
//   4. The CIS table (`iso_cis.cis_host_support`) learns that the bit is set,
//      which LE Create CIS needs.
//
// `IsoBringUp` walks the steps in that order, one command at a time; the
// caller sends the command a step names and hands the answer back.  A
// refused command ends the bring-up in `Failed`: a Controller that refuses
// to enable the events or to take the feature cannot be used for
// isochronous channels, and the Host carries on without them.
//
// Satisfies: REQ-BLE-ISO-006.

use hci_commands
use hci_codec
use iso_cis
use iso_flow
// The bits of the LE feature set the bring-up reads ([Vol 6] Part B,
// Section 4.6).
const FEATURE_CIS_CENTRAL = 28

const FEATURE_CIS_PERIPHERAL = 29

const FEATURE_ISOCHRONOUS_BROADCASTER = 30

const FEATURE_SYNCHRONIZED_RECEIVER = 31

// What the Controller reports.
@value
struct IsoFeatures
    cis_central: Bool
    cis_peripheral: Bool
    broadcaster: Bool
    receiver: Bool

// Whether bit `bit` of the 8-octet LE feature set `features` is set: bit N
// is bit N mod 8 of octet N / 8.  A feature set shorter than the bit needs
// reports it clear.
@tier(embedded)
@no_alloc
fn le_feature_bit(features: [u8], bit: Int) -> Bool
    let octet = bit / 8
    octet >= 0 and octet < list.len(features) and ((features[octet] as Int >> (bit % 8)) & 1) == 1

@satisfies("REQ-BLE-ISO-006")
@tier(embedded)
fn iso_features(features: [u8]) -> IsoFeatures
    IsoFeatures {
        cis_central: le_feature_bit(features, FEATURE_CIS_CENTRAL),
        cis_peripheral: le_feature_bit(features, FEATURE_CIS_PERIPHERAL),
        broadcaster: le_feature_bit(features, FEATURE_ISOCHRONOUS_BROADCASTER),
        receiver: le_feature_bit(features, FEATURE_SYNCHRONIZED_RECEIVER) }

// Whether the Controller supports any isochronous channel.
@tier(embedded)
@no_alloc
fn iso_supported(f: IsoFeatures) -> Bool
    f.cis_central or f.cis_peripheral or f.broadcaster or f.receiver

// Whether the Controller supports a CIS role, which the Host Support bit
// needs.
@tier(embedded)
@no_alloc
fn iso_has_cis(f: IsoFeatures) -> Bool
    f.cis_central or f.cis_peripheral

// The LE event mask: `base`, the events the Host enables already, with the
// events of the roles in `f` added.  CIS Established is enabled in both of
// its forms, [v1] and [v2] (bits 24 and 41), because the specification does
// not say which a Controller sends when both are enabled and the Host reads
// either; LE CIS Request (bit 25) only for a Peripheral; the Broadcaster's
// two BIG events (bits 26 and 27) for a Broadcaster; the Receiver's two
// (bits 28 and 29) and the BIGInfo Advertising Report (bit 33) for a
// Receiver.  A role the Controller does not report adds nothing.
@satisfies("REQ-BLE-ISO-006")
@tier(embedded)
@no_alloc
fn iso_event_mask(base: Int, f: IsoFeatures) -> Int
    var mask = base
    if iso_has_cis(f)
        mask = mask | hci_commands.LE_EVENT_MASK_CIS_ESTABLISHED | hci_commands.LE_EVENT_MASK_CIS_ESTABLISHED_V2
    if f.cis_peripheral
        mask = mask | hci_commands.LE_EVENT_MASK_CIS_REQUEST
    if f.broadcaster
        mask = mask | hci_commands.LE_EVENT_MASK_BIG_BROADCASTER
    if f.receiver
        mask = mask | hci_commands.LE_EVENT_MASK_BIG_RECEIVER | hci_commands.LE_EVENT_MASK_BIG_INFO_ADVERTISING_REPORT
    mask

// The command the isochronous bring-up sends next, or that it is done or failed.
pub @value
enum BringUpStep
    // LE Read Buffer Size [v2] is next.
    ReadBufferSize
    // LE Set Event Mask is next.
    SetEventMask
    // LE Set Host Feature is next.
    SetHostFeature
    // Nothing more to send: the bring-up is complete, or the Controller
    // reports no isochronous channel and there was nothing to do.
    Done
    // A command was refused.
    Failed

// The state of the isochronous bring-up: the step it is at, the features the Controller reported and the LE event
// mask to set.
pub @value
struct IsoBringUp
    step: BringUpStep
    features: IsoFeatures
    mask: Int
    // The step that was refused, when `step` is `Failed`.
    failed_at: BringUpStep
    // Whether a Controller with a CIS role took the Host Support bit.
    host_support: Bool

// The bring-up for a Controller whose LE feature set is `le_features`, with
// `base_mask` as the LE event mask the Host enables already.  A Controller
// that reports no isochronous channel starts at `Done`, with the mask as it
// was.
pub @satisfies("REQ-BLE-ISO-006")
@tier(embedded)
fn iso_bringup_new(le_features: [u8], base_mask: Int) -> IsoBringUp
    let f = iso_features(le_features)
    let step = if iso_supported(f)
        BringUpStep.ReadBufferSize
    else
        BringUpStep.Done
    IsoBringUp {
        step: step, features: f, mask: iso_event_mask(base_mask, f),
        failed_at: BringUpStep.Done, host_support: false }

// The step after `step`: the Host Support bit is for a Controller with a CIS
// role only.
@tier(embedded)
fn iso_bringup_after(b: IsoBringUp, step: BringUpStep) -> BringUpStep
    match step
        BringUpStep.ReadBufferSize => BringUpStep.SetEventMask
        BringUpStep.SetEventMask   => if iso_has_cis(b.features)
            BringUpStep.SetHostFeature
        else
            BringUpStep.Done
        _                          => BringUpStep.Done

// The answer to the command the current step names, as its Status.  A
// failure ends the bring-up and keeps the step it failed in; a success moves
// to the next step.  An answer when no command is waiting changes nothing.
pub @satisfies("REQ-BLE-ISO-006")
@tier(embedded)
fn iso_bringup_answer(var b: IsoBringUp, status: Int) -> BringUpStep
    if b.step == BringUpStep.Done or b.step == BringUpStep.Failed
        return b.step
    if status != 0
        b.failed_at = b.step
        b.step = BringUpStep.Failed
        return b.step
    if b.step == BringUpStep.SetHostFeature
        b.host_support = true
    b.step = iso_bringup_after(b, b.step)
    b.step

// The answer to LE Read Buffer Size [v2], as the Command Complete event.  A
// refused command, an answer that is too short, and one that leaves the ISO
// buffer length or count at 0 (the Controller carries no HCI ISO Data
// packet) fail the step; otherwise the pool takes the sizes.
pub @satisfies("REQ-BLE-ISO-006")
@tier(embedded)
fn iso_bringup_buffer_size(var b: IsoBringUp, var credits: iso_flow.IsoCredits,
                           evt: [u8]) -> BringUpStep
    if b.step != BringUpStep.ReadBufferSize
        return b.step
    let status = hci_codec.command_complete_status(evt)
    if status != 0
        return iso_bringup_answer(var b, (if status < 0 then 0xFF else status))
    match hci_codec.le_buffer_size_v2(hci_codec.command_complete_return_parameters(evt))
        None        => iso_bringup_answer(var b, 0xFF)
        Some(sizes) =>
            if iso_flow.iso_credits_configure(var credits, sizes)
                iso_bringup_answer(var b, 0)
            else
                iso_bringup_answer(var b, 0xFF)

// Hand the outcome of the bring-up to the CIS table: Create CIS is allowed
// when the Controller took the Host Support bit.
pub @satisfies("REQ-BLE-ISO-006")
@tier(embedded)
@no_alloc
fn iso_bringup_finish(b: IsoBringUp, var cis: iso_cis.CisTable)
    iso_cis.cis_host_support(var cis, b.host_support)

// The command the current step sends, or None at `Done` and `Failed`.
// It builds lists, so it is application-tier; a program without a heap
// builds the same parameter octets with the builders of `hci_commands`.
pub @satisfies("REQ-BLE-ISO-006")
@tier(app)
fn iso_bringup_command(b: IsoBringUp) -> ?HciCmdMsg
    match b.step
        BringUpStep.ReadBufferSize => Some(HciCmdMsg { opcode: hci_commands.opcode_le_read_buffer_size_v2(), params: [] })
        BringUpStep.SetEventMask   => Some(HciCmdMsg { opcode: hci_commands.opcode_le_set_event_mask(),
            params: hci_commands.build_set_event_mask(b.mask) })
        BringUpStep.SetHostFeature => Some(HciCmdMsg { opcode: hci_commands.opcode_le_set_host_feature(),
            params: hci_commands.build_le_set_host_feature(hci_commands.FEATURE_CONNECTED_ISOCHRONOUS_STREAM_HOST_SUPPORT, true) })
        _                          => None

// ── Events of a Controller, for fakes and tests ─────────────────────────

// An LE feature set with the bits `bits` set.
pub @tier(app)
fn feature_set(bits: [Int]) -> [u8]
    var out: [u8] = [0, 0, 0, 0, 0, 0, 0, 0]
    for b in bits
        out[b / 8] = (out[b / 8] as Int | (1 << (b % 8))) as u8
    out

// A Command Complete event for `opcode` with `status` and the return
// parameters `rp`.
pub @tier(app)
fn complete(opcode: Int, status: Int, rp: [u8]) -> [u8]
    var evt: [u8] = [0x0E,
        (4 + list.len(rp)) as u8,
        0x01,
        (opcode & 0xFF) as u8,
        ((opcode >>> 8) & 0xFF) as u8,
        status as u8]
    list.append(evt, rp)
    evt

// The return parameters of LE Read Buffer Size [v2] after Status: ACL
// 251 octets and 3 packets, ISO `iso_length` octets and `iso_total` packets.
pub @tier(app)
fn buffer_size_return(iso_length: Int, iso_total: Int) -> [u8]
    [0xFB,
        0x00,
        0x03,
        (iso_length & 0xFF) as u8,
        ((iso_length >>> 8) & 0xFF) as u8,
        iso_total as u8]
