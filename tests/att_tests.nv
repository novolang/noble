use att

// ── Tests ───────────────────────────────────────────────────────────

@test
@satisfies("REQ-BLE-ATT-PDU-001")
fn test_opcode_field_extraction()
    // 0x52 = 0101 0010 — bit 6 (command) set, bit 7 (signed) clear,
    // method = 0x12: the write command.
    test.assert_eq(opcode_method(0x52), 0x12)
    test.assert_eq(opcode_is_command(0x52), true)
    test.assert_eq(opcode_is_signed(0x52), false)

    // 0xD2 = 1101 0010 — both top bits set: signed-write command.
    test.assert_eq(opcode_method(0xD2), 0x12)
    test.assert_eq(opcode_is_command(0xD2), true)
    test.assert_eq(opcode_is_signed(0xD2), true)

    // 0x0A = 0000 1010 — plain READ_REQ (request, not signed).
    test.assert_eq(opcode_method(0x0A), 0x0A)
    test.assert_eq(opcode_is_command(0x0A), false)
    test.assert_eq(opcode_is_signed(0x0A), false)

@test
@satisfies("REQ-BLE-ATT-PDU-002")
fn test_error_rsp_shape()
    // ERROR_RSP for READ_REQ on handle 0x000F with INVALID_HANDLE.
    let e = build_error_rsp(ATT_OP_READ_REQ, 0x000F, ATT_ERR_INVALID_HANDLE)
    test.assert_eq(list.len(e), 5)
    test.assert_eq(e[0] as Int, 0x01)   // opcode
    test.assert_eq(e[1] as Int, 0x0A)   // request opcode (READ)
    test.assert_eq(e[2] as Int, 0x0F)   // handle lo
    test.assert_eq(e[3] as Int, 0x00)   // handle hi
    test.assert_eq(e[4] as Int, 0x01)   // err code

@test
@satisfies("REQ-BLE-ATT-PDU-002")
fn test_error_rsp_request_not_supported()
    let e = build_error_rsp(ATT_OP_WRITE_REQ, 0x0000, ATT_ERR_REQUEST_NOT_SUPPORTED)
    test.assert_eq(e[1] as Int, ATT_OP_WRITE_REQ)
    test.assert_eq(e[4] as Int, ATT_ERR_REQUEST_NOT_SUPPORTED)

@test
@satisfies("REQ-BLE-ATT-PDU-003")
fn test_exchange_mtu_req_round_trip()
    let req: [u8] = [ATT_OP_EXCHANGE_MTU_REQ, 0x17, 0x00]
    test.assert_eq(read_exchange_mtu_req_mtu(req), 23)

    let rsp = build_exchange_mtu_rsp(23)
    test.assert_eq(list.len(rsp), 3)
    test.assert_eq(rsp[0] as Int, ATT_OP_EXCHANGE_MTU_RSP)
    test.assert_eq(rsp[1] as Int, 0x17)
    test.assert_eq(rsp[2] as Int, 0x00)

