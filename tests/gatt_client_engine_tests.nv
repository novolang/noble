// ── Subscriptions, notifications and indications ────────────────────

// Subscribe to the characteristic at 0x001C (CCCD 0x001D) with `mode` and
// run the write.
fn subscribe(var t: gatt_client.ClientTable, link: links.LinkId, var s: gatt_server.GattServer,
             mode: Int)
    test.assert_eq(run(var t, link, var s, gatt_client.begin_subscribe(var t, link, 0, 0x001D, mode)), 0)

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_subscription_is_a_write_of_the_configuration_descriptor()
    var t = table()
    var s = server()
    var trace = new_log()
    let _ = gatt_client.begin_subscribe(var t, link_a(), 0, 0x001D, gatt_client.CCCD_NOTIFY)
    pump(var t, link_a(), var s, var trace)
    test.assert_eq(trace.sent[0], [0x12, 0x1D, 0x00, 0x01, 0x00])
    test.assert_eq(trace.statuses, [0])
    test.assert_eq(gatt_server.configuration(s.link, 0x001D), 1)

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_notification_is_reported_with_its_handle_and_value()
    var t = table()
    var s = server()
    subscribe(var t, link_a(), var s, gatt_client.CCCD_NOTIFY)
    test.assert(gatt_server.set_value(var s.db, 0x001C, [0x42, 0x43]))
    var trace = new_log()
    for pdu in gatt_server.send_value(var s.db, var s.link, 0x001C, 0)
        deliver(var t, link_a(), 0, pdu, var trace)
    test.assert_eq(trace.events, [gatt_client.EV_NOTIFICATION])
    test.assert_eq(trace.notified, [0x001C])
    test.assert_eq(trace.pushed, [[0x42, 0x43]])
    // A notification is not confirmed.
    var out: gatt_client.ClientPdu = Vec.new()
    test.assert_eq(gatt_client.take_tx(var t, link_a(), 0, 0, var out), gatt_client.TX_NONE)

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_an_indication_is_reported_and_confirmed()
    var t = table()
    var s = server()
    subscribe(var t, link_a(), var s, gatt_client.CCCD_INDICATE)
    test.assert(gatt_server.set_value(var s.db, 0x001C, [0x11]))
    var trace = new_log()
    for pdu in gatt_server.send_value(var s.db, var s.link, 0x001C, 0)
        deliver(var t, link_a(), 0, pdu, var trace)
    test.assert_eq(trace.events, [gatt_client.EV_INDICATION])
    test.assert_eq(trace.pushed, [[0x11]])
    test.assert_eq(s.link.bearers[0].indicating, 0x001C)
    pump(var t, link_a(), var s, var trace)
    test.assert_eq(trace.kinds, [gatt_client.TX_CONFIRM])
    test.assert_eq(trace.sent[0], [0x1E])
    test.assert_eq(s.link.bearers[0].indicating, 0)

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_the_next_indication_follows_the_confirmation_of_the_one_before()
    var t = table()
    var s = server()
    subscribe(var t, link_a(), var s, gatt_client.CCCD_INDICATE)
    var trace = new_log()
    test.assert(gatt_server.set_value(var s.db, 0x001C, [0x01]))
    for pdu in gatt_server.send_value(var s.db, var s.link, 0x001C, 0)
        deliver(var t, link_a(), 0, pdu, var trace)
    test.assert(gatt_server.set_value(var s.db, 0x001C, [0x02]))
    test.assert_eq(list.len(gatt_server.send_value(var s.db, var s.link, 0x001C, 0)), 0)
    var next: [[u8]] = []
    var out: gatt_client.ClientPdu = Vec.new()
    test.assert_eq(gatt_client.take_tx(var t, link_a(), 0, 0, var out), gatt_client.TX_CONFIRM)
    next = gatt_server.receive_on(var s.db, var s.link, 0, from_pdu(out, out.len()), 0)
    test.assert_eq(list.len(next), 1)
    deliver(var t, link_a(), 0, next[0], var trace)
    test.assert_eq(trace.pushed, [[0x01], [0x02]])
    test.assert_eq(trace.events, [gatt_client.EV_INDICATION, gatt_client.EV_INDICATION])

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
