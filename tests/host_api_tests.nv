@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_a_full_queue_drops_and_counts_adverts_and_still_delivers_the_state_events_of_a_connection()
    var h = new_host(2)
    var l = script_link()
    var p = test_policy()
    var b = new_store()
    started(var h, var l, var p, var b)
    for i in 0..6
        list.push(l.inbox, report_event(i + 1, -60))
    run(var h, var l, var p, var b, 2)
    test.assert_eq(p.adverts, 6)
    // Four slots, two kept for the two connections: two adverts fit.
    list.push(l.inbox, connection_complete(0, 0x41, 1, peer_octets(0x31)))
    run(var h, var l, var p, var b, 1)
    list.push(l.inbox, disconnection_complete(0x41, 0x13))
    run(var h, var l, var p, var b, 1)
    test.assert_eq(next_kind(var h), EV_ADVERT)
    test.assert_eq(next_kind(var h), EV_ADVERT)
    test.assert_eq(next_kind(var h), EV_CONNECTED)
    test.assert_eq(next_kind(var h), EV_DISCONNECTED)
    match host_api.next_event(var h)
        Some(e) =>
            match e
                Dropped(n) => test.assert_eq(n as Int, 4)
                _ => test.fail("Dropped is reported once the queue is empty")
        None => test.fail("Dropped is reported once the queue is empty")
    test.assert_eq(next_kind(var h), -1)

