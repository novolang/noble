// gap.nv — Generic Access Profile.
//
// GAP sits above the LL and below the application: it owns the
// roles a device plays (Peripheral / Central / Broadcaster /
// Observer), the discoverability + connectability modes that map
// to AD flags + advertising parameters, and the procedure shells
// (general / limited discovery, auto / direct connection
// establishment) that wrap LL primitives into spec-named flows.
//
// Surface in this module (Peripheral-focused; the Central-side
// scanning / initiating helpers are stubs):
//
//   Role             marker enum (Peripheral / Central / Broadcaster /
//                    Observer)
//   DiscoverableMode Non / Limited / General → AD flag bits
//   ConnectableMode  Non / Directed / Undirected (advertising side)
//   ad_flags_for     map (DiscoverableMode, transport_only_le) → AD
//                    flags byte
//   build_ad_flags_record  / build_local_name_record
//                    AD record builders for the advertising payload
//
// Satisfies: REQ-BLE-GAP-001 (role marker), REQ-BLE-GAP-002
// (discoverable-mode flag mapping), REQ-BLE-GAP-003 (connectable-
// mode classification), REQ-BLE-GAP-004 (AD record builders).

// ── Roles (Vol 3 Part C §2.2) ──────────────────────────────────────
//
// The four GAP roles a device may take.  Marker enum used for
// type-checking which procedures are valid in which mode.
enum Role
    Peripheral
    Central
    Broadcaster
    Observer

// ── Discoverable mode (Vol 3 Part C §9.2) ──────────────────────────
//
//   Non         not advertising — invisible to scanners
//   Limited     advertising for ~30 s with LIMITED_DISCOVERABLE_MODE
//               flag set (used for one-shot pairings)
//   General     advertising indefinitely with GENERAL_DISCOVERABLE_MODE
//               flag set (the common case for an always-on device)
enum DiscoverableMode
    NonDiscoverable
    LimitedDiscoverable
    GeneralDiscoverable

// ── Connectable mode (Vol 3 Part C §9.3) ───────────────────────────
//
//   Non                 ADV_NONCONN_IND / ADV_SCAN_IND on the wire —
//                       receiver can't initiate a connection.
//   DirectedConnectable ADV_DIRECT_IND, peer_addr in the AdvA field —
//                       only the named peer can connect (high-duty
//                       reconnect after bond).
//   UndirectedConnectable ADV_IND — any scanner may CONNECT_IND.  The
//                       common case.
enum ConnectableMode
    NonConnectable
    DirectedConnectable
    UndirectedConnectable

// ── Advertising Data (AD) flag bits, Vol 3 Part C §11.1.3 ──────────
//
//   bit 0  LE Limited Discoverable Mode
//   bit 1  LE General Discoverable Mode
//   bit 2  BR/EDR Not Supported
//   bit 3  Simultaneous LE + BR/EDR (Controller)
//   bit 4  Simultaneous LE + BR/EDR (Host)
const AD_FLAG_LE_LIMITED_DISC = 0x01
const AD_FLAG_LE_GENERAL_DISC = 0x02
const AD_FLAG_BR_EDR_NOT_SUPPORTED = 0x04
const AD_FLAG_LE_BR_EDR_CONTROLLER = 0x08
const AD_FLAG_LE_BR_EDR_HOST = 0x10

// AD record types (Core Specification Supplement §1).  The server
// uses the basic four:
const AD_TYPE_FLAGS = 0x01
const AD_TYPE_INCOMPLETE_LIST_16 = 0x02  // incomplete service UUID list (16-bit)
const AD_TYPE_COMPLETE_LIST_16 = 0x03  // complete service UUID list (16-bit)
const AD_TYPE_SHORTENED_LOCAL_NAME = 0x08
const AD_TYPE_COMPLETE_LOCAL_NAME = 0x09
const AD_TYPE_TX_POWER_LEVEL = 0x0A
const AD_TYPE_APPEARANCE = 0x19
const AD_TYPE_SERVICE_DATA_16 = 0x16  // service data (16-bit UUID)

// ── DiscoverableMode → AD flag bits ────────────────────────────────
//
// Per Vol 3 Part C §9.2 — the AD payload's Flags byte must have
// the right LE-discoverable bit set for the chosen mode.
// `le_only` = true for typical BLE-only devices; sets the
// BR/EDR Not Supported bit.
@satisfies("REQ-BLE-GAP-002")
@tier(embedded)
@no_alloc
fn discoverable_mode_flag(mode: DiscoverableMode) -> Int
    match mode
        NonDiscoverable     => 0
        LimitedDiscoverable => AD_FLAG_LE_LIMITED_DISC
        GeneralDiscoverable => AD_FLAG_LE_GENERAL_DISC

@satisfies("REQ-BLE-GAP-002")
@tier(embedded)
@no_alloc
fn ad_flags_for(mode: DiscoverableMode, le_only: Bool) -> Int
    let mode_bit = discoverable_mode_flag(mode)
    if le_only
        mode_bit | AD_FLAG_BR_EDR_NOT_SUPPORTED
    else
        mode_bit

// ── Mode classification helpers for tests / dispatchers ────────────
@tier(embedded)
fn discoverable_mode_name(m: DiscoverableMode) -> Str
    match m
        NonDiscoverable     => "Non"
        LimitedDiscoverable => "Limited"
        GeneralDiscoverable => "General"

@tier(embedded)
fn connectable_mode_name(m: ConnectableMode) -> Str
    match m
        NonConnectable        => "Non"
        DirectedConnectable   => "Directed"
        UndirectedConnectable => "Undirected"

@tier(embedded)
fn role_name(r: Role) -> Str
    match r
        Peripheral  => "Peripheral"
        Central     => "Central"
        Broadcaster => "Broadcaster"
        Observer    => "Observer"

// ── AD record builders ─────────────────────────────────────────────
//
// Each AD record on-the-wire is:
//
//   length:u8 | type:u8 | data:[u8 length-1]
//
// where length counts type + data (so length = data_len + 1).

// Flags record — 1 byte of flag bits.  Fixed shape.
@satisfies("REQ-BLE-GAP-004")
@tier(embedded)
fn build_ad_flags_record(flags: Int) -> [u8]
    [0x02, AD_TYPE_FLAGS, (flags & 0xFF) as u8]

// Complete Local Name record — len = 1 + len(name).
@satisfies("REQ-BLE-GAP-004")
@tier(embedded)
fn build_local_name_record(name: [u8]) -> [u8]
    var header: [u8] = list.with_capacity(2 + list.len(name))
    list.append(header, [(list.len(name) + 1) as u8, AD_TYPE_COMPLETE_LOCAL_NAME])
    list.append(header, name)
    header

// Complete List of 16-bit Service UUIDs.  Each UUID = 2 bytes LE.
// Caller passes the flat byte sequence — i.e. for [0x180D, 0x180F]
// it should pass [0x0D 0x18 0x0F 0x18].
@satisfies("REQ-BLE-GAP-004")
@tier(embedded)
fn build_complete_list_16_record(uuids_le: [u8]) -> [u8]
    var header: [u8] = list.with_capacity(2 + list.len(uuids_le))
    list.append(header, [(list.len(uuids_le) + 1) as u8, AD_TYPE_COMPLETE_LIST_16])
    list.append(header, uuids_le)
    header

// Appearance record — the 16-bit appearance value, least significant
// octet first.
@satisfies("REQ-BLE-GAP-004")
@tier(embedded)
fn build_appearance_record(appearance: Int) -> [u8]
    [0x03, AD_TYPE_APPEARANCE, (appearance & 0xFF) as u8, ((appearance >>> 8) & 0xFF) as u8]

// Service Data record for the 16-bit service `uuid`: the UUID, least
// significant octet first, then `data`.
pub @satisfies("REQ-BLE-GAP-004")
@tier(embedded)
fn build_service_data_16_record(uuid: Int, data: [u8]) -> [u8]
    var record: [u8] = list.with_capacity(4 + list.len(data))
    list.append(record, [(list.len(data) + 3) as u8,
        AD_TYPE_SERVICE_DATA_16,
        (uuid & 0xFF) as u8,
        ((uuid >>> 8) & 0xFF) as u8])
    list.append(record, data)
    record

// Advertising data for a device in General Discoverable mode
// ([Vol 3] Part C, Section 9.2.4): the Flags AD record followed by the
// Complete Local Name AD record.  The caller checks
// the result against the 31-byte limit of the advertising field.
@satisfies("REQ-BLE-GAP-004")
@tier(embedded)
fn build_flags_and_name_ad(flags: Int, name: [u8]) -> [u8]
    var ad = build_ad_flags_record(flags)
    list.append(ad, build_local_name_record(name))
    ad

// ── Discovery procedures (Vol 3 Part C §9.2.5 and §9.2.6) ──────────

// The flag octet of the first Flags AD type in advertising data made of
// AD structures, or None when there is none.  An AD structure whose
// Length is zero ends the significant part of the data ([Vol 3] Part C,
// Section 11), and so does one that runs past the end.
@tier(embedded)
fn ad_flags_of(ad: [u8]) -> ?Int
    let n = list.len(ad)
    // `next` is the offset of the next AD structure's Length octet; each
    // structure takes at least one octet, so `n` passes reach them all.
    var next = 0
    for at in 0..n
        if at == next
            let len = ad[at] as Int
            if len == 0 or at + 1 + len > n
                return None
            if (ad[at + 1] as Int) == AD_TYPE_FLAGS and len >= 2
                return Some(ad[at + 2] as Int)
            next = at + 1 + len
    None

// The data of the first Complete Local Name AD type in data made of AD
// structures, or None when there is none; the walk is that of
// `ad_flags_of`.
pub @tier(embedded)
fn complete_local_name_of(ad: [u8]) -> ?[u8]
    let n = list.len(ad)
    var next = 0
    for at in 0..n
        if at == next
            let len = ad[at] as Int
            if len == 0 or at + 1 + len > n
                return None
            if (ad[at + 1] as Int) == AD_TYPE_COMPLETE_LOCAL_NAME
                return Some(ad[at + 2:at + 1 + len])
            next = at + 1 + len
    None

// Whether a Host performing the Limited Discovery procedure (`limited`)
// or the General Discovery procedure considers the device that sent the
// advertising data `ad` a discovered device.  The limited procedure
// takes a device whose Flags AD type has the LE Limited Discoverable
// Mode flag set; the general procedure takes either that flag or the LE
// General Discoverable Mode flag.  Advertising data with no Flags AD
// type is ignored, and the Simultaneous LE and BR/EDR to Same Device
// Capable (Controller) bit plays no part ([Vol 3] Part C, Sections
// 9.2.5.2 and 9.2.6.2).
pub @tier(embedded)
@no_alloc
fn is_discovered(ad: [u8], limited: Bool) -> Bool
    match ad_flags_of(ad)
        None        => false
        Some(flags) =>
            let wanted = if limited
                AD_FLAG_LE_LIMITED_DISC
            else
                AD_FLAG_LE_LIMITED_DISC | AD_FLAG_LE_GENERAL_DISC
            (flags & wanted) != 0
