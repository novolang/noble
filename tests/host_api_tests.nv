// ── ATT traffic of a Peripheral ─────────────────────────────────────

// An HCI ACL Data packet from the Controller carrying the ATT PDU `att` on the fixed channel 4.
fn att_packet(handle: Int, att: [u8]) -> [u8]
    let l2cap_length = list.len(att)
    let total = l2cap_length + 4
    var pkt: [u8] = [0x02, (handle & 0xFF) as u8, (((handle >> 8) & 0x0F) | 0x20) as u8, (total & 0xFF) as u8, ((total >> 8) & 0xFF) as u8]
    list.append(pkt, le16(l2cap_length))
    list.append(pkt, le16(4))
    list.append(pkt, att)
    pkt

@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_the_host_answers_the_att_requests_of_a_client_through_the_link()
    var h = new_host(2)
    var l = script_link()
    var p = test_policy()
    var b = new_store()
    started(var h, var l, var p, var b)
    list.push(l.inbox, connection_complete(0, 0x41, 1, peer_octets(0x31)))
    run(var h, var l, var p, var b, 1)
    test.assert_eq(next_kind(var h), EV_CONNECTED)
    // A Read Request of the Device Name, handle 3: the Host answers it with an ACL packet.
    list.push(l.inbox, att_packet(0x41, [0x0A, 0x03, 0x00]))
    run(var h, var l, var p, var b, 2)
    test.assert_eq(list.len(l.acl), 1)
    test.assert_eq(l.acl[0][0] as Int, 2)
    test.assert_eq(l.acl[0][9] as Int, 0x0B)
    // A Write Request of the same handle (the Device Name is writable) is answered too.  The GATT server
    // reports a write as a change only for the attributes it tracks (`take_changed`), and the Device Name
    // is not one of them, so no `Written` is queued.
    list.push(l.inbox, att_packet(0x41, [0x12, 0x03, 0x00, 0x58, 0x59]))
    run(var h, var l, var p, var b, 2)
    test.assert_eq(list.len(l.acl), 2)
    test.assert_eq(l.acl[1][9] as Int, 0x13)
    test.assert_eq(next_kind(var h), -1)
