@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_find_scans_until_a_report_matches_the_filter_and_stops_and_times_out_when_none_does()
    var ble = new_ble()
    test.assert(ble.start().is_ok())
    test.assert_eq(wait_kind(var ble, 0), 0)
    // A device of another service, a device of the Battery Service that is too weak, and the one that is wanted.
    list.push(ble.io.inbox, report_ad(peer_octets(0x61), -40, [3, 3, 0x34, 0x12]))
    list.push(ble.io.inbox, report_ad(peer_octets(0x63), -90, [3, 3, 0x0F, 0x18]))
    list.push(ble.io.inbox, report_ad(peer_octets(0x62), -50, [3, 3, 0x0F, 0x18]))
    var found = noble.blank_report()
    var want = noble.scan_service(0x180F)
    want = noble.ScanFilter { uuid16: want.uuid16, name_prefix: want.name_prefix, rssi_min: -60, duplicates: false }
    let st = ble.find(want, 5000, var found)
    test.assert(st.is_ok())
    test.assert_eq(found.addr.octets[0] as Int, 0x62)
    test.assert_eq(found.rssi as Int, -50)
    // Only the report that passed the filter reached the policy.
    test.assert_eq(ble.policy.adverts, 1)
    test.assert_eq(times_sent(ble.io, hci_commands.opcode_le_set_scan_parameters()), 1)
    test.assert_eq(times_sent(ble.io, hci_commands.opcode_le_set_scan_enable()), 2)
    test.assert(not ble.host.api.scan_on)
    let missed = ble.find(noble.scan_service(0x180A), 300, var found)
    test.assert(missed.is(noble.LAYER_LOCAL, noble.E_TIMEOUT))
    test.assert(not ble.host.api.scan_on)

@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_scan_start_reports_as_events_a_name_filter_applies_and_extended_scanning_is_refused()
    var ble = new_ble()
    test.assert(ble.start().is_ok())
    test.assert_eq(wait_kind(var ble, 0), 0)
    var prefix: String[16] = String.new()
    let _ = prefix.push_str("hr")
    let by_name = noble.ScanFilter { uuid16: 0, name_prefix: prefix, rssi_min: -127, duplicates: true }
    test.assert(ble.scan_start(noble.scan_passive(), by_name).is_ok())
    test.assert(ble.host.api.scan_on)
    list.push(ble.io.inbox, report_ad(peer_octets(0x61), -40, [3, 9, 0x6E, 0x6F]))
    list.push(ble.io.inbox, report_ad(peer_octets(0x62), -40, [3, 9, 0x68, 0x72]))
    test.assert_eq(wait_kind(var ble, 100), 1)
    test.assert_eq(wait_kind(var ble, 100), -1)
    // A second start disables the scan that runs first.
    let before = times_sent(ble.io, hci_commands.opcode_le_set_scan_enable())
    test.assert(ble.scan_start(noble.scan_passive(), noble.scan_all()).is_ok())
    test.assert_eq(times_sent(ble.io, hci_commands.opcode_le_set_scan_enable()), before + 2)
    test.assert(ble.scan_stop().is_ok())
    test.assert(ble.scan_stop().is_ok())
    let wide = noble.ScanParams { active: true, extended: true, interval_ms: 100, window_ms: 50, duration_ms: 0 }
    test.assert(ble.scan_start(wide, noble.scan_all()).is(noble.LAYER_LOCAL, noble.E_BAD_ARGUMENT))
    let backwards = noble.ScanParams { active: true, extended: false, interval_ms: 50, window_ms: 100, duration_ms: 0 }
    test.assert(ble.scan_start(backwards, noble.scan_all()).is(noble.LAYER_LOCAL, noble.E_BAD_ARGUMENT))

@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_sync_create_ends_with_the_established_event_and_sync_stop_forgets_the_train()
    var ble = new_ble()
    test.assert(ble.start().is_ok())
    ble.io.sync = 0
    test.assert(ble.sync_create(peer_addr(0x71), 3, 0, 100).is_ok())
    test.assert_eq(ble.host.api.sync_handle, 0x10)
    test.assert(ble.sync_stop().is_ok())
    test.assert_eq(ble.host.api.sync_handle, -1)
    test.assert(ble.sync_stop().is(noble.LAYER_LOCAL, noble.E_NOT_FOUND))
    ble.io.sync = noble.HCI_CONNECTION_FAILED_TO_ESTABLISH
    test.assert(ble.sync_create(peer_addr(0x71), 3, 0, 100).is(noble.LAYER_HCI, noble.HCI_CONNECTION_FAILED_TO_ESTABLISH))
    // The Controller reports the train gone, and the Host forgets it.
    ble.io.sync = 0
    test.assert(ble.sync_create(peer_addr(0x71), 3, 0, 100).is_ok())
    list.push(ble.io.inbox, le_meta(0x10, [0x10, 0x00]))
    ble.step()
    test.assert_eq(ble.host.api.sync_handle, -1)
    test.assert(ble.sync_create(peer_addr(0x71), 16, 0, 100).is(noble.LAYER_LOCAL, noble.E_BAD_ARGUMENT))
    // No established event within the call: it ends with a timeout.
    ble.io.sync = -1
    test.assert(ble.sync_create(peer_addr(0x71), 3, 0, 100).is(noble.LAYER_LOCAL, noble.E_TIMEOUT))

@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_accept_list_from_bonds_writes_the_accept_list_and_the_resolving_list_of_the_bonds_with_a_key()
    let plain = bond_for(peer_addr(0x81), Security.Encrypted)
    var known = bond_for(peer_addr(0x82), Security.Authenticated)
    known = Bond { peer: known.peer, irk: [9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9], has_irk: true, ltk: known.ltk, ediv: 0, rand: known.rand, key_size: 16, level: known.level }
    var store = new_store()
    test.assert(store.save(plain).is_ok())
    test.assert(store.save(known).is_ok())
    var ble = noble.adapter(script_link(), test_policy(), store)
    test.assert(ble.start().is_ok())
    let first = list.len(ble.io.commands)
    test.assert(ble.accept_list_from_bonds().is_ok())
    test.assert_eq(ble.io.commands[first], hci_commands.opcode_le_clear_filter_accept_list())
    test.assert_eq(ble.io.commands[first + 1], hci_commands.opcode_le_add_device_to_filter_accept_list())
    test.assert_eq(ble.io.commands[first + 2], hci_commands.opcode_le_add_device_to_filter_accept_list())
    test.assert_eq(ble.io.commands[first + 3], hci_commands.opcode_le_clear_resolving_list())
    test.assert_eq(ble.io.commands[first + 4], hci_commands.opcode_le_add_device_to_resolving_list())
    test.assert_eq(list.len(ble.io.commands), first + 5)
    // Without a key in the store only the accept list is written.
    var only = new_store()
    test.assert(only.save(plain).is_ok())
    var bare = noble.adapter(script_link(), test_policy(), only)
    test.assert(bare.start().is_ok())
    let mark = list.len(bare.io.commands)
    test.assert(bare.accept_list_from_bonds().is_ok())
    test.assert_eq(list.len(bare.io.commands), mark + 2)

