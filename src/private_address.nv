// private_address.nv — the private addresses a Host generates
// for its own use.
//
// A private address is a random device address of one of two sub-types
// ([Vol 6] Part B, Section 1.3.2.2), told apart by the two most
// significant bits of the address:
//
//   0b00  Non-resolvable Private Address: 46 random bits, at least one
//         of them 0 and at least one 1, and the address shall not be
//         equal to the public address.
//   0b01  Resolvable Private Address: prand || hash.  prand is 24 bits
//         whose two most significant bits are 0b01 and whose 22 random
//         bits have at least one 0 and at least one 1; hash is
//         ah(IRK, prand), the random address hash function of [Vol 3]
//         Part H, Section 2.2.2, and its least significant octet is the
//         least significant octet of the address.
//
// GAP names the two procedures that build them the Non-Resolvable
// Private Address Generation procedure and the Resolvable Private
// Address Generation procedure ([Vol 3] Part C, Sections 10.8.2.1 and
// 10.8.2.2).
//
// The random bits are the Random_Number of the LE Rand command
// ([Vol 4] Part E, Section 7.8.23), 8 octets.  ah is
// e(IRK, padding || prand) mod 2^24, and the Host computes e, AES-128,
// with the LE Encrypt command ([Vol 3] Part H, Section 2.2.1 allows
// it; [Vol 4] Part E, Section 7.8.22).  Both commands carry their
// operands as HCI carries every multi-octet value, least significant
// octet first, and so does every address, key and block here.  The
// functions only shape operands and results; the program that owns HCI
// sends the commands.

use std.test
use advertiser

// Octets of the LE Rand command's Random_Number return parameter.
const RANDOM_NUMBER_LEN = 8

// Octets of a key, a Plaintext_Data block and an Encrypted_Data block
// of the LE Encrypt command.
const AES_BLOCK_LEN = 16

// The two most significant bits of an address, in the top octet.
const SUBTYPE_MASK = 0xC0
const SUBTYPE_NON_RESOLVABLE = 0x00
const SUBTYPE_RESOLVABLE = 0x40

// Whether the `count` low octets of `octets`, with the two most
// significant bits of the top one left out, are neither all 0 nor all
// 1: the random part rule of [Vol 6] Part B, Section 1.3.2.2.
pub @tier(embedded)
@no_alloc
fn random_part_is_mixed(octets: [u8], count: Int) -> Bool
    var any_zero = false
    var any_one = false
    for i in 0..count
        let part = if i == count - 1
            (octets[i] as Int) & 0x3F
        else
            octets[i] as Int
        let width_mask = if i == count - 1 then 0x3F else 0xFF
        if part != 0
            any_one = true
        if part != width_mask
            any_zero = true
    any_zero and any_one

@tier(embedded)
@no_alloc
fn same_address(a: [u8], b: [u8]) -> Bool
    if list.len(a) != list.len(b)
        false
    else
        var eq = true
        for i in 0..list.len(a)
            if a[i] != b[i]
                eq = false
        eq

// A Non-resolvable Private Address from an LE Rand Random_Number, or
// None when the random part breaks the rule above or the address
// equals `identity`; the caller then draws again.  The first six
// octets of the random number become the address, least significant
// first, with the two most significant bits cleared.
pub @tier(embedded)
fn non_resolvable_from_random(random: [u8], identity: [u8]) -> ?[u8]
    if list.len(random) < 6
        return None
    let top = ((random[5] as Int) & (SUBTYPE_MASK ^ 0xFF)) | SUBTYPE_NON_RESOLVABLE
    let address: [u8] = [random[0], random[1], random[2], random[3], random[4], top as u8]
    if not random_part_is_mixed(address, 6) or same_address(address, identity)
        None
    else
        Some(address)

// prand, 3 octets least significant first, from an LE Rand
// Random_Number, or None when its random part breaks the rule above.
pub @tier(embedded)
fn prand_from_random(random: [u8]) -> ?[u8]
    if list.len(random) < 3
        return None
    let top = ((random[2] as Int) & (SUBTYPE_MASK ^ 0xFF)) | SUBTYPE_RESOLVABLE
    let prand: [u8] = [random[0], random[1], top as u8]
    if random_part_is_mixed(prand, 3)
        Some(prand)
    else
        None

// r' = padding || r ([Vol 3] Part H, Section 2.2.2): prand in the
// three least significant octets and 104 bits of zeros above, as the
// Plaintext_Data of the LE Encrypt command.
pub @tier(embedded)
fn ah_plaintext(prand: [u8]) -> [u8]
    var block: [u8] = [prand[0], prand[1], prand[2]]
    for _ in 3..AES_BLOCK_LEN
        list.push(block, 0x00)
    block

// The parameters of the LE Encrypt command ([Vol 4] Part E, Section
// 7.8.22): Key, then Plaintext_Data, 16 octets each.
pub @tier(embedded)
fn le_encrypt_parameters(irk: [u8], plaintext: [u8]) -> [u8]
    var params: [u8] = []
    for i in 0..AES_BLOCK_LEN
        list.push(params, irk[i])
    for i in 0..AES_BLOCK_LEN
        list.push(params, plaintext[i])
    params

// The Resolvable Private Address for `prand` and the Encrypted_Data the
// LE Encrypt command returned for its r'.  ah keeps the least
// significant 24 bits of e ([Vol 3] Part H, Section 2.2.2), which are
// the first three octets; the address is prand || hash.  None when the
// block is short.
pub @tier(embedded)
fn resolvable_from_encrypted(prand: [u8], encrypted: [u8]) -> ?[u8]
    if list.len(encrypted) < AES_BLOCK_LEN or list.len(prand) != 3
        None
    else
        Some([encrypted[0], encrypted[1], encrypted[2], prand[0], prand[1], prand[2]])

// An IRK written as 32 hex digits, most significant octet first, the
// way the IXIT and a command line write a 128-bit key, as the 16
// octets HCI carries, least significant first.  None unless the text
// is exactly 32 hex digits.
pub @tier(embedded)
fn parse_irk(text: [u8]) -> ?[u8]
    if list.len(text) != 2 * AES_BLOCK_LEN
        return None
    var key: [u8] = []
    for k in 0..AES_BLOCK_LEN
        let at = 2 * (AES_BLOCK_LEN - 1 - k)
        let hi = advertiser.hex_digit(text[at] as Int)
        let lo = advertiser.hex_digit(text[at + 1] as Int)
        if hi < 0 or lo < 0
            return None
        list.push(key, (hi * 16 + lo) as u8)
    Some(key)

// ── Tests ───────────────────────────────────────────────────────────

@tier(app)
fn identity() -> [u8]
    [0x01, 0x4F, 0x56, 0x4F, 0x4E, 0xC0]

@test
fn test_non_resolvable_has_the_0b00_subtype_and_the_random_octets()
    let random: [u8] = [0x11, 0x22, 0x33, 0x44, 0x55, 0xFF, 0x77, 0x88]
    match non_resolvable_from_random(random, identity())
        None    => test.fail("a mixed random part gives an address")
        Some(a) =>
            test.assert(same_address(a, [0x11, 0x22, 0x33, 0x44, 0x55, 0x3F]))
            test.assert_eq((a[5] as Int) & 0xC0, 0x00)

@test
fn test_non_resolvable_refuses_all_zeros_and_all_ones()
    // The two most significant bits do not count: 0xC0 over zeros is
    // still an all-zero random part.
    let zeros: [u8] = [0x00, 0x00, 0x00, 0x00, 0x00, 0xC0, 0x12, 0x34]
    let ones: [u8] = [0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x00, 0x00]
    test.assert(non_resolvable_from_random(zeros, identity()) == None)
    test.assert(non_resolvable_from_random(ones, identity()) == None)
    // One bit either way is enough.
    let one_bit: [u8] = [0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]
    let one_zero: [u8] = [0xFE, 0xFF, 0xFF, 0xFF, 0xFF, 0x3F, 0x00, 0x00]
    test.assert(non_resolvable_from_random(one_bit, identity()) != None)
    test.assert(non_resolvable_from_random(one_zero, identity()) != None)

@test
fn test_non_resolvable_refuses_the_identity_address()
    let public_like: [u8] = [0x01, 0x02, 0x03, 0x04, 0x05, 0x06]
    let random: [u8] = [0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x00, 0x00]
    test.assert(non_resolvable_from_random(random, public_like) == None)
    test.assert(non_resolvable_from_random(random, identity()) != None)

@test
fn test_non_resolvable_needs_six_octets()
    test.assert(non_resolvable_from_random([0x01, 0x02], identity()) == None)

@test
fn test_prand_has_the_0b01_subtype()
    match prand_from_random([0x94, 0x81, 0xB0, 0x00, 0x00, 0x00, 0x00, 0x00])
        None    => test.fail("a mixed prand is kept")
        Some(p) =>
            test.assert(same_address(p, [0x94, 0x81, 0x70]))
            test.assert_eq((p[2] as Int) & 0xC0, 0x40)

@test
fn test_prand_refuses_all_zeros_and_all_ones()
    test.assert(prand_from_random([0x00, 0x00, 0x40]) == None)
    test.assert(prand_from_random([0xFF, 0xFF, 0xFF]) == None)
    test.assert(prand_from_random([0xFF, 0xFF, 0x3E]) != None)

// [Vol 3] Part H, Appendix D.7: IRK ec0234a3 57c8ad05 341010a6 0a397d9b,
// prand 0x708194, M = 0x...00708194, AES_128 159d5fb7 2ebe2311 a48c1bdc
// c40dfbaa, ah 0x0dfbaa.  Each value here is least significant octet
// first, as HCI carries it.

@tier(app)
fn d7_irk() -> [u8]
    [0x9b, 0x7d, 0x39, 0x0a, 0xa6, 0x10, 0x10, 0x34, 0x05, 0xad, 0xc8, 0x57, 0xa3, 0x34, 0x02, 0xec]

@tier(app)
fn d7_encrypted() -> [u8]
    [0xaa, 0xfb, 0x0d, 0xc4, 0xdc, 0x1b, 0x8c, 0xa4, 0x11, 0x23, 0xbe, 0x2e, 0xb7, 0x5f, 0x9d, 0x15]

@test
fn test_ah_plaintext_is_the_d7_m()
    let m = ah_plaintext([0x94, 0x81, 0x70])
    test.assert_eq(list.len(m), 16)
    test.assert(same_address(m[0:3], [0x94, 0x81, 0x70]))
    for i in 3..16
        test.assert_eq(m[i] as Int, 0)

@test
fn test_le_encrypt_parameters_are_key_then_plaintext()
    let p = le_encrypt_parameters(d7_irk(), ah_plaintext([0x94, 0x81, 0x70]))
    test.assert_eq(list.len(p), 32)
    test.assert(same_address(p[0:16], d7_irk()))
    test.assert_eq(p[16] as Int, 0x94)
    test.assert_eq(p[18] as Int, 0x70)

@test
fn test_resolvable_address_from_the_d7_vector()
    // RPA 0x7081940dfbaa, least significant octet first.
    match resolvable_from_encrypted([0x94, 0x81, 0x70], d7_encrypted())
        None    => test.fail("a full block gives an address")
        Some(a) =>
            test.assert(same_address(a, [0xaa, 0xfb, 0x0d, 0x94, 0x81, 0x70]))
            test.assert_eq((a[5] as Int) & 0xC0, 0x40)
    test.assert(resolvable_from_encrypted([0x94, 0x81, 0x70], [0x00]) == None)

@test
fn test_parse_irk_reverses_the_written_order()
    let text = "ec0234a357c8ad05341010a60a397d9b"
    match parse_irk(bytes_of(text))
        None    => test.fail("32 hex digits are a key")
        Some(k) => test.assert(same_address(k, d7_irk()))
    test.assert(parse_irk(bytes_of("ec0234")) == None)
    test.assert(parse_irk(bytes_of("zz0234a357c8ad05341010a60a397d9b")) == None)

@tier(app)
fn bytes_of(text: Str) -> [u8]
    var out: [u8] = []
    for i in 0..str.len(text)
        list.push(out, (str.byte_at(text, i) ?? 0) as u8)
    out
