// att_server_scratch.nv — scratch-based ATT response builders.
//
// Mirrors att_server.handle_* but writes ATT response bytes
// directly into the fixed-RAM scratch (att_scratch.nv) instead of
// returning a heap [u8].  Eliminates the O(N²) list.append cost
// that was driving the 300ms post-discovery stall on the bigger
// writable db.
//
// Convention: the caller (conn_event_dispatch.dispatch_data_rx_to_scratch)
// writes the 4-byte L2CAP B-frame placeholder (length:u16 LE +
// cid:u16 LE) at offsets 0-3.  Handlers below append ATT bytes
// starting at the current cursor (which is 4 after the L2CAP
// placeholder).  Caller patches the L2CAP length field at offsets
// 0-1 once the ATT response is fully written.
//
// Each handler returns Bool: true if a response was successfully
// written, false on scratch overflow or on the "no matching
// attributes" path that emits an ERROR_RSP at the same scratch
// position.

use std.bits
use att
use att_scratch
use att_server


// ── No-allocation db value access ─────────────────────────────────
//
// att_server.db_value_at builds a fresh [u8] via list.append per
// byte — that's the heap traffic that OOM'd the scratch path's
// first hardware test (frame trace pointed at db_value_at →
// list.append → novo_alloc).  These helpers read the value bytes
// directly from the blob's [u8] storage without an intermediate
// [u8] copy, then stream them into scratch.

@tier(embedded)
@no_alloc
fn db_value_byte_at(blob: [u8], idx: Int, k: Int) -> Int
    let off = att_server.db_record_offset(blob, idx)
    if off < 0
        -1
    else
        // Header is 7 bytes; value bytes follow.  blob[off + 6]
        // is the value_len.  Bounds check via the caller (k <
        // db_value_len_at).
        blob[off + att_server.DB_REC_HEADER_LEN + k] as Int

@tier(embedded)
fn db_write_value_to_scratch(blob: [u8], idx: Int) -> Bool [hw]
    let value_len = att_server.db_value_len_at(blob, idx)
    if value_len <= 0
        true                      // empty value, nothing to write
    else
        let off = att_server.db_record_offset(blob, idx)
        if off < 0
            true
        else
            var i = 0
            var ok = true
            loop
                if i >= value_len or not ok
                    break
                ok = att_scratch.scratch_write_u8(
                    blob[off + att_server.DB_REC_HEADER_LEN + i] as Int)
                i = i + 1
            ok


// ── Fixed-RAM db accessors ────────────────────────────────────────
//
// Mirror att_server.db_* but read directly from the fixed-RAM blob
// at att_scratch.gatt_db_blob_addr() via hw.mem_read8.  No heap
// traffic; survives the heap_save_ptr wrap.  Used by the write path
// so blob mutations persist past heap_restore_ptr.

@tier(embedded)
fn db_count_ram() -> Int [hw]
    let n = att_scratch.gatt_db_ram_len()
    var idx = 0
    var count = 0
    loop
        if idx >= n
            break
        if idx + att_server.DB_REC_HEADER_LEN > n
            break
        let value_len = att_scratch.gatt_db_ram_byte_at(idx + 6)
        idx = idx + att_server.DB_REC_HEADER_LEN + value_len
        count = count + 1
    count

@tier(embedded)
fn db_record_offset_ram(idx: Int) -> Int [hw]
    let n = att_scratch.gatt_db_ram_len()
    var off = 0
    var i = 0
    var found = -1
    loop
        if i > idx
            break
        if off >= n
            break
        if off + att_server.DB_REC_HEADER_LEN > n
            break
        if i == idx
            found = off
            break
        let value_len = att_scratch.gatt_db_ram_byte_at(off + 6)
        off = off + att_server.DB_REC_HEADER_LEN + value_len
        i = i + 1
    found

@tier(embedded)
fn db_handle_at_ram(idx: Int) -> Int [hw]
    let off = db_record_offset_ram(idx)
    if off < 0
        -1
    else
        att_scratch.gatt_db_ram_byte_at(off) | (att_scratch.gatt_db_ram_byte_at(off + 1) << 8)

@tier(embedded)
fn db_type16_at_ram(idx: Int) -> Int [hw]
    let off = db_record_offset_ram(idx)
    if off < 0
        -1
    else
        att_scratch.gatt_db_ram_byte_at(off + 2) | (att_scratch.gatt_db_ram_byte_at(off + 3) << 8)

@tier(embedded)
fn db_end_group_at_ram(idx: Int) -> Int [hw]
    let off = db_record_offset_ram(idx)
    if off < 0
        -1
    else
        att_scratch.gatt_db_ram_byte_at(off + 4) | (att_scratch.gatt_db_ram_byte_at(off + 5) << 8)

@tier(embedded)
fn db_value_len_at_ram(idx: Int) -> Int [hw]
    let off = db_record_offset_ram(idx)
    if off < 0
        -1
    else
        att_scratch.gatt_db_ram_byte_at(off + 6)

@tier(embedded)
fn db_value_byte_at_ram(idx: Int, k: Int) -> Int [hw]
    let off = db_record_offset_ram(idx)
    if off < 0
        -1
    else
        att_scratch.gatt_db_ram_byte_at(off + att_server.DB_REC_HEADER_LEN + k)

@tier(embedded)
fn db_index_for_handle_ram(handle: Int) -> Int [hw]
    let count = db_count_ram()
    var i = 0
    var found = -1
    loop
        if i >= count
            break
        if db_handle_at_ram(i) == handle
            found = i
            break
        i = i + 1
    found


@tier(embedded)
fn db_write_value_to_scratch_ram(idx: Int) -> Bool [hw]
    let value_len = db_value_len_at_ram(idx)
    if value_len <= 0
        true
    else
        let off = db_record_offset_ram(idx)
        if off < 0
            true
        else
            var i = 0
            var ok = true
            loop
                if i >= value_len or not ok
                    break
                ok = att_scratch.scratch_write_u8(
                    att_scratch.gatt_db_ram_byte_at(off + att_server.DB_REC_HEADER_LEN + i))
                i = i + 1
            ok


// ── Write apply (in-place, fixed RAM) ─────────────────────────────
//
// Mutates the fixed-RAM blob via hw.mem_write8.  No heap traffic.
// Survives heap_save_ptr/restore wraps unconditionally.
//
// Returns true iff the write was applied (handle exists, offset +
// length within the attribute's value bytes).
@tier(embedded)
fn db_apply_write_ram(handle: Int, offset: Int, value_addr: Int, value_len: Int) -> Bool [hw]
    let idx = db_index_for_handle_ram(handle)
    if idx < 0
        false
    else
        let off = db_record_offset_ram(idx)
        let attr_value_len = att_scratch.gatt_db_ram_byte_at(off + 6)
        if offset < 0 or offset + value_len > attr_value_len
            false
        else
            var i = 0
            loop
                if i >= value_len
                    break
                let b = hw.mem_read8(value_addr + i)
                att_scratch.gatt_db_ram_set_byte_at(
                    off + att_server.DB_REC_HEADER_LEN + offset + i, b)
                i = i + 1
            true


// CCCD UUID (Vol 3 Part G §3.3.3.3) — replicated here so the
// scratch handlers can do the writability check without pulling
// in att_server's CCCD_UUID16 (which has the same value).  Kept in
// sync via spec.
const CCCD_UUID16_RAM = 0x2902

@tier(embedded)
fn db_writable_at_ram(value_handle: Int) -> Bool [hw]
    let idx = db_index_for_handle_ram(value_handle)
    if idx < 0
        false
    else if db_type16_at_ram(idx) == CCCD_UUID16_RAM
        true
    else
        // Walk forward characteristic declarations to find one whose
        // value_handle (bytes 1-2 of decl value) matches.
        let count = db_count_ram()
        var i = 0
        var props = -1
        loop
            if i >= count
                break
            if db_type16_at_ram(i) == 0x2803      // CHARACTERISTIC
                let decl_off = db_record_offset_ram(i)
                let v_off = decl_off + att_server.DB_REC_HEADER_LEN
                if att_scratch.gatt_db_ram_byte_at(v_off + 0) >= 0
                    let vh_lo = att_scratch.gatt_db_ram_byte_at(v_off + 1)
                    let vh_hi = att_scratch.gatt_db_ram_byte_at(v_off + 2)
                    let vh = vh_lo | (vh_hi << 8)
                    if vh == value_handle
                        props = att_scratch.gatt_db_ram_byte_at(v_off)
                        break
            i = i + 1
        if props < 0
            false
        else
            // 0x08 = Write, 0x04 = Write Without Response.
            (props & 0x0C) != 0


// ── Helper: write an ERROR_RSP into scratch at the current cursor ─
//
// Drop-in replacement for att.build_error_rsp's caller side.  Writes
// 5 bytes (opcode | req_opcode | handle:u16 LE | err_code).
@tier(embedded)
fn write_error_rsp(req_opcode: Int, handle: Int, err_code: Int) -> Bool [hw]
    if att_scratch.scratch_write_u8(att.ATT_OP_ERROR_RSP)
        if att_scratch.scratch_write_u8(req_opcode)
            if att_scratch.scratch_write_u16_le(handle)
                att_scratch.scratch_write_u8(err_code)
            else
                false
        else
            false
    else
        false


// ── EXCHANGE_MTU into scratch ──────────────────────────────────────
@tier(embedded)
fn handle_exchange_mtu_to_scratch(my_mtu: Int) -> Bool [hw]
    if att_scratch.scratch_write_u8(att.ATT_OP_EXCHANGE_MTU_RSP)
        att_scratch.scratch_write_u16_le(my_mtu)
    else
        false


// ── READ — return attribute value at handle ────────────────────────
@tier(embedded)
fn handle_read_to_scratch(blob: [u8], req: [u8]) -> Bool [hw]
    let handle = att.read_read_req_handle(req)
    if handle < 0
        write_error_rsp(att.ATT_OP_READ_REQ, 0, att.ATT_ERR_INVALID_PDU)
    else
        let idx = att_server.db_index_for_handle(blob, handle)
        if idx < 0
            write_error_rsp(att.ATT_OP_READ_REQ, handle, att.ATT_ERR_INVALID_HANDLE)
        else
            if not att_scratch.scratch_write_u8(att.ATT_OP_READ_RSP)
                false
            else
                db_write_value_to_scratch(blob, idx)


// ── READ_BLOB — value bytes from offset, capped at MTU ────────────
@tier(embedded)
fn handle_read_blob_to_scratch(blob: [u8], my_mtu: Int, req: [u8]) -> Bool [hw]
    let handle = att.read_read_blob_req_handle(req)
    let offset = att.read_read_blob_req_offset(req)
    if handle < 0 or offset < 0
        write_error_rsp(att.ATT_OP_READ_BLOB_REQ, 0, att.ATT_ERR_INVALID_PDU)
    else
        let idx = att_server.db_index_for_handle(blob, handle)
        if idx < 0
            write_error_rsp(att.ATT_OP_READ_BLOB_REQ, handle, att.ATT_ERR_INVALID_HANDLE)
        else
            let value_len = att_server.db_value_len_at(blob, idx)
            if offset > value_len
                write_error_rsp(att.ATT_OP_READ_BLOB_REQ, handle, att.ATT_ERR_INVALID_OFFSET)
            else if offset == value_len
                att_scratch.scratch_write_u8(att.ATT_OP_READ_BLOB_RSP)
            else
                if not att_scratch.scratch_write_u8(att.ATT_OP_READ_BLOB_RSP)
                    false
                else
                    let max = my_mtu - 1
                    var end = offset + max
                    if value_len < end
                        end = value_len
                    let off = att_server.db_record_offset(blob, idx)
                    var i = offset
                    var ok = true
                    loop
                        if i >= end or not ok
                            break
                        ok = att_scratch.scratch_write_u8(
                            blob[off + att_server.DB_REC_HEADER_LEN + i] as Int)
                        i = i + 1
                    ok


// ── READ_BY_TYPE — handle/value pairs matching a 16-bit type ──────
//
// Per spec, all pairs in one RSP must have the same value length.
// We emit the response header (opcode + pair_len) up front via a
// patch-after pattern: write opcode, write placeholder pair_len = 0,
// remember the offset, then walk the db; on first match we patch
// pair_len and start emitting pairs.  At end, if no match, rewind
// scratch and emit ERROR_RSP.
@tier(embedded)
fn handle_read_by_type_to_scratch(blob: [u8], my_mtu: Int, req: [u8]) -> Bool [hw]
    let start = att.read_read_by_type_req_start(req)
    let end = att.read_read_by_type_req_end(req)
    let tlen = att.read_read_by_type_req_type_len(req)
    if start < 0 or end < 0 or tlen < 0
        write_error_rsp(att.ATT_OP_READ_BY_TYPE_REQ, 0, att.ATT_ERR_INVALID_PDU)
    else if tlen != 2
        write_error_rsp(att.ATT_OP_READ_BY_TYPE_REQ, start, att.ATT_ERR_REQUEST_NOT_SUPPORTED)
    else if start == 0 or start > end
        write_error_rsp(att.ATT_OP_READ_BY_TYPE_REQ, start, att.ATT_ERR_INVALID_HANDLE)
    else
        let type16 = att.read_read_by_type_req_type16(req)
        let count = att_server.db_count(blob)
        // Snapshot scratch len so we can rewind on no-match.
        let header_off = att_scratch.scratch_len()
        // Write the response header — opcode + placeholder pair_len.
        if not att_scratch.scratch_write_u8(att.ATT_OP_READ_BY_TYPE_RSP)
            false
        else
            let pair_len_off = att_scratch.scratch_len()
            if not att_scratch.scratch_write_u8(0)        // patched on first match
                false
            else
                var pair_value_len = -1
                var pair_byte_len = 0
                var pairs_written = 0
                var i = 0
                let max_payload = my_mtu - 2
                loop
                    if i >= count
                        break
                    let h = att_server.db_handle_at(blob, i)
                    let t = att_server.db_type16_at(blob, i)
                    if h >= start and h <= end and t == type16
                        let vlen = att_server.db_value_len_at(blob, i)
                        if pair_value_len < 0
                            pair_value_len = vlen
                            pair_byte_len = 2 + vlen
                            att_scratch.scratch_patch_u8(pair_len_off, pair_byte_len)
                        if vlen == pair_value_len
                            let written_so_far = att_scratch.scratch_len() - (header_off + 2)
                            if written_so_far + pair_byte_len <= max_payload
                                let _ = att_scratch.scratch_write_u16_le(h)
                                let _ = db_write_value_to_scratch(blob, i)
                                pairs_written = pairs_written + 1
                            else
                                i = count
                    i = i + 1
                if pairs_written == 0
                    // Rewind scratch and emit ERROR_RSP.
                    att_scratch.scratch_set_len(header_off)
                    write_error_rsp(att.ATT_OP_READ_BY_TYPE_REQ, start, att.ATT_ERR_ATTRIBUTE_NOT_FOUND)
                else
                    true


// ── READ_BY_GROUP_TYPE — handle/end_group/value triplets ──────────
@tier(embedded)
fn handle_read_by_group_type_to_scratch(blob: [u8], my_mtu: Int, req: [u8]) -> Bool [hw]
    let start = att.read_read_by_group_type_req_start(req)
    let end = att.read_read_by_group_type_req_end(req)
    let tlen = att.read_read_by_group_type_req_type_len(req)
    if start < 0 or end < 0 or tlen < 0
        write_error_rsp(att.ATT_OP_READ_BY_GROUP_TYPE_REQ, 0, att.ATT_ERR_INVALID_PDU)
    else if tlen != 2
        write_error_rsp(att.ATT_OP_READ_BY_GROUP_TYPE_REQ, start, att.ATT_ERR_REQUEST_NOT_SUPPORTED)
    else if start == 0 or start > end
        write_error_rsp(att.ATT_OP_READ_BY_GROUP_TYPE_REQ, start, att.ATT_ERR_INVALID_HANDLE)
    else
        let type16 = att.read_read_by_group_type_req_type16(req)
        if type16 != att_server.GATT_UUID_PRIMARY_SERVICE
            write_error_rsp(att.ATT_OP_READ_BY_GROUP_TYPE_REQ, start, att.ATT_ERR_UNSUPPORTED_GROUP_TYPE)
        else
            let count = att_server.db_count(blob)
            let header_off = att_scratch.scratch_len()
            if not att_scratch.scratch_write_u8(att.ATT_OP_READ_BY_GROUP_TYPE_RSP)
                false
            else
                let triplet_len_off = att_scratch.scratch_len()
                if not att_scratch.scratch_write_u8(0)
                    false
                else
                    var triplet_value_len = -1
                    var triplet_byte_len = 0
                    var triplets_written = 0
                    var i = 0
                    let max_payload = my_mtu - 2
                    loop
                        if i >= count
                            break
                        let h = att_server.db_handle_at(blob, i)
                        let t = att_server.db_type16_at(blob, i)
                        if h >= start and h <= end and t == type16
                            let eg = att_server.db_end_group_at(blob, i)
                            let vlen = att_server.db_value_len_at(blob, i)
                            if triplet_value_len < 0
                                triplet_value_len = vlen
                                triplet_byte_len = 4 + vlen
                                att_scratch.scratch_patch_u8(triplet_len_off, triplet_byte_len)
                            if vlen == triplet_value_len
                                let written_so_far = att_scratch.scratch_len() - (header_off + 2)
                                if written_so_far + triplet_byte_len <= max_payload
                                    let _ = att_scratch.scratch_write_u16_le(h)
                                    let _ = att_scratch.scratch_write_u16_le(eg)
                                    let _ = db_write_value_to_scratch(blob, i)
                                    triplets_written = triplets_written + 1
                                else
                                    i = count
                        i = i + 1
                    if triplets_written == 0
                        att_scratch.scratch_set_len(header_off)
                        write_error_rsp(att.ATT_OP_READ_BY_GROUP_TYPE_REQ, start, att.ATT_ERR_ATTRIBUTE_NOT_FOUND)
                    else
                        true


// ── FIND_INFORMATION — handle/UUID pairs (16-bit format only) ─────
@tier(embedded)
fn handle_find_information_to_scratch(blob: [u8], my_mtu: Int, req: [u8]) -> Bool [hw]
    let start = att.read_find_info_req_start(req)
    let end = att.read_find_info_req_end(req)
    if start < 0 or end < 0
        write_error_rsp(att.ATT_OP_FIND_INFORMATION_REQ, 0, att.ATT_ERR_INVALID_PDU)
    else if start == 0 or start > end
        write_error_rsp(att.ATT_OP_FIND_INFORMATION_REQ, start, att.ATT_ERR_INVALID_HANDLE)
    else
        let count = att_server.db_count(blob)
        let header_off = att_scratch.scratch_len()
        if not att_scratch.scratch_write_u8(att.ATT_OP_FIND_INFORMATION_RSP)
            false
        else
            if not att_scratch.scratch_write_u8(att.ATT_FIND_INFO_FORMAT_UUID16)
                false
            else
                var pairs_written = 0
                var i = 0
                let max_payload = my_mtu - 2
                loop
                    if i >= count
                        break
                    let h = att_server.db_handle_at(blob, i)
                    let t = att_server.db_type16_at(blob, i)
                    if h >= start and h <= end
                        let written_so_far = att_scratch.scratch_len() - (header_off + 2)
                        if written_so_far + 4 <= max_payload
                            let _ = att_scratch.scratch_write_u16_le(h)
                            let _ = att_scratch.scratch_write_u16_le(t)
                            pairs_written = pairs_written + 1
                        else
                            i = count
                    i = i + 1
                if pairs_written == 0
                    att_scratch.scratch_set_len(header_off)
                    write_error_rsp(att.ATT_OP_FIND_INFORMATION_REQ, start, att.ATT_ERR_ATTRIBUTE_NOT_FOUND)
                else
                    true


// ── FIND_BY_TYPE_VALUE — handle group ids matching (type, value) ──
@tier(embedded)
fn handle_find_by_type_value_to_scratch(blob: [u8], my_mtu: Int, req: [u8]) -> Bool [hw]
    let start = att.read_find_by_type_value_req_start(req)
    let end = att.read_find_by_type_value_req_end(req)
    let type16 = att.read_find_by_type_value_req_type16(req)
    let req_len = list.len(req)
    if start < 0 or end < 0 or type16 < 0 or req_len < 7
        write_error_rsp(att.ATT_OP_FIND_BY_TYPE_VALUE_REQ, 0, att.ATT_ERR_INVALID_PDU)
    else if start == 0 or start > end
        write_error_rsp(att.ATT_OP_FIND_BY_TYPE_VALUE_REQ, start, att.ATT_ERR_INVALID_HANDLE)
    else
        let compare_len = req_len - 7
        let count = att_server.db_count(blob)
        let header_off = att_scratch.scratch_len()
        if not att_scratch.scratch_write_u8(att.ATT_OP_FIND_BY_TYPE_VALUE_RSP)
            false
        else
            var pairs_written = 0
            var i = 0
            let max_payload = my_mtu - 1
            loop
                if i >= count
                    break
                let h = att_server.db_handle_at(blob, i)
                let t = att_server.db_type16_at(blob, i)
                if h >= start and h <= end and t == type16
                    let vlen = att_server.db_value_len_at(blob, i)
                    if vlen == compare_len
                        var matches = true
                        var j = 0
                        loop
                            if j >= compare_len
                                break
                            if db_value_byte_at(blob, i, j) != (req[7 + j] as Int)
                                matches = false
                                break
                            j = j + 1
                        if matches
                            let eg = att_server.db_end_group_at(blob, i)
                            let written_so_far = att_scratch.scratch_len() - (header_off + 1)
                            if written_so_far + 4 <= max_payload
                                let _ = att_scratch.scratch_write_u16_le(h)
                                let _ = att_scratch.scratch_write_u16_le(eg)
                                pairs_written = pairs_written + 1
                            else
                                i = count
                i = i + 1
            if pairs_written == 0
                att_scratch.scratch_set_len(header_off)
                write_error_rsp(att.ATT_OP_FIND_BY_TYPE_VALUE_REQ, start, att.ATT_ERR_ATTRIBUTE_NOT_FOUND)
            else
                true


// ── Top-level dispatcher to scratch ────────────────────────────────
//
// Caller has already written 4 bytes of L2CAP B-frame header
// (length placeholder + CID = 0x0004) into scratch.  This function
// dispatches the ATT request and writes the response starting at
// the current cursor.  Returns the ATT response length (bytes
// written by this call) so the caller can patch L2CAP's length.
// Returns 0 on overflow / unsupported / "drop response" paths
// where the caller should stamp an empty PDU instead of an
// L2CAP frame.
pub @tier(embedded)
fn handle_request_to_scratch(blob: [u8], my_mtu: Int, req: [u8]) -> Int [hw]
    let start_len = att_scratch.scratch_len()
    let n = list.len(req)
    let ok = if n < 1
        write_error_rsp(0, 0, att.ATT_ERR_INVALID_PDU)
    else
        let op = req[0] as Int
        match att.opcode_method(op)
            0x02 => handle_exchange_mtu_to_scratch(my_mtu)
            0x0A => handle_read_to_scratch(blob, req)
            0x0C => handle_read_blob_to_scratch(blob, my_mtu, req)
            0x08 => handle_read_by_type_to_scratch(blob, my_mtu, req)
            0x10 => handle_read_by_group_type_to_scratch(blob, my_mtu, req)
            0x04 => handle_find_information_to_scratch(blob, my_mtu, req)
            0x06 => handle_find_by_type_value_to_scratch(blob, my_mtu, req)
            _    => write_error_rsp(op, 0, att.ATT_ERR_REQUEST_NOT_SUPPORTED)
    if ok
        att_scratch.scratch_len() - start_len
    else
        0


// ── Write — fixed-RAM blob path ────────────────────────────────────
//
// WRITE_REQ to a writable attribute (any CCCD, or a char with
// Write / Write Without Response bits set).  Writes the new value
// into the fixed-RAM blob via db_apply_write_ram, then stamps the
// 1-byte WRITE_RSP into scratch.  Returns true on success.
//
// Errors map to ATT_ERR_*:
//   INVALID_PDU                    request too short
//   INVALID_HANDLE                 handle not in db
//   WRITE_NOT_PERMITTED            attribute not writable
//   INVALID_ATTRIBUTE_VALUE_LEN    value bytes won't fit
@tier(embedded)
fn handle_write_req_to_scratch_ram(req_addr: Int, req_len: Int) -> Bool [hw]
    if req_len < 3
        write_error_rsp(att.ATT_OP_WRITE_REQ, 0, att.ATT_ERR_INVALID_PDU)
    else
        let handle = hw.mem_read8(req_addr + 1) | (hw.mem_read8(req_addr + 2) << 8)
        let idx = db_index_for_handle_ram(handle)
        if idx < 0
            write_error_rsp(att.ATT_OP_WRITE_REQ, handle, att.ATT_ERR_INVALID_HANDLE)
        else if not db_writable_at_ram(handle)
            write_error_rsp(att.ATT_OP_WRITE_REQ, handle, att.ATT_ERR_WRITE_NOT_PERMITTED)
        else
            let value_len = req_len - 3
            let attr_value_len = db_value_len_at_ram(idx)
            if value_len > attr_value_len
                write_error_rsp(att.ATT_OP_WRITE_REQ, handle, att.ATT_ERR_INVALID_ATTRIBUTE_VALUE_LEN)
            else
                // Apply the write — bytes start at req_addr + 3.
                let _ = db_apply_write_ram(handle, 0, req_addr + 3, value_len)
                att_scratch.scratch_write_u8(att.ATT_OP_WRITE_RSP)


// WRITE_CMD — silent overwrite (no response, even on error).
// Returns true iff the blob was actually mutated; caller (main.nv)
// uses this to gate CCCD-write detection for subscription tracking.
@tier(embedded)
fn handle_write_cmd_to_scratch_ram(req_addr: Int, req_len: Int) -> Bool [hw]
    if req_len < 3
        false
    else
        let handle = hw.mem_read8(req_addr + 1) | (hw.mem_read8(req_addr + 2) << 8)
        let idx = db_index_for_handle_ram(handle)
        if idx < 0 or not db_writable_at_ram(handle)
            false
        else
            let value_len = req_len - 3
            let attr_value_len = db_value_len_at_ram(idx)
            if value_len > attr_value_len
                false
            else
                db_apply_write_ram(handle, 0, req_addr + 3, value_len)


// ── Fully-ram-backed read handlers (no heap [u8] blob) ────────────
//
// Each mirrors handle_*_to_scratch but reads request bytes directly
// from RX RAM via hw.mem_read8 and looks up attribute bytes via
// db_*_ram accessors.  Eliminates the per-request gatt_db_ram_to_blob
// rebuild (which OOM'd the 36 KB heap with N² list.append pressure)
// and the att_req [u8] decode loop.
//
// Convention shared with the heap-side handlers:
//   - Caller has already laid down the 4-byte L2CAP header
//     placeholder in scratch.  Handler appends ATT bytes from
//     the current cursor.
//   - Returns true on success (response bytes written or expected
//     no-response for WRITE_CMD).  False on overflow / paths that
//     leave nothing in scratch.

// Read handle:u16 LE at byte offset 1 of an ATT request stored at
// req_addr.  Returns -1 on truncated request.
@tier(embedded)
fn read_req_handle_ram(req_addr: Int, req_len: Int) -> Int [hw]
    if req_len < 3
        -1
    else
        hw.mem_read8(req_addr + 1) | (hw.mem_read8(req_addr + 2) << 8)

// Read u16 LE at byte offset `off` of an ATT request.  Returns -1
// when off+1 >= req_len.
@tier(embedded)
fn read_req_u16_at_ram(req_addr: Int, req_len: Int, off: Int) -> Int [hw]
    if off + 1 >= req_len
        -1
    else
        hw.mem_read8(req_addr + off) | (hw.mem_read8(req_addr + off + 1) << 8)


@tier(embedded)
fn handle_read_ram(req_addr: Int, req_len: Int) -> Bool [hw]
    let handle = read_req_handle_ram(req_addr, req_len)
    if handle < 0
        write_error_rsp(att.ATT_OP_READ_REQ, 0, att.ATT_ERR_INVALID_PDU)
    else
        let idx = db_index_for_handle_ram(handle)
        if idx < 0
            write_error_rsp(att.ATT_OP_READ_REQ, handle, att.ATT_ERR_INVALID_HANDLE)
        else
            if not att_scratch.scratch_write_u8(att.ATT_OP_READ_RSP)
                false
            else
                db_write_value_to_scratch_ram(idx)


@tier(embedded)
fn handle_read_blob_ram(my_mtu: Int, req_addr: Int, req_len: Int) -> Bool [hw]
    let handle = read_req_handle_ram(req_addr, req_len)
    let offset = read_req_u16_at_ram(req_addr, req_len, 3)
    if handle < 0 or offset < 0
        write_error_rsp(att.ATT_OP_READ_BLOB_REQ, 0, att.ATT_ERR_INVALID_PDU)
    else
        let idx = db_index_for_handle_ram(handle)
        if idx < 0
            write_error_rsp(att.ATT_OP_READ_BLOB_REQ, handle, att.ATT_ERR_INVALID_HANDLE)
        else
            let value_len = db_value_len_at_ram(idx)
            if offset > value_len
                write_error_rsp(att.ATT_OP_READ_BLOB_REQ, handle, att.ATT_ERR_INVALID_OFFSET)
            else if offset == value_len
                att_scratch.scratch_write_u8(att.ATT_OP_READ_BLOB_RSP)
            else
                if not att_scratch.scratch_write_u8(att.ATT_OP_READ_BLOB_RSP)
                    false
                else
                    let max = my_mtu - 1
                    var end = offset + max
                    if value_len < end
                        end = value_len
                    var i = offset
                    var ok = true
                    loop
                        if i >= end or not ok
                            break
                        ok = att_scratch.scratch_write_u8(db_value_byte_at_ram(idx, i))
                        i = i + 1
                    ok


@tier(embedded)
fn handle_read_by_type_ram(my_mtu: Int, req_addr: Int, req_len: Int) -> Bool [hw]
    let start = read_req_u16_at_ram(req_addr, req_len, 1)
    let end = read_req_u16_at_ram(req_addr, req_len, 3)
    // Type len: 7 = 16-bit UUID, 21 = 128-bit UUID.
    let tlen = if req_len == 7
        2
    else if req_len == 21
        16
    else
        -1
    if start < 0 or end < 0 or tlen < 0
        write_error_rsp(att.ATT_OP_READ_BY_TYPE_REQ, 0, att.ATT_ERR_INVALID_PDU)
    else if tlen != 2
        write_error_rsp(att.ATT_OP_READ_BY_TYPE_REQ, start, att.ATT_ERR_REQUEST_NOT_SUPPORTED)
    else if start == 0 or start > end
        write_error_rsp(att.ATT_OP_READ_BY_TYPE_REQ, start, att.ATT_ERR_INVALID_HANDLE)
    else
        let type16 = read_req_u16_at_ram(req_addr, req_len, 5)
        let count = db_count_ram()
        let header_off = att_scratch.scratch_len()
        if not att_scratch.scratch_write_u8(att.ATT_OP_READ_BY_TYPE_RSP)
            false
        else
            let pair_len_off = att_scratch.scratch_len()
            if not att_scratch.scratch_write_u8(0)
                false
            else
                var pair_value_len = -1
                var pair_byte_len = 0
                var pairs_written = 0
                var i = 0
                let max_payload = my_mtu - 2
                loop
                    if i >= count
                        break
                    let h = db_handle_at_ram(i)
                    let t = db_type16_at_ram(i)
                    if h >= start and h <= end and t == type16
                        let vlen = db_value_len_at_ram(i)
                        if pair_value_len < 0
                            pair_value_len = vlen
                            pair_byte_len = 2 + vlen
                            att_scratch.scratch_patch_u8(pair_len_off, pair_byte_len)
                        if vlen == pair_value_len
                            let written_so_far = att_scratch.scratch_len() - (header_off + 2)
                            if written_so_far + pair_byte_len <= max_payload
                                let _ = att_scratch.scratch_write_u16_le(h)
                                let _ = db_write_value_to_scratch_ram(i)
                                pairs_written = pairs_written + 1
                            else
                                i = count
                    i = i + 1
                if pairs_written == 0
                    att_scratch.scratch_set_len(header_off)
                    write_error_rsp(att.ATT_OP_READ_BY_TYPE_REQ, start, att.ATT_ERR_ATTRIBUTE_NOT_FOUND)
                else
                    true


@tier(embedded)
fn handle_read_by_group_type_ram(my_mtu: Int, req_addr: Int, req_len: Int) -> Bool [hw]
    let start = read_req_u16_at_ram(req_addr, req_len, 1)
    let end = read_req_u16_at_ram(req_addr, req_len, 3)
    let tlen = if req_len == 7
        2
    else if req_len == 21
        16
    else
        -1
    if start < 0 or end < 0 or tlen < 0
        write_error_rsp(att.ATT_OP_READ_BY_GROUP_TYPE_REQ, 0, att.ATT_ERR_INVALID_PDU)
    else if tlen != 2
        write_error_rsp(att.ATT_OP_READ_BY_GROUP_TYPE_REQ, start, att.ATT_ERR_REQUEST_NOT_SUPPORTED)
    else if start == 0 or start > end
        write_error_rsp(att.ATT_OP_READ_BY_GROUP_TYPE_REQ, start, att.ATT_ERR_INVALID_HANDLE)
    else
        let type16 = read_req_u16_at_ram(req_addr, req_len, 5)
        if type16 != att_server.GATT_UUID_PRIMARY_SERVICE
            write_error_rsp(att.ATT_OP_READ_BY_GROUP_TYPE_REQ, start, att.ATT_ERR_UNSUPPORTED_GROUP_TYPE)
        else
            let count = db_count_ram()
            let header_off = att_scratch.scratch_len()
            if not att_scratch.scratch_write_u8(att.ATT_OP_READ_BY_GROUP_TYPE_RSP)
                false
            else
                let triplet_len_off = att_scratch.scratch_len()
                if not att_scratch.scratch_write_u8(0)
                    false
                else
                    var triplet_value_len = -1
                    var triplet_byte_len = 0
                    var triplets_written = 0
                    var i = 0
                    let max_payload = my_mtu - 2
                    loop
                        if i >= count
                            break
                        let h = db_handle_at_ram(i)
                        let t = db_type16_at_ram(i)
                        if h >= start and h <= end and t == type16
                            let eg = db_end_group_at_ram(i)
                            let vlen = db_value_len_at_ram(i)
                            if triplet_value_len < 0
                                triplet_value_len = vlen
                                triplet_byte_len = 4 + vlen
                                att_scratch.scratch_patch_u8(triplet_len_off, triplet_byte_len)
                            if vlen == triplet_value_len
                                let written_so_far = att_scratch.scratch_len() - (header_off + 2)
                                if written_so_far + triplet_byte_len <= max_payload
                                    let _ = att_scratch.scratch_write_u16_le(h)
                                    let _ = att_scratch.scratch_write_u16_le(eg)
                                    let _ = db_write_value_to_scratch_ram(i)
                                    triplets_written = triplets_written + 1
                                else
                                    i = count
                        i = i + 1
                    if triplets_written == 0
                        att_scratch.scratch_set_len(header_off)
                        write_error_rsp(att.ATT_OP_READ_BY_GROUP_TYPE_REQ, start, att.ATT_ERR_ATTRIBUTE_NOT_FOUND)
                    else
                        true


@tier(embedded)
fn handle_find_information_ram(my_mtu: Int, req_addr: Int, req_len: Int) -> Bool [hw]
    let start = read_req_u16_at_ram(req_addr, req_len, 1)
    let end = read_req_u16_at_ram(req_addr, req_len, 3)
    if start < 0 or end < 0
        write_error_rsp(att.ATT_OP_FIND_INFORMATION_REQ, 0, att.ATT_ERR_INVALID_PDU)
    else if start == 0 or start > end
        write_error_rsp(att.ATT_OP_FIND_INFORMATION_REQ, start, att.ATT_ERR_INVALID_HANDLE)
    else
        let count = db_count_ram()
        let header_off = att_scratch.scratch_len()
        if not att_scratch.scratch_write_u8(att.ATT_OP_FIND_INFORMATION_RSP)
            false
        else
            if not att_scratch.scratch_write_u8(att.ATT_FIND_INFO_FORMAT_UUID16)
                false
            else
                var pairs_written = 0
                var i = 0
                let max_payload = my_mtu - 2
                loop
                    if i >= count
                        break
                    let h = db_handle_at_ram(i)
                    let t = db_type16_at_ram(i)
                    if h >= start and h <= end
                        let written_so_far = att_scratch.scratch_len() - (header_off + 2)
                        if written_so_far + 4 <= max_payload
                            let _ = att_scratch.scratch_write_u16_le(h)
                            let _ = att_scratch.scratch_write_u16_le(t)
                            pairs_written = pairs_written + 1
                        else
                            i = count
                    i = i + 1
                if pairs_written == 0
                    att_scratch.scratch_set_len(header_off)
                    write_error_rsp(att.ATT_OP_FIND_INFORMATION_REQ, start, att.ATT_ERR_ATTRIBUTE_NOT_FOUND)
                else
                    true


@tier(embedded)
fn handle_find_by_type_value_ram(my_mtu: Int, req_addr: Int, req_len: Int) -> Bool [hw]
    let start = read_req_u16_at_ram(req_addr, req_len, 1)
    let end = read_req_u16_at_ram(req_addr, req_len, 3)
    let type16 = read_req_u16_at_ram(req_addr, req_len, 5)
    if start < 0 or end < 0 or type16 < 0 or req_len < 7
        write_error_rsp(att.ATT_OP_FIND_BY_TYPE_VALUE_REQ, 0, att.ATT_ERR_INVALID_PDU)
    else if start == 0 or start > end
        write_error_rsp(att.ATT_OP_FIND_BY_TYPE_VALUE_REQ, start, att.ATT_ERR_INVALID_HANDLE)
    else
        let compare_len = req_len - 7
        let count = db_count_ram()
        let header_off = att_scratch.scratch_len()
        if not att_scratch.scratch_write_u8(att.ATT_OP_FIND_BY_TYPE_VALUE_REQ + 1)   // RSP = 0x07
            false
        else
            var pairs_written = 0
            var i = 0
            let max_payload = my_mtu - 1
            loop
                if i >= count
                    break
                let h = db_handle_at_ram(i)
                let t = db_type16_at_ram(i)
                if h >= start and h <= end and t == type16
                    let vlen = db_value_len_at_ram(i)
                    if vlen == compare_len
                        var matches = true
                        var j = 0
                        loop
                            if j >= compare_len
                                break
                            if db_value_byte_at_ram(i, j) != hw.mem_read8(req_addr + 7 + j)
                                matches = false
                                break
                            j = j + 1
                        if matches
                            let eg = db_end_group_at_ram(i)
                            let written_so_far = att_scratch.scratch_len() - (header_off + 1)
                            if written_so_far + 4 <= max_payload
                                let _ = att_scratch.scratch_write_u16_le(h)
                                let _ = att_scratch.scratch_write_u16_le(eg)
                                pairs_written = pairs_written + 1
                            else
                                i = count
                i = i + 1
            if pairs_written == 0
                att_scratch.scratch_set_len(header_off)
                write_error_rsp(att.ATT_OP_FIND_BY_TYPE_VALUE_REQ, start, att.ATT_ERR_ATTRIBUTE_NOT_FOUND)
            else
                true


// Read-side dispatch (fully ram).  Returns Bool indicating whether
// the handler successfully wrote response bytes into scratch.
// Extracted into its own function so the top-level dispatcher
// doesn't trip Novo's LLVM codegen on a deep if/else-if/else chain
// with a match inside the trailing else.
@tier(embedded)
fn dispatch_read_ram(my_mtu: Int, req_addr: Int, req_len: Int) -> Bool [hw]
    let op = hw.mem_read8(req_addr)
    let m = att.opcode_method(op)
    match m
        0x02 => handle_exchange_mtu_to_scratch(my_mtu)
        0x0A => handle_read_ram(req_addr, req_len)
        0x0C => handle_read_blob_ram(my_mtu, req_addr, req_len)
        0x08 => handle_read_by_type_ram(my_mtu, req_addr, req_len)
        0x10 => handle_read_by_group_type_ram(my_mtu, req_addr, req_len)
        0x04 => handle_find_information_ram(my_mtu, req_addr, req_len)
        0x06 => handle_find_by_type_value_ram(my_mtu, req_addr, req_len)
        _    => write_error_rsp(op, 0, att.ATT_ERR_REQUEST_NOT_SUPPORTED)


// Top-level fully-ram dispatcher.  Zero heap traffic; reads request
// bytes from RX RAM directly, walks the ram-backed gatt_db, writes
// response bytes into att_scratch.  Returns the rsp_len; the
// associated write_handle is stashed in
// att_scratch.last_write_handle.
//
// Flat structure (no else-if chain) — Novo's LLVM codegen wrapped
// return values from a deep if/else-if/else with if-without-else
// side-effects in `novo_some_int` causing 'i64 vs ptr' type
// mismatches.  Computing the result via early returns one branch
// at a time sidesteps the type-inference quirk.
pub @tier(embedded)
fn handle_request_to_scratch_ram_full(my_mtu: Int, req_addr: Int, req_len: Int) -> Int [hw]
    let start_len = att_scratch.scratch_len()
    att_scratch.last_write_handle_clear()
    if req_len < 1
        let _ = write_error_rsp(0, 0, att.ATT_ERR_INVALID_PDU)
        return att_scratch.scratch_len() - start_len
    let op = hw.mem_read8(req_addr)
    if op == att.ATT_OP_WRITE_REQ
        let h = hw.mem_read8(req_addr + 1) | (hw.mem_read8(req_addr + 2) << 8)
        let ok = handle_write_req_to_scratch_ram(req_addr, req_len)
        let rsp_len = att_scratch.scratch_len() - start_len
        if ok and rsp_len == 1
            att_scratch.last_write_handle_set(h)
        return rsp_len
    if op == att.ATT_OP_WRITE_CMD
        let h = hw.mem_read8(req_addr + 1) | (hw.mem_read8(req_addr + 2) << 8)
        let applied = handle_write_cmd_to_scratch_ram(req_addr, req_len)
        if applied
            att_scratch.last_write_handle_set(h)
        return 0
    // Read-side
    let ok = dispatch_read_ram(my_mtu, req_addr, req_len)
    if ok
        att_scratch.scratch_len() - start_len
    else
        0


// (Old hybrid `handle_request_to_scratch_ram` removed —
// superseded by `handle_request_to_scratch_ram_full` above which
// is fully ram-backed and has no struct return.  LLVM codegen
// tripped on the `(rsp_len, write_handle)` struct return of the
// hybrid version through the read-fallback dispatch path.)
