// tests/gatt_client_engine_tests.nv -- the GATT client engine against the
// GATT server, in one process.
//
// `gatt_client` is the client half and `gatt_server` the server half of the
// Attribute Protocol.  Each test builds a server (the database of
// `gatt_server.host_server` and the services it adds), opens a client link on
// a `ClientTable`, and moves the PDUs between them as a transport would:
// whatever `take_tx` hands out goes to `gatt_server.receive_on`, and what the
// server answers goes to `on_pdu`.  A second server and a second client link
// make the two links of a Central that talks to two peripherals at once.
//
//   * every procedure of the engine runs against the server that answers it:
//     MTU exchange, the discoveries, the reads, the writes, the subscriptions;
//   * the error paths: an Error Response, a response that cannot be read, a
//     transaction that times out, a queue that is full;
//   * the peer's database changes: Database Out Of Sync, the Database Hash and
//     a Service Changed indication;
//   * two links, and two bearers of one link, run side by side and keep their
//     own state.

use std.test
use att
use gatt_client
use gatt_db
use gatt_server
use links
use noble.CONFIG

// ── Fixtures ────────────────────────────────────────────────────────

// What a run of the PDU pump saw: the events `on_pdu` answered, and for each
// `EV_DONE` the ticket, the status and the value buffer at that moment.
struct Log
    var events: [Int]
    var tickets: [Int]
    var statuses: [Int]
    var values: [[Int]]
    var sent: [[Int]]
    var notified: [Int]
    var pushed: [[Int]]
    var kinds: [Int]

fn new_log() -> Log
    Log { events: [],
        tickets: [],
        statuses: [],
        values: [],
        sent: [],
        notified: [],
        pushed: [],
        kinds: [] }

fn to_pdu(b: [u8]) -> gatt_client.ClientPdu
    var v: gatt_client.ClientPdu = Vec.new()
    for x in b
        let _ = v.push(x)
    v

fn from_pdu(v: gatt_client.ClientPdu, n: Int) -> [u8]
    var out: [u8] = []
    for i in 0..n
        list.push(out, v[i])
    out

fn payload(b: [Int]) -> gatt_client.ClientPayload
    var v: gatt_client.ClientPayload = Vec.new()
    for x in b
        let _ = v.push(x as u8)
    v

fn ints(b: [u8]) -> [Int]
    var out: [Int] = []
    for x in b
        list.push(out, x as Int)
    out

fn value_of(var t: gatt_client.ClientTable, link: links.LinkId, bearer: Int) -> [Int]
    var out: [Int] = []
    for i in 0..gatt_client.value_len(var t, link, bearer)
        list.push(out, gatt_client.value_at(var t, link, bearer, i))
    out

fn fill(n: Int, v: Int) -> [Int]
    var out: [Int] = []
    for _ in 0..n
        list.push(out, v)
    out

fn ramp(n: Int) -> [Int]
    var out: [Int] = []
    for i in 0..n
        list.push(out, (i + 1) & 0xFF)
    out

fn link_a() -> links.LinkId
    links.link_id(0, 1)

fn link_b() -> links.LinkId
    links.link_id(1, 1)

// A table with link A open.
fn table() -> gatt_client.ClientTable
    var t = gatt_client.new_table()
    test.assert(gatt_client.open(var t, link_a()))
    t

// Hand the client bearer's PDUs to `s` and the answers back, until the client
// has nothing more to send.  `now` is the clock the client's timers read.
fn pump_at(var t: gatt_client.ClientTable, link: links.LinkId, bearer: Int,
           var s: gatt_server.GattServer, now: Int, var log: Log)
    for _ in 0..200
        var out: gatt_client.ClientPdu = Vec.new()
        let kind = gatt_client.take_tx(var t, link, bearer, now, var out)
        if kind == gatt_client.TX_NONE
            return
        list.push(log.kinds, kind)
        let sent = from_pdu(out, out.len())
        list.push(log.sent, ints(sent))
        for r in gatt_server.receive_on(var s.db, var s.link, bearer, sent, now)
            deliver(var t, link, bearer, r, var log)
    test.fail("the pump did not settle")

// Feed one PDU to the client and note what came of it.
fn deliver(var t: gatt_client.ClientTable, link: links.LinkId, bearer: Int, pdu: [u8], var log: Log)
    var p = to_pdu(pdu)
    let ev = gatt_client.on_pdu(var t, link, bearer, var p, list.len(pdu))
    if ev != gatt_client.EV_NONE
        list.push(log.events, ev)
    if ev == gatt_client.EV_DONE
        list.push(log.tickets, gatt_client.result_ticket(var t, link, bearer))
        list.push(log.statuses, gatt_client.result_status(var t, link, bearer))
        list.push(log.values, value_of(var t, link, bearer))
    if ev == gatt_client.EV_NOTIFICATION or ev == gatt_client.EV_INDICATION or ev == gatt_client.EV_SERVICE_CHANGED
        list.push(log.notified, gatt_client.event_handle(var t, link, bearer))
        list.push(log.pushed, ints(pdu[3:]))

fn pump(var t: gatt_client.ClientTable, link: links.LinkId, var s: gatt_server.GattServer,
        var log: Log)
    pump_at(var t, link, 0, var s, 0, var log)

// Take one PDU from the client bearer, hand it to the server and answer what
// the server answered without delivering it, so a test can change it first.
// `kind` is what `take_tx` said; the answers are empty when there was nothing
// to send.
fn exchange(var t: gatt_client.ClientTable, link: links.LinkId, bearer: Int,
            var s: gatt_server.GattServer, now: Int, var log: Log) -> [[u8]]
    var out: gatt_client.ClientPdu = Vec.new()
    let kind = gatt_client.take_tx(var t, link, bearer, now, var out)
    if kind == gatt_client.TX_NONE
        return []
    list.push(log.kinds, kind)
    let sent = from_pdu(out, out.len())
    list.push(log.sent, ints(sent))
    gatt_server.receive_on(var s.db, var s.link, bearer, sent, now)

// The value the server holds at `handle`.
fn served(var s: gatt_server.GattServer, handle: Int) -> [Int]
    ints(s.db.attributes[gatt_server.index_of(s.db, handle)].value)

// Run one request to its end and answer its status.
fn run(var t: gatt_client.ClientTable, link: links.LinkId, var s: gatt_server.GattServer,
       ticket: Int) -> Int
    test.assert(ticket > 0)
    var trace = new_log()
    pump(var t, link, var s, var trace)
    test.assert_eq(list.len(trace.tickets), 1)
    test.assert_eq(trace.tickets[0], ticket)
    trace.statuses[0]

// A server with the services below on top of the GAP and GATT services of
// `host_server` (handles 0x0001 to 0x0017):
//
//   0x0018 service 0xAA00, to 0x0021
//     0x0019 characteristic 0xAA01 (read, write), value 0x001A = 01 02 03 04
//     0x001B characteristic 0xAA02 (read, write, notify, indicate), value 0x001C,
//            with the configuration descriptor 0x001D and a user description 0x001E
//     0x001F characteristic 0xAA03 (read), value 0x0020 = the ramp of 100 octets
//     0x0021 characteristic 0xAA04 (write without response), value 0x0022
//   0x0023 service 0xBB00, to 0x0026, which includes the first service
//     0x0024 include of 0x0018
//     0x0025 characteristic 0xBB01 (read), value 0x0026
fn server() -> gatt_server.GattServer
    var s = gatt_server.host_server()
    test.assert_eq(gatt_server.add_service(var s.db, false, gatt_server.le16(0xAA00)), 0x0018)
    test.assert_eq(gatt_server.add_characteristic(var s.db, 0x0A, gatt_server.PERM_READ | gatt_server.PERM_WRITE, gatt_server.le16(0xAA01)),
        0x0019)
    test.assert(gatt_server.set_value(var s.db, 0, [0x01, 0x02, 0x03, 0x04]))
    test.assert_eq(gatt_server.add_characteristic(var s.db, 0x3A, gatt_server.PERM_READ | gatt_server.PERM_WRITE, gatt_server.le16(0xAA02)),
        0x001B)
    test.assert(gatt_server.set_value(var s.db, 0, [0x09]))
    test.assert_eq(gatt_server.add_descriptor(var s.db,
        gatt_server.PERM_READ | gatt_server.PERM_WRITE,
        gatt_server.le16(gatt_server.UUID_CLIENT_CHARACTERISTIC_CONFIGURATION)),
    0x001D)
    test.assert_eq(gatt_server.add_descriptor(var s.db,
        gatt_server.PERM_READ,
        gatt_server.le16(gatt_server.UUID_CHARACTERISTIC_USER_DESCRIPTION)),
    0x001E)
    test.assert_eq(gatt_server.add_characteristic(var s.db, 0x02, gatt_server.PERM_READ, gatt_server.le16(0xAA03)),
        0x001F)
    test.assert(gatt_server.set_value(var s.db, 0, gatt_server.octets(ramp(100))))
    test.assert_eq(gatt_server.add_characteristic(var s.db, 0x04, gatt_server.PERM_WRITE, gatt_server.le16(0xAA04)),
        0x0021)
    test.assert(gatt_server.set_value(var s.db, 0, [0x00]))
    test.assert_eq(gatt_server.add_service(var s.db, false, gatt_server.le16(0xBB00)), 0x0023)
    test.assert_eq(gatt_server.add_included(var s.db, 0x0018), 0x0024)
    test.assert_eq(gatt_server.add_characteristic(var s.db, 0x02, gatt_server.PERM_READ, gatt_server.le16(0xBB01)),
        0x0025)
    test.assert(gatt_server.set_value(var s.db, 0, [0x77]))
    s

// ── Link and bearer ─────────────────────────────────────────────────

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_the_mtu_is_exchanged_once_and_is_the_smaller_of_the_two()
    var t = table()
    var s = server()
    test.assert_eq(gatt_client.mtu(var t, link_a(), 0), 23)
    let ticket = gatt_client.begin_exchange_mtu(var t, link_a(), 0)
    test.assert_eq(run(var t, link_a(), var s, ticket), 0)
    // The server's Rx MTU is 65 and the client offers its own 247.
    test.assert_eq(gatt_client.mtu(var t, link_a(), 0), 65)
    test.assert_eq(gatt_server.mtu_of(s.link, 0), 65)
    test.assert_eq(gatt_client.begin_exchange_mtu(var t, link_a(), 0), gatt_client.ERR_REPEAT)

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_the_mtu_request_carries_the_clients_rx_mtu()
    var t = table()
    var s = server()
    var trace = new_log()
    let _ = gatt_client.begin_exchange_mtu(var t, link_a(), 0)
    pump(var t, link_a(), var s, var trace)
    test.assert_eq(trace.sent[0], [0x02, noble.CONFIG.MAX_ATT_MTU & 0xFF, noble.CONFIG.MAX_ATT_MTU >>> 8])

// ── Discovery ───────────────────────────────────────────────────────

// Record `i` of the cache as kind, handle, a, b and the UUID's low word.
fn rec(var t: gatt_client.ClientTable, link: links.LinkId, i: Int) -> [Int]
    [gatt_client.cache_kind_at(var t, link, i), gatt_client.cache_handle_at(var t, link, i), gatt_client.cache_a_at(var t, link, i),
        gatt_client.cache_b_at(var t, link, i), gatt_client.cache_uuid_at(var t, link, i).lo]

// The UUID of the 16 octets `b` as they are on the air.
fn uuid_of(b: [u8]) -> gatt_client.Uuid
    var lo = 0
    var hi = 0
    for k in 0..8
        lo = lo | (b[k] as Int << (8 * k))
        hi = hi | (b[8 + k] as Int << (8 * k))
    gatt_client.uuid128(lo, hi)

fn discover_everything(var t: gatt_client.ClientTable, link: links.LinkId,
                       var s: gatt_server.GattServer)
    test.assert_eq(run(var t, link, var s, gatt_client.begin_exchange_mtu(var t, link, 0)), 0)
    test.assert_eq(run(var t, link, var s, gatt_client.begin_discover_services(var t, link, 0, 1, 0xFFFF, false)),
        0)

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_primary_services_are_discovered_and_cached()
    var t = table()
    var s = server()
    discover_everything(var t, link_a(), var s)
    test.assert_eq(gatt_client.cache_count(var t, link_a()), 4)
    test.assert_eq(rec(var t, link_a(), 0), [1, 0x0001, 0x000D, 0, 0x1800])
    test.assert_eq(rec(var t, link_a(), 1), [1, 0x000E, 0x0017, 0, 0x1801])
    test.assert_eq(rec(var t, link_a(), 2), [1, 0x0018, 0x0022, 0, 0xAA00])
    test.assert_eq(rec(var t, link_a(), 3), [1, 0x0023, 0x0026, 0, 0xBB00])
    test.assert(not gatt_client.cache_secondary_at(var t, link_a(), 0))

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_discovery_pages_until_the_range_ends()
    var t = table()
    var s = server()
    // At ATT_MTU 23 a response holds three services of six octets.
    var trace = new_log()
    let _ = gatt_client.begin_discover_services(var t, link_a(), 0, 1, 0xFFFF, false)
    pump(var t, link_a(), var s, var trace)
    // The third request, past the last service, is answered Attribute Not Found.
    test.assert_eq(list.len(trace.sent), 3)
    test.assert_eq(trace.sent[0], [0x10, 0x01, 0x00, 0xFF, 0xFF, 0x00, 0x28])
    test.assert_eq(trace.sent[1], [0x10, 0x23, 0x00, 0xFF, 0xFF, 0x00, 0x28])
    test.assert_eq(trace.sent[2], [0x10, 0x27, 0x00, 0xFF, 0xFF, 0x00, 0x28])
    test.assert_eq(trace.statuses, [0])
    test.assert_eq(gatt_client.result_found(var t, link_a(), 0), 4)
    test.assert_eq(gatt_client.cache_count(var t, link_a()), 4)

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_discovery_of_a_narrow_range_stops_at_its_end()
    var t = table()
    var s = server()
    var trace = new_log()
    let _ = gatt_client.begin_discover_services(var t, link_a(), 0, 0x0018, 0x0018, false)
    pump(var t, link_a(), var s, var trace)
    test.assert_eq(list.len(trace.sent), 1)
    test.assert_eq(gatt_client.cache_count(var t, link_a()), 1)
    test.assert_eq(rec(var t, link_a(), 0), [1, 0x0018, 0x0022, 0, 0xAA00])

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_range_with_no_service_ends_well_with_nothing_found()
    var t = table()
    var s = server()
    test.assert_eq(run(var t,
        link_a(),
        var s,
        gatt_client.begin_discover_services(var t, link_a(), 0, 0x0030, 0xFFFF, false)),
        0)
    test.assert_eq(gatt_client.result_found(var t, link_a(), 0), 0)
    test.assert_eq(gatt_client.cache_count(var t, link_a()), 0)

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_services_of_both_uuid_widths_are_discovered()
    var t = table()
    var s = server()
    let wide = gatt_server.add_service(var s.db, false, gatt_server.uuid128(0x05))
    test.assert_eq(wide, 0x0027)
    discover_everything(var t, link_a(), var s)
    test.assert_eq(gatt_client.cache_count(var t, link_a()), 5)
    let u = gatt_client.cache_uuid_at(var t, link_a(), 4)
    test.assert(u.wide)
    test.assert(gatt_client.uuid_same(u, uuid_of(gatt_server.uuid128(0x05))))
    test.assert_eq(gatt_client.cache_handle_at(var t, link_a(), 4), 0x0027)

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_secondary_services_are_discovered_apart_from_primary_ones()
    var t = table()
    var s = server()
    let secondary = gatt_server.add_service(var s.db, true, gatt_server.le16(0xCC00))
    test.assert_eq(run(var t,
        link_a(),
        var s,
        gatt_client.begin_discover_services(var t, link_a(), 0, 1, 0xFFFF, true)),
        0)
    test.assert_eq(gatt_client.cache_count(var t, link_a()), 1)
    test.assert_eq(gatt_client.cache_handle_at(var t, link_a(), 0), secondary)
    test.assert(gatt_client.cache_secondary_at(var t, link_a(), 0))

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_service_is_found_by_uuid()
    var t = table()
    var s = server()
    var trace = new_log()
    let _ = gatt_client.begin_discover_services_by_uuid(var t, link_a(), 0, 1, 0xFFFF, gatt_client.uuid16(0xBB00))
    pump(var t, link_a(), var s, var trace)
    test.assert_eq(trace.sent[0], [0x06, 0x01, 0x00, 0xFF, 0xFF, 0x00, 0x28, 0x00, 0xBB])
    test.assert_eq(trace.statuses, [0])
    test.assert_eq(gatt_client.cache_count(var t, link_a()), 1)
    test.assert_eq(rec(var t, link_a(), 0), [1, 0x0023, 0x0026, 0, 0xBB00])

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_128_bit_service_is_found_by_uuid()
    var t = table()
    var s = server()
    let _ = gatt_server.add_service(var s.db, false, gatt_server.uuid128(0x05))
    let want = uuid_of(gatt_server.uuid128(0x05))
    var trace = new_log()
    let _ = gatt_client.begin_discover_services_by_uuid(var t, link_a(), 0, 1, 0xFFFF, want)
    pump(var t, link_a(), var s, var trace)
    test.assert_eq(list.len(trace.sent[0]), 7 + 16)
    test.assert_eq(trace.statuses, [0])
    test.assert_eq(gatt_client.cache_count(var t, link_a()), 1)
    test.assert(gatt_client.uuid_same(gatt_client.cache_uuid_at(var t, link_a(), 0), want))

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_service_that_is_not_there_is_not_found_and_not_an_error()
    var t = table()
    var s = server()
    test.assert_eq(run(var t,
        link_a(),
        var s,
        gatt_client.begin_discover_services_by_uuid(var t, link_a(), 0, 1, 0xFFFF, gatt_client.uuid16(0x1234))),
    0)
    test.assert_eq(gatt_client.cache_count(var t, link_a()), 0)

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_characteristics_of_a_service_are_discovered()
    var t = table()
    var s = server()
    test.assert_eq(run(var t,
        link_a(),
        var s,
        gatt_client.begin_discover_characteristics(var t, link_a(), 0, 0x0018, 0x0022)),
        0)
    test.assert_eq(gatt_client.cache_count(var t, link_a()), 4)
    test.assert_eq(rec(var t, link_a(), 0), [3, 0x0019, 0x001A, 0x0A, 0xAA01])
    test.assert_eq(rec(var t, link_a(), 1), [3, 0x001B, 0x001C, 0x3A, 0xAA02])
    test.assert_eq(rec(var t, link_a(), 2), [3, 0x001F, 0x0020, 0x02, 0xAA03])
    test.assert_eq(rec(var t, link_a(), 3), [3, 0x0021, 0x0022, 0x04, 0xAA04])

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_characteristics_are_found_by_uuid_and_only_those_are_cached()
    var t = table()
    var s = server()
    var trace = new_log()
    let _ = gatt_client.begin_discover_characteristics_by_uuid(var t, link_a(), 0, 0x0018, 0x0022, gatt_client.uuid16(0xAA03))
    pump(var t, link_a(), var s, var trace)
    test.assert_eq(trace.statuses, [0])
    test.assert_eq(gatt_client.cache_count(var t, link_a()), 1)
    test.assert_eq(rec(var t, link_a(), 0), [3, 0x001F, 0x0020, 0x02, 0xAA03])
    test.assert_eq(gatt_client.result_found(var t, link_a(), 0), 1)

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_128_bit_characteristic_is_discovered()
    var t = table()
    var s = server()
    let decl = gatt_server.add_characteristic(var s.db, 0x02, gatt_server.PERM_READ, gatt_server.uuid128(0x06))
    test.assert(gatt_server.set_value(var s.db, 0, [0x01]))
    test.assert_eq(run(var t,
        link_a(),
        var s,
        gatt_client.begin_discover_characteristics(var t, link_a(), 0, decl, decl + 1)),
        0)
    test.assert_eq(gatt_client.cache_count(var t, link_a()), 1)
    test.assert(gatt_client.uuid_same(gatt_client.cache_uuid_at(var t, link_a(), 0), uuid_of(gatt_server.uuid128(0x06))))
    test.assert_eq(gatt_client.cache_a_at(var t, link_a(), 0), decl + 1)

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_descriptors_are_discovered_and_the_cccd_is_found()
    var t = table()
    var s = server()
    test.assert_eq(run(var t,
        link_a(),
        var s,
        gatt_client.begin_discover_characteristics(var t, link_a(), 0, 0x0018, 0x0022)),
        0)
    test.assert_eq(run(var t,
        link_a(),
        var s,
        gatt_client.begin_discover_descriptors(var t, link_a(), 0, 0x001D, 0x001E)),
        0)
    test.assert_eq(gatt_client.cache_count(var t, link_a()), 6)
    test.assert_eq(rec(var t, link_a(), 4), [4, 0x001D, 0, 0, 0x2902])
    test.assert_eq(rec(var t, link_a(), 5), [4, 0x001E, 0, 0, 0x2901])
    // The second characteristic owns the descriptors; no other does.
    test.assert_eq(gatt_client.cccd_of(var t, link_a(), 1), 0x001D)
    test.assert_eq(gatt_client.cccd_of(var t, link_a(), 0), 0)
    test.assert_eq(gatt_client.cccd_of(var t, link_a(), 2), 0)
    test.assert_eq(gatt_client.descriptor_of(var t, link_a(), 1, 0x2901), 0x001E)

