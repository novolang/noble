@when(noble_config.EVENT_QUEUE == 4 and noble_config.ATT_VALUE_BYTES >= 32)
@test
fn test_a_second_call_while_one_is_in_flight_answers_busy_and_a_call_before_start_answers_not_ready()
    var h = new_host(2)
    var l = script_link()
    var p = test_policy()
    var b = new_store()
    test.assert(host_api.begin(var h, Request.Connect(peer_addr(1), noble.conn_params_default())).is(noble.LAYER_LOCAL, noble.E_NOT_READY))
    started(var h, var l, var p, var b)
    test.assert(host_api.begin(var h, Request.Connect(peer_addr(1), noble.conn_params_default())).is_ok())
    test.assert(host_api.begin(var h, Request.ConnectCancel).is(noble.LAYER_LOCAL, noble.E_BUSY))
    test.assert(host_api.result(var h) == None)
    // Giving the call up frees the Host for the next one.
    host_api.abandon(var h)
    test.assert(host_api.begin(var h, Request.ConnectCancel).is_ok())
    // Extended scanning is not served: the Host reads the legacy report only.
    host_api.abandon(var h)
    let extended = noble.ScanParams { active: false, extended: true, interval_ms: 100, window_ms: 50, duration_ms: 0 }
    test.assert(host_api.begin(var h, Request.ScanStart(extended, noble.scan_all())).is(noble.LAYER_LOCAL, noble.E_BAD_ARGUMENT))

