    test.assert(not gatt_client.is_dead(var t, link_a(), 0))

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_dead_bearer_is_alive_again_when_the_link_is_opened_again()
    var t = table()
    let _ = gatt_client.begin_read(var t, link_a(), 0, 0x001A)
    var out: gatt_client.ClientPdu = Vec.new()
    let _ = gatt_client.take_tx(var t, link_a(), 0, 0, var out)
    test.assert_eq(gatt_client.tick(var t, link_a(), 0, 30000), gatt_client.EV_DONE)
    test.assert(gatt_client.open(var t, links.link_id(0, 2)))
    test.assert(gatt_client.begin_read(var t, links.link_id(0, 2), 0, 0x001A) > 0)

// ── The peer's database changes ─────────────────────────────────────

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_the_database_hash_is_read_and_compared_with_the_last_one()
    var t = table()
    var s = server()
    discover_everything(var t, link_a(), var s)
    let first = gatt_client.begin_database_hash(var t, link_a(), 0)
    test.assert_eq(run(var t, link_a(), var s, first), 0)
    test.assert(not gatt_client.take_changed(var t, link_a()))
    test.assert_eq(gatt_client.cache_count(var t, link_a()), 4)
    // The same database: the cache stays.
    test.assert_eq(run(var t, link_a(), var s, gatt_client.begin_database_hash(var t, link_a(), 0)), 0)
    test.assert(not gatt_client.take_changed(var t, link_a()))
    test.assert_eq(gatt_client.cache_count(var t, link_a()), 4)
    // A new service: the hash differs and the cache goes.
    let _ = gatt_server.add_service(var s.db, false, gatt_server.le16(0xEE00))
    test.assert_eq(run(var t, link_a(), var s, gatt_client.begin_database_hash(var t, link_a(), 0)), 0)
    test.assert_eq(gatt_client.cache_count(var t, link_a()), 0)
    test.assert(gatt_client.take_changed(var t, link_a()))
    test.assert(not gatt_client.take_changed(var t, link_a()))

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_the_hash_request_is_read_by_type_over_all_handles()
    var t = table()
    var s = server()
    var trace = new_log()
    let _ = gatt_client.begin_database_hash(var t, link_a(), 0)
    pump(var t, link_a(), var s, var trace)
    test.assert_eq(trace.sent[0], [0x08, 0x01, 0x00, 0xFF, 0xFF, 0x2A, 0x2B])
    test.assert_eq(trace.values[0], [])

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_database_out_of_sync_marks_the_link_and_the_hash_read_clears_it()
    var t = table()
    var s = server()
    discover_everything(var t, link_a(), var s)
    // The client declares Robust Caching, then the database changes.
    var features = payload([gatt_server.CSF_ROBUST_CACHING])
    test.assert_eq(run(var t,
        link_a(),
        var s,
        gatt_client.begin_write(var t, link_a(), 0, gatt_db.GAP_SERVER_CLIENT_SUPPORTED_FEATURES_HANDLE, features, 1)),
    0)
    test.assert_eq(run(var t, link_a(), var s, gatt_client.begin_database_hash(var t, link_a(), 0)), 0)
    let _ = gatt_server.add_service(var s.db, false, gatt_server.le16(0xEE00))
    test.assert(not gatt_client.is_stale(var t, link_a()))
    let status = run(var t, link_a(), var s, gatt_client.begin_read(var t, link_a(), 0, 0x001A))
    test.assert_eq(status, att.ATT_ERR_DATABASE_OUT_OF_SYNC)
    test.assert(gatt_client.is_out_of_sync(status))
    test.assert(gatt_client.is_stale(var t, link_a()))
    // The cache is kept until the hash says it is wrong.
    test.assert_eq(gatt_client.cache_count(var t, link_a()), 4)
    test.assert_eq(run(var t, link_a(), var s, gatt_client.begin_database_hash(var t, link_a(), 0)), 0)
    test.assert(not gatt_client.is_stale(var t, link_a()))
    test.assert(gatt_client.take_changed(var t, link_a()))
    test.assert_eq(gatt_client.cache_count(var t, link_a()), 0)
    // Rediscovery finds the new service, and the read is served.
    test.assert_eq(run(var t,
        link_a(),
        var s,
        gatt_client.begin_discover_services(var t, link_a(), 0, 1, 0xFFFF, false)),
        0)
    test.assert_eq(gatt_client.cache_count(var t, link_a()), 5)
    test.assert_eq(run(var t, link_a(), var s, gatt_client.begin_read(var t, link_a(), 0, 0x001A)), 0)

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_service_changed_indication_drops_the_records_of_its_range()
    var t = table()
    var s = server()
    discover_everything(var t, link_a(), var s)
    test.assert_eq(run(var t,
        link_a(),
        var s,
        gatt_client.begin_discover_characteristics(var t, link_a(), 0, 0x0018, 0x0022)),
        0)
    test.assert_eq(gatt_client.cache_count(var t, link_a()), 8)
    gatt_client.set_service_changed_handle(var t, link_a(), gatt_db.GAP_SERVER_SERVICE_CHANGED_HANDLE)
    test.assert_eq(run(var t,
        link_a(),
        var s,
        gatt_client.begin_subscribe(var t, link_a(), 0, gatt_db.GAP_SERVER_SERVICE_CHANGED_CCCD_HANDLE, gatt_client.CCCD_INDICATE)),
    0)
    var trace = new_log()
    for pdu in gatt_server.service_changed(var s.db, var s.link, 0x0018, 0x0022, 0)
        deliver(var t, link_a(), 0, pdu, var trace)
    test.assert_eq(trace.events, [gatt_client.EV_SERVICE_CHANGED])
    test.assert_eq(gatt_client.service_changed_first(var t, link_a(), 0), 0x0018)
    test.assert_eq(gatt_client.service_changed_last(var t, link_a(), 0), 0x0022)
    // The service and its four characteristics went; the rest stayed.
    test.assert_eq(gatt_client.cache_count(var t, link_a()), 3)
    test.assert_eq(gatt_client.cache_handle_at(var t, link_a(), 0), 0x0001)
    test.assert_eq(gatt_client.cache_handle_at(var t, link_a(), 1), 0x000E)
    test.assert_eq(gatt_client.cache_handle_at(var t, link_a(), 2), 0x0023)
    test.assert(gatt_client.take_changed(var t, link_a()))
    // The indication is confirmed.
    pump(var t, link_a(), var s, var trace)
    test.assert_eq(trace.kinds, [gatt_client.TX_CONFIRM])

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_an_indication_of_another_handle_is_not_service_changed()
    var t = table()
    var trace = new_log()
    gatt_client.set_service_changed_handle(var t, link_a(), 0x0010)
    deliver(var t, link_a(), 0, [0x1D, 0x20, 0x00, 0x01, 0x00, 0x05, 0x00], var trace)
    test.assert_eq(trace.events, [gatt_client.EV_INDICATION])
    // A Service Changed indication too short to carry a range is a plain one.
    deliver(var t, link_a(), 0, [0x1D, 0x10, 0x00, 0x01], var trace)
    test.assert_eq(trace.events, [gatt_client.EV_INDICATION, gatt_client.EV_INDICATION])

// ── Two links, two bearers ──────────────────────────────────────────

// A table with both links open.
fn table2() -> gatt_client.ClientTable
    var t = table()
    test.assert(gatt_client.open(var t, link_b()))
    t

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_two_links_run_their_procedures_side_by_side()
    var t = table2()
    var sa = server()
    var sb = server()
    let _ = gatt_server.add_service(var sb.db, false, gatt_server.le16(0xEE00))
    var la = new_log()
    var lb = new_log()
    let ta = gatt_client.begin_discover_services(var t, link_a(), 0, 1, 0xFFFF, false)
    let tb = gatt_client.begin_discover_services(var t, link_b(), 0, 1, 0xFFFF, false)
    // One PDU of each at a time, as two controllers would deliver them.
    for _ in 0..4
        for r in exchange(var t, link_a(), 0, var sa, 0, var la)
            deliver(var t, link_a(), 0, r, var la)
        for r in exchange(var t, link_b(), 0, var sb, 0, var lb)
            deliver(var t, link_b(), 0, r, var lb)
    test.assert_eq(la.tickets, [ta])
    test.assert_eq(lb.tickets, [tb])
    test.assert_eq(gatt_client.cache_count(var t, link_a()), 4)
    test.assert_eq(gatt_client.cache_count(var t, link_b()), 5)
    test.assert_eq(gatt_client.cache_handle_at(var t, link_b(), 4), 0x0027)

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_each_link_keeps_its_own_mtu_cache_and_hash()
    var t = table2()
    var sa = server()
    var sb = server()
    test.assert_eq(run(var t, link_a(), var sa, gatt_client.begin_exchange_mtu(var t, link_a(), 0)), 0)
    test.assert_eq(gatt_client.mtu(var t, link_a(), 0), 65)
    test.assert_eq(gatt_client.mtu(var t, link_b(), 0), 23)
    test.assert_eq(run(var t,
        link_b(),
        var sb,
        gatt_client.begin_discover_services(var t, link_b(), 0, 1, 0xFFFF, false)),
        0)
    test.assert_eq(gatt_client.cache_count(var t, link_a()), 0)
    test.assert_eq(gatt_client.cache_count(var t, link_b()), 4)
    // The hash of one is not the hash of the other: A's database changed.
    test.assert_eq(run(var t, link_a(), var sa, gatt_client.begin_database_hash(var t, link_a(), 0)), 0)
    test.assert_eq(run(var t, link_b(), var sb, gatt_client.begin_database_hash(var t, link_b(), 0)), 0)
    let _ = gatt_server.add_service(var sa.db, false, gatt_server.le16(0xEE00))
    test.assert_eq(run(var t, link_a(), var sa, gatt_client.begin_database_hash(var t, link_a(), 0)), 0)
    test.assert(gatt_client.take_changed(var t, link_a()))
    test.assert(not gatt_client.take_changed(var t, link_b()))
    test.assert_eq(gatt_client.cache_count(var t, link_b()), 4)

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_timeout_on_one_link_leaves_the_other_alone()
    var t = table2()
    var sb = server()
    let _ = gatt_client.begin_read(var t, link_a(), 0, 0x001A)
    var out: gatt_client.ClientPdu = Vec.new()
    let _ = gatt_client.take_tx(var t, link_a(), 0, 0, var out)
    test.assert_eq(gatt_client.tick(var t, link_a(), 0, 40000), gatt_client.EV_DONE)
    test.assert(gatt_client.is_dead(var t, link_a(), 0))
    test.assert(not gatt_client.is_dead(var t, link_b(), 0))
    test.assert_eq(run(var t, link_b(), var sb, gatt_client.begin_read(var t, link_b(), 0, 0x001A)), 0)

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_link_that_ends_does_not_answer_for_the_next_one_in_its_slot()
    var t = table2()
    var sa = server()
    discover_everything(var t, link_a(), var sa)
    let old = link_a()
    gatt_client.close(var t, old)
    test.assert_eq(gatt_client.cache_count(var t, old), 0)
    test.assert_eq(gatt_client.begin_read(var t, old, 0, 3), gatt_client.ERR_NO_LINK)
    let next = links.link_id(0, 2)
    test.assert(gatt_client.open(var t, next))
    test.assert_eq(gatt_client.cache_count(var t, next), 0)
    test.assert_eq(gatt_client.mtu(var t, next, 0), 23)
    test.assert_eq(gatt_client.begin_read(var t, old, 0, 3), gatt_client.ERR_NO_LINK)
    test.assert(gatt_client.begin_read(var t, next, 0, 3) > 0)
    // The other link was not touched.
    test.assert(gatt_client.begin_read(var t, link_b(), 0, 3) > 0)

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_closing_a_link_drops_its_requests_without_a_completion()
    var t = table2()
    let _ = gatt_client.begin_read(var t, link_a(), 0, 0x001A)
    let _ = gatt_client.begin_read(var t, link_a(), 0, 0x001A)
    gatt_client.close(var t, link_a())
    var out: gatt_client.ClientPdu = Vec.new()
    test.assert_eq(gatt_client.take_tx(var t, link_a(), 0, 0, var out), gatt_client.TX_NONE)
    test.assert(not gatt_client.is_busy(var t, link_a(), 0))

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_the_bearers_of_a_link_each_keep_a_transaction_outstanding()
    var t = table()
    var s = server()
    // The second bearer is an Enhanced ATT bearer with an ATT_MTU of its own.
    test.assert(gatt_client.open_bearer(var t, link_a(), 1, 64))
    test.assert_eq(gatt_server.open_bearer(var s.link, 0x0040, true, 64), 1)
    let r0 = gatt_client.begin_read(var t, link_a(), 0, 0x0020)
    let r1 = gatt_client.begin_read(var t, link_a(), 1, 0x0020)
    var out: gatt_client.ClientPdu = Vec.new()
    // Both requests go out before either is answered.
    test.assert_eq(gatt_client.take_tx(var t, link_a(), 0, 0, var out), gatt_client.TX_REQUEST)
    test.assert_eq(gatt_client.take_tx(var t, link_a(), 1, 0, var out), gatt_client.TX_REQUEST)
    test.assert_eq(gatt_client.take_tx(var t, link_a(), 0, 0, var out), gatt_client.TX_NONE)
    test.assert_eq(gatt_client.take_tx(var t, link_a(), 1, 0, var out), gatt_client.TX_NONE)
    // Each is answered at its bearer's ATT_MTU.
    var l0 = new_log()
    var l1 = new_log()
    for r in gatt_server.receive_on(var s.db, var s.link, 0, [0x0A, 0x20, 0x00], 0)
        deliver(var t, link_a(), 0, r, var l0)
    for r in gatt_server.receive_on(var s.db, var s.link, 1, [0x0A, 0x20, 0x00], 0)
        deliver(var t, link_a(), 1, r, var l1)
    test.assert_eq(l0.tickets, [r0])
    test.assert_eq(l1.tickets, [r1])
    test.assert_eq(l0.values[0], ramp(22))
    test.assert_eq(l1.values[0], ramp(63))

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_a_timeout_ends_one_bearer_and_not_the_other()
    var t = table()
    test.assert(gatt_client.open_bearer(var t, link_a(), 1, 64))
    let _ = gatt_client.begin_read(var t, link_a(), 0, 0x001A)
    let _ = gatt_client.begin_read(var t, link_a(), 1, 0x001A)
    var out: gatt_client.ClientPdu = Vec.new()
    let _ = gatt_client.take_tx(var t, link_a(), 0, 0, var out)
    let _ = gatt_client.take_tx(var t, link_a(), 1, 20000, var out)
    test.assert_eq(gatt_client.tick(var t, link_a(), 0, 30000), gatt_client.EV_DONE)
    test.assert_eq(gatt_client.tick(var t, link_a(), 1, 30000), gatt_client.EV_NONE)
    test.assert(gatt_client.is_dead(var t, link_a(), 0))
    test.assert(not gatt_client.is_dead(var t, link_a(), 1))

@when(noble.CONFIG.MAX_CLIENT_LINKS >= 2 and noble.CONFIG.CLIENT_BEARERS >= 2 and noble.CONFIG.CLIENT_QUEUE >= 4 and noble.CONFIG.CLIENT_VALUE_BYTES >= 256 and noble.CONFIG.CLIENT_CACHE_RECORDS >= 24 and noble.CONFIG.MAX_ATT_MTU >= 247)
@test
fn test_the_discovery_cache_is_the_links_and_not_a_bearers()
    var t = table()
    var s = server()
    test.assert(gatt_client.open_bearer(var t, link_a(), 1, 64))
    test.assert_eq(gatt_server.open_bearer(var s.link, 0x0040, true, 64), 1)
    var trace = new_log()
    let _ = gatt_client.begin_discover_services(var t, link_a(), 1, 1, 0xFFFF, false)
    pump_at(var t, link_a(), 1, var s, 0, var trace)
    test.assert_eq(trace.statuses, [0])
    test.assert_eq(gatt_client.cache_count(var t, link_a()), 4)
    // An Enhanced ATT bearer has its MTU from its channel and no exchange.
    test.assert_eq(gatt_client.mtu(var t, link_a(), 1), 64)
    // A closed bearer holds nothing.
    gatt_client.close_bearer(var t, link_a(), 1)
    test.assert_eq(gatt_client.begin_read(var t, link_a(), 1, 3), gatt_client.ERR_NO_BEARER)
    test.assert_eq(gatt_client.cache_count(var t, link_a()), 4)

