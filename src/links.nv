// links.nv — the identity of a connection slot, the registry of the
// connection slots, and the Controller's ACL buffers the slots share.
//
// The Host holds a fixed number of connection slots (`noble_config.MAX_CONNECTIONS`)
// and every per-connection table is indexed by the slot.  A `LinkId` is a
// slot number together with the generation of the slot: the generation rises
// each time the slot is given to a new connection, so an id kept from a
// connection that has ended names no connection once the slot is reused, and
// a table that is handed such an id refuses it instead of answering for the
// next occupant.
//
// `Links` is the registry: which slots hold a connection, and for each one
// the Connection_Handle the Controller assigned, the Host's role and the
// peer's address.  It finds a slot by handle or by peer address, which is how
// an HCI event and a BTP command reach the connection they mean, and it
// refuses a connection when every slot is taken.
//
// `AclCredits` is the Controller's ACL buffer pool.  LE Read Buffer Size
// reports one count for all connections ([Vol 4] Part E, Section 7.8.2), so
// the free count is one number that every connection spends from and the
// Number Of Completed Packets event returns to ([Vol 4] Part E, Section
// 4.1.1).  It keeps the packets in flight of each slot, so that a connection
// that ends gives back the buffers the Controller flushed with it, and it
// hands the free buffers to the connections that wait in turn, so that one
// connection with a long queue does not hold the others back.
//
// The `Vec` capacities are literals today (the capacity of a storage type
// cannot be a named constant), and a test compares them with `LINK_SLOTS`.
// A registry is made for the `slots` a Host serves, at most `LINK_SLOTS`.

use limits
use noble_config
// The slot of a link that holds none.
const NO_SLOT = -1

// One connection slot's identity.  `slot` is the index into the per-link
// tables, `generation` counts the connections the slot has held.
pub @value
struct LinkId
    slot: Int
    generation: Int

// The id of the connection that holds `slot` for the `generation`-th time.
pub @tier(embedded)
fn link_id(slot: Int, generation: Int) -> LinkId
    LinkId { slot: slot, generation: generation }

// The id that names no connection.
pub @tier(embedded)
fn no_link() -> LinkId
    LinkId { slot: NO_SLOT, generation: 0 }

// Whether `id` names a slot at all.
pub @tier(embedded)
@no_alloc
fn is_link(id: LinkId) -> Bool
    id.slot >= 0

// Whether `a` and `b` name the same connection: the same slot in the same
// generation.
pub @tier(embedded)
@no_alloc
fn same_link(a: LinkId, b: LinkId) -> Bool
    a.slot == b.slot and a.generation == b.generation

// The id the slot of `id` answers to once a new connection takes it.
@tier(embedded)
fn next_generation(id: LinkId) -> LinkId
    LinkId { slot: id.slot, generation: id.generation + 1 }

// ── The ACL buffers the connections share ───────────────────────────

// The octets of a Bluetooth device address.
const ADDRESS_OCTETS = 6

// A Connection_Handle is 0x0000 to 0x0EFF ([Vol 4] Part E, Section 5.3.1).
const HANDLE_MAX = 0x0EFF

// The HCI ACL Data packet length every LE Controller accepts, the size the
// Host assumes until LE Read Buffer Size answers ([Vol 4] Part E, Section
// 5.4.2).
const ACL_DATA_MIN = 27

// The octets of the HCI ACL Data packet header: Connection_Handle with its
// flags, and Data_Total_Length ([Vol 4] Part E, Section 5.4.2).
const ACL_HEADER_OCTETS = 4

// The data octets one of the Host's own ACL buffers holds: `noble_config.ACL_OCTETS`
// less the header, and never fewer than the 27 octets every Host accepts.
// This is the Host's private size.  It is not agreed with the Controller at
// build time: the Controller's LE_ACL_Data_Packet_Length is read at run time
// (`acl_credits_configure`) and the Host's own size is told to the Controller
// at run time (Set Host Buffer Size, `hci_commands.build_host_buffer_size`).
pub @tier(embedded)
@no_alloc
fn acl_slot_payload() -> Int
    let n = noble_config.ACL_OCTETS - ACL_HEADER_OCTETS
    if n < ACL_DATA_MIN
        ACL_DATA_MIN
    else
        n

// The ACL packets the Host tells the Controller it can hold at once when it
// turns flow control toward itself on (Host_Total_Num_ACL_Data_Packets of
// Host Buffer Size).  Private to the Host, like `acl_slot_payload`: the
// Controller learns it from the command and reads no configuration of the
// Host.  The Host takes a packet whole before it reads the next, so one
// would do; a few let the Controller send while the Host works.
pub const ACL_RX_BUFFERS = 3

// The handles the Host keeps a count of returned buffers for before it sends
// Host Number Of Completed Packets.
const ACL_OWED_HANDLES = 8

// The Controller's ACL buffers and what each connection slot has in flight.
// `packet_length` is the length the Host sends in one packet: the
// LE_ACL_Data_Packet_Length, cut to the Host's own buffer.  `total` is the
// number of buffers, `free` the ones no packet holds, and `cursor` the slot
// the last hand-out went to.  `flow_control` says Controller-to-Host flow
// control is on (the Host sent Set Controller To Host Flow Control and Host
// Buffer Size, and owes Host Number Of Completed Packets), and `rx_oversize`
// counts the packets the Controller sent that did not fit the Host's buffer.
// `owed_handle` and `owed_count` list the packets taken and not yet returned
// with Host Number Of Completed Packets, `owed_n` entries of them, `owed_total`
// packets in all.
@value
struct AclCredits
    packet_length: u16
    total: u8
    free: u8
    cursor: u8
    flow_control: Bool
    rx_oversize: u16
    in_flight: Vec[u8; 4]
    owed_handle: Vec[u16; 8]
    owed_count: Vec[u16; 8]
    owed_n: u8
    owed_total: u16

// A pool of one buffer of the minimum size, with nothing in flight: what the
// Host assumes before the Controller says.
@tier(embedded)
fn acl_credits_new() -> AclCredits
    var c = AclCredits { packet_length: ACL_DATA_MIN as u16,
        total: 1,
        free: 1,
        cursor: 0,
        flow_control: false,
        rx_oversize: 0,
        in_flight: Vec.new(),
        owed_handle: Vec.new(),
        owed_count: Vec.new(),
        owed_n: 0,
        owed_total: 0 }
    for _ in 0..limits.LINK_SLOTS
        let _a = c.in_flight.push(0)
    for _ in 0..ACL_OWED_HANDLES
        let _h = c.owed_handle.push(0)
        let _n = c.owed_count.push(0)
    c

// Take the answer of LE Read Buffer Size: `length` octets in each of `total`
// buffers.  A Controller that reports no dedicated LE buffers (a length below
// 27 octets or a count of zero) shares its BR/EDR buffers, which this Host
// does not read, so the pool stays as it was and the answer is false.  A new
// size starts with every buffer free and nothing in flight.
//
// The Host holds a packet in a buffer of `acl_slot_payload` octets, so a
// Controller that reports a longer packet is served at the Host's size: the
// Host sends packets of at most `acl_slot_payload` octets, which every
// Controller accepts because each is no longer than its own length, and the
// answer is still true.  What the Controller sends to the Host is limited
// the other way: by Set Host Buffer Size when the Controller lists it, and
// otherwise a longer packet is a defined error (`acl_rx_fits`).
@tier(embedded)
@no_alloc
fn acl_credits_configure(var c: AclCredits, length: Int, total: Int) -> Bool
    if length < ACL_DATA_MIN or length > 0xFFFF or total < 1 or total > 0xFF
        return false
    let slot = acl_slot_payload()
    c.packet_length = (if length > slot then slot else length) as u16
    c.total = total as u8
    c.free = total as u8
    for i in 0..c.in_flight.len()
        c.in_flight[i] = 0
    true

// The largest HCI ACL Data packet the Host sends: the Controller's length,
// cut to the Host's buffer.
@tier(embedded)
@no_alloc
fn acl_packet_length(c: AclCredits) -> Int
    c.packet_length as Int

// Whether an HCI ACL Data packet of `length` data octets fits a buffer of
// the Host.  A Controller that honours Set Host Buffer Size never sends one
// that does not; one that does not honour it, or that never got the command,
// may.  The Host drops such a packet and the L2CAP PDU it belongs to, and
// counts it (`acl_rx_note_oversize`).
@tier(embedded)
@no_alloc
fn acl_rx_fits(length: Int) -> Bool
    length <= acl_slot_payload()

// Count one packet that did not fit.
@tier(embedded)
@no_alloc
fn acl_rx_note_oversize(var c: AclCredits)
    if c.rx_oversize < 0xFFFF
        c.rx_oversize = c.rx_oversize + 1

// The packets dropped for their length since the pool was made.
@tier(embedded)
@no_alloc
fn acl_rx_oversize(c: AclCredits) -> Int
    c.rx_oversize as Int

// Controller-to-Host flow control is on for ACL data.
@tier(embedded)
@no_alloc
fn acl_flow_control(c: AclCredits) -> Bool
    c.flow_control

// Record that Controller-to-Host flow control is on or off.  The Host turns
// it on once Set Controller To Host Flow Control and Host Buffer Size were
// answered with Success, and off again with Reset.
@tier(embedded)
@no_alloc
fn acl_flow_control_set(var c: AclCredits, on: Bool)
    c.flow_control = on
    acl_owed_clear(var c)

// Note that the Host took `n` packets of `handle` and owes the Controller
// their buffers.  False when the list of handles is full; the Host then
// returns what it owes before it notes this one.
@tier(embedded)
@no_alloc
fn acl_owe(var c: AclCredits, handle: Int, n: Int) -> Bool
    for i in 0..c.owed_n as Int
        if (c.owed_handle[i] as Int) == handle
            c.owed_count[i] = c.owed_count[i] + n as u16
            c.owed_total = c.owed_total + n as u16
            return true
    if (c.owed_n as Int) >= ACL_OWED_HANDLES
        return false
    c.owed_handle[c.owed_n as Int] = handle as u16
    c.owed_count[c.owed_n as Int] = n as u16
    c.owed_n = c.owed_n + 1
    c.owed_total = c.owed_total + n as u16
    true

// Whether the packets owed reach half of the buffers the Host told the
// Controller it holds, rounded up: the Host then returns them without
// waiting for its next step.
@tier(embedded)
@no_alloc
fn acl_owed_due(c: AclCredits) -> Bool
    (c.owed_total as Int) >= (ACL_RX_BUFFERS + 1) / 2

// The handles with packets owed.
@tier(embedded)
@no_alloc
fn acl_owed_handles(c: AclCredits) -> Int
    c.owed_n as Int

// The handle of entry `i` of the packets owed, and its count.
@tier(embedded)
@no_alloc
fn acl_owed_handle(c: AclCredits, i: Int) -> Int
    c.owed_handle[i] as Int

@tier(embedded)
@no_alloc
fn acl_owed_count(c: AclCredits, i: Int) -> Int
    c.owed_count[i] as Int

// Forget the packets owed: they were returned, or flow control went off.
@tier(embedded)
@no_alloc
fn acl_owed_clear(var c: AclCredits)
    c.owed_n = 0
    c.owed_total = 0

// The buffers no packet holds.
@tier(embedded)
@no_alloc
fn acl_free(c: AclCredits) -> Int
    c.free as Int

// The packets of `slot` the Controller has not completed.
@tier(embedded)
@no_alloc
fn acl_in_flight(c: AclCredits, slot: Int) -> Int
    if slot < 0 or slot >= c.in_flight.len()
        0
    else
        c.in_flight[slot] as Int

// Take one buffer for a packet of `slot`.  False when none is free or the
// slot is not one the pool tracks.
@tier(embedded)
@no_alloc
fn acl_credits_take(var c: AclCredits, slot: Int) -> Bool
    if slot < 0 or slot >= c.in_flight.len() or c.free == 0
        return false
    c.free = c.free - 1
    c.in_flight[slot] = c.in_flight[slot] + 1
    true

// The Controller completed `count` packets of `slot`: their buffers are free
// again.  No more are returned than the slot had in flight, so a Controller
// that reports more than was sent does not mint credits.  The answer is the
// number returned.
@tier(embedded)
@no_alloc
fn acl_credits_completed(var c: AclCredits, slot: Int, count: Int) -> Int
    if slot < 0 or slot >= c.in_flight.len() or count < 1
        return 0
    let held = c.in_flight[slot] as Int
    let back = if count < held
        count
    else
        held
    c.in_flight[slot] = (held - back) as u8
    c.free = (c.free as Int + back) as u8
    back

// The connection of `slot` ended.  The Host assumes every packet it sent and
// the Controller had not completed was flushed and its buffer freed ([Vol 4]
// Part E, Section 4.3).  The answer is the number of buffers given back.
@tier(embedded)
@no_alloc
fn acl_credits_release(var c: AclCredits, slot: Int) -> Int
    acl_credits_completed(var c, slot, 0xFF)

// The slot that gets the next free buffer among those named by the bit set
// `wanting` (bit `n` for slot `n`): the first one after the slot the last
// hand-out went to, wrapping round, so that the connections that wait share
// the buffers in turn.  The cursor moves to the slot answered.  -1 when no
// slot is named or no buffer is free.
@tier(embedded)
@no_alloc
fn acl_credits_next(var c: AclCredits, wanting: Int) -> Int
    if c.free == 0 or wanting == 0
        return -1
    let n = c.in_flight.len()
    for k in 1..n + 1
        let slot = (c.cursor as Int + k) % n
        if (wanting & (1 << slot)) != 0
            c.cursor = slot as u8
            return slot
    -1

// ── The registry ────────────────────────────────────────────────────

// The connection slots.  A slot is in use between `links_open` and
// `links_close`; `generation` counts the connections it has held.  `slots` is
// the number of slots the Host serves, at most `LINK_SLOTS`; the columns are
// always `LINK_SLOTS` long.  `peer` holds the six octets of each slot's peer
// address, least significant first, at `slot * 6`.
pub @value
struct Links
    slots: u8
    used: Vec[Bool; 4]
    generation: Vec[u32; 4]
    handle: Vec[u16; 4]
    central: Vec[Bool; 4]
    peer_type: Vec[u8; 4]
    peer: Vec[u8; 24]

// An empty registry of `slots` slots, clamped to 1 and `LINK_SLOTS`.
pub @tier(embedded)
fn links_new(slots: Int) -> Links
    let served = if slots < 1
        1
    else
        if slots > limits.LINK_SLOTS
            limits.LINK_SLOTS
        else
            slots
    var l = Links {
        slots: served as u8,
        used: Vec.new(), generation: Vec.new(), handle: Vec.new(), central: Vec.new(),
        peer_type: Vec.new(), peer: Vec.new() }
    for _ in 0..limits.LINK_SLOTS
        let _a = l.used.push(false)
        let _b = l.generation.push(0)
        let _c = l.handle.push(0)
        let _d = l.central.push(false)
        let _e = l.peer_type.push(0)
        for _ in 0..ADDRESS_OCTETS
            let _f = l.peer.push(0)
    l

// The number of slots the Host serves.
@tier(embedded)
@no_alloc
fn links_slots(l: Links) -> Int
    l.slots as Int

// The number of connections the registry holds.
pub @tier(embedded)
@no_alloc
fn links_count(l: Links) -> Int
    var n = 0
    for i in 0..l.slots as Int
        if l.used[i]
            n = n + 1
    n

// The id of the connection in `slot`, `no_link()` for a slot that is empty or
// does not exist.
pub @tier(embedded)
fn links_id(l: Links, slot: Int) -> LinkId
    if slot < 0 or slot >= (l.slots as Int) or not l.used[slot]
        no_link()
    else
        link_id(slot, l.generation[slot] as Int)

// Whether `id` names a connection the registry holds now: its slot is in use
// and in the generation of `id`.
@tier(embedded)
@no_alloc
fn links_live(l: Links, id: LinkId) -> Bool
    if id.slot < 0 or id.slot >= (l.slots as Int) or not l.used[id.slot]
        false
    else
        (l.generation[id.slot] as Int) == id.generation

// Give the lowest free slot to the connection `handle` to the peer
// (`peer_type`, the six octets `peer`), with the Host in the Central role when
// `central`.  The slot's generation rises by one.  `no_link()` when every
// slot is taken, when `handle` is outside 0x0000 to 0x0EFF or held already,
// and when `peer` is not six octets.
pub @tier(embedded)
fn links_open(var l: Links, handle: Int, central: Bool, peer_type: Int, peer: [u8]) -> LinkId
    if handle < 0 or handle > HANDLE_MAX or list.len(peer) != ADDRESS_OCTETS or peer_type < 0 or peer_type > 0xFF
        return no_link()
    if is_link(links_find_handle(l, handle))
        return no_link()
    for slot in 0..l.slots as Int
        if not l.used[slot]
            l.used[slot] = true
            l.generation[slot] = l.generation[slot] + 1
            l.handle[slot] = handle as u16
            l.central[slot] = central
            l.peer_type[slot] = peer_type as u8
            for k in 0..ADDRESS_OCTETS
                l.peer[slot * ADDRESS_OCTETS + k] = peer[k]
            return link_id(slot, l.generation[slot] as Int)
    no_link()

// The connection `id` ended: its slot is free for the next one.  False for an
// id that names no live connection, which changes nothing.
pub @tier(embedded)
@no_alloc
fn links_close(var l: Links, id: LinkId) -> Bool
    if not links_live(l, id)
        return false
    l.used[id.slot] = false
    l.handle[id.slot] = 0
    l.central[id.slot] = false
    l.peer_type[id.slot] = 0
    for k in 0..ADDRESS_OCTETS
        l.peer[id.slot * ADDRESS_OCTETS + k] = 0
    true

// The peer of `id` is known by another address from now on: the Identity
// Address a pairing or a bond resolved the address it connected from to.
// False, with nothing changed, for a stale id or an address that is not six
// octets.
@tier(embedded)
@no_alloc
fn links_set_peer(var l: Links, id: LinkId, peer_type: Int, peer: [u8]) -> Bool
    if not links_live(l, id) or list.len(peer) != ADDRESS_OCTETS or peer_type < 0 or peer_type > 0xFF
        return false
    l.peer_type[id.slot] = peer_type as u8
    for k in 0..ADDRESS_OCTETS
        l.peer[id.slot * ADDRESS_OCTETS + k] = peer[k]
    true

// The connection with the Connection_Handle `handle`, `no_link()` for none.
pub @tier(embedded)
fn links_find_handle(l: Links, handle: Int) -> LinkId
    for slot in 0..l.slots as Int
        if l.used[slot] and (l.handle[slot] as Int) == handle
            return link_id(slot, l.generation[slot] as Int)
    no_link()

// The connection to the peer (`peer_type`, `peer`), `no_link()` for none.
@tier(embedded)
fn links_find_peer(l: Links, peer_type: Int, peer: [u8]) -> LinkId
    if list.len(peer) != ADDRESS_OCTETS
        return no_link()
    for slot in 0..l.slots as Int
        if l.used[slot] and (l.peer_type[slot] as Int) == peer_type
            var same = true
            for k in 0..ADDRESS_OCTETS
                if l.peer[slot * ADDRESS_OCTETS + k] != peer[k]
                    same = false
            if same
                return link_id(slot, l.generation[slot] as Int)
    no_link()

// The Connection_Handle of `id`, -1 when it names no live connection.
pub @tier(embedded)
@no_alloc
fn links_handle(l: Links, id: LinkId) -> Int
    if links_live(l, id)
        l.handle[id.slot] as Int
    else
        -1

// Whether the Host is the Central in `id`; false for a stale id.
@tier(embedded)
@no_alloc
fn links_central(l: Links, id: LinkId) -> Bool
    links_live(l, id) and l.central[id.slot]

// The address type of the peer of `id`, -1 for a stale id.
pub @tier(embedded)
@no_alloc
fn links_peer_type(l: Links, id: LinkId) -> Int
    if links_live(l, id)
        l.peer_type[id.slot] as Int
    else
        -1

// Whether the six octets of the peer of `id` are `peer`.
@tier(embedded)
@no_alloc
fn links_peer_is(l: Links, id: LinkId, peer: [u8]) -> Bool
    if not links_live(l, id) or list.len(peer) != ADDRESS_OCTETS
        return false
    for k in 0..ADDRESS_OCTETS
        if l.peer[id.slot * ADDRESS_OCTETS + k] != peer[k]
            return false
    true
