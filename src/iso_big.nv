@test
@satisfies("REQ-BLE-ISO-004")
fn test_create_big_test_refuses_a_parameter_out_of_range_as_unsupported()
    var t = big_table_new()
    let unsupported = iso_event.STATUS_UNSUPPORTED_FEATURE_OR_PARAMETER
    // ISO_Interval 0x0004 to 0x0C80.
    test.assert_eq(create_test(var t, 3, 2, 100, 1, 1, 0), unsupported)
    test.assert_eq(create_test(var t, 0x0C81, 2, 100, 1, 1, 0), unsupported)
    // NSE 0x01 to 0x1F.
    test.assert_eq(create_test(var t, 8, 0, 100, 1, 1, 0), unsupported)
    test.assert_eq(create_test(var t, 8, 0x20, 100, 1, 1, 0), unsupported)
    // Max_PDU 0x0001 to 0x00FB.
    test.assert_eq(create_test(var t, 8, 2, 0, 1, 1, 0), unsupported)
    test.assert_eq(create_test(var t, 8, 2, 0xFC, 1, 1, 0), unsupported)
    // BN 1 to 7, IRC 1 to 15, PTO 0 to 15.
    test.assert_eq(create_test(var t, 8, 2, 100, 0, 1, 0), unsupported)
    test.assert_eq(create_test(var t, 8, 2, 100, 8, 1, 0), unsupported)
    test.assert_eq(create_test(var t, 8, 2, 100, 1, 0, 0), unsupported)
    test.assert_eq(create_test(var t, 8, 2, 100, 1, 16, 0), unsupported)
    test.assert_eq(create_test(var t, 8, 2, 100, 1, 1, 16), unsupported)
    test.assert_eq(create_test(var t, 8, 2, 100, 1, 1, -1), unsupported)
    // A parameter the two commands share is out of range here too.
    test.assert_eq(big_create_test(var t, 0xF0, 1, 1, 10000, 8, 2, 100, 100, 0x02, 0, 0, 1, 1, 0, false, zero_code()), unsupported)
    test.assert_eq(big_create_test(var t, 1, 1, 1, 0xFE, 8, 2, 100, 100, 0x02, 0, 0, 1, 1, 0, false, zero_code()), unsupported)
    test.assert_eq(big_create_test(var t, 1, 1, 1, 10000, 8, 2, 100, 100, 0x08, 0, 0, 1, 1, 0, false, zero_code()), unsupported)
    test.assert(t.pending == BigPending.NoCommand)

