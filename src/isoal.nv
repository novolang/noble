// isoal.nv — Isochronous Adaptation Layer, the Host's side.
//
// Two adaptations sit between an SDU and the air, and this module holds
// both as pure functions over lists of octets, with no HCI session and no
// clock:
//
//   1. The HCI level ([Vol 4] Part E, Section 5.4.5).  The Host gives the
//      Controller an SDU as one HCI ISO Data packet, or as a first
//      fragment, intermediate fragments and a last fragment when the SDU
//      is longer than the ISO_Data_Packet_Length the Controller reported
//      (LE Read Buffer Size [v2]).  The Controller gives the Host an SDU
//      the same way, with a Packet_Status_Flag.  `isoal_fragments` cuts an
//      SDU into packets; `IsoReassembler` and `isoal_push` put received
//      packets together again.  SDU fragments generated over HCI are
//      unrelated to the fragments the Link Layer's ISOAL generates (same
//      section).
//
//   2. The Link Layer level ([Vol 6] Part G, Section 2).  An SDU is
//      carried in unframed PDUs, where an SDU is split into plain
//      fragments and the LLID says whether a PDU starts or continues an
//      SDU (0b01) or ends one (0b00) ([Vol 6] Part B, Sections 2.6.1 and
//      2.6.2), or in framed PDUs, where each segment has a two-octet
//      segmentation header and the first segment of an SDU a three-octet
//      Time_Offset.  The Host does not send these PDUs; a Controller, and a
//      test that stands in for one, does, so the cut and the recombination
//      are here for the Controller side of this package to use.  The
//      framed layout, the segmentation header (SC in bit 0, CMPLT in bit 1,
//      six reserved bits, then an 8-bit Length: Figure 2.3) and the 24-bit
//      Time_Offset, was compared with [Vol 6] Part G, Sections 2.2 and 3.1,
//      of Core 6.3.  Unsegmented mode (one SDU in one segment of one PDU) and
//      the aggregation of several SDUs into the framed PDUs of the sending
//      side are cut in the section "Framed PDUs: Unsegmented mode,
//      aggregation and padding"; the reader takes the Time_Offset as it is
//      given.  The timing rules of Section 3 (the Time_Offset, the
//      transport latency and the SDU synchronization reference) are
//      `isoal_timing.nv`.
//
// Satisfies: REQ-BLE-ISO-002, REQ-BLE-ISO-007.

use hci_codec
use noble.CONFIG
// ── HCI level: segmentation of an SDU ───────────────────────────────

// ISO_SDU_Length is 12 bits, so an SDU is at most 4095 octets
// ([Vol 4] Part E, Section 5.4.5).
const ISOAL_SDU_MAX = 0x0FFF

// The packets that carry `sdu` to the Controller, for `connection_handle`,
// with `packet_sequence_number` and, when `time_stamp` is given, a
// Time_Stamp in the first packet.  `max_packet_length` is the
// ISO_Data_Packet_Length of the Controller: a packet's Data_Total_Length,
// SDU header included, is at most that.
//
// An SDU that fits is one complete-SDU packet, an empty SDU too.  A longer
// SDU is a first fragment that carries the SDU header and as much of the
// SDU as fits beside it, intermediate fragments of `max_packet_length`
// octets, and a last fragment with the rest. ISO_SDU_Length is the length of
// the whole SDU in every packet that has the SDU header.
//
// `None` for an SDU above 4095 octets, for a `max_packet_length` that
// leaves no room for an octet of data beside the SDU header (4 octets, 8
// with a Time_Stamp), for a `packet_sequence_number` outside 16 bits and
// for a `time_stamp` outside 32 bits.
pub @satisfies("REQ-BLE-ISO-002")
@tier(embedded)
fn isoal_fragments(connection_handle: Int, packet_sequence_number: Int, time_stamp: ?Int, sdu: [u8],
                   max_packet_length: Int) -> ?[hci_codec.IsoDataPacket]
    let n = list.len(sdu)
    let has_ts = time_stamp != None
    let head = hci_codec.ISO_SDU_HEADER_LEN + (if has_ts then hci_codec.ISO_TIME_STAMP_LEN else 0)
    if n > ISOAL_SDU_MAX or max_packet_length <= head or max_packet_length > hci_codec.ISO_DATA_TOTAL_LENGTH_MAX
        return None
    if packet_sequence_number < 0 or packet_sequence_number > 0xFFFF
        return None
    if has_ts and ((time_stamp ?? 0) < 0 or (time_stamp ?? 0) > 0xFFFFFFFF)
        return None
    var packets: [hci_codec.IsoDataPacket] = []
    if head + n <= max_packet_length
        list.push(packets, hci_codec.IsoDataPacket {
            connection_handle: connection_handle, pb_flag: hci_codec.ISO_PB_COMPLETE_SDU,
            has_sdu_header: true, has_time_stamp: has_ts, time_stamp: time_stamp ?? 0,
            packet_sequence_number: packet_sequence_number, iso_sdu_length: n,
            packet_status: hci_codec.ISO_PSF_VALID, data: sdu[:] })
        return Some(packets)
    let first = max_packet_length - head
    list.push(packets, hci_codec.IsoDataPacket {
        connection_handle: connection_handle, pb_flag: hci_codec.ISO_PB_FIRST_FRAGMENT,
        has_sdu_header: true, has_time_stamp: has_ts, time_stamp: time_stamp ?? 0,
        packet_sequence_number: packet_sequence_number, iso_sdu_length: n,
        packet_status: hci_codec.ISO_PSF_VALID, data: sdu[0:first] })
    var at = first
    while at < n
        var end = at + max_packet_length
        var pb = hci_codec.ISO_PB_INTERMEDIATE_FRAGMENT
        if end >= n
            end = n
            pb = hci_codec.ISO_PB_LAST_FRAGMENT
        list.push(packets, hci_codec.IsoDataPacket {
            connection_handle: connection_handle, pb_flag: pb, has_sdu_header: false,
            has_time_stamp: false, time_stamp: 0, packet_sequence_number: 0, iso_sdu_length: 0,
            packet_status: 0, data: sdu[at:end] })
        at = end
    Some(packets)

// ── HCI level: reassembly of received packets ───────────────────────

// One SDU a Controller gave the Host.  `packet_status` is the
// Packet_Status_Flag: valid data, possibly invalid data, or lost data
// (`ISO_PSF_*` of hci_codec); an SDU of lost data has no data.
// `has_time_stamp` and `time_stamp` are those of its first packet.
struct IsoSdu
    packet_sequence_number: Int
    has_time_stamp: Bool
    time_stamp: Int
    packet_status: Int
    data: [u8]

// The state of the reassembly of the SDUs of one Connection_Handle: the
// SDU being collected, if any, a count of fragments that arrived with
// no first fragment before them, and a count of SDUs longer than the Host's
// SDU buffer (`noble.CONFIG.ISO_SDU_OCTETS`).  There is no flow control of ISO data
// toward the Host ([Vol 4] Part E, Section 4.1.1 covers ACL and SCO only),
// so the Host's SDU size is told to the Controller through the SDU sizes of
// the CIG or BIG parameters and checked here: an SDU that would not fit the
// buffer is reported as an SDU of lost data and its remaining fragments are
// orphans.
pub struct IsoReassembler
    connection_handle: Int
    var collecting: Bool
    var packet_sequence_number: Int
    var has_time_stamp: Bool
    var time_stamp: Int
    var iso_sdu_length: Int
    var packet_status: Int
    var data: [u8]
    var orphan_fragments: Int
    var oversize: Int

// A reassembler for the SDUs of the stream `connection_handle`, with nothing collected yet.
pub @tier(embedded)
fn isoal_reassembler(connection_handle: Int) -> IsoReassembler
    IsoReassembler {
        connection_handle: connection_handle, collecting: false, packet_sequence_number: 0,
        has_time_stamp: false, time_stamp: 0, iso_sdu_length: 0, packet_status: 0,
        data: [], orphan_fragments: 0, oversize: 0 }

// The SDU of lost data for the sequence number `seq`.
@tier(embedded)
fn lost_sdu(seq: Int, has_ts: Bool, ts: Int) -> IsoSdu
    IsoSdu { packet_sequence_number: seq,
        has_time_stamp: has_ts,
        time_stamp: ts,
        packet_status: hci_codec.ISO_PSF_LOST,
        data: [] }

// The SDU `r` has collected, once its last octet has arrived. Its status
// is the Packet_Status_Flag of its first packet, and a valid status
// becomes "possibly invalid" when the data is not as long as
// ISO_SDU_Length says: part of the SDU may be missing, which is what that
// status means ([Vol 4] Part E, Section 5.4.5).  A status of lost data
// carries no data.
@tier(embedded)
fn finish_sdu(r: IsoReassembler) -> IsoSdu
    var status = r.packet_status
    var data = r.data[:]
    if status == hci_codec.ISO_PSF_LOST
        data = []
    else if list.len(data) != r.iso_sdu_length and status == hci_codec.ISO_PSF_VALID
        status = hci_codec.ISO_PSF_POSSIBLY_INVALID
    IsoSdu { packet_sequence_number: r.packet_sequence_number,
        has_time_stamp: r.has_time_stamp,
        time_stamp: r.time_stamp,
        packet_status: status,
        data: data }

// Take one HCI ISO Data packet received for `r`'s Connection_Handle and
// answer the SDUs it completes: none for a fragment that leaves the SDU
// open, one for a last fragment or a complete SDU, and two when a packet
// that starts an SDU arrives while another is still open, because the
// open one will not be finished any more and is reported first as an SDU
// of lost data (so that a consumer sees every sequence number once).
//
// A first fragment of lost data, and a complete SDU of lost data, which
// is what a Controller sends for an SDU it lost ([Vol 4] Part E, Section
// 5.4.5), are SDUs of lost data with no data. An intermediate or a last
// fragment with no first fragment before it belongs to no SDU: it is
// counted in `orphan_fragments` and answers no SDU. A packet for another
// Connection_Handle is not `r`'s and is ignored.
pub @satisfies("REQ-BLE-ISO-002")
@tier(embedded)
fn isoal_push(var r: IsoReassembler, pkt: hci_codec.IsoDataPacket) -> [IsoSdu]
    var out: [IsoSdu] = []
    if pkt.connection_handle != r.connection_handle
        return out
    if hci_codec.iso_pb_has_sdu_header(pkt.pb_flag)
        if r.collecting
            list.push(out, lost_sdu(r.packet_sequence_number, r.has_time_stamp, r.time_stamp))
        if list.len(pkt.data) > noble.CONFIG.ISO_SDU_OCTETS
            r.collecting = false
            r.data = []
            r.oversize = r.oversize + 1
            list.push(out, lost_sdu(pkt.packet_sequence_number, pkt.has_time_stamp, pkt.time_stamp))
            return out
        r.collecting = true
        r.packet_sequence_number = pkt.packet_sequence_number
        r.has_time_stamp = pkt.has_time_stamp
        r.time_stamp = pkt.time_stamp
        r.iso_sdu_length = pkt.iso_sdu_length
        r.packet_status = pkt.packet_status
        r.data = pkt.data[:]
        if pkt.pb_flag == hci_codec.ISO_PB_COMPLETE_SDU or pkt.packet_status == hci_codec.ISO_PSF_LOST
            list.push(out, finish_sdu(r))
            r.collecting = false
            r.data = []
        return out
    if not r.collecting
        r.orphan_fragments = r.orphan_fragments + 1
        return out
    if list.len(r.data) + list.len(pkt.data) > noble.CONFIG.ISO_SDU_OCTETS
        let dropped = lost_sdu(r.packet_sequence_number, r.has_time_stamp, r.time_stamp)
        r.collecting = false
        r.data = []
        r.oversize = r.oversize + 1
        list.push(out, dropped)
        return out
    list.append(r.data, pkt.data)
    if pkt.pb_flag == hci_codec.ISO_PB_LAST_FRAGMENT
        list.push(out, finish_sdu(r))
        r.collecting = false
        r.data = []
    out

// ── Link Layer level: unframed and framed PDUs ──────────────────────

// LLID of a CIS Data PDU or a BIS Data PDU ([Vol 6] Part B, Sections
// 2.6.1 and 2.6.2): an unframed PDU that ends an SDU or holds a complete
// one; an unframed PDU that starts or continues an SDU (it also marks an
// empty PDU, which carries no octets); a framed PDU.
const ISO_LLID_UNFRAMED_END = 0x00

const ISO_LLID_UNFRAMED_START_OR_CONTINUATION = 0x01

const ISO_LLID_FRAMED = 0x02

// One isochronous data PDU: its LLID and its payload.
struct IsoPdu
    llid: Int
    payload: [u8]

// The unframed PDUs that carry `sdu`, each with at most `max_pdu`
// payload octets: LLID 0b01 on every PDU but the last and 0b00 on the
// last, which is also the only PDU of an SDU that fits. An empty SDU is one
// PDU with LLID 0b00 and no payload. `None` for a `max_pdu` below 1.
@satisfies("REQ-BLE-ISO-002")
@tier(embedded)
fn isoal_unframed_pdus(sdu: [u8], max_pdu: Int) -> ?[IsoPdu]
    if max_pdu < 1
        return None
    var pdus: [IsoPdu] = []
    let n = list.len(sdu)
    var at = 0
    while n - at > max_pdu
        list.push(pdus,
            IsoPdu { llid: ISO_LLID_UNFRAMED_START_OR_CONTINUATION, payload: sdu[at:at + max_pdu] })
        at = at + max_pdu
    list.push(pdus, IsoPdu { llid: ISO_LLID_UNFRAMED_END, payload: sdu[at:n] })
    Some(pdus)

// `pdus`, the unframed PDUs of one SDU, made up to `upps` PDUs with
// padding: empty PDUs of LLID 0b01, which a Link Layer sends when an SDU
// generates fewer fragments than UPPS, so that every SDU takes the same
// number of PDUs ([Vol 6] Part G, Section 2.1).  `pdus` is returned as it is
// when it already has `upps` PDUs or more.
@satisfies("REQ-BLE-ISO-002")
@tier(embedded)
fn isoal_unframed_pad(pdus: [IsoPdu], upps: Int) -> [IsoPdu]
    var out = pdus[:]
    while list.len(out) < upps
        list.push(out, IsoPdu { llid: ISO_LLID_UNFRAMED_START_OR_CONTINUATION, payload: [] })
    out

// The SDUs a sequence of unframed PDUs carries, in order. A PDU with
// LLID 0b01 adds its payload to the SDU being collected and one with LLID
// 0b00 ends it. A PDU of another LLID is not unframed and is skipped.  The
// octets after the last LLID 0b00 PDU belong to an SDU that is not
// finished and are not answered.
@satisfies("REQ-BLE-ISO-002")
@tier(embedded)
fn isoal_unframed_sdus(pdus: [IsoPdu]) -> [[u8]]
    var sdus: [[u8]] = []
    var current: [u8] = []
    for p in pdus
        if p.llid == ISO_LLID_UNFRAMED_START_OR_CONTINUATION
            list.append(current, p.payload)
        else if p.llid == ISO_LLID_UNFRAMED_END
            list.append(current, p.payload)
            list.push(sdus, current[:])
            current = []
    sdus

// The segmentation header of a framed PDU: two octets ([Vol 6] Part G,
// Figure 2.3), SC in bit 0 then CMPLT in bit 1 and six reserved bits in
// the first (SC clear on the first segment of an SDU and set on a
// continuation; CMPLT set on the last segment), and the 8-bit segment
// length in the second.  A segment that starts an SDU has the 3-octet
// Time_Offset, in microseconds, after the header, and its length counts
// those three octets.
const ISO_SEGMENT_SC = 0x01

const ISO_SEGMENT_CMPLT = 0x02

const ISO_SEGMENT_HEADER_LEN = 2

const ISO_TIME_OFFSET_LEN = 3

// One SDU a sequence of framed PDUs carries, with the Time_Offset of its
// first segment.
struct IsoFramedSdu
    time_offset: Int
    data: [u8]

// The framed PDUs that carry `sdu`, one segment to a PDU, each PDU at most
// `max_pdu` octets: the first segment is SC clear, a 2-octet header, the
// 3-octet `time_offset` and the first part of the SDU; later segments are
// SC set, a header and the next part; CMPLT is set on the last segment
// only. An empty SDU is one segment of the header and the Time_Offset.
// `None` for a `max_pdu` that leaves no room for an octet of data beside
// the header and the Time_Offset (6), and for a `time_offset` outside 24
// bits ([Vol 6] Part G, Table 1.1: a 24-bit value in microseconds).
@satisfies("REQ-BLE-ISO-002")
@tier(embedded)
fn isoal_framed_pdus(sdu: [u8], time_offset: Int, max_pdu: Int) -> ?[IsoPdu]
    // The segment length is one octet, and the first segment's counts the
    // Time_Offset, so a segment holds at most 255 octets and the first
    // 252 of the SDU.
    var first_room = max_pdu - ISO_SEGMENT_HEADER_LEN - ISO_TIME_OFFSET_LEN
    var later_room = max_pdu - ISO_SEGMENT_HEADER_LEN
    if first_room < 1 or time_offset < 0 or time_offset > 0xFFFFFF
        return None
    if first_room > 0xFF - ISO_TIME_OFFSET_LEN
        first_room = 0xFF - ISO_TIME_OFFSET_LEN
    if later_room > 0xFF
        later_room = 0xFF
    let n = list.len(sdu)
    var pdus: [IsoPdu] = []
    var at = 0
    var first = true
    while true
        let room = if first
            first_room
        else
            later_room
        let take = if n - at > room
            room
        else
            n - at
        let last = at + take >= n
        var payload: [u8] = [((if first then 0 else ISO_SEGMENT_SC) | (if last then ISO_SEGMENT_CMPLT else 0)) as u8,
                             (take + (if first then ISO_TIME_OFFSET_LEN else 0)) as u8]
        if first
            list.append(payload, [(time_offset & 0xFF) as u8,
                ((time_offset >>> 8) & 0xFF) as u8,
                ((time_offset >>> 16) & 0xFF) as u8])
        list.append(payload, sdu[at:at + take])
        list.push(pdus, IsoPdu { llid: ISO_LLID_FRAMED, payload: payload })
        at = at + take
        first = false
        if last
            break
    Some(pdus)

// The SDUs a sequence of framed PDUs carries, in order.  A PDU holds one or
// more segments, each a header and its `length` octets; a segment with SC
// clear starts an SDU and has the Time_Offset first, one with SC set
// continues it, and one with CMPLT set ends it. A PDU of another LLID is
// skipped. A segment that runs past the end of its PDU, a continuation
// with no start, a start whose segment is shorter than the Time_Offset
// and the octets after the last CMPLT segment are not answered; the first
// three also drop the SDU being collected.
@satisfies("REQ-BLE-ISO-002")
@tier(embedded)
fn isoal_framed_sdus(pdus: [IsoPdu]) -> [IsoFramedSdu]
    var sdus: [IsoFramedSdu] = []
    var current: [u8] = []
    var offset = 0
    var open = false
    for p in pdus
        if p.llid != ISO_LLID_FRAMED
            continue
        let pl = p.payload
        var at = 0
        while at + ISO_SEGMENT_HEADER_LEN <= list.len(pl)
            let flags = pl[at] as Int
            let len = pl[at + 1] as Int
            let body = at + ISO_SEGMENT_HEADER_LEN
            if body + len > list.len(pl)
                open = false
                current = []
                break
            var data_at = body
            var ok = true
            if (flags & ISO_SEGMENT_SC) == 0
                // A start segment: Time_Offset first.  It drops an SDU left open.
                current = []
                if len < ISO_TIME_OFFSET_LEN
                    ok = false
                    open = false
                else
                    offset = pl[body] as Int | (pl[body + 1] as Int << 8) | (pl[body + 2] as Int << 16)
                    data_at = body + ISO_TIME_OFFSET_LEN
                    open = true
            else if not open
                ok = false
            if ok
                list.append(current, pl[data_at:body + len])
                if (flags & ISO_SEGMENT_CMPLT) != 0
                    list.push(sdus, IsoFramedSdu { time_offset: offset, data: current[:] })
                    current = []
                    open = false
            at = body + len
    sdus

// ── Framed PDUs: Unsegmented mode, aggregation and padding ──────────
//
// [Vol 6] Part G, Section 2.2: in Segmentable mode a PDU may hold segments
// of more than one SDU and an SDU may run over several PDUs; in Unsegmented
// mode each SDU is one segment in one PDU, and a PDU may hold more than one
// SDU.  A segment's header and Time_Offset are never split between PDUs, so
// a new segment starts in a PDU only when the octets left hold the header
// and the Time_Offset and, for an SDU with data, one octet of it: the
// specification allows a start with only the header and the Time_Offset
// left (5 octets) and advises against it, which these functions follow.
// A framed PDU of zero length is a padding PDU and has no header.
//
// These functions build lists of PDUs and are application-tier: a
// Controller's Link Layer, and the tests that stand in for one, send the
// PDUs; the Host does not.

// The padding PDU of a framed stream: no payload, no segmentation header.
@satisfies("REQ-BLE-ISO-007")
@tier(app)
fn isoal_framed_padding_pdu() -> IsoPdu
    IsoPdu { llid: ISO_LLID_FRAMED, payload: [] }

// `pdus`, the framed PDUs of one event, made up to `bn` PDUs with padding
// PDUs, so that every CIS or BIS event carries the number of PDUs the burst
// number says ([Vol 6] Part G, Section 2.2).  `pdus` is returned as it is
// when it has `bn` PDUs or more.
@satisfies("REQ-BLE-ISO-007")
@tier(app)
fn isoal_framed_pad(pdus: [IsoPdu], bn: Int) -> [IsoPdu]
    var out = pdus[:]
    while list.len(out) < bn
        list.push(out, isoal_framed_padding_pdu())
    out

// The one PDU that carries `sdu` in Unsegmented mode: a segmentation header
// with SC clear and CMPLT set, the Time_Offset and the whole SDU.  `None`
// when the segment does not fit: the PDU is longer than `max_pdu`, or the
// segment is above 255 octets (its length is one octet and counts the
// Time_Offset), and for a `time_offset` outside 24 bits.
@satisfies("REQ-BLE-ISO-007")
@tier(app)
fn isoal_framed_unsegmented_pdu(sdu: [u8], time_offset: Int, max_pdu: Int) -> ?IsoPdu
    let segment = ISO_TIME_OFFSET_LEN + list.len(sdu)
    if time_offset < 0 or time_offset > 0xFFFFFF or segment > 0xFF or ISO_SEGMENT_HEADER_LEN + segment > max_pdu
        return None
    var payload: [u8] = [ISO_SEGMENT_CMPLT, segment as u8,
                         (time_offset & 0xFF) as u8, ((time_offset >>> 8) & 0xFF) as u8, ((time_offset >>> 16) & 0xFF) as u8]
    list.append(payload, sdu)
    Some(IsoPdu { llid: ISO_LLID_FRAMED, payload: payload })

// Append one segment to `payload`: header, then the Time_Offset when the
// segment starts an SDU, then `data`.
@tier(app)
fn isoal_put_segment(var payload: [u8], start: Bool, complete: Bool, time_offset: Int, data: [u8])
    let length = list.len(data) + (if start then ISO_TIME_OFFSET_LEN else 0)
    list.push(payload,
        ((if start then 0 else ISO_SEGMENT_SC) | (if complete then ISO_SEGMENT_CMPLT else 0)) as u8)
    list.push(payload, length as u8)
    if start
        list.append(payload, [(time_offset & 0xFF) as u8,
            ((time_offset >>> 8) & 0xFF) as u8,
            ((time_offset >>> 16) & 0xFF) as u8])
    for b in data
        list.push(payload, b)

// The framed PDUs that carry `sdus` in order, each PDU at most `max_pdu`
// octets, filled as far as the rules above allow.  With `unsegmented` clear
// this is Segmentable mode: an SDU that does not fit the octets left in a
// PDU is cut, the first part going into them and the rest starting the next
// PDU, and an SDU that fits is followed in the same PDU by the next SDU's
// start.  With `unsegmented` set each SDU is one segment, put in the PDU
// that is open when it fits whole and in a new PDU when it does not.  The
// last PDU is closed with what it holds.  `None` for a `max_pdu` that leaves
// no room for an octet of data beside a header and a Time_Offset (6), for a
// Time_Offset outside 24 bits, and in Unsegmented mode for an SDU whose
// segment is above 255 octets or does not fit one empty PDU.
@satisfies("REQ-BLE-ISO-007")
@tier(app)
fn isoal_framed_aggregate(sdus: [IsoFramedSdu], max_pdu: Int, unsegmented: Bool) -> ?[IsoPdu]
    let start_room = ISO_SEGMENT_HEADER_LEN + ISO_TIME_OFFSET_LEN
    if max_pdu <= start_room
        return None
    var pdus: [IsoPdu] = []
    var payload: [u8] = []
    for sdu in sdus
        if sdu.time_offset < 0 or sdu.time_offset > 0xFFFFFF
            return None
        let n = list.len(sdu.data)
        if unsegmented
            let need = start_room + n
            if ISO_TIME_OFFSET_LEN + n > 0xFF or need > max_pdu
                return None
            if list.len(payload) + need > max_pdu
                list.push(pdus, IsoPdu { llid: ISO_LLID_FRAMED, payload: payload })
                payload = []
            isoal_put_segment(var payload, true, true, sdu.time_offset, sdu.data)
            continue
        var at = 0
        var first = true
        while true
            // A new segment needs the header, the Time_Offset when it starts
            // an SDU, and one octet of data when there is data left; a
            // header with no data to follow is for an empty SDU only.
            let head = ISO_SEGMENT_HEADER_LEN + (if first then ISO_TIME_OFFSET_LEN else 0)
            let left = max_pdu - list.len(payload)
            let wants = head + (if n - at > 0 then 1 else 0)
            if left < wants
                list.push(pdus, IsoPdu { llid: ISO_LLID_FRAMED, payload: payload })
                payload = []
                continue
            var room = left - head
            let cap = 0xFF - (if first then ISO_TIME_OFFSET_LEN else 0)
            if room > cap
                room = cap
            let take = if n - at > room
                room
            else
                n - at
            let last = at + take >= n
            isoal_put_segment(var payload, first, last, sdu.time_offset, sdu.data[at:at + take])
            at = at + take
            first = false
            if last
                break
    if list.len(payload) > 0
        list.push(pdus, IsoPdu { llid: ISO_LLID_FRAMED, payload: payload })
    Some(pdus)

// ── Fixtures that the suites of other modules share ─────────────────────

// `n` octets 0, 1, 2, ... (mod 251, so that neighbouring octets differ).
@tier(app)
fn sdu_of(n: Int) -> [u8]
    var sdu: [u8] = []
    for i in 0..n
        list.push(sdu, (i % 251) as u8)
    sdu
